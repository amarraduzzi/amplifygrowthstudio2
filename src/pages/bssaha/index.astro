---
// Bssaha: commission-free ordering directory for Rabat restaurants (French only).
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import FinalCta from '../../components/FinalCta.astro';
import WaButton from '../../components/WaButton.astro';
import { ROUTES, abs } from '../../i18n/routes';
import { waLink } from '../../config';
import { RESTOS, MODES } from '../../data/bssaha';

const lang = 'fr' as const;
const title = 'Bssaha : commandez directement au restaurant, sans commission | Rabat';
const description = 'Les restaurants de Rabat vendent ici sans commission. Vous commandez directement chez eux, par leur page de commande ou sur WhatsApp.';
const wa = 'Bonjour, je voudrais ajouter mon restaurant sur Bssaha.';
const restos = RESTOS.filter(r => r.actif).map(r => ({
  ...r,
  href: r.orderUrl || (r.whatsapp ? waLink(`Bonjour, je souhaite commander (via Bssaha).`).replace(/wa\.me\/\d+/, `wa.me/${r.whatsapp.replace(/\D/g, '')}`) : ''),
  isWa: !r.orderUrl && !!r.whatsapp,
}));
const quartiers = [...new Set(restos.map(r => r.quartier))].sort();
const cuisines = [...new Set(restos.map(r => r.cuisine))].sort();
const schema = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Bssaha', inLanguage: 'fr', url: abs(ROUTES.bssaha.fr),
  about: restos.map(r => ({ '@type': 'Restaurant', name: r.nom, servesCuisine: r.cuisine, address: { '@type': 'PostalAddress', addressLocality: r.quartier, addressCountry: 'MA' } })) }];
const WA_JOIN = waLink('Bonjour, je voudrais ajouter mon restaurant sur Bssaha.');
---
<Base lang={lang} page="bssaha" title={title} description={description} wa={wa} schema={schema} langsOnly={['fr']}>
  <section class="relative isolate overflow-hidden bg-blue text-white">
    <Bars class="absolute inset-x-0 bottom-0 -z-10 h-32 md:h-44" animate />
    <div class="mx-auto grid max-w-6xl gap-12 px-4 pb-24 pt-12 sm:px-6 md:grid-cols-[1.2fr_0.8fr] md:items-center md:pb-28 md:pt-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-semibold text-mint"><span class="size-2 rounded-full bg-green" aria-hidden="true"></span>Bssaha, par Amplify</p>
        <h1 id="hero-title" class="mt-5 text-[3.2rem] sm:text-6xl lg:text-[5.2rem]">Commandez directement <span class="text-green">au restaurant</span></h1>
        <p class="measure mt-6 text-lg text-white/85">À Rabat, des restaurants vendent ici sans commission. Vous choisissez, vous commandez chez eux, et votre argent va au restaurant.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a id="hero-cta" href="#liste" class="inline-flex min-h-12 items-center justify-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">Voir les restaurants</a>
          <a href="#rejoindre" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 px-7 text-lg hover:border-white">Je suis restaurateur</a>
        </div>
      </div>
      <!-- the receipt: where the money goes -->
      <div class="rotate-[1.5deg] rounded-2xl bg-paper p-6 font-mono text-navy shadow-[0_24px_50px_-28px_rgba(0,0,0,0.7)]" aria-label="Exemple de ticket de commande">
        <div class="flex justify-between py-1"><span>Votre commande</span><span dir="ltr">100 DH</span></div>
        <hr class="my-2 border-dashed border-line" />
        <div class="flex justify-between py-1"><span>Au restaurant</span><span dir="ltr">100 DH</span></div>
        <div class="flex justify-between py-1"><span>Commission Bssaha</span><span dir="ltr">0 DH</span></div>
        <hr class="my-2 border-dashed border-line" />
        <div class="flex justify-between py-1 text-lg font-bold"><span>Total plats</span><span dir="ltr">100 DH</span></div>
        <p class="mt-3 font-sans text-sm text-muted">Exemple. La livraison est facturée à part, selon le restaurant.</p>
      </div>
    </div>
  </section>

  <section id="liste" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
    <h2 class="text-5xl md:text-6xl">Restaurants à Rabat</h2>
    <div class="mt-8 grid gap-3 md:grid-cols-[2fr_1fr_1fr]">
      <input id="q-text" type="search" placeholder="Rechercher un restaurant ou une cuisine" aria-label="Rechercher" class="min-h-12 rounded-full bg-paper px-5 ring-1 ring-line" />
      <select id="q-quartier" aria-label="Quartier" class="min-h-12 rounded-full bg-paper px-5 ring-1 ring-line"><option value="">Tous les quartiers</option>{quartiers.map(q => <option value={q}>{q}</option>)}</select>
      <select id="q-cuisine" aria-label="Cuisine" class="min-h-12 rounded-full bg-paper px-5 ring-1 ring-line"><option value="">Toutes les cuisines</option>{cuisines.map(c => <option value={c}>{c}</option>)}</select>
    </div>
    <label class="mt-4 flex items-center gap-2 text-muted"><input id="q-open" type="checkbox" class="size-5 accent-green" /> Ouverts maintenant</label>
    <p id="count" class="mt-4 text-sm text-muted" aria-live="polite"></p>
    <ul id="grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {restos.map(r => (
        <li class="resto flex flex-col gap-3 rounded-[1.4rem] bg-paper p-5 ring-1 ring-line" data-nom={`${r.nom} ${r.cuisine} ${r.description}`.toLowerCase()} data-q={r.quartier} data-c={r.cuisine} data-h={JSON.stringify(r.horaires ?? {})}>
          <h3 class="text-xl">{r.nom}</h3>
          <p class="text-sm text-muted">{r.cuisine} – {r.quartier}</p>
          <p class="flex flex-wrap gap-2">
            <span class="open-tag hidden rounded-full bg-green px-3 py-1 text-xs font-bold text-navy">Ouvert maintenant</span>
            {r.modes.map(m => <span class={`rounded-full px-3 py-1 text-xs font-bold ${m === 'direct' ? 'bg-mint text-green-deep' : 'bg-chalk text-navy'}`}>{MODES[m]}</span>)}
          </p>
          <p class="text-[0.95rem]">{r.description}</p>
          {r.href && <a href={r.href} target="_blank" rel="noopener" class="mt-auto inline-flex min-h-12 items-center justify-center rounded-full bg-green px-6 font-semibold text-navy hover:bg-[#04A859]">{r.isWa ? 'Commander sur WhatsApp' : 'Commander'}</a>}
        </li>
      ))}
    </ul>
    <p id="empty" class="mt-4 hidden rounded-2xl border border-dashed border-line p-8 text-center text-muted">Aucun restaurant pour ce filtre. <a href="#rejoindre" class="font-semibold text-green-deep underline">Ajoutez le vôtre.</a></p>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
      <h2 class="text-5xl md:text-6xl">Comment ça marche</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        <li class="border-s-4 border-green ps-5"><h3 class="text-xl">Vous choisissez</h3><p class="mt-2 text-muted">Cherchez par quartier, cuisine ou « ouvert maintenant ».</p></li>
        <li class="border-s-4 border-green ps-5"><h3 class="text-xl">Vous commandez chez eux</h3><p class="mt-2 text-muted">Le bouton ouvre la page de commande du restaurant, ou son WhatsApp.</p></li>
        <li class="border-s-4 border-green ps-5"><h3 class="text-xl">Le restaurant garde tout</h3><p class="mt-2 text-muted">Bssaha ne prélève aucune commission sur la commande.</p></li>
      </ol>
    </div>
  </section>

  <section id="rejoindre" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-5xl md:text-6xl">Vous avez un restaurant ?</h2>
        <p class="measure mt-5 text-lg text-muted">Que vous ayez déjà un site, votre propre livraison ou rien du tout, vous pouvez être listé. Sans site, Amplify vous en crée un avec commande directe.</p>
        <ul class="mt-6 space-y-3">
          <li>Aucune commission sur les commandes passées via Bssaha.</li>
          <li>Les prix affichés ne dépassent pas ceux de votre salle.</li>
          <li>Les emplacements payants seront toujours clairement indiqués.</li>
          <li>Un restaurant lent ou peu fiable peut être retiré de la liste.</li>
        </ul>
      </div>
      <form id="join" class="grid content-start gap-4 rounded-[1.6rem] bg-paper p-6 ring-1 ring-line">
        <label class="grid gap-1.5 font-semibold">Nom du restaurant<input name="nom" required class="min-h-12 rounded-xl bg-chalk px-4 font-normal" /></label>
        <label class="grid gap-1.5 font-semibold">Quartier<input name="quartier" required placeholder="Agdal, Hay Riad, Souissi…" class="min-h-12 rounded-xl bg-chalk px-4 font-normal" /></label>
        <label class="grid gap-1.5 font-semibold">Votre numéro WhatsApp<input name="tel" type="tel" required placeholder="06 …" class="min-h-12 rounded-xl bg-chalk px-4 font-normal" /></label>
        <label class="grid gap-1.5 font-semibold">Votre situation
          <select name="cas" class="min-h-12 rounded-xl bg-chalk px-4 font-normal"><option>Je n’ai pas de site</option><option>J’ai déjà un site ou une page de commande</option><option>J’ai ma propre livraison</option><option>Les deux : site et livraison</option></select></label>
        <label class="grid gap-1.5 font-semibold">Lien de votre site ou page de commande (facultatif)<input name="lien" type="url" placeholder="https://" class="min-h-12 rounded-xl bg-chalk px-4 font-normal" /></label>
        <button type="submit" class="min-h-12 rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">Envoyer sur WhatsApp</button>
        <p class="text-sm text-muted">Le bouton ouvre WhatsApp avec vos réponses. Vous pouvez modifier le message avant l’envoi. <a href={WA_JOIN} class="underline">Ou écrivez-nous directement.</a></p>
      </form>
    </div>
  </section>

  <FinalCta lang={lang} page="bssaha" wa={wa} h2="Vendez sans commission" p="Une question avant de vous inscrire ? Écrivez-nous sur WhatsApp." />

  <script is:inline define:vars={{ number: '212611053649' }}>
    (function () {
      var cards = [].slice.call(document.querySelectorAll('.resto'));
      var days = ['dim', 'lun', 'mar', 'mer', 'jeu', 'ven', 'sam'];
      function isOpen(h) {
        var now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Casablanca' }));
        var slot = h[days[now.getDay()]]; if (!slot) return null;
        var p = slot.split('-').map(function (s) { var x = s.split(':'); return +x[0] * 60 + +x[1]; });
        var m = now.getHours() * 60 + now.getMinutes();
        return p[1] > p[0] ? (m >= p[0] && m < p[1]) : (m >= p[0] || m < p[1]);
      }
      cards.forEach(function (c) { c._o = isOpen(JSON.parse(c.dataset.h || '{}')); if (c._o === true) c.querySelector('.open-tag').classList.remove('hidden'); });
      var $ = function (s) { return document.querySelector(s); };
      function draw() {
        var s = $('#q-text').value.toLowerCase(), q = $('#q-quartier').value, cu = $('#q-cuisine').value, op = $('#q-open').checked, n = 0;
        cards.forEach(function (c) {
          var ok = (!s || c.dataset.nom.indexOf(s) > -1) && (!q || c.dataset.q === q) && (!cu || c.dataset.c === cu) && (!op || c._o === true);
          c.hidden = !ok; if (ok) n++;
        });
        $('#count').textContent = n + ' restaurant' + (n > 1 ? 's' : '');
        $('#empty').classList.toggle('hidden', n > 0);
      }
      ['#q-text', '#q-quartier', '#q-cuisine', '#q-open'].forEach(function (id) { $(id).addEventListener('input', draw); $(id).addEventListener('change', draw); });
      draw();
      $('#join').addEventListener('submit', function (e) {
        e.preventDefault(); var f = new FormData(e.target);
        var msg = 'Bonjour, je souhaite rejoindre Bssaha.\nRestaurant : ' + f.get('nom') + '\nQuartier : ' + f.get('quartier') + '\nWhatsApp : ' + f.get('tel') + '\nSituation : ' + f.get('cas') + '\nLien : ' + (f.get('lien') || '-');
        location.href = 'https://wa.me/' + number + '?text=' + encodeURIComponent(msg);
      });
    })();
  </script>
</Base>
