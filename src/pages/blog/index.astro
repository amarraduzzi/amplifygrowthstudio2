---
// Blog overview (French only). Add a post here when a new article goes live.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FinalCta from '../../components/FinalCta.astro';
import { ROUTES, abs } from '../../i18n/routes';

const lang = 'fr' as const;
const title = 'Blog : gérer un restaurant avec des chiffres | Amplify Growth Studio';
const description = 'Des articles courts et chiffrés pour les restaurateurs au Maroc : coût d’un plat, marketing qui rapporte, caisse et marges.';
const wa = 'Bonjour, j’ai lu votre blog. Je voudrais regarder mes chiffres avec vous.';
const posts = [
  { href: ROUTES.blogChiffres.fr, img: '/img/photos/metier-snack', imgBig: '1600', w: 1536, alt: 'Le comptoir très animé d’un snack : des cuisiniers préparent des plats pendant que des clients attendent', date: '2026-10-11', label: '11 octobre 2026', min: 6,
    title: 'Les six chiffres que tout restaurateur doit connaître', text: 'Ticket moyen, coût d’un plat, ingrédients, personnel, point mort, bénéfice : les bases, comment les calculer et à quel rythme les regarder.' },
  { href: ROUTES.blogPointMort.fr, img: '/img/photos/metier-cafe', imgBig: '1600', w: 1536, alt: 'Au comptoir d’un café, un barista prépare un café pendant que des clients attendent devant la vitrine de viennoiseries', date: '2026-10-11', label: '11 octobre 2026', min: 6,
    title: 'Combien vendre par jour pour gagner de l’argent ?', text: 'Le point mort : le chiffre d’affaires en dessous duquel vous perdez. Le calcul en trois lignes, par mois, par jour et en clients.' },
  { href: ROUTES.blogValeur.fr, img: '/img/photos/pf-soir', imgBig: '1600', w: 1376, alt: 'Un patron de restaurant fait ses comptes seul au comptoir, tard le soir, salle vide et chaises relevées', date: '2026-10-11', label: '11 octobre 2026', min: 6,
    title: 'Que vaut votre restaurant, sur le papier ?', text: 'Banque, acheteur, futur franchisé : ils ne regardent pas ce que vous gagnez, mais ce que vous pouvez prouver. Un exemple chiffré et quatre étapes.' },
  { href: ROUTES.blogCouts.fr, img: '/img/photos/metier-restaurant', imgBig: '1600', w: 1536, alt: 'Une salle de restaurant bien remplie, avec des serveurs qui circulent entre les tables', date: '2026-10-11', label: '11 octobre 2026', min: 6,
    title: 'Les coûts bas cachent des défauts', text: 'Personnel peu cher, achats en hausse : ce qui reste de vos ventes quand les coûts bougent, et quatre réflexes pour rendre votre restaurant sain.' },
  { href: ROUTES.blogPlateforme.fr, img: '/img/photos/metier-snack', imgBig: '1600', w: 1536, alt: 'Le comptoir très animé d’un snack : des cuisiniers préparent des plats pendant que des clients attendent', date: '2026-10-11', label: '11 octobre 2026', min: 5,
    title: 'Que reste-t-il d’une commande de 100 DH ?', text: 'Commission, ingrédients, emballage : ce qu’il vous reste vraiment d’une commande via une plateforme, comparé à une commande directe.' },
  { href: ROUTES.blogCout.fr, img: '/img/photos/balance', imgBig: '1376', w: 1376, alt: 'Un cuisinier ajoute du fromage râpé sur une pizza posée sur une balance', date: '2026-10-11', label: '11 octobre 2026', min: 5,
    title: 'Combien coûte vraiment votre plat ?', text: 'Fiche technique, foodcost et prix : un exemple chiffré sur une pizza, et comment lire le prix du voisin sans le copier.' },
  { href: ROUTES.blogVues.fr, img: '/img/blog/vues-1-hero', imgBig: '1376', w: 1376, alt: 'Un patron de café à Rabat, seul dans sa salle presque vide, son téléphone à la main', date: '2026-10-11', label: '11 octobre 2026', min: 5,
    title: '80 000 vues, combien de clients ?', text: 'Agence, publicité Meta, tournage : la facture complète d’une vidéo virale, et ce qu’il en reste vraiment en caisse.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'Blog', name: 'Blog Amplify Growth Studio', inLanguage: 'fr', url: abs(ROUTES.blog.fr),
  blogPost: posts.map(p => ({ '@type': 'BlogPosting', headline: p.title, url: abs(p.href), datePublished: p.date })) }];
---
<Base lang={lang} page="blog" title={title} description={description} wa={wa} schema={schema} langsOnly={['fr']}>
  <PageHero lang={lang} page="blog" wa={wa} h1="Le blog" lead="Des chiffres, pas des opinions. Des articles courts pour les restaurateurs qui veulent savoir ce qu’il leur reste." />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
    <ul class="grid gap-6 md:grid-cols-2">
      {posts.map(p => (
        <li class="flex">
          <a href={p.href} class="group flex w-full flex-col overflow-hidden rounded-3xl bg-paper ring-1 ring-line transition-shadow hover:shadow-xl focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-green">
            <div class="overflow-hidden"><img src={`${p.img}-${p.imgBig}.webp`} srcset={`${p.img}-800.webp 800w, ${p.img}-${p.imgBig}.webp ${p.w}w`} sizes="(min-width: 1152px) 560px, (min-width: 768px) 50vw, 100vw" alt={p.alt} width="1376" height="768" loading="lazy" decoding="async" class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="text-sm text-muted"><time datetime={p.date}>{p.label}</time> · {p.min} min de lecture</p>
              <h2 class="mt-2 text-3xl sm:text-4xl">{p.title}</h2>
              <p class="mt-3 text-muted">{p.text}</p>
              <p class="mt-auto pt-5 font-semibold text-green-deep">Lire l’article <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-sm text-muted">Les montants des articles sont des exemples. Les photos sont des illustrations, elles ne montrent ni de vrais clients ni l’équipe Amplify.</p>
  </section>

  <FinalCta lang={lang} page="blog" wa={wa} h2="Parlons de vos chiffres." p="Nous les regardons avec vous, gratuitement, à partir de vos propres données de caisse." />
</Base>
