---
// Article: what a "viral" restaurant video really costs and brings in. French only (the audience reads French).
// Figures are worked examples, said so on the page. Replace them with a client's real numbers when available.
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogEnd from '../../../components/BlogEnd.astro';
import FinalCta from '../../../components/FinalCta.astro';
import PhotoBand from '../../../components/PhotoBand.astro';
import CountUp from '../../../components/CountUp.astro';
import LeakTicker from '../../../components/LeakTicker.astro';
import { ROUTES, abs } from '../../../i18n/routes';

const lang = 'fr' as const;
const title = '80 000 vues, combien de clients ? Le calcul complet | Amplify Growth Studio';
const description = 'Une vidéo vue 80 000 fois rapporte combien de clients à un restaurant ? Le calcul complet : agence, publicité Meta, et ce qu’il reste vraiment en caisse.';
const wa = 'Bonjour, j’ai lu votre article sur les 80 000 vues. Je voudrais regarder mes chiffres avec vous.';
const url = abs(ROUTES.blogVues.fr);

const schema = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: '80 000 vues, combien de clients ?',
  description, inLanguage: 'fr', image: abs('/img/blog/vues-1-hero-1376.webp'), datePublished: '2026-10-11', mainEntityOfPage: url,
  author: { '@type': 'Organization', name: 'Amplify Growth Studio' },
  publisher: { '@type': 'Organization', name: 'Amplify Growth Studio' },
}];

// AI-generated illustrations (ambience only, not real clients), see the note at the end of the article.
const IMG = {
  hero: ['vues-1-hero', 'Un patron de café à Rabat, seul à une table dans sa salle presque vide, son téléphone à la main'],
  cout: ['vues-2-cout', 'Un créateur de contenu filme un plateau de plats marocains avec un smartphone sur stabilisateur, le patron derrière lui les bras croisés'],
  terrasse: ['vues-3-terrasse', 'Une terrasse de café presque vide à Rabat, un thé à la menthe et un téléphone posés sur une table en mosaïque'],
  cuisine: ['vues-4-cuisine', 'Dans une cuisine de restaurant, un chef pèse une portion sur une balance pendant qu’une collègue contrôle une liste'],
  apres: ['vues-5-apres', 'Deux jeunes regardent un téléphone dans une rue de Rabat au crépuscule, devant l’entrée éclairée d’un restaurant'],
  chiffres: ['vues-6-chiffres', 'Le patron d’un restaurant, au comptoir après la fermeture, consulte ses chiffres sur une tablette'],
} as const;

const costs: [string, string][] = [
  ['Agence ou créateur de contenu', '3 000 DH / mois'],
  ['Publicité Meta, ciblée sur Rabat', '2 000 DH / mois'],
];
const funnel: [string, string, number][] = [
  ['Vues de la vidéo', '80 000', 1],
  ['Regardent plus de 3 secondes', '2 000', 0.025],
  ['Habitent la zone (la moitié)', '1 000', 0.0125],
  ['Viennent vraiment (2 %)', '20 clients', 0.0025],
];
const note = 'Les montants de cet article sont des exemples qui illustrent le raisonnement. Vos chiffres réels peuvent être très différents, et c’est précisément pour cela qu’il vaut la peine de les regarder. Les photos sont des illustrations générées par IA, elles ne montrent ni de vrais clients ni l’équipe Amplify.';
const reads = [{ href: ROUTES.blogCout.fr, title: 'Combien coûte vraiment votre plat ?', text: 'Le calcul de la marge, plat par plat.' },{ href: ROUTES.blogPlateforme.fr, title: 'Que reste-t-il d’une commande de 100 DH ?', text: 'Plateforme de livraison ou commande directe.' }];
const question = 'Le mois prochain, ne regardez pas combien de vues vous avez eues. Regardez combien il reste de chaque tranche de 100 DH de chiffre d’affaires, après tous les coûts, agence et publicité comprises. Quel chiffre attendez-vous ? Et correspond-il à ce qui arrive sur votre compte ?';
const after = [
  ['Il vous cherche sur Google ou Maps.', 'Votre fiche est-elle à jour, avec les horaires et de belles photos ?'],
  ['Il veut commander ou réserver.', 'Peut-il le faire directement par WhatsApp, ou doit-il chercher un numéro ?'],
  ['Il vient, et il est content.', 'A-t-il une raison de revenir ?'],
];
---
<Base lang={lang} page="blogVues" title={title} description={description} wa={wa} schema={schema} langsOnly={['fr']}>
  <PageHero lang={lang} page="blogVues" wa={wa}
    h1="80 000 vues, combien de clients ?"
    lead="Votre vidéo a été vue 80 000 fois. Ça fait plaisir. Mais ces vues ne sont presque jamais gratuites. Regardons la facture complète, du premier dirham au dernier client." />

  <article>
  <div class="mx-auto max-w-3xl px-4 pb-8 pt-16 sm:px-6 md:pt-24">
    <figure class="mb-10 overflow-hidden rounded-3xl ring-1 ring-line">
      <img src={`/img/blog/${IMG.hero[0]}-1376.webp`} srcset={`/img/blog/${IMG.hero[0]}-800.webp 800w, /img/blog/${IMG.hero[0]}-1376.webp 1376w`} sizes="(min-width: 768px) 768px, 100vw" alt={IMG.hero[1]} width="1376" height="768" loading="eager" decoding="async" class="aspect-video w-full object-cover" />
    </figure>
        <p class="text-xl text-muted">Il y a eu le tournage, souvent une agence, et de l’argent versé à Meta pour que la vidéo soit montrée. Voici un exemple chiffré, avec des hypothèses. Remplacez-les par ce que vous payez vraiment.</p>

    <!-- cost -->
    <h2 class="mt-14 text-2xl sm:mt-16 sm:text-4xl">Ce que la vidéo coûte</h2>
    <figure class="mt-8 overflow-hidden rounded-3xl ring-1 ring-line">
      <img src={`/img/blog/${IMG.cout[0]}-1376.webp`} srcset={`/img/blog/${IMG.cout[0]}-800.webp 800w, /img/blog/${IMG.cout[0]}-1376.webp 1376w`} sizes="(min-width: 768px) 768px, 100vw" alt={IMG.cout[1]} width="1376" height="768" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
    </figure>
    <div class="mt-6 rounded-3xl bg-paper p-6 ring-1 ring-line sm:p-8">
      <dl>
        {costs.map(([k, v]) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-3"><dt>{k}</dt><dd class="whitespace-nowrap font-semibold">{v}</dd></div>
        ))}
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 pt-4"><dt class="font-semibold">Total</dt><dd class="display text-3xl text-navy">5 000 DH / mois</dd></div>
      </dl>
      <p class="mt-2 text-end text-muted">soit <strong class="text-navy">60 000 DH par an</strong></p>
    </div>
    <p class="mt-5">Votre temps n’est pas compté ici. Si vous faites les vidéos vous-même, vous ne payez pas d’agence, mais vous payez en heures qui ne vont ni à la cuisine ni aux clients.</p>

    <!-- return -->
    <h2 class="mt-14 text-2xl sm:mt-16 sm:text-4xl">Ce que la vidéo rapporte</h2>
    <p class="mt-5">Supposons que ça marche : <strong>80 000 vues</strong>. Voilà ce qu’il en reste.</p>
    </div>
  <PhotoBand name="vues-3-terrasse" dir="/img/blog" big="1376" w={1376} h={768} alt={IMG.terrasse[1]} kicker="Le piège" title="Des vues. Pas des clients." class="my-14 md:my-20" pos="50% 60%" />
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mt-6 rounded-3xl bg-paper p-6 ring-1 ring-line sm:p-8" data-scrub="steps">
      <ul class="space-y-5">
        {funnel.map(([k, v, share]) => (
          <li class="step fn-row">
            <div class="flex items-baseline justify-between gap-4"><span>{k}</span><strong class="display whitespace-nowrap text-2xl">{v}</strong></div>
            <div class="mt-2 h-4 overflow-hidden rounded-full bg-chalk" aria-hidden="true"><div class="fn-bar h-full rounded-full bg-green" style={`width:${Math.max(share * 100, 1.2)}%`}></div></div>
          </li>
        ))}
      </ul>
      <p class="mt-6 border-t-2 border-navy pt-4 text-end">20 clients × 60 DH = <strong class="display whitespace-nowrap text-3xl"><span data-count="1200">1 200</span> DH</strong> de chiffre d’affaires</p>
      <p class="mt-2 text-end text-sm text-muted">Les barres sont à l’échelle. La dernière est agrandie : à taille réelle, elle serait invisible.</p>
    </div>

    <div class="mt-8 rounded-3xl bg-navy p-7 text-white sm:p-9" data-scrub="steps">
      <p class="display text-4xl sm:text-5xl"><span data-count="5000">5 000</span> DH dépensés.<br /><span class="text-green"><span data-count="1200">1 200</span> DH encaissés.</span></p>
      <div class="mt-6 space-y-3" aria-hidden="true">
        <div class="step fn-row h-4 overflow-hidden rounded-full bg-white/10"><div class="fn-bar h-full w-full rounded-full bg-[#E5484D]"></div></div>
        <div class="step fn-row h-4 overflow-hidden rounded-full bg-white/10"><div class="fn-bar h-full w-[24%] rounded-full bg-green"></div></div>
      </div>
      <p class="mt-4 text-lg text-white/80">Et cela, avant même de payer les ingrédients. Chaque nouveau client vous coûte environ <strong class="text-white">250 DH</strong> de marketing, alors qu’il dépense 60 DH. Même dans un mois exceptionnel, à 5 % au lieu de 2 %, on arrive à 50 clients et 3 000 DH de chiffre d’affaires : encore moins que la dépense.</p>
    </div>

    <h2 class="mt-14 text-2xl sm:mt-16 sm:text-4xl">Ce qui peut sauver le calcul</h2>
    <p class="mt-5">Un client qui revient. Quelqu’un qui vient quatre fois vaut 240 DH, pas 60 DH. C’est là que se trouve la vraie valeur, mais seulement si vos clients ont une raison de revenir et si vous savez qui ils sont. Sans cela, la vidéo reste une dépense à refaire chaque mois.</p>

    <!-- other side -->
    <h2 class="mt-14 text-2xl sm:mt-16 sm:text-4xl">L’autre côté de la balance</h2>
    <p class="mt-5">Imaginons un chiffre d’affaires de 200 000 DH par mois. Que se passe-t-il si vous perdez 3 % de moins en gaspillage, en portions mal calibrées, en achats ou en écarts de caisse ?</p>
    </div>
  <PhotoBand name="vues-4-cuisine" dir="/img/blog" big="1376" w={1376} h={768} alt={IMG.cuisine[1]} kicker="Là où l’argent se joue" title="Le vrai levier est en cuisine." class="my-14 md:my-20" pos="50% 50%" />
  <LeakTicker />
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mt-6 rounded-3xl bg-mint p-7 sm:p-9">
      <p class="text-lg">3 % de 200 000 DH =</p>
      <p class="display mt-1 text-5xl text-green-deep sm:text-6xl"><span data-count="6000">6 000</span> DH par mois</p>
      <p class="mt-3 text-lg">Soit <strong>72 000 DH par an</strong>, chaque année.</p>
    </div>
    <p class="mt-6">C’est plus que l’agence et la publicité réunies, sans dépense supplémentaire. Une vidéo virale est un pic qu’il faut racheter chaque mois. Une baisse du coût de revient travaille tous les jours.</p>
    <p class="mt-4">Pourquoi tant d’établissements choisissent-ils quand même la vidéo ? Parce qu’elle se voit. Le chiffre monte et on peut le montrer. Les coûts, eux, restent invisibles tant qu’on ne connaît pas ses chiffres.</p>

    <!-- what happens after: a real sequence -->
    <h2 class="mt-14 text-2xl sm:mt-16 sm:text-4xl">Ce qui se passe après la vidéo</h2>
    <p class="mt-5">Quelqu’un aime votre vidéo. Que fait-il ensuite ?</p>
    <figure class="mt-8 overflow-hidden rounded-3xl ring-1 ring-line">
      <img src={`/img/blog/${IMG.apres[0]}-1376.webp`} srcset={`/img/blog/${IMG.apres[0]}-800.webp 800w, /img/blog/${IMG.apres[0]}-1376.webp 1376w`} sizes="(min-width: 768px) 768px, 100vw" alt={IMG.apres[1]} width="1376" height="768" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
    </figure>
    <ol class="mt-6 space-y-4" data-scrub="steps">
      {after.map(([a, b], i) => (
        <li class="step af-step flex gap-4 rounded-2xl bg-paper p-5 ring-1 ring-line">
          <span class="node grid size-9 shrink-0 place-items-center rounded-full bg-green font-bold text-navy transition-all duration-500" aria-hidden="true">{i + 1}</span>
          <p><strong>{a}</strong> {b}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6">Si une de ces étapes échoue, vous avez payé, en argent et en temps, pour des visiteurs que vous n’avez pas su garder.</p>

    <!-- what works -->
    <h2 class="mt-14 text-2xl sm:mt-16 sm:text-4xl">Ce qui fonctionne vraiment</h2>
    <ul class="mt-6 space-y-4">
      <li class="border-s-4 border-green ps-4"><strong>Le marketing reste utile, mais il doit mener quelque part :</strong> une bonne fiche Google, un site à vous, et la commande directe par WhatsApp. <a href={ROUTES.marketing.fr} class="font-semibold text-green-deep underline underline-offset-4">Voir notre approche</a>.</li>
      <li class="border-s-4 border-green ps-4"><strong>Demandez à votre agence des résultats en clients, pas en vues.</strong> Combien de nouveaux clients, et combien chacun a coûté, budget publicitaire compris ?</li>
      <li class="border-s-4 border-green ps-4"><strong>Connaissez vos chiffres.</strong> Que vous reste-t-il sur une commande moyenne, après coûts ? Quel plat coûte plus qu’il ne rapporte ? D’où vient l’écart entre la caisse et le chiffre du jour ? <a href={ROUTES.profit.fr} class="font-semibold text-green-deep underline underline-offset-4">Voir Amplify Profit</a>.</li>
      <li class="border-s-4 border-green ps-4"><strong>Mesurez d’abord, investissez ensuite.</strong> Celui qui sait ce qu’il garde choisit mieux où placer son prochain dirham.</li>
    </ul>

    <figure class="mt-14 overflow-hidden rounded-3xl ring-1 ring-line sm:mt-16">
      <img src={`/img/blog/${IMG.chiffres[0]}-1376.webp`} srcset={`/img/blog/${IMG.chiffres[0]}-800.webp 800w, /img/blog/${IMG.chiffres[0]}-1376.webp 1376w`} sizes="(min-width: 768px) 768px, 100vw" alt={IMG.chiffres[1]} width="1376" height="768" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
    </figure>
    <BlogEnd question={question} note={note} reads={reads} />
  </div>
  </article>

  <FinalCta lang={lang} page="blogVues" wa={wa}
    h2="Parlons de vos chiffres."
    p="Nous les regardons avec vous, gratuitement, à partir de vos propres données de caisse." />
</Base>

<CountUp />
