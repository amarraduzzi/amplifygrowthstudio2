---
// Marketing hero. Two ways to do marketing, side by side on one card:
// everyone's way (views climb, hearts fly, the room stays empty) and ours (found on Google, the room fills).
// It switches by itself until the visitor picks one.
import WaButton from './WaButton.astro';
import { mkOf } from '../i18n/content';
import { tr, langOf } from '../i18n/t';
const LG = langOf(Astro.url);
const tt = tr(LG);
const c = mkOf(LG);
interface Props { waLabel: string }
const { waLabel } = Astro.props;
// top view of the room: [x %, y %, seats]
const tables = [[18, 22, 4], [50, 22, 2], [80, 22, 4], [18, 68, 2], [50, 68, 4], [80, 68, 2]] as const;
const seatPos = (n: number) => n === 2 ? [[-1, 0], [1, 0]] : [[-1, -1], [1, -1], [-1, 1], [1, 1]];
let seatN = 0;
---
<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.05fr] lg:gap-12">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{c.hero.kicker}</p>
      <h1 class="mt-5 text-[clamp(3rem,6.4vw,5.6rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{c.hero.h1a}</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="mk-h1b rise relative inline-block text-muted/70" style="--d:220ms">{c.hero.h1b}<span class="mk-strike absolute inset-x-[-2%] top-[52%] h-[0.09em] origin-left rounded-full bg-[#E5484D] rtl:origin-right" aria-hidden="true"></span></span></span>
      </h1>
      <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:350ms">{c.hero.lead}</p>
      <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:450ms">
        <WaButton text={c.wa} label={c.hero.cta} where="marketing-hero" class="px-7 text-lg" />
        <a href="#methode" class="inline-flex min-h-12 items-center rounded-full border border-navy/25 px-6 text-lg hover:border-navy">{c.hero.cta2}</a>
      </div>
    </div>

    <!-- the two ways -->
    <div class="fade-up" style="--d:300ms" data-mkhero data-mode="a">
      <div class="mx-auto mb-4 flex w-fit rounded-full bg-paper p-1 text-sm font-semibold ring-1 ring-line" role="tablist" aria-label="Deux façons de faire du marketing">
        {c.hero.modes.map((m, i) => <button type="button" role="tab" class="mk-tab rounded-full px-3.5 py-2 transition-colors sm:px-4" data-m={i ? 'b' : 'a'} aria-selected={i ? 'false' : 'true'}>{m}</button>)}
      </div>
      <div class="mk-stage relative overflow-hidden rounded-[2rem] p-4 ring-1 transition-colors duration-700 sm:p-6" aria-hidden="true">
        <div class="grid grid-cols-[8.5rem_1fr] items-center gap-4 sm:grid-cols-[10.5rem_1fr] sm:gap-6">
          <!-- phone -->
          <div class="relative rounded-[1.8rem] bg-linear-to-b from-[#3A3F47] via-[#1C1F24] to-[#3A3F47] p-1.5 shadow-2xl">
            <div class="relative h-[17rem] overflow-hidden rounded-[1.45rem] bg-black sm:h-[20rem]">
              <span class="absolute start-1/2 top-1.5 z-20 h-3.5 w-12 -translate-x-1/2 rounded-full bg-black rtl:translate-x-1/2"></span>
              <!-- A: a reel -->
              <div class="mk-a absolute inset-0 bg-linear-to-b from-[#3B2A4A] via-[#5A3A3A] to-[#2A1F1F] transition-opacity duration-500">
                <div class="absolute inset-x-3 bottom-14 space-y-1.5">
                  <span class="block h-2 w-3/4 rounded bg-white/50"></span><span class="block h-2 w-1/2 rounded bg-white/30"></span>
                </div>
                <div class="absolute bottom-4 start-3 flex items-center gap-1.5 text-white"><span class="text-base">▶</span><span class="mk-views display text-xl tabular-nums">0</span><span class="text-[0.6rem] font-semibold">vues</span></div>
                <div class="mk-hearts absolute bottom-10 end-3 h-40 w-8">{[0, 1, 2, 3, 4, 5].map(i => <span class="mk-heart absolute bottom-0 text-lg text-[#FF5C7A]" style={`--d:${i * 0.45}s;--x:${(i % 3) * 8}px`}>♥</span>)}</div>
              </div>
              <!-- B: Google Maps -->
              <div class="mk-b absolute inset-0 bg-[#F4F6F5] px-2.5 pt-7 text-navy transition-opacity duration-500">
                <p class="flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1.5 text-[0.62rem] shadow-sm"><span class="text-muted">⌕</span><span class="mk-type">café près de moi</span></p>
                <div class="mt-2 space-y-1.5 text-[0.6rem]">
                  <div class="mk-r1 rounded-lg bg-white p-2 shadow-md ring-2 ring-green">
                    <p class="flex items-center justify-between font-bold">Votre café <span class="text-[#F5B301]">★★★★★</span></p>
                    <p class="text-green-deep">Ouvert · 300 m</p>
                    <p class="mk-go mt-1.5 rounded-full bg-[#1A73E8] py-1 text-center font-bold text-white">Itinéraire</p>
                  </div>
                  <div class="rounded-lg bg-white p-2 opacity-60"><p class="font-semibold">Un autre café</p><p class="text-muted">Ouvert · 1,2 km</p></div>
                  <div class="rounded-lg bg-white p-2 opacity-40"><p class="font-semibold">Encore un café</p><p class="text-muted">Fermé</p></div>
                </div>
              </div>
            </div>
          </div>
          <!-- the room, from above -->
          <div>
            <div class="relative aspect-[5/4] rounded-2xl bg-white/70 ring-1 ring-line">
              <span class="absolute inset-x-[38%] -bottom-px h-1.5 rounded-t bg-navy/70"></span>
              {tables.map(([x, y, n]) => (
                <div class="absolute aspect-square w-[15%] -translate-x-1/2 -translate-y-1/2 rtl:translate-x-1/2" style={`left:${x}%;top:${y}%`}>
                  <span class="absolute inset-0 rounded-lg bg-[#E7DCC8] ring-1 ring-[#D5C6AC]"></span>
                  {seatPos(n).map(([dx, dy]) => {
                    const i = seatN++;
                    return <span class="mk-seat absolute aspect-square w-[34%] rounded-full" style={`left:${50 + dx * 62}%;top:${50 + dy * (n === 2 ? 0 : 62)}%;--d:${(i * 7 % 18) * 110}ms`}></span>;
                  })}
                </div>
              ))}
            </div>
            <p class="mk-cap mt-3 text-center text-sm font-bold"><span class="mk-ca">Salle vide.</span><span class="mk-cb">Des gens à table.</span></p>
          </div>
        </div>
      </div>
      <p class="mt-2 text-center text-xs text-muted">Illustration</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-mkhero]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.mk-tab')];
    const views = root.querySelector<HTMLElement>('.mk-views')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0, auto = !still, timer = 0;
    const countViews = () => {
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 2200), v = Math.round(100000 * (1 - (1 - k) ** 2));
        views.textContent = v >= 1000 ? `${Math.floor(v / 1000)}K` : String(v);
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const set = (m: string) => {
      root.dataset.mode = m;
      tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.m === m)));
      if (m === 'a') still ? (views.textContent = '100K') : countViews();
    };
    tabs.forEach(t => t.addEventListener('click', () => { auto = false; clearInterval(timer); set(t.dataset.m!); }));
    set('a');
    if (auto) timer = window.setInterval(() => auto && set(root.dataset.mode === 'a' ? 'b' : 'a'), 5200);
  });
</script>
