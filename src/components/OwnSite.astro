---
// "Votre site web, inclus": the restaurant website made from the menu, for Google and the phone.
// Real screenshots of demo café Dar Nour. Shown once SITES_LIVE is on (config.ts).
import Icon from './Icon.astro';
import Device from './Device.astro';
const points = [
  ['search', 'Fait pour Google', 'Votre carte, vos horaires, votre adresse et vos prix sont lisibles par Google, page par page.'],
  ['phone', 'Parfait sur téléphone', 'Commander, réserver, appeler et l’itinéraire à portée de pouce.'],
  ['chart', 'Toujours à jour', 'Vous changez un prix dans la caisse, le site suit. Un plat épuisé, une happy hour : aussi.'],
  ['store', 'À votre nom', 'Trois styles, vos couleurs, votre logo, et votre propre domaine si vous le souhaitez.'],
] as const;
---
<section class="relative overflow-hidden border-y border-line bg-paper" data-os>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="max-w-2xl">
      <p class="oc-rv inline-flex items-center gap-2 rounded-full bg-chalk px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Nouveau</p>
      <h2 class="oc-rv mt-5 text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]" style="--d:80ms"><span class="block">Votre site web.</span><span class="block text-green-deep">Prêt avec votre carte.</span></h2>
      <p class="oc-rv mt-5 text-lg text-muted" style="--d:160ms">Votre menu existe déjà dans Amplify : votre site aussi. Activez-le, choisissez un style, il est en ligne.</p>
    </div>
    <div class="relative mt-12" aria-hidden="true">
      <div class="oc-rv overflow-hidden rounded-[1.4rem] bg-[#0B1422] shadow-[0_40px_80px_-35px_rgba(0,30,62,0.6)] ring-1 ring-black/10 lg:me-[14%]" style="--d:100ms">
        <div class="flex items-center gap-2 px-4 py-3"><span class="size-3 rounded-full bg-[#FF5F57]"></span><span class="size-3 rounded-full bg-[#FEBC2E]"></span><span class="size-3 rounded-full bg-[#28C840]"></span>
          <span class="ms-3 flex-1 truncate rounded-full bg-white/10 px-4 py-1 text-xs text-white/70" dir="ltr">www.darnour.ma</span></div>
        <img src="/img/n-site.webp" alt="" width="1200" height="750" loading="lazy" decoding="async" class="block h-auto w-full" />
      </div>
      <div class="oc-rv oc-drop absolute -bottom-8 end-0 w-[30%] max-w-[15rem] lg:w-[22%]" style="--d:350ms"><Device kind="phone" src="/img/n-site-phone.webp" alt="" w={600} h={1298} screenBg="#0E0D0B" class="rotate-[3deg]" /></div>
    </div>
    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {points.map(([i, h, x], k) => (
        <div class="oc-rv rounded-3xl bg-chalk p-6 ring-1 ring-line" style={`--d:${k * 90}ms`}>
          <Icon name={i} class="size-6 text-green-deep" /><p class="mt-3 font-semibold">{h}</p><p class="mt-1 text-sm leading-relaxed text-muted">{x}</p>
        </div>
      ))}
    </div>
  </div>
</section>
