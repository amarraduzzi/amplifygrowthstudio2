---
interface Props { items: string[][]; dark?: boolean }
const { items, dark = false } = Astro.props;
---
<dl class={`grid gap-x-12 sm:grid-cols-2 ${dark ? 'text-white' : ''}`}>
  {items.map(([h, p]) => (
    <div class={`border-t py-6 ${dark ? 'border-white/15' : 'border-line'}`}>
      <dt class="text-lg font-medium">{h}</dt>
      <dd class={`mt-1.5 ${dark ? 'text-white/70' : 'text-muted'}`}>{p}</dd>
    </div>
  ))}
</dl>
