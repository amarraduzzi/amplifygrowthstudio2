---
// Livraison, hero film: the story in five scenes, drawn in code (no video file). 1: an order arrives. 2: with a delivery app a bite is taken
// out of the money and the customer stays with the app. 3: the app is not needed any more. 4: the same order goes through the five parts of
// the Amplify system and arrives whole. 5: the result. Plays once (about 13 s) and stops on the last scene; the dots jump to a scene, "Revoir" replays.
// The order and the code are examples (labelled as such); no percentage is written anywhere.
// Without JavaScript or with reduced motion the last scene is shown straight away.
import Icon from './Icon.astro';
import { tr } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const tt = tr(Astro.props.lang);
const rows = [
  ['search', 'Bssaha'],
  ['qr', 'Votre site de commande'],
  ['till', 'Votre caisse'],
  ['truck', 'Votre livreur'],
  ['shield', 'Remise avec code'],
] as const;
const dots = ['La commande', 'Avec une app', 'Sans app', 'Avec Amplify', 'Le résultat'];
---
<div class="film" id="film" data-s="5" data-a="2" data-k="6" data-till="full">
  <div class="st" role="img" aria-label={tt('L’histoire en images : une commande avec une app, puis avec Amplify.')}>
    <p class="st-bar font-dot" dir="ltr" aria-hidden="true">AMPLIFY // {tt('Exemple')}</p>
    <div class="cl" aria-hidden="true">
      <span class="cl-ic"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" /></svg></span>
      <span class="cl-l">{tt('Client')}</span>
      <span class="cl-b">2 × {tt('Tajine poulet')}</span>
    </div>
    <i class="ln" aria-hidden="true"></i>
    <div class="app" aria-hidden="true">
      <b>{tt('App de livraison')}</b>
      <small>{tt('Les clients restent à l’app')}</small>
      <span class="shard">− {tt('commission')}</span>
    </div>
    <ol class="rows" aria-hidden="true">
      {rows.map(([ic, h], i) => (
        <li class="row on" style={`--i:${i}`}>
          <span class="row-n"><Icon name={ic} class="size-4" /></span>
          <span class="row-t">{tt(h)}</span>
          {i === 4 && <em class="code font-dot" dir="ltr">4827</em>}
        </li>
      ))}
    </ol>
    <div class="tok tokA bx-led" dir="ltr" aria-hidden="true">140 DH</div>
    <div class="tok tokB bx-led" dir="ltr" aria-hidden="true">140 DH</div>
    <div class="rst" aria-hidden="true">
      <span class="rst-l">{tt('Votre restaurant')}</span>
      <div class="rst-v">
        <b class="t0 bx-led" dir="ltr">0 DH</b>
        <b class="tb bx-led" dir="ltr">140 DH<i></i></b>
        <b class="tf bx-led" dir="ltr">140 DH</b>
      </div>
      <span class="stamp">{tt('Zéro commission')}</span>
    </div>
  </div>
  <div class="film-cap" aria-live="off">
    <p data-c="1">{tt('Une commande arrive : 2 tajines, 140 DH.')}</p>
    <p data-c="2">{tt('Avec une app, une part de chaque commande part chez elle. Et le client reste chez elle.')}</p>
    <p data-c="3">{tt('Mais vous n’en avez plus besoin.')}</p>
    <p data-c="4">{tt('Avec Amplify, la commande passe par votre propre système, de Bssaha jusqu’à la remise.')}</p>
    <p data-c="5">{tt('Votre argent reste chez vous.')}</p>
  </div>
  <div class="film-nav">
    {dots.map((d, i) => <button type="button" data-go={i + 1} aria-label={tt(d)} title={tt(d)}><i></i></button>)}
    <button type="button" class="film-re" id="film-re" hidden>{tt('Revoir l’histoire')}</button>
  </div>
</div>
<script is:inline>
  (function () {
    var f = document.getElementById('film');
    if (!f || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    f.dataset.s = '1'; f.dataset.a = '0'; f.dataset.k = '0'; f.dataset.till = 'zero';
    f.querySelectorAll('.row').forEach(function (r) { r.classList.remove('on'); });
  })();
</script>
<script>
  type St = { s: number; a: number; k: number; till: string };
  const f = document.getElementById('film');
  if (f) {
    const rows = [...f.querySelectorAll<HTMLElement>('.row')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timers: number[] = [];
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const apply = (x: St) => {
      f.dataset.s = String(x.s); f.dataset.a = String(x.a); f.dataset.k = String(x.k); f.dataset.till = x.till;
      rows.forEach((r, i) => r.classList.toggle('on', x.k >= i + 1));
    };
    const at = (ms: number, x: St) => timers.push(window.setTimeout(() => apply(x), ms));
    const FINAL: St = { s: 5, a: 2, k: 6, till: 'full' };
    const play = () => {
      clear();
      apply({ s: 1, a: 0, k: 0, till: 'zero' });
      at(2800, { s: 2, a: 1, k: 0, till: 'zero' });
      at(4000, { s: 2, a: 2, k: 0, till: 'bite' });
      at(6600, { s: 3, a: 2, k: 0, till: 'bite' });
      at(8600, { s: 4, a: 2, k: 0, till: 'zero' });
      for (let i = 1; i <= 6; i++) at(8600 + 650 * i, { s: 4, a: 2, k: i, till: i === 6 ? 'full' : 'zero' });
      at(13200, FINAL);
    };
    const jump: Record<number, St> = {
      1: { s: 1, a: 0, k: 0, till: 'zero' }, 2: { s: 2, a: 2, k: 0, till: 'bite' }, 3: { s: 3, a: 2, k: 0, till: 'bite' },
      4: { s: 4, a: 2, k: 5, till: 'zero' }, 5: FINAL,
    };
    f.querySelectorAll<HTMLButtonElement>('[data-go]').forEach(b => b.addEventListener('click', () => { clear(); apply(jump[Number(b.dataset.go)]); }));
    const re = document.getElementById('film-re') as HTMLButtonElement | null;
    if (!reduced) {
      if (re) { re.hidden = false; re.addEventListener('click', play); }
      timers.push(window.setTimeout(play, 600));
    }
  }
</script>
<style>
  .film { width: 100%; max-width: 30rem; margin-inline: auto; }
  .st { position: relative; aspect-ratio: 1 / 1.1; overflow: hidden; border-radius: 1.4rem; background: rgb(0 30 62 / .6); box-shadow: inset 0 0 0 1px var(--edge), 0 30px 60px rgb(0 0 0 / .35); backdrop-filter: blur(6px); }
  .st-bar { position: absolute; top: .7rem; inset-inline: 1rem; font-size: .72rem; letter-spacing: .08em; color: var(--gl); opacity: .8; }
  .ln { position: absolute; left: 50%; top: 21%; bottom: 20%; width: 3px; translate: -50% 0; border-radius: 3px; background: repeating-linear-gradient(to bottom, rgb(255 255 255 / .28) 0 6px, transparent 6px 12px); transition: background .5s, box-shadow .5s; }
  .film:is([data-s='4'], [data-s='5']) .ln { background: var(--gl); box-shadow: 0 0 14px rgb(61 255 160 / .8); }

  .cl { position: absolute; top: 8%; left: 50%; translate: -50% 0; display: flex; flex-direction: column; align-items: center; gap: .15rem; }
  .cl-ic { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; color: #fff; background: rgb(255 255 255 / .1); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .35); }
  .cl-l { font-size: .75rem; color: rgb(255 255 255 / .75); }
  .cl-b { position: absolute; left: calc(100% + .2rem); top: .35rem; white-space: nowrap; padding: .3rem .65rem; border-radius: 99px; font-size: .78rem; font-weight: 700; color: #0b2a4a; background: #f6f4ec; opacity: 0; transition: opacity .4s; }
  .film[data-s='1'] .cl-b { opacity: 1; }

  .tok { position: absolute; left: 50%; translate: -50% -50%; z-index: 4; padding: .3rem .85rem; border-radius: .7rem; font-size: 1.15rem; line-height: 1.1; white-space: nowrap; background: #07213d; box-shadow: inset 0 0 0 1.5px var(--gl), 0 0 18px rgb(61 255 160 / .45); opacity: 0; transition: top .9s cubic-bezier(.5, 0, .2, 1), opacity .5s, clip-path .5s, filter .5s; }
  .tokA { top: 29%; clip-path: polygon(0 0, 100% 0, 100% 12%, 100% 25%, 100% 38%, 100% 50%, 100% 62%, 100% 75%, 100% 88%, 100% 100%, 0 100%); }
  .film[data-a='1'] .tokA { top: 47%; }
  .film[data-a='2'] .tokA { top: 77%; clip-path: polygon(0 0, 66% 0, 56% 12%, 66% 25%, 56% 38%, 66% 50%, 56% 62%, 66% 75%, 56% 88%, 66% 100%, 0 100%); filter: saturate(.3) brightness(.8); }
  .film:is([data-s='1'], [data-s='2']) .tokA { opacity: 1; transition-delay: 0s, .4s, 0s, 0s; }
  .tokB { top: 29%; }
  .film:is([data-s='4'], [data-s='5']) .tokB { opacity: 1; }
  .film[data-k='1'] .tokB { top: 33%; } .film[data-k='2'] .tokB { top: 42%; } .film[data-k='3'] .tokB { top: 51%; }
  .film[data-k='4'] .tokB { top: 60%; } .film[data-k='5'] .tokB { top: 69%; } .film[data-k='6'] .tokB { top: 77%; }
  .film[data-s='4'] .tokB { transition-duration: .55s, .4s; }

  .app { position: absolute; left: 50%; top: 47%; width: 74%; display: grid; justify-items: center; gap: .1rem; padding: .9rem .5rem; border-radius: 1rem; background: rgb(255 107 91 / .16); box-shadow: inset 0 0 0 2px var(--coral); opacity: 0; transform: translate(-50%, -50%) scale(.85); transition: opacity .5s, transform .5s; }
  .app b { font-size: 1.15rem; color: #fff; text-decoration-color: var(--coral); text-decoration-thickness: 3px; }
  .app small { font-size: .75rem; color: var(--coral); }
  .film:is([data-s='2']) .app { opacity: 1; transform: translate(-50%, -50%); }
  .film[data-s='3'] .app { opacity: 0; transform: translate(-50%, calc(-50% + 46px)) rotate(7deg) scale(.8); transition: opacity .9s .9s, transform .9s .9s; }
  .film[data-s='3'] .app b { text-decoration-line: line-through; }
  .shard { position: absolute; right: -.3rem; bottom: -1.1rem; padding: .25rem .6rem; border-radius: 99px; background: var(--coral); color: #2a0b07; font-weight: 800; font-size: .78rem; scale: 0; transition: scale .35s cubic-bezier(.2, 1.5, .4, 1); }
  .film[data-a='2'] .shard { scale: 1; }

  .rows { position: absolute; inset: 0; list-style: none; margin: 0; padding: 0; pointer-events: none; }
  .row { position: absolute; left: 11%; right: 11%; top: calc(33% + var(--i) * 9% - 4%); height: 8%; display: flex; align-items: center; gap: .5rem; padding-inline: .3rem .8rem; border-radius: 99px; background: rgb(0 30 62 / .85); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .18); opacity: 0; transform: scale(.85); transition: opacity .4s, transform .4s, box-shadow .4s; }
  .film:is([data-s='4'], [data-s='5']) .row { opacity: .55; transform: none; transition-delay: calc(var(--i) * 90ms); }
  .film:is([data-s='4'], [data-s='5']) .row.on { opacity: 1; box-shadow: inset 0 0 0 1.5px var(--gl), 0 0 16px rgb(61 255 160 / .35); transition-delay: 0s; }
  .row-n { display: grid; place-items: center; flex: none; height: 100%; aspect-ratio: 1; max-height: 1.9rem; border-radius: 50%; color: rgb(255 255 255 / .6); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .25); transition: background .3s, color .3s; }
  .row.on .row-n { color: #03231a; background: var(--gl); box-shadow: 0 0 14px rgb(61 255 160 / .7); }
  .row-t { font-size: .8rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .code { margin-inline-start: auto; font-style: normal; font-size: .95rem; color: var(--gl); opacity: 0; transition: opacity .4s; }
  .row.on .code { opacity: 1; }

  .rst { position: absolute; left: 6%; right: 6%; bottom: 3%; height: 15%; display: grid; align-content: center; justify-items: center; border-radius: 1rem; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .22); background: rgb(255 255 255 / .05); }
  .rst-l { font-size: .72rem; color: rgb(255 255 255 / .7); }
  .rst-v { display: grid; justify-items: center; }
  .rst-v b { grid-area: 1 / 1; font-size: 1.9rem; line-height: 1.05; opacity: 0; transition: opacity .35s, color .35s; }
  .t0 { color: rgb(255 255 255 / .4); text-shadow: none; }
  .tb { position: relative; color: #8da093; text-shadow: none; overflow: hidden; }
  .tb i { position: absolute; top: 0; right: 0; bottom: 0; width: 42%; background: var(--coral); clip-path: polygon(16% 0, 100% 0, 100% 100%, 16% 100%, 0 88%, 14% 74%, 0 60%, 14% 46%, 0 32%, 14% 18%, 0 6%); }
  .film[data-till='zero'] .t0, .film[data-till='bite'] .tb, .film[data-till='full'] .tf { opacity: 1; }
  .stamp { position: absolute; right: .7rem; top: -.55rem; padding: .2rem .55rem; border: 2.5px solid var(--gl); border-radius: .5rem; color: var(--gl); background: #04203a; font-weight: 900; font-size: .72rem; rotate: -8deg; scale: 1.7; opacity: 0; transition: scale .45s cubic-bezier(.2, 1.4, .4, 1), opacity .2s; }
  .film[data-till='full'] .stamp { scale: 1; opacity: 1; }
  .film[data-till='full'] .rst { box-shadow: inset 0 0 0 1.5px var(--gl), 0 0 26px rgb(61 255 160 / .35); }

  .film-cap { display: grid; margin-top: 1rem; min-height: 4.4rem; text-align: center; }
  .film-cap p { grid-area: 1 / 1; font-size: 1.1rem; font-weight: 700; line-height: 1.3; color: #fff; opacity: 0; transition: opacity .4s; }
  .film[data-s='2'] [data-c='2'] { color: var(--coral); }
  .film[data-s='1'] [data-c='1'], .film[data-s='2'] [data-c='2'], .film[data-s='3'] [data-c='3'], .film[data-s='4'] [data-c='4'], .film[data-s='5'] [data-c='5'] { opacity: 1; }
  .film[data-s='5'] [data-c='5'] { color: var(--gl); font-size: 1.3rem; }
  .film-nav { display: flex; justify-content: center; align-items: center; gap: .15rem; margin-top: .3rem; }
  .film-nav button[data-go] { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; }
  .film-nav i { width: .6rem; height: .6rem; border-radius: 50%; background: rgb(255 255 255 / .3); transition: background .3s, scale .3s; }
  .film[data-s='1'] [data-go='1'] i, .film[data-s='2'] [data-go='2'] i, .film[data-s='3'] [data-go='3'] i, .film[data-s='4'] [data-go='4'] i, .film[data-s='5'] [data-go='5'] i { background: var(--gl); scale: 1.4; }
  .film-nav button:focus-visible { outline: 2px solid #fff; border-radius: 50%; }
  .film-re { margin-inline-start: .8rem; font-size: .8rem; color: rgb(255 255 255 / .65); text-decoration: underline; text-underline-offset: 3px; }
  .film-re:hover, .film-re:focus-visible { color: var(--gl); }
  @media (max-width: 480px) { .st { aspect-ratio: 1 / 1.16; } .row-t { font-size: .74rem; } .tok { font-size: 1rem; } .film-cap p { font-size: 1rem; } .film[data-s='5'] [data-c='5'] { font-size: 1.15rem; } }
</style>
