---
// "Ramassage et livraison": the driver's round, drawn as a map. A light section on purpose (the one next to
// it, "clients pros", is dark). A van drives Pressing → Hay Riad → Agdal → Souissi → back, and every stop
// opens its card (time, fee), the WhatsApp to the client, the "Livré" tap, the deposit created at the till.
// Plays while in view, loops, still when motion is reduced. Demo shop, invented names.
import Icon from './Icon.astro';
import Device from './Device.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
interface Props { items: readonly (readonly [string, string, string])[] }
const { items } = Astro.props;
// stop coordinates in the 640 x 470 map space; the route passes exactly through them
const ROUTE = 'M120 350 C150 270 195 175 240 140 C310 100 350 250 410 250 C480 250 515 170 540 100 C510 250 340 420 120 350';
---
<section id="tournees" class="pr relative isolate scroll-mt-20 overflow-hidden border-y border-line bg-[#EFE9DC] text-navy" data-tf data-pr>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-center">
      <div class="tf-x">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Ramassage et livraison.')}</span><span class="block text-green-deep">{tt('Sans carnet.')}</span></h2>
        <p class="mt-5 max-w-md text-lg text-muted">{tt('Vos clients n’ont plus le temps de passer ? Le chauffeur passe pour eux. Chaque tournée a son adresse, son heure et ses frais, et finit dans la caisse.')}</p>
      </div>

      <div class="tf" style="--d:150ms">
        <div class="pr-wrap relative sm:pb-[9%] sm:pe-[2%]">
          <div class="pr-map relative aspect-[640/470] w-full overflow-hidden rounded-[1.6rem] bg-[#F7F3E9] shadow-[0_50px_90px_-50px_rgba(0,30,62,.55)] ring-1 ring-black/5 sm:rounded-[2rem]" role="img" aria-label={tt('La tournée du chauffeur : trois arrêts, du ramassage à la caisse')}>
            <svg viewBox="0 0 640 470" class="absolute inset-0 size-full" aria-hidden="true">
              <path d="M0 0H122C104 60 130 112 92 172C62 218 72 292 42 344C22 382 30 432 0 470Z" fill="#CFE5EC" />
              <path d="M122 0C104 60 130 112 92 172C62 218 72 292 42 344C22 382 30 432 0 470" fill="none" stroke="#E8DFC9" stroke-width="7" />
              <g fill="none" stroke="#fff" stroke-linecap="round" stroke-width="11" opacity=".95">
                <path d="M150 0L262 470" /><path d="M0 205L640 150" /><path d="M0 312L640 346" /><path d="M318 0L372 470" /><path d="M470 0L526 470" /><path d="M170 430L640 404" />
              </g>
              <g fill="none" stroke="#E7DFCD" stroke-linecap="round" stroke-width="4">
                <path d="M0 96L640 62" /><path d="M214 0L300 470" /><path d="M398 0L452 470" /><path d="M560 0L600 470" /><path d="M0 410L420 440" /><path d="M200 255L640 250" />
              </g>
              <ellipse cx="528" cy="372" rx="58" ry="34" fill="#DCEBC8" /><ellipse cx="208" cy="62" rx="40" ry="22" fill="#DCEBC8" />
              <g font-size="17" font-weight="700" letter-spacing="2.4" fill="#A59E8A" text-anchor="middle">
                <text x="244" y="176">HAY RIAD</text><text x="410" y="222">AGDAL</text><text x="540" y="68">SOUISSI</text>
              </g>
              <path d={ROUTE} class="pr-base" fill="none" stroke="#001E3E" stroke-opacity=".22" stroke-width="4" stroke-dasharray="3 9" stroke-linecap="round" />
              <path d={ROUTE} class="pr-route pr-trail" fill="none" stroke="#05B962" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
              <g class="pr-pins">
                <g class="pn pn0" transform="translate(120 350)"><circle r="18" fill="#001E3E" /><path d="M-8 3h16M-6 3V-5h12V3" stroke="#05B962" stroke-width="2.4" fill="none" stroke-linecap="round" /></g>
                <g class="pn pn1" transform="translate(240 140)"><circle class="ring" r="22" /><circle class="dot" r="12" /></g>
                <g class="pn pn2" transform="translate(410 250)"><circle class="ring" r="22" /><circle class="dot" r="12" /></g>
                <g class="pn pn3" transform="translate(540 100)"><circle class="ring" r="22" /><circle class="dot" r="12" /></g>
              </g>
            </svg>

            <p class="pr-lab" style="left:11%;top:80%">{tt('Le pressing')}</p>

            <!-- stop 1: pick-up in Hay Riad -->
            <div class="pr-c pr-c1" style="left:37%;top:5%">
              <span class="pr-ic"><Icon name="pin" class="size-[1.15em]" /></span>
              <div class="min-w-0"><p class="pr-t">{tt('Ramassage')} · Leila A.</p><p class="pr-s" dir="ltr">18h–19h · 20 MAD</p></div>
              <p class="pr-b pr-b-g"><Icon name="shirt" class="size-[1.1em]" />{tt('Réceptionner le linge')}</p>
            </div>
            <p class="pr-wa" style="left:3%;top:25%"><span class="pr-wi"><Icon name="message" class="size-[1em]" /></span>{tt('Bonjour Leila, nous passons entre 18 h et 19 h.')}</p>

            <!-- stop 2: delivery in Agdal -->
            <div class="pr-c pr-c2" style="left:54%;top:60%">
              <span class="pr-ic"><Icon name="truck" class="size-[1.15em]" /></span>
              <div class="min-w-0"><p class="pr-t">{tt('Livraison')} n° 1042 · Nadia B.</p><p class="pr-s" dir="ltr">12h–13h · 30 MAD</p></div>
              <p class="pr-b pr-b-d"><span class="pr-b-a">{tt('Livraison')}</span><span class="pr-b-z"><Icon name="check" class="size-[1.1em]" />{tt('Livré')}</span></p>
            </div>

            <!-- stop 3: pick-up in Souissi -->
            <div class="pr-c pr-c3" style="right:2.5%;top:31%">
              <span class="pr-ic"><Icon name="pin" class="size-[1.15em]" /></span>
              <div class="min-w-0"><p class="pr-t">{tt('Ramassage')} · Youssef</p><p class="pr-s" dir="ltr">10h · 20 MAD</p></div>
            </div>

            <!-- back at the till -->
            <p class="pr-end" style="left:3%;top:90%"><Icon name="check" class="size-[1.15em]" />{tt('Les ramassages deviennent des dépôts en caisse')}</p>

            <span class="pr-van" aria-hidden="true"><Icon name="truck" class="size-[1.25em]" /></span>
          </div>

          <div class="pr-tab absolute bottom-0 end-0 hidden w-[36%] sm:block">
            <Device src="/img/pressing-tournees.webp" alt={tt('Les tournées du jour : un ramassage à Hay Riad et une livraison à Agdal')} w={1200} h={750} />
          </div>
        </div>
      </div>
    </div>

    <ul class="mt-14 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {items.map(([i, h, x], k) => (
        <li class="tf border-t border-navy/15 pt-5" style={`--d:${k * 90}ms`}>
          <span class="grid size-11 place-items-center rounded-2xl bg-navy text-green"><Icon name={i} class="size-5" /></span>
          <p class="mt-4 font-semibold">{tt(h)}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{tt(x)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pr-wrap { container-type: inline-size; }
  .pr-map { font-size: max(9px, 1.85cqw); }
  .pr-wrap .pr-tab { transform: rotate(2deg); }
  .pn .ring { fill: #05B962; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .pn .dot { fill: #fff; stroke: #05B962; stroke-width: 4; transition: fill .3s; }
  .pr-map.a1 .pn1 .dot, .pr-map.a2 .pn2 .dot, .pr-map.a3 .pn3 .dot { fill: #05B962; }
  .pr-map.a1 .pn1 .ring, .pr-map.a2 .pn2 .ring, .pr-map.a3 .pn3 .ring { animation: pr-ping 1.4s ease-out 2; }
  @keyframes pr-ping { 0% { opacity: .5; transform: scale(.5); } 100% { opacity: 0; transform: scale(1.5); } }
  .pr-lab { position: absolute; font-size: .95em; font-weight: 700; color: #001E3E; letter-spacing: .02em; }
  .pr-van { position: absolute; left: 0; top: 0; z-index: 5; display: grid; place-items: center; width: 2.6em; height: 2.6em; border-radius: 999px; background: #05B962; color: #001E3E; box-shadow: 0 .5em 1.2em -.3em rgba(0, 30, 62, .55), 0 0 0 .3em rgba(255, 255, 255, .85); transform: translate(-50%, -50%); }
  .pr-c { position: absolute; z-index: 4; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .15em .7em; width: 17.5em; padding: .7em .8em; border-radius: 1em; background: #fff; box-shadow: 0 1em 2.2em -1em rgba(0, 30, 62, .5), 0 0 0 1px rgba(0, 30, 62, .06); opacity: 0; transform: translateY(.6em) scale(.94); transition: opacity .45s, transform .55s cubic-bezier(.3, 1.4, .5, 1); }
  .pr-map.a1 .pr-c1, .pr-map.a2 .pr-c2, .pr-map.a3 .pr-c3 { opacity: 1; transform: none; }
  .pr-ic { display: grid; place-items: center; width: 2.2em; height: 2.2em; border-radius: .7em; background: #E3F6EC; color: #00804A; }
  .pr-t { font-size: 1em; font-weight: 700; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pr-s { margin-top: .1em; font-size: .9em; font-weight: 600; color: #4A5D74; }
  .pr-b { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; gap: .5em; margin-top: .45em; padding: .55em .8em; border-radius: .7em; font-weight: 700; font-size: .95em; }
  .pr-b-g { background: #05B962; color: #001E3E; }
  .pr-b-d { position: relative; background: #EEF1F4; color: #4A5D74; overflow: hidden; }
  .pr-b-a { transition: opacity .3s; }
  .pr-b-z { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: .5em; background: #05B962; color: #001E3E; transform: translateY(100%); transition: transform .4s cubic-bezier(.3, 1.2, .5, 1) 1.1s; }
  .pr-map.a2 .pr-b-z { transform: none; } .pr-map.a2 .pr-b-a { opacity: 0; transition-delay: 1.1s; }
  .pr-wa { position: absolute; z-index: 4; display: flex; align-items: flex-start; gap: .6em; max-width: 17em; padding: .65em .85em; border-radius: 1em 1em 1em .2em; background: #DCF8C6; color: #1B2B1B; font-size: .95em; font-weight: 600; line-height: 1.3; box-shadow: 0 .8em 1.8em -1em rgba(0, 30, 62, .5); opacity: 0; transform: translateY(.8em) scale(.9); transition: opacity .4s .9s, transform .5s cubic-bezier(.3, 1.5, .5, 1) .9s; }
  .pr-wi { display: grid; place-items: center; flex: none; width: 1.7em; height: 1.7em; border-radius: 999px; background: #25D366; color: #fff; }
  .pr-map.a1 .pr-wa { opacity: 1; transform: none; }
  .pr-end { position: absolute; z-index: 4; display: flex; align-items: center; gap: .55em; max-width: 62%; padding: .55em .9em; border-radius: 999px; background: #001E3E; color: #fff; font-size: .95em; font-weight: 700; opacity: 0; transform: translateY(.6em); transition: opacity .45s, transform .5s cubic-bezier(.3, 1.4, .5, 1); }
  .pr-end :global(svg) { color: #05B962; flex: none; }
  .pr-map.a4 .pr-end { opacity: 1; transform: none; }
  .pr-map.rs .pr-c, .pr-map.rs .pr-wa, .pr-map.rs .pr-end { transition-duration: .01s; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) {
    .pr-c, .pr-wa, .pr-end { transition: none; }
    .pn .ring { animation: none !important; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pr]');
  const map = root?.querySelector<HTMLElement>('.pr-map');
  const path = map?.querySelector<SVGPathElement>('.pr-route');
  const van = map?.querySelector<HTMLElement>('.pr-van');
  if (root && map && path && van) {
    const W = 640, H = 470, L = path.getTotalLength();
    path.style.strokeDasharray = String(L);
    const pins = [...map.querySelectorAll<SVGGElement>('.pn')].map((g) => {
      const m = /translate\(([\d.]+)\s+([\d.]+)\)/.exec(g.getAttribute('transform') || '');
      return { x: +(m?.[1] ?? 0), y: +(m?.[2] ?? 0) };
    });
    // the length along the route at which each stop sits (pin 0 is the start and the end)
    const at = pins.map((p, i) => {
      if (i === 0) return 0;
      let best = 0, bd = 1e9;
      for (let s = 0; s <= 600; s++) { const l = (s / 600) * L, q = path.getPointAtLength(l); const d = (q.x - p.x) ** 2 + (q.y - p.y) ** 2; if (d < bd) { bd = d; best = l; } }
      return best;
    });
    at.push(L);
    const MOVE = 2300, DWELL = [0, 2200, 2200, 2200], END = 5200;
    // timeline: leg i moves for MOVE ms, then dwells DWELL[i+1] ms at the stop
    const ease = (t: number) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const put = (l: number) => {
      const q = path.getPointAtLength(l);
      van.style.left = (q.x / W) * 100 + '%'; van.style.top = (q.y / H) * 100 + '%';
      path.style.strokeDashoffset = String(L - l);
    };
    const setStage = (n: number) => { for (let k = 1; k <= 4; k++) map.classList.toggle('a' + k, k <= n); };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { setStage(4); put(0); path.style.strokeDashoffset = '0'; }
    else {
      let raf = 0, t0 = 0, running = false;
      const total = 4 * MOVE + DWELL[1] + DWELL[2] + DWELL[3] + END;
      const frame = (now: number) => {
        if (!t0) t0 = now;
        let t = (now - t0) % total, l = 0, stage = 0, k = 0;
        for (; k < 4; k++) {
          if (t < MOVE) { l = at[k] + (at[k + 1] - at[k]) * ease(t / MOVE); stage = k; break; }
          t -= MOVE; l = at[k + 1]; stage = k + 1;
          const dw = k < 3 ? DWELL[k + 1] : END;
          if (t < dw) break; t -= dw;
        }
        put(l); setStage(stage);
        if (running) raf = requestAnimationFrame(frame);
      };
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) { running = true; t0 = 0; raf = requestAnimationFrame(frame); }
        else if (!e.isIntersecting) { running = false; cancelAnimationFrame(raf); }
      }, { threshold: 0.25 });
      io.observe(map);
    }
  }
</script>
