---
// Allergens, computed from the ingredients: left, the QR menu with "Une allergie ?" (a dish that contains it
// disappears, a dish not checked yet disappears too and never says "no allergens"); right, the production
// label of a batch with its lot number, dates and allergens in French and Arabic, printed with one tap.
// Demo products and dates; the real ones come from your recipes.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
const A = { g: tt('Gluten'), l: tt('Lait'), n: tt('Fruits à coque'), o: tt('Œufs') } as const;
const dishes: [string, string, (keyof typeof A)[] | null][] = [
  [tt('Croissant'), '8 DH', ['g', 'l']],
  [tt('Corne de gazelle'), '6 DH', ['g', 'n', 'o']],
  [tt('Macaron pistache'), '12 DH', ['n', 'o']],
  [tt('Salade de fruits'), '25 DH', []],
  [tt('Tarte du jour'), '30 DH', null],
];
---
<div class="grid gap-5 lg:grid-cols-[1.05fr_0.95fr]" data-allergen>
  <!-- the QR menu -->
  <div class="al-card rounded-[2rem] bg-white p-5 shadow-[0_40px_80px_-40px_rgba(0,30,62,0.45)] ring-1 ring-line sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <p class="flex items-center gap-2 font-bold"><Icon name="qr" class="size-5 text-green-deep" />{tt('Menu QR')}</p>
      <span class="rounded-full bg-mint px-2.5 py-0.5 text-xs font-bold text-green-deep">{tt('Exemple')}</span>
    </div>
    <p class="mt-4 text-sm font-semibold">{tt('Une allergie ?')}</p>
    <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label={tt('Une allergie ?')}>
      {Object.entries(A).map(([k, l]) => <button type="button" class="al-chip min-h-10 rounded-full bg-chalk px-4 text-sm font-bold ring-1 ring-line transition-colors" data-a={k} aria-pressed="false">{l}</button>)}
    </div>
    <ul class="mt-4 space-y-2">
      {dishes.map(([n, p, al]) => (
        <li class="al-row grid transition-[grid-template-rows,opacity] duration-500" data-al={al === null ? 'unknown' : al.join(',')}>
          <div class="min-h-0 overflow-hidden">
            <div class="flex items-center gap-3 rounded-2xl bg-chalk px-4 py-3">
              <span class="min-w-0 flex-1">
                <span class="block font-semibold">{n}</span>
                <span class="mt-1 flex flex-wrap gap-1">
                  {al === null
                    ? <span class="text-xs font-semibold text-[#B45309]">{tt('Allergènes : demandez au personnel')}</span>
                    : al.length === 0 ? <span class="text-xs font-semibold text-green-deep">{tt('Sans allergène majeur')}</span>
                    : al.map(k => <span class="rounded-full bg-white px-2 py-0.5 text-[0.7rem] font-bold text-navy ring-1 ring-line">{A[k]}</span>)}
                </span>
              </span>
              <span class="font-bold tabular-nums" dir="ltr">{p}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm text-muted" data-al-note>{tt('Choisissez une allergie : les produits qui la contiennent disparaissent.')}</p>
    <span hidden data-al-hid>{tt('{n} produit(s) masqué(s), dont ceux qui ne sont pas encore vérifiés.')}</span>
  </div>

  <!-- the production label -->
  <div class="al-card relative flex flex-col rounded-[2rem] bg-navy p-5 text-white shadow-[0_50px_90px_-50px_rgba(0,30,62,0.8)] sm:p-6">
    <p class="flex items-center gap-2 font-bold"><Icon name="box" class="size-5 text-green" />{tt('Étiquette de la fournée')}</p>
    <p class="mt-1 text-sm text-white/60">{tt('58 × 40 mm · ou 50 × 30, 80 × 50, 100 × 60')}</p>
    <!-- the printer slot, the label comes out of it -->
    <div class="relative mt-6 flex-1">
      <div class="relative z-10 h-4 rounded-full bg-[#071C38] ring-1 ring-white/15" aria-hidden="true"></div>
      <div class="-mt-2 overflow-hidden px-4 pb-2">
        <div class="al-label mx-auto max-w-[19rem] rounded-b-xl bg-white px-4 pb-4 pt-5 font-mono text-[0.78rem] leading-snug text-navy shadow-[0_24px_40px_-20px_rgba(0,0,0,.6)]" data-label>
          <p class="text-center text-[0.7rem] font-bold uppercase tracking-wide">{tt('Pâtisserie Démo')}</p>
          <p class="mt-1 text-center text-base font-bold">{tt('Corne de gazelle')}</p>
          <div class="mt-2 flex justify-between border-t border-dashed border-navy/30 pt-2"><span>{tt('Fabriqué le')}</span><span dir="ltr">27/10/2026</span></div>
          <div class="flex justify-between font-bold"><span>{tt('À consommer jusqu’au')}</span><span dir="ltr">03/11/2026</span></div>
          <div class="flex justify-between"><span>{tt('Lot')}</span><span dir="ltr">P261027-03</span></div>
          <p class="mt-2 border-t border-dashed border-navy/30 pt-2"><b>{tt('Allergènes :')}</b> {tt('gluten, fruits à coque, œufs')}</p>
          <p dir="rtl" lang="ar" class="text-end font-sans">مسببات الحساسية: الغلوتين، المكسرات، البيض</p>
        </div>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="button" class="inline-flex min-h-11 items-center gap-2 rounded-full bg-green px-5 font-bold text-navy transition-transform active:scale-95" data-print><Icon name="check" class="size-4" />{tt('Imprimer l’étiquette')}</button>
      <span class="text-sm text-white/70"><span class="display text-2xl tabular-nums text-white" data-copies dir="ltr">0</span> {tt('étiquettes')}</span>
    </div>
    <p class="mt-3 text-xs text-white/50">{tt('Un ingrédient pas encore vérifié ? L’étiquette dit « demandez au personnel », jamais « sans allergène ».')}</p>
  </div>
</div>

<style is:global>
  .al-chip[aria-pressed="true"] { background: var(--color-navy); color: #fff; box-shadow: none; }
  .al-row { grid-template-rows: 1fr; }
  .al-row.is-hidden { grid-template-rows: 0fr; opacity: 0; }
  .al-label { transition: transform 1.1s cubic-bezier(.3,0,.2,1); }
  .js [data-allergen]:not(.in) .al-label { transform: translateY(-100%); }
  .al-label.feed { animation: al-feed 1s steps(8, end); }
  @keyframes al-feed { 0% { transform: translateY(-100%); } 100% { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .al-label, .al-row { transition: none !important; animation: none !important; } .js [data-allergen] .al-label { transform: none !important; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-allergen]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.al-chip')];
    const rows = [...root.querySelectorAll<HTMLElement>('.al-row')];
    const note = root.querySelector<HTMLElement>('[data-al-note]')!;
    const first = note.textContent;
    const hidTxt = root.querySelector<HTMLElement>('[data-al-hid]')!.textContent ?? '';
    let touched = false;
    const apply = () => {
      const on = chips.filter(c => c.getAttribute('aria-pressed') === 'true').map(c => c.dataset.a!);
      let hid = 0;
      rows.forEach((r) => {
        const al = r.dataset.al!;
        // a dish not checked yet is hidden as soon as an allergy is chosen: never shown as safe
        const hide = on.length > 0 && (al === 'unknown' || on.some(a => al.split(',').includes(a)));
        r.classList.toggle('is-hidden', hide); if (hide) hid++;
      });
      note.textContent = on.length ? hidTxt.replace('{n}', String(hid)) : first;
    };
    chips.forEach(c => c.addEventListener('click', () => { touched = true; c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true')); apply(); }));

    const label = root.querySelector<HTMLElement>('[data-label]')!;
    const copies = root.querySelector<HTMLElement>('[data-copies]')!;
    let n = 0;
    root.querySelector('[data-print]')!.addEventListener('click', () => {
      n += 24; copies.textContent = String(n);
      if (!still) { label.classList.remove('feed'); void label.offsetWidth; label.classList.add('feed'); }
    });

    const io = 'IntersectionObserver' in window ? new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return; io!.disconnect(); root.classList.add('in');
      if (!still) setTimeout(() => { if (!touched) { chips[2].setAttribute('aria-pressed', 'true'); apply(); } }, 1600);
    }, { threshold: 0.35 }) : null;
    if (io) io.observe(root); else root.classList.add('in');
  });
</script>
