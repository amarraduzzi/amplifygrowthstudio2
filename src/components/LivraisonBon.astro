---
// Livraison, hero visual: one real-looking order, shown twice. "Avec une app": a bite is taken out of what the restaurant keeps.
// "Avec Amplify": the bite is gone and the amount is whole. It plays app, then Amplify, and stops; the two tabs let people switch.
// The order is an example (labelled as such). No commission percentage is written anywhere.
import { tr } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const tt = tr(Astro.props.lang);
---
<div class="bon" id="bon" data-mode="amp">
  <div class="bon-tabs" role="group" aria-label={tt('Comparer une commande')}>
    <button type="button" data-set="app" aria-pressed="false">{tt('Avec une app')}</button>
    <button type="button" data-set="amp" aria-pressed="true">{tt('Avec Amplify')}</button>
  </div>
  <div class="bon-wrap">
    <span class="bon-chip" aria-hidden="true">{tt('App de livraison')}</span>
    <div class="bon-paper">
      <div class="bon-head"><span>{tt('Commande n° 1042')}</span><i>{tt('Exemple')}</i></div>
      <div class="bon-line"><span>2 × {tt('Tajine poulet')}</span><b dir="ltr">140 DH</b></div>
      <div class="bon-sep"></div>
      <p class="bon-lbl">{tt('Il vous reste')}</p>
      <div class="bon-amt">
        <b dir="ltr">140 DH</b>
        <span class="bon-bite" aria-hidden="true"></span>
        <span class="bon-minus" aria-hidden="true">− {tt('commission')}</span>
      </div>
      <span class="bon-stamp" aria-hidden="true">{tt('Zéro commission')}</span>
      <div class="bon-cap">
        <p class="bon-cap-app">{tt('L’app prend sa part de chaque commande et garde vos clients.')}</p>
        <p class="bon-cap-amp">{tt('Rien entre vous et votre client. La commande, l’argent et le client sont à vous.')}</p>
      </div>
    </div>
  </div>
</div>
<script>
  const box = document.getElementById('bon');
  if (box && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-set]')];
    let touched = false;
    const set = (m: string) => { box.dataset.mode = m; tabs.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.set === m))); };
    tabs.forEach(b => b.addEventListener('click', () => { touched = true; set(b.dataset.set!); }));
    set('app');
    let started = false;
    const start = () => { if (started) return; started = true; setTimeout(() => { if (!touched) set('amp'); }, 3400); };
    addEventListener('lv-warp-done', start);
    setTimeout(start, 4200);
  }
</script>
<style>
  .bon { width: 100%; max-width: 27rem; margin-inline: auto; }
  .bon-tabs { display: flex; gap: .3rem; padding: .25rem; margin-bottom: 1.1rem; border-radius: 999px; background: rgb(255 255 255 / .07); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .12); }
  .bon-tabs button { flex: 1; padding: .6rem .8rem; border-radius: 999px; font-weight: 700; font-size: .95rem; color: rgb(255 255 255 / .7); transition: background .3s, color .3s; }
  .bon[data-mode='app'] .bon-tabs [data-set='app'] { background: var(--coral); color: #2a0b07; }
  .bon[data-mode='amp'] .bon-tabs [data-set='amp'] { background: var(--gl); color: #03231a; }
  .bon-tabs button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .bon-wrap { position: relative; filter: drop-shadow(0 24px 40px rgb(0 0 0 / .45)); }
  .bon-paper { position: relative; padding: 1.4rem 1.4rem 2.2rem; background: #f6f4ec; color: #0b2a4a;
    -webkit-mask: linear-gradient(#000 0 0) top / 100% calc(100% - 9px) no-repeat, conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 18px 9px repeat-x;
            mask: linear-gradient(#000 0 0) top / 100% calc(100% - 9px) no-repeat, conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 18px 9px repeat-x; }
  .bon-head { display: flex; justify-content: space-between; align-items: center; font-size: .85rem; color: #4a5f78; }
  .bon-head i { font-style: normal; padding: .15rem .55rem; border-radius: 99px; background: #0b2a4a; color: #f6f4ec; font-size: .75rem; }
  .bon-line { display: flex; justify-content: space-between; margin-top: 1.1rem; font-size: 1.15rem; font-weight: 600; }
  .bon-sep { margin: 1.1rem 0 .9rem; border-top: 2px dashed #b8c2cf; }
  .bon-lbl { font-size: .9rem; color: #4a5f78; }
  .bon-amt { position: relative; margin-top: .2rem; padding-block: .3rem; overflow: hidden; }
  .bon-amt b { display: block; font-family: 'Doto Variable', ui-monospace, monospace; font-weight: 900; font-size: clamp(2.7rem, 11.5vw, 3.5rem); line-height: 1; color: #00804A; transition: color .4s; }
  .bon-bite { position: absolute; top: 0; right: 0; bottom: 0; width: 0; background: var(--coral);
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 14% 100%, 0 90%, 12% 78%, 0 66%, 12% 54%, 0 42%, 12% 30%, 0 18%); transition: width .7s cubic-bezier(.2, .9, .2, 1); }
  .bon-minus { position: absolute; right: .6rem; top: 50%; translate: 0 -50%; font-weight: 800; font-size: 1.05rem; color: #2a0b07; opacity: 0; transition: opacity .3s .35s; }
  .bon-stamp { position: absolute; right: 1.2rem; top: 5.9rem; max-width: 6.8rem; text-align: center; line-height: 1.1; padding: .35rem .6rem; border: 3px solid #00804A; border-radius: .6rem; color: #00804A; font-weight: 900; font-size: .9rem; transform: rotate(-9deg) scale(1.6); opacity: 0; transition: transform .45s cubic-bezier(.2, 1.4, .4, 1), opacity .2s; pointer-events: none; }
  .bon-chip { position: absolute; z-index: 2; top: -15px; right: 20px; padding: .4rem .9rem; border-radius: 99px; background: var(--coral); color: #2a0b07; font-weight: 800; font-size: .9rem; rotate: 5deg; transition: opacity .35s, translate .35s; }
  .bon-cap { display: grid; margin-top: 1rem; font-size: .95rem; line-height: 1.4; }
  .bon-cap p { grid-area: 1 / 1; transition: opacity .4s; }
  .bon-cap-app { color: #b3261e; font-weight: 600; opacity: 0; }
  .bon-cap-amp { color: #0b2a4a; font-weight: 600; }

  .bon[data-mode='app'] .bon-bite { width: 46%; }
  .bon[data-mode='app'] .bon-minus { opacity: 1; }
  .bon[data-mode='app'] .bon-amt b { color: #7d8f86; }
  .bon[data-mode='app'] .bon-cap-app { opacity: 1; }
  .bon[data-mode='app'] .bon-cap-amp { opacity: 0; }
  .bon[data-mode='amp'] .bon-stamp { opacity: 1; transform: rotate(-9deg) scale(1); }
  .bon[data-mode='amp'] .bon-chip { opacity: .0; translate: 0 -12px; }
  @media (max-width: 480px) { .bon-paper { padding: 1.1rem 1.1rem 2rem; } .bon-stamp { top: 5.4rem; font-size: .8rem; max-width: 6rem; } }
</style>
