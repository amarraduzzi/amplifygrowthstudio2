---
// "Le WhatsApp de vos clients vaut de l'or." A green section that stands out. Right: a quiet Tuesday,
// one message to the regulars, replies come in and the room fills. Plays once, then the visitor can
// press "Envoyer" again.
import Icon from './Icon.astro';
import WaButton from './WaButton.astro';
import { mkFr as c } from '../i18n/marketing-fr';
const w = c.wa;
const people = ['SA', 'KM', 'YB', 'NL', 'HE', 'OM', 'IZ', 'RB', 'FA', 'MT', 'AD', 'LK'];
const replyAt = [1, 4, 6, 9];
const STEP_ICO = ['🍵', '🤝', '📲'];
---
<section class="relative isolate overflow-hidden bg-green py-24 text-navy" data-mkwa>
  <!-- big faint WhatsApp mark -->
  <svg viewBox="0 0 24 24" class="pointer-events-none absolute -end-32 -bottom-32 -z-10 size-[34rem] text-white/15" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.22-.08-.39-.12-.55.13-.17.24-.64.8-.78.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.47a.9.9 0 0 0-.66.31c-.22.25-.86.85-.86 2.07s.88 2.4 1.01 2.57c.12.16 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"/></svg>
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:items-start">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-navy px-3 py-1.5 text-sm font-semibold text-white"><span class="text-[#F5B301]">★</span>{w.kicker}</p>
      <h2 class="mt-5 text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{w.h2a}</span><span class="mkw-gold block">{w.h2b}</span></h2>
      <p class="mt-5 max-w-xl text-lg font-medium text-navy/80">{w.p}</p>
      <ol class="mt-8 space-y-3">
        {w.steps.map(([h, p], i) => (
          <li class="flex gap-4 rounded-2xl bg-white/25 p-4 ring-1 ring-white/30 backdrop-blur-sm">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-navy text-xl">{STEP_ICO[i]}</span>
            <span><span class="block text-lg font-bold">{String(i + 1).padStart(2, '0')} · {h}</span><span class="text-navy/80">{p}</span></span>
          </li>
        ))}
      </ol>
      <ul class="mt-6 flex flex-wrap gap-2 text-sm font-bold">{w.rules.map(r => <li class="flex items-center gap-1.5 rounded-full bg-navy px-3 py-1.5 text-white"><Icon name="check" class="size-3.5 text-green" />{r}</li>)}</ul>
      <p class="mt-6 max-w-xl font-semibold">{w.us}</p>
      <div class="mt-6"><WaButton text="Bonjour, je voudrais construire la liste WhatsApp de mes clients." label={w.cta} where="marketing-wa" class="bg-navy! px-7 text-lg text-white! hover:bg-blue!" /></div>
    </div>

    <!-- the quiet Tuesday -->
    <div class="mkw-stage lg:sticky lg:top-28" data-phase="0">
      <div class="rounded-[2rem] bg-navy p-5 text-white shadow-[0_50px_90px_-40px_rgba(0,30,62,0.8)] sm:p-6">
        <div class="flex items-center justify-between text-sm">
          <span class="font-semibold">{w.time}</span>
          <span class="mkw-room flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 font-semibold"><span class="mkw-dot size-2 rounded-full bg-[#F5B301]"></span><span class="mkw-room-t">{w.calm}</span></span>
        </div>
        <!-- room level -->
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/10" aria-hidden="true"><span class="mkw-level block h-full rounded-full bg-[#F5B301] transition-[width,background-color] duration-1000"></span></div>

        <!-- the message -->
        <div class="mt-5 rounded-2xl bg-[#0B141A] p-3">
          <div class="mkw-msg ms-auto max-w-[88%] rounded-xl rounded-se-none bg-[#005C4B] px-3 py-2 text-sm leading-snug">
            {w.msg}
            <span class="mt-1 flex justify-end gap-1 text-[0.65rem] text-white/60">15:10 <span class="mkw-ticks">✓</span></span>
          </div>
        </div>
        <button type="button" class="mkw-send mt-4 flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-green font-bold text-navy transition-transform hover:scale-[1.02]">
          <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M3 20.5 21 12 3 3.5 3 10l12 2-12 2z"/></svg><span class="mkw-send-t">{w.send}</span>
        </button>

        <!-- the regulars -->
        <ul class="mx-auto mt-8 grid w-fit grid-cols-6 gap-x-3 gap-y-9 pt-4" aria-hidden="true">
          {people.map((p, i) => (
            <li class="mkw-p relative" style={`--d:${i * 70}ms`}>
              <span class="mkw-av grid size-10 place-items-center rounded-full sm:size-11 bg-white/10 text-xs font-bold transition-colors duration-300">{p}</span>
              {replyAt.includes(i) && <span class="mkw-reply absolute bottom-full start-1/2 mb-1 whitespace-nowrap rounded-lg rounded-es-none bg-white px-2 py-1 text-[0.65rem] font-semibold text-navy shadow-lg" style={`--r:${replyAt.indexOf(i) * 450}ms`}>{w.replies[replyAt.indexOf(i)]}</span>}
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-3 text-center text-xs font-semibold text-navy/70">{w.note}</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-mkwa]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.mkw-stage')!;
    const btn = root.querySelector<HTMLButtonElement>('.mkw-send')!;
    const label = root.querySelector<HTMLElement>('.mkw-send-t')!;
    const roomT = root.querySelector<HTMLElement>('.mkw-room-t')!;
    const ticks = root.querySelector<HTMLElement>('.mkw-ticks')!;
    const T = { send: label.textContent!, calm: roomT.textContent! };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timers: number[] = [];
    const reset = () => { timers.forEach(clearTimeout); timers = []; stage.dataset.phase = '0'; label.textContent = T.send; roomT.textContent = T.calm; ticks.textContent = '✓'; };
    const play = () => {
      reset();
      const at = (ms: number, f: () => void) => timers.push(window.setTimeout(f, still ? 0 : ms));
      at(50, () => { stage.dataset.phase = '1'; label.textContent = 'Envoyé ✓'; });
      at(1100, () => { ticks.textContent = '✓✓'; stage.dataset.phase = '2'; });
      at(2400, () => { stage.dataset.phase = '3'; roomT.textContent = 'Salle pleine à 17:30'; });
    };
    btn.addEventListener('click', play);
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); setTimeout(play, 700); } }, { threshold: 0.5 });
      io.observe(stage);
    } else play();
  });
</script>
