---
// "Le WhatsApp de vos clients vaut de l'or." Dark section with a gold headline. Centre: a real-looking
// WhatsApp broadcast on an iPhone. The offer types itself, is sent to the regulars, the ticks turn blue,
// replies pop up around the phone and the room gauge goes from calm to full. "Renvoyer" plays it again.
import Icon from './Icon.astro';
import WaButton from './WaButton.astro';
import { mkFr as c } from '../i18n/marketing-fr';
const w = c.wa;
const toasts = [
  { n: 'Sara', i: 'S', r: w.replies[0], pos: 'start-0 top-[13%] sm:-start-6', bg: '#F5B301' },
  { n: 'Karim', i: 'K', r: w.replies[1], pos: 'end-0 top-[24%] sm:-end-6', bg: '#2DD4BF' },
  { n: 'Nadia', i: 'N', r: w.replies[2], pos: 'start-0 top-[35%] sm:-start-8', bg: '#8FB3FF' },
  { n: 'Youssef', i: 'Y', r: w.replies[3], pos: 'end-0 top-[46%] sm:-end-4', bg: '#FF8A8D' },
];
const STEP_ICO = ['🍵', '🤝', '📲'];
const coins = [[8, 0], [22, 2.5], [37, 5], [55, 1.2], [70, 3.8], [86, 6.2], [94, 1.8], [46, 7.4]];
---
<section class="mkw relative isolate overflow-hidden py-24 text-white md:py-32" data-mkwa>
  <!-- glow, grid, rising gold coins -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <span class="absolute inset-0 bg-[radial-gradient(60%_50%_at_75%_45%,rgba(5,185,98,.28),transparent_70%),radial-gradient(40%_40%_at_10%_10%,rgba(245,179,1,.12),transparent_70%)]"></span>
    <span class="absolute inset-0 opacity-[0.06] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:48px_48px]"></span>
    {coins.map(([x, d]) => <span class="mkw-coin absolute bottom-[-40px] size-5 rounded-full" style={`left:${x}%;--d:${d}s`}></span>)}
  </div>

  <div class="mx-auto grid max-w-6xl gap-x-16 gap-y-12 px-4 sm:px-6 lg:grid-cols-[1fr_1fr]">
    <!-- header -->
    <div class="lg:col-start-1">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold ring-1 ring-white/20 backdrop-blur"><span class="text-[#F5B301]">★</span>{w.kicker}</p>
      <h2 class="mt-5 text-[2.9rem] leading-[0.92] sm:text-6xl lg:text-[5.2rem]"><span class="block">{w.h2a}</span><span class="mkw-gold block">{w.h2b}</span></h2>
      <p class="mt-6 max-w-xl text-lg text-white/75">{w.p}</p>
    </div>

    <!-- the phone -->
    <div class="mkw-stage relative mx-auto w-full max-w-[26rem] pb-16 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center" data-phase="0" aria-hidden="true">
      <span class="mkw-rays absolute inset-[-30%] -z-10 rounded-full"></span>
      <div class="mkw-phone relative mx-auto w-[16.5rem] rounded-[3rem] bg-linear-to-b from-[#4A505A] via-[#1C1F24] to-[#4A505A] p-[0.45rem] shadow-[0_60px_120px_-30px_rgba(0,0,0,.8),0_0_0_1px_rgba(255,255,255,.08)] sm:w-[17.5rem]">
        <span class="absolute -start-[3px] top-[22%] h-8 w-[3px] rounded-s bg-[#3A3F47]"></span>
        <span class="absolute -start-[3px] top-[32%] h-14 w-[3px] rounded-s bg-[#3A3F47]"></span>
        <span class="absolute -end-[3px] top-[28%] h-20 w-[3px] rounded-e bg-[#3A3F47]"></span>
        <div class="overflow-hidden rounded-[2.6rem] bg-black p-[0.3rem]">
          <div class="relative flex h-[34rem] flex-col overflow-hidden rounded-[2.3rem] bg-[#0B141A] text-[0.78rem]">
            <div class="relative z-10 flex items-center justify-between bg-[#1F2C34] px-6 pb-1 pt-2.5 text-[0.7rem] font-semibold">
              <span>15:10</span><span class="flex items-center gap-1"><span class="flex items-end gap-px">{[3, 5, 7, 9].map(h => <span class="w-[3px] rounded-sm bg-white" style={`height:${h}px`}></span>)}</span><span class="ms-1 h-2.5 w-5 rounded-[3px] border border-white/80 p-px"><span class="block h-full w-3/4 rounded-[1px] bg-white"></span></span></span>
            </div>
            <span class="absolute start-1/2 top-2 z-20 h-6 w-[5.5rem] -translate-x-1/2 rounded-full bg-black"></span>
            <div class="flex items-center gap-2.5 bg-[#1F2C34] px-3 pb-2.5 pt-1.5">
              <span class="text-lg text-[#00A884]">‹</span>
              <span class="grid size-9 place-items-center rounded-full bg-[#00A884] text-[#0B141A]"><svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M12 3a9 9 0 0 0-9 9v3h3v-3a6 6 0 0 1 12 0v3h3v-3a9 9 0 0 0-9-9zM4 17h4v4H4zm12 0h4v4h-4z"/></svg></span>
              <span class="min-w-0 flex-1 leading-tight"><span class="block truncate font-semibold">Habitués · Votre café</span><span class="block truncate text-[0.65rem] text-white/55">Liste de diffusion · 12 destinataires</span></span>
            </div>
            <div class="mkw-wall relative flex flex-1 flex-col justify-end gap-2 px-3 pb-3">
              <p class="mx-auto mb-auto mt-3 rounded-md bg-[#1F2C34] px-2.5 py-1 text-[0.62rem] text-white/60">Aujourd’hui</p>
              <div class="mkw-msg ms-auto w-[86%] overflow-hidden rounded-lg rounded-se-none bg-[#005C4B] p-1 shadow-md">
                <img src="/img/menu/crepe-banane.webp" alt="" width="600" height="600" loading="lazy" class="h-28 w-full rounded-md object-cover" />
                <p class="px-1.5 pb-0.5 pt-1.5 leading-snug">{w.msg}</p>
                <p class="flex justify-end gap-1 px-1.5 text-[0.6rem] text-white/60">15:10 <span class="mkw-ticks">✓</span></p>
              </div>
            </div>
            <div class="flex items-end gap-2 bg-[#0B141A] px-2 pb-4 pt-1">
              <div class="flex max-h-[5.6rem] min-h-10 flex-1 items-end overflow-hidden rounded-3xl bg-[#1F2C34] px-3.5 py-2.5 text-white/90">
                <span class="block min-w-0 flex-1 leading-snug"><span class="mkw-typed"></span><span class="mkw-caret ms-px inline-block h-3.5 w-px translate-y-0.5 bg-[#00A884]"></span><span class="mkw-ph text-white/40">Message</span></span>
              </div>
              <span class="mkw-btn grid size-10 shrink-0 place-items-center rounded-full bg-[#00A884] text-[#0B141A]"><svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M3 20.5 21 12 3 3.5 3 10l12 2-12 2z"/></svg></span>
            </div>
          </div>
        </div>
      </div>

      {toasts.map((t, k) => (
        <div class={`mkw-toast absolute z-10 flex w-[12.5rem] items-center gap-2 rounded-2xl bg-white/95 p-2 text-navy shadow-[0_20px_40px_-15px_rgba(0,0,0,.6)] backdrop-blur ${t.pos}`} style={`--r:${k * 380}ms`}>
          <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold" style={`background:${t.bg}`}>{t.i}</span>
          <span class="min-w-0 leading-tight"><span class="flex items-center gap-1 text-[0.62rem] font-semibold text-muted"><span class="size-1.5 rounded-full bg-[#00A884]"></span>{t.n} · WhatsApp</span><span class="block truncate text-[0.8rem] font-bold">{t.r}</span></span>
        </div>
      ))}

      <div class="mkw-gauge absolute bottom-0 start-1/2 z-10 flex w-56 -translate-x-1/2 items-center gap-3 rounded-2xl bg-navy/90 p-3 ring-1 ring-white/15 backdrop-blur rtl:translate-x-1/2">
        <svg viewBox="0 0 36 36" class="size-12 shrink-0 -rotate-90"><circle cx="18" cy="18" r="15" fill="none" stroke="rgb(255 255 255 / .12)" stroke-width="4" /><circle class="mkw-arc" cx="18" cy="18" r="15" fill="none" stroke-width="4" stroke-linecap="round" pathLength="100" /></svg>
        <span class="leading-tight"><span class="block text-[0.65rem] text-white/60">Salle à 17:30</span><span class="block font-bold"><span class="mkw-calm">{w.calm}</span><span class="mkw-full">Pleine</span></span></span>
      </div>
    </div>

    <!-- steps, rules, cta -->
    <div class="lg:col-start-1">
      <ol class="space-y-3">
        {w.steps.map(([h, p], i) => (
          <li class="flex gap-4 rounded-2xl bg-white/[0.04] p-4 ring-1 ring-white/10 transition-colors hover:bg-white/[0.08]">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-linear-to-br from-[#F5B301] to-[#C98F00] text-xl shadow-[0_8px_20px_-8px_rgba(245,179,1,.7)]">{STEP_ICO[i]}</span>
            <span><span class="block text-lg font-bold"><span class="me-1.5 text-[#F5B301]">{String(i + 1).padStart(2, '0')}</span>{h}</span><span class="text-white/70">{p}</span></span>
          </li>
        ))}
      </ol>
      <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">{w.rules.map(r => <li class="flex items-center gap-1.5 rounded-full bg-green/15 px-3 py-1.5 text-green ring-1 ring-green/30"><Icon name="check" class="size-3.5" />{r}</li>)}</ul>
      <p class="mt-6 max-w-xl font-semibold text-white/90">{w.us}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <WaButton text="Bonjour, je voudrais construire la liste WhatsApp de mes clients." label={w.cta} where="marketing-wa" class="px-7 text-lg" />
        <button type="button" class="mkw-replay inline-flex min-h-12 items-center gap-2 rounded-full px-5 font-semibold text-white/80 ring-1 ring-white/25 hover:bg-white/10">↻ Rejouer l’envoi</button>
      </div>
      <p class="mt-3 text-xs text-white/40">{w.note}</p>
    </div>
  </div>
</section>

<script define:vars={{ msg: w.msg }}>
  document.querySelectorAll('[data-mkwa]').forEach((root) => {
    const stage = root.querySelector('.mkw-stage');
    const typed = root.querySelector('.mkw-typed');
    const ticks = root.querySelector('.mkw-ticks');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timers = [];
    const at = (ms, f) => timers.push(setTimeout(f, ms));
    const play = () => {
      timers.forEach(clearTimeout); timers = [];
      ticks.textContent = '✓'; typed.textContent = '';
      if (still) { stage.dataset.phase = '3'; ticks.textContent = '✓✓'; return; }
      stage.dataset.phase = 'type';
      const speed = 22;
      for (let i = 1; i <= msg.length; i++) at(i * speed, () => (typed.textContent = msg.slice(0, i)));
      const end = msg.length * speed;
      at(end + 450, () => { stage.dataset.phase = 'tap'; });
      at(end + 750, () => { typed.textContent = ''; stage.dataset.phase = '1'; });
      at(end + 1700, () => { ticks.textContent = '✓✓'; stage.dataset.phase = '2'; });
      at(end + 2300, () => { stage.dataset.phase = '3'; });
    };
    root.querySelector('.mkw-replay').addEventListener('click', () => { stage.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' }); play(); });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); setTimeout(play, 400); } }, { threshold: 0.45 });
      io.observe(stage);
    } else play();
  });
</script>
