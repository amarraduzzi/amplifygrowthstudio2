---
// Le Rouleau, hero: a thermal receipt unrolls once; the visitor moves the order amount and the receipt prints along.
// Commission stays at 0,00 DH. Second slip: a small calculator with the visitor's own commission % (nothing is claimed about other platforms).
import type { BssahaCopy } from '../i18n/bssaha';
interface Props { c: BssahaCopy }
const { c } = Astro.props;
const row = 'tk-line flex items-baseline gap-2 py-1';
---
<div class="bs-ticket mx-auto grid w-full max-w-sm gap-7">
  <div class="[filter:drop-shadow(0_18px_20px_rgba(0,0,0,0.32))]">
    <div class="bs-roll">
      <div class="bs-paper bs-torn rotate-[0.8deg] px-5 pb-10 pt-6 font-dot text-[1.05rem]" role="group" aria-label={c.ticketLabel}>
        <p class="text-center text-4xl tracking-[0.25em]">BSSAHA</p>
        <p class="mt-1 text-center font-sans text-xs font-normal text-black/60">{c.badge}</p>
        <hr class="my-4 border-t-2 border-dashed border-black/40" />
        <label for="t-amt" class="flex justify-between gap-3 font-sans text-sm font-semibold"><span>{c.tSlider}</span><output id="t-amt-out" dir="ltr" for="t-amt">100 DH</output></label>
        <input id="t-amt" type="range" min="30" max="500" step="10" value="100" class="mb-3 mt-2 w-full accent-black" />
        <div class={row} style="--d:0ms"><span>{c.ticketOrder}</span><span class="bs-leader"></span><span dir="ltr" data-o="order">100,00 DH</span></div>
        <div class={row} style="--d:140ms"><span>{c.ticketResto}</span><span class="bs-leader"></span><span dir="ltr" data-o="resto">100,00 DH</span></div>
        <div class={`${row} text-lg`} style="--d:280ms"><span class="bs-mark">{c.ticketComm}</span><span class="bs-leader"></span><span class="bs-mark" dir="ltr">0,00 DH</span></div>
        <hr class="my-3 border-t-2 border-dashed border-black/40" />
        <div class={`${row} text-2xl`} style="--d:420ms"><span>{c.ticketTotal}</span><span class="bs-leader"></span><span dir="ltr" data-o="total">100,00 DH</span></div>
        <p class="mt-4 font-sans text-xs font-normal text-black/60">{c.ticketNote}</p>
        <div class="bs-barcode mt-4" aria-hidden="true"></div>
      </div>
    </div>
  </div>
  <div class="[filter:drop-shadow(0_18px_20px_rgba(0,0,0,0.32))]">
    <div class="bs-roll" style="--d:900ms">
      <div class="bs-paper bs-torn -rotate-[1deg] px-5 pb-10 pt-6 font-dot">
        <p class="text-xl">{c.calcTitle}</p>
        <label for="c-pct" class="mt-3 flex justify-between gap-3 font-sans text-sm font-semibold"><span>{c.calcPct}</span><output id="c-pct-out" dir="ltr" for="c-pct">20 %</output></label>
        <input id="c-pct" type="range" min="5" max="35" step="1" value="20" class="w-full accent-black" />
        <label for="c-ord" class="mt-2 flex justify-between gap-3 font-sans text-sm font-semibold"><span>{c.calcOrders}</span><output id="c-ord-out" dir="ltr" for="c-ord">200</output></label>
        <input id="c-ord" type="range" min="20" max="1000" step="10" value="200" class="w-full accent-black" />
        <p class="mt-4 font-sans text-sm font-semibold">{c.calcOut}</p>
        <p class="mt-1 text-4xl"><span class="bs-mark" dir="ltr" id="c-out" aria-live="polite">4 000 DH</span></p>
        <p class="mt-3 font-sans text-xs font-normal text-black/60">{c.calcHow}</p>
      </div>
    </div>
  </div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('.bs-ticket');
  if (root) {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const amt = q<HTMLInputElement>('#t-amt'), pct = q<HTMLInputElement>('#c-pct'), ord = q<HTMLInputElement>('#c-ord');
    const fmt = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    const set = (s: string, v: string) => { q(s).textContent = v; };
    const update = () => {
      const a = +amt.value, p = +pct.value, o = +ord.value;
      set('#t-amt-out', `${a} DH`);
      for (const k of ['order', 'resto', 'total']) set(`[data-o="${k}"]`, `${a},00 DH`);
      set('#c-pct-out', `${p} %`); set('#c-ord-out', fmt(o));
      set('#c-out', `${fmt(a * o * p / 100)} DH`);
    };
    [amt, pct, ord].forEach(el => el.addEventListener('input', update));
    update();
  }
</script>
