---
// The living receipt: the visitor moves the order amount and the receipt prints along; the commission stays at 0 DH.
// Below it, a small calculator with the visitor's own commission percentage (nothing is claimed about other platforms).
import type { BssahaCopy } from '../i18n/bssaha';
interface Props { c: BssahaCopy }
const { c } = Astro.props;
const line = 'tk-line flex justify-between gap-3 py-1';
---
<div class="bs-ticket grid gap-4">
  <div class="rotate-[1deg] rounded-2xl bg-paper p-6 font-mono text-navy shadow-[0_24px_50px_-28px_rgba(0,0,0,0.7)]" aria-label={c.ticketLabel}>
    <label for="t-amt" class="flex justify-between gap-3 font-sans text-sm font-semibold"><span>{c.tSlider}</span><output id="t-amt-out" dir="ltr" for="t-amt">100 DH</output></label>
    <input id="t-amt" type="range" min="30" max="500" step="10" value="100" class="mt-2 mb-3 w-full accent-green" />
    <div class={line} style="--d:0ms"><span>{c.ticketOrder}</span><span dir="ltr" data-o="order">100 DH</span></div>
    <hr class="my-2 border-dashed border-line" />
    <div class={line} style="--d:120ms"><span>{c.ticketResto}</span><span dir="ltr" data-o="resto">100 DH</span></div>
    <div class={line} style="--d:240ms"><span>{c.ticketComm}</span><span dir="ltr">0 DH</span></div>
    <hr class="my-2 border-dashed border-line" />
    <div class={`${line} text-lg font-bold`} style="--d:360ms"><span>{c.ticketTotal}</span><span dir="ltr" data-o="total">100 DH</span></div>
    <p class="mt-3 font-sans text-sm text-muted">{c.ticketNote}</p>
  </div>
  <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15">
    <p class="font-semibold text-mint">{c.calcTitle}</p>
    <label for="c-pct" class="mt-3 flex justify-between gap-3 text-sm"><span>{c.calcPct}</span><output id="c-pct-out" dir="ltr" for="c-pct">20 %</output></label>
    <input id="c-pct" type="range" min="5" max="35" step="1" value="20" class="w-full accent-green" />
    <label for="c-ord" class="mt-2 flex justify-between gap-3 text-sm"><span>{c.calcOrders}</span><output id="c-ord-out" dir="ltr" for="c-ord">200</output></label>
    <input id="c-ord" type="range" min="20" max="1000" step="10" value="200" class="w-full accent-green" />
    <p class="mt-3 text-sm text-white/80">{c.calcOut}</p>
    <p class="text-4xl font-bold text-green" dir="ltr" id="c-out" aria-live="polite">4 000 DH</p>
    <p class="mt-1 text-xs text-white/60">{c.calcHow}</p>
  </div>
</div>
<style>
  @media (prefers-reduced-motion: no-preference) {
    .tk-line { animation: tk-print .5s steps(8, end) both; animation-delay: calc(var(--d, 0ms) + 250ms); }
    @keyframes tk-print { from { clip-path: inset(0 100% 0 0); opacity: 0; } to { clip-path: inset(0 0 0 0); opacity: 1; } }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('.bs-ticket');
  if (root) {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const amt = q<HTMLInputElement>('#t-amt'), pct = q<HTMLInputElement>('#c-pct'), ord = q<HTMLInputElement>('#c-ord');
    const fmt = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    const set = (s: string, v: string) => { q(s).textContent = v; };
    const update = () => {
      const a = +amt.value, p = +pct.value, o = +ord.value;
      set('#t-amt-out', `${a} DH`);
      for (const k of ['order', 'resto', 'total']) set(`[data-o="${k}"]`, `${a} DH`);
      set('#c-pct-out', `${p} %`); set('#c-ord-out', fmt(o));
      set('#c-out', `${fmt(a * o * p / 100)} DH`);
    };
    [amt, pct, ord].forEach(el => el.addEventListener('input', update));
    update();
  }
</script>
