---
// Bssaha, hero terminal: a glass order terminal that tilts with the pointer. The visitor moves the order amount; every figure follows.
// Commission stays at 0,00 DH. (The restaurant calculator lives in BssahaCalc.)
import type { BssahaCopy } from '../i18n/bssaha';
interface Props { c: BssahaCopy }
const { c } = Astro.props;
---
<div class="relative mx-auto w-full max-w-md">
  <div class="bx-glass bx-term" data-tilt="7" role="group" aria-label={c.ticketLabel}>
    <span class="bx-orbit" style="top:-1.3rem;inset-inline-end:.6rem" aria-hidden="true">✓ {c.modes.direct}</span>
    <div class="bx-term-bar" aria-hidden="true"><i></i><i></i><i></i><span class="font-dot">BSSAHA // {c.liveNow}</span></div>
    <label for="t-amt" class="bx-amt-row"><span>{c.tSlider}</span><output id="t-amt-out" for="t-amt" dir="ltr" class="bx-led bx-amt-big">100 DH</output></label>
    <input id="t-amt" type="range" min="30" max="500" step="10" value="100" class="bx-range" style="--fill:15%" />
    <div class="bx-pipe" aria-hidden="true"><b class="font-dot">100 % → {c.ticketResto}</b></div>
    <div class="bx-row"><span>{c.ticketOrder}</span><span class="lead"></span><span dir="ltr" class="font-dot" data-o="order">100,00 DH</span></div>
    <div class="bx-row"><span>{c.ticketResto}</span><span class="lead"></span><span dir="ltr" class="font-dot" data-o="resto">100,00 DH</span></div>
    <div class="bx-row bx-row--zero text-base sm:text-lg"><span class="font-semibold">{c.ticketComm}</span><span class="lead"></span><span dir="ltr" class="bx-led bx-glitch zero" data-t="0,00 DH">0,00 DH</span></div>
    <div class="bx-row text-lg sm:text-xl" style="border-top:1px dashed rgba(255,255,255,.2);margin-top:.5rem;padding-top:.8rem"><span class="font-bold">{c.ticketTotal}</span><span class="lead"></span><span dir="ltr" class="bx-led text-xl sm:text-2xl" data-o="total">100,00 DH</span></div>
    <p class="mt-3 text-xs bx-mute">{c.ticketNote}</p>
    <span class="bx-orbit alt" style="bottom:-1.2rem;inset-inline-start:.6rem" aria-hidden="true"><span class="bx-dot"></span> 0 DH {c.zeroLabel}</span>
  </div>
</div>
<script>
  const amt = document.getElementById('t-amt') as HTMLInputElement | null;
  if (amt) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const outs = new Map<HTMLElement, number>();
    const fmt = (n: number) => `${Math.round(n)},00 DH`;
    const els = ['order', 'resto', 'total'].map(k => document.querySelector<HTMLElement>(`[data-o="${k}"]`)!);
    const big = document.getElementById('t-amt-out')!;
    els.concat(big).forEach(e => outs.set(e, 100));
    let raf = 0, from = 100, to = 100, t0 = 0;
    const show = (v: number) => { els.forEach(e => e.textContent = fmt(v)); big.textContent = `${Math.round(v)} DH`; };
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / 320), e = 1 - Math.pow(1 - k, 3);
      show(from + (to - from) * e);
      if (k < 1) raf = requestAnimationFrame(step);
    };
    const set = (v: number, fromEvent = false) => {
      amt.value = String(v);
      amt.style.setProperty('--fill', `${((v - +amt.min) / (+amt.max - +amt.min) * 100).toFixed(1)}%`);
      if (still) show(v); else { cancelAnimationFrame(raf); from = parseFloat(big.textContent || '100'); to = v; t0 = performance.now(); raf = requestAnimationFrame(step); }
      if (!fromEvent) document.dispatchEvent(new CustomEvent('bx:amt', { detail: v }));
    };
    amt.addEventListener('input', () => set(+amt.value));
    document.addEventListener('bx:amt', e => { const v = (e as CustomEvent<number>).detail; if (v !== +amt.value) set(v, true); });
    set(100, true);
  }
</script>
