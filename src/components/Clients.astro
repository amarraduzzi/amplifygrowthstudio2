---
// The restaurants that already work with Amplify: their real logos, what they use, and a link to
// the live site when there is one. Only facts we can stand behind: no service is listed unless it runs.
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
type Svc = 'pos' | 'site' | 'qr' | 'online';
const SVC: Record<Svc, string> = {
  pos: tt('Caisse'), site: tt('Site web'), qr: tt('Commande QR'), online: tt('Commande en ligne'),
};
const clients: { name: string; logo: string; bg: string; kind: string; svc: Svc[]; url?: string; fit?: 'contain' }[] = [
  { name: 'Gaston Gali', logo: 'gaston-gali', bg: '#241e20', kind: tt('Pâtisserie, café et traiteur'), svc: ['qr'], url: 'https://gastongali.com' },
  { name: 'Dom’s Café', logo: 'doms', bg: '#0a0404', fit: 'contain', kind: tt('Café et pizzeria, Agdal'), svc: ['pos', 'site'], url: 'https://domscafeagdal.pages.dev' },
  { name: 'Indian Flavors', logo: 'indian-flavors', bg: '#1b1b1b', kind: tt('Restaurant indien, Agdal'), svc: ['online', 'site'], url: 'https://indianflavor.pages.dev' },
  { name: 'Relais Marin', logo: 'relais-marin', bg: '#051935', kind: 'Rabat', svc: ['qr', 'site'], url: 'https://site.amplifygrowthstudio.com/relais-marin' },
  { name: 'L’Atelier by Sam', logo: 'atelier-sam', bg: '#faf7f0', kind: tt('Salon de thé et brunch'), svc: ['pos', 'site'] },
  { name: 'Zayna Café', logo: 'zayna', bg: '#ffffff', kind: tt('Coffee shop'), svc: ['pos'] },
  { name: 'Ba Fares', logo: 'ba-fares', bg: '#f2c63e', kind: tt('Rabat, depuis 1957'), svc: ['site'], url: 'https://bafares.pages.dev' },
  { name: 'Chez Pino', logo: 'chez-pino', bg: '#ffffff', kind: tt('Restaurant italien, Hay Riad'), svc: ['site'], url: 'https://chezpino.ma' },
  { name: 'Moë Tea Room', logo: 'moe', bg: '#1c1c1c', kind: tt('Salon de thé, Rabat'), svc: ['site'], url: 'https://moetearoom.pages.dev' },
];
---
<section class="mx-auto max-w-6xl px-4 pb-6 pt-14 sm:px-6 md:pt-20">
  <div class="max-w-2xl">
    <h2 class="text-[2.2rem] leading-[0.95] sm:text-5xl">{tt('Ils travaillent déjà avec nous')}</h2>
    <p class="mt-3 text-muted md:text-lg">{tt('Des cafés, restaurants et salons de thé qui nous confient leur caisse, leur menu QR ou leur site.')}</p>
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
    {clients.map((c, i) => {
      const inner = (
        <>
          <span class={`block overflow-hidden ${i === 0 ? 'aspect-[2/1] md:aspect-square' : 'aspect-square'} rounded-[1.1rem] ring-1 ring-line/70`} style={`background:${c.bg}`}>
            <img src={`/img/clients/${c.logo}.webp`} alt={c.name} width="440" height="440" loading="lazy" decoding="async" class={`size-full transition ${c.fit === 'contain' ? 'object-contain p-[6%]' : 'object-cover'} duration-300 group-hover:scale-[1.04]`} />
          </span>
          <span class="mt-3 block px-1">
            <span class="flex items-baseline justify-between gap-2">
              <span class="font-bold leading-tight">{c.name}</span>
              {c.url && <span class="shrink-0 text-sm font-semibold text-green-deep" aria-hidden="true"><span class="inline-block transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 rtl:-scale-x-100">↗</span></span>}
            </span>
            <span class="mt-0.5 block text-sm text-muted">{c.kind}</span>
            {c.svc.length > 0 && (
              <span class="mt-2 flex flex-wrap gap-1.5">
                {c.svc.map(s => <span class="rounded-full bg-mint px-2.5 py-0.5 text-xs font-semibold text-green-deep">{SVC[s]}</span>)}
              </span>
            )}
          </span>
        </>
      );
      return (
        <li class={i === 0 ? 'col-span-2 md:col-span-1' : ''}>
          {c.url
            ? <a href={c.url} target="_blank" rel="noopener" class="group block rounded-[1.4rem] bg-paper p-2.5 ring-1 ring-line transition hover:-translate-y-1 hover:ring-green/60" aria-label={`${c.name}, ${tt('voir le site')}`}>{inner}</a>
            : <div class="group block h-full rounded-[1.4rem] bg-paper p-2.5 ring-1 ring-line">{inner}</div>}
        </li>
      );
    })}
  </ul>
</section>
