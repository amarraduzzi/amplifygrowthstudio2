---
// "Pour qui": the trades Amplify serves today, each to the page that speaks its language.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
import { ROUTES, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(langOf(Astro.url));
const items = [
  { icon: 'cup', t: tt('Cafés et salons de thé'), p: tt('Caisse rapide, menu QR, fidélité.'), href: ROUTES.restaurants[lang] },
  { icon: 'chef', t: tt('Restaurants'), p: tt('Tables, cuisine, marges par plat.'), href: ROUTES.restaurants[lang] },
  { icon: 'cake', t: tt('Pâtisseries et boulangeries'), p: tt('Préparations, production du jour, vente au kilo.'), href: ROUTES.bakery[lang] },
  { icon: 'briefcase', t: tt('Traiteurs'), p: tt('Devis, acomptes, facture avec ICE.'), href: `${ROUTES.bakery[lang]}#traiteur` },
] as const;
---
<section class="mx-auto max-w-6xl px-4 pb-8 pt-4 sm:px-6">
  <h2 class="text-[2.2rem] leading-[0.95] sm:text-5xl">{tt('Pour qui ?')}</h2>
  <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {items.map(it => (
      <a href={it.href} class="group flex flex-col rounded-[1.5rem] bg-paper p-5 ring-1 ring-line transition hover:-translate-y-1 hover:ring-green/60">
        <span class="grid size-12 place-items-center rounded-2xl bg-navy text-green"><Icon name={it.icon} class="size-6" /></span>
        <span class="mt-4 text-lg font-bold leading-tight">{it.t}</span>
        <span class="mt-1 flex-1 text-muted">{it.p}</span>
        <span class="mt-3 font-semibold text-green-deep" aria-hidden="true"><span class="inline-block transition-transform group-hover:translate-x-1 rtl:rotate-180 rtl:group-hover:-translate-x-1">→</span></span>
      </a>
    ))}
  </div>
</section>
