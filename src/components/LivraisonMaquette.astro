---
// Livraison, hero "Le Parcours": one scroll-driven story told in six photographs (public/img/livraison/1..6.webp, AI-made, no text in them).
// The picture is pinned while five sentences scroll past; the photo changes with the sentence and drifts in slowly. Wide street first and last.
// Photos: 1 street at blue hour, 2 the customer, 3 the restaurant, 4 the till, 5 the scooter, 6 the door and the code. The green in each photo is the order.
// Restaurant name, order and code are examples. No percentage and no price are stated: only "0 DH commission on your orders".
// No JavaScript / reduced motion: the same five sentences as a plain page (class mq--static); the pinned mode is class mq--pin.
import { tr } from '../i18n/t';
import type { Lang } from '../i18n/routes';
import { waLink } from '../config';
import BxArrow from './BxArrow.astro';
interface Props { lang: Lang; wa: string }
const { lang, wa } = Astro.props;
const tt = tr(lang);
const beats = [
  ['Bssaha', 'Vos clients vous trouvent.', 'Un annuaire où l’on commande sans commission.'],
  ['Votre site', 'Ils commandent chez vous.', 'Sous votre nom, par lien ou QR code. Pas de place de marché.'],
  ['Votre caisse', 'La commande arrive seule.', 'Rien à retaper : l’adresse et le numéro du client sont déjà là.'],
  ['Votre transport', 'Le vôtre, ou le nôtre.', 'Vous choisissez à chaque commande.'],
  ['Le code de remise', 'Remise prouvée.', 'Le client donne son code à 4 chiffres au livreur. Exemple : 4827.'],
] as const;
// picture shown with each of the 7 screens (intro, five steps, end) and where to keep the subject in view on a tall phone screen
const shots = [[1, '50%'], [2, '70%'], [3, '50%'], [4, '38%'], [5, '60%'], [6, '52%'], [1, '50%']] as const;
const src = (n: number) => `/img/livraison/${n}-800.webp 800w, /img/livraison/${n}-1376.webp 1376w`;
const imgs = [['1', '50% 50%'], ['2', '74% 50%'], ['3', '55% 50%'], ['4', '38% 60%'], ['5', '62% 50%'], ['6', '52% 50%']] as const;
---
<section class="mq" id="mq">
  <div class="mq-pin">
    <div class="mq-stage" aria-hidden="true">{shots.map(([n, pos], k) => <img class="mq-ph" src={`/img/livraison/${n}-1376.webp`} srcset={src(n)} sizes="100vw" alt="" width="1376" height="768" style={`--pos:${pos}`} loading={k < 2 ? 'eager' : 'lazy'} decoding="async" fetchpriority={k === 0 ? 'high' : 'auto'} />)}</div>
    <div class="mq-shade" aria-hidden="true"></div>
    <div class="mq-ui">
      <div class="mq-b on" data-k="0">
        <p class="bx-badge"><span class="bx-dot"></span><span class="font-dot text-sm tracking-widest">{tt('Amplify Livraison')}</span></p>
        <h1 class="bx-h1 lv-h1 mq-h1"><span class="l1">{tt('Votre livraison,')}</span><span class="block">{tt('sans passer par les apps de livraison.')}</span></h1>
        <p class="mq-sm mq-lead">{tt('Vos clients commandent chez vous. La commande arrive dans votre caisse. Un livreur est demandé en un clic. Tout est entre vos mains, de la commande à la remise.')}</p>
        <div class="mq-cta">
          <a href={waLink(wa)} target="_blank" rel="noopener" data-wa="livraison-hero" class="bx-btn bx-btn--go" data-mag>{tt('Parler de ma livraison')}<BxArrow /></a>
        </div>
        <span class="mq-hint font-dot" aria-hidden="true">{tt('Faites défiler')}<i></i></span>
      </div>
      {beats.map(([label, big, small], i) => (
        <div class="mq-b" data-k={i + 1}>
          <img class="mq-inl" src={`/img/livraison/${shots[i + 1][0]}-800.webp`} alt="" width="800" height="446" loading="lazy" decoding="async" />
          <p class="lv-lab"><b class="font-dot">{`0${i + 1}`}</b><span>{tt(label)}</span><i></i></p>
          <p class="mq-big">{tt(big)}</p>
          <p class="mq-sm">{tt(small)}</p>
        </div>
      ))}
      <div class="mq-b" data-k="6">
        <p class="mq-zero" dir="ltr"><span>0</span><small>DH</small></p>
        <p class="mq-big mq-big--s">{tt('de commission sur vos commandes.')}</p>
        <p class="mq-sm">{tt('Votre client. Votre caisse. Votre livreur.')}</p>
        <div class="mq-cta">
          <a href={waLink(wa)} target="_blank" rel="noopener" data-wa="livraison-hero-end" class="bx-btn bx-btn--go" data-mag>{tt('Parler de ma livraison')}<BxArrow /></a>
          <a href="#parcours" class="bx-btn bx-btn--ghost" data-mag>{tt('Voir le parcours')}</a>
        </div>
      </div>
    </div>
    <ol class="mq-rail" aria-hidden="true">{[0, 1, 2, 3, 4].map(i => <li data-i={i}></li>)}</ol>
  </div>
  <p class="sr-only">{tt('Une commande part de votre client, arrive dans votre caisse, est livrée par votre livreur et remise avec un code. Aucune commission.')}</p>
</section>
<script is:inline>
  (function () {
    var n = document.getElementById('mq');
    if (!n || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    n.classList.add('mq--pin');
  })();
</script>
<script>
  // @ts-nocheck
  const root = document.getElementById('mq');
  if (root && root.classList.contains('mq--pin')) {
    const pin = root.querySelector('.mq-pin');
    const imgs = [...root.querySelectorAll('.mq-ph img')];
    const blocks = [...root.querySelectorAll('.mq-b')], rail = [...root.querySelectorAll('.mq-rail li')];
    // sentence -> photo (the last sentence returns to the wide street) and where each sentence starts and ends in the scroll
    const IMG = [0, 1, 2, 3, 4, 5, 0], B = [0, 0.12, 0.26, 0.5, 0.62, 0.84, 0.94, 1];
    let beat = -1, queued = false;
    const clamp = (x, a, b) => Math.min(b, Math.max(a, x));
    const upd = () => {
      queued = false;
      const r = root.getBoundingClientRect(), hdr = parseFloat(getComputedStyle(pin).top) || 0, run = r.height - pin.clientHeight;
      const p = run > 0 ? clamp((hdr - r.top) / run, 0, 1) : 0;
      let b = 0; while (b < 6 && p >= B[b + 1]) b++;
      const t = clamp((p - B[b]) / (B[b + 1] - B[b]), 0, 1);
      imgs.forEach((im, k) => { const on = k === IMG[b]; if (on) im.style.setProperty('--z', (1.03 + 0.07 * (b === 6 ? 1 - t : t)).toFixed(4)); if (im.classList.contains('on') !== on) im.classList.toggle('on', on); });
      if (b !== beat) { beat = b; blocks.forEach((e, k) => e.classList.toggle('on', k === b)); rail.forEach((e, k) => e.classList.toggle('on', k < b || b === 6)); }
    };
    const q = () => { if (!queued) { queued = true; requestAnimationFrame(upd); } };
    addEventListener('scroll', q, { passive: true }); addEventListener('resize', q); upd();
  }
</script>
<style is:global>
  /* static layout (no JS, no WebGL, reduced motion): five sentences on navy. */
  .mq { position: relative; background: #00101f; color: #fff; }
  .mq-pin { position: relative; padding: 3.5rem 1.25rem 4.5rem; }
  .mq-stage, .mq-shade, .mq-rail { display: none; }
  .mq-inl { display: block; width: 100%; max-width: 34rem; height: auto; border-radius: .5rem; margin-bottom: .6rem; }
  .mq-ui { display: grid; gap: 4.5rem; max-width: 42rem; margin-inline: auto; }
  .mq-b { display: grid; gap: 1.1rem; align-content: start; justify-items: start; }
  .mq-big { margin: 0; font-weight: 800; font-stretch: 62%; text-transform: uppercase; line-height: .92; letter-spacing: 0; font-size: clamp(2.7rem, 11.5vw, 4.6rem); color: #fff; text-wrap: balance; }
  .mq-big--s { font-size: clamp(1.9rem, 7.5vw, 3rem); }
  .mq-sm { margin: 0; max-width: 27rem; font-size: 1.05rem; line-height: 1.5; color: rgb(255 255 255 / .7); }
  .mq-lead { max-width: 30rem; }
  .mq-zero { margin: 0; display: flex; align-items: flex-end; gap: .12em; font-weight: 800; font-stretch: 62%; line-height: .78; font-size: clamp(8rem, 34vw, 12rem); color: var(--gl); }
  .mq-zero small { font-size: .15em; font-stretch: 100%; letter-spacing: .08em; padding-bottom: .4em; color: #fff; }
  .mq-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .6rem; }
  .mq-hint { display: inline-flex; align-items: center; gap: .8rem; margin-top: 1.4rem; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: rgb(255 255 255 / .55); }
  .mq-hint i { display: block; width: 1px; height: 2.4rem; background: linear-gradient(var(--gl), transparent); transform-origin: top; animation: mq-hint 2.2s ease-in-out infinite; }
  @keyframes mq-hint { 0%, 100% { transform: scaleY(.3); opacity: .4; } 50% { transform: scaleY(1); opacity: 1; } }
  [dir="rtl"] .mq-big { font-stretch: 100%; text-transform: none; line-height: 1.18; }
  [dir="rtl"] .mq-hint { letter-spacing: 0; }
  .mq--static .mq-hint, .mq--static .mq-b[data-k="0"] .mq-cta { display: none; }

  /* pinned mode: the picture is held while the five sentences scroll past */
  .mq--pin { height: 600vh; height: 600svh; }
  .mq--pin .mq-inl { display: none; }
  .mq--pin .mq-pin { position: sticky; top: 4.1rem; height: calc(100vh - 4.1rem); height: calc(100svh - 4.1rem); padding: 0; overflow: hidden; }
  .mq--pin .mq-stage { display: block; position: absolute; inset: 0; overflow: hidden; background: #00101f; }
  .mq-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50%) 50%; opacity: 0; visibility: hidden; transform-origin: 50% 60%; will-change: transform, opacity; }
  .mq-ph:first-child { opacity: 1; visibility: visible; }
  .mq--pin .mq-shade { display: block; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, #00101f 0%, rgb(0 16 31 / .88) 34%, rgb(0 16 31 / 0) 64%), linear-gradient(#00101f 0%, transparent 12%); }
  .mq--pin .mq-ui { position: absolute; inset: 0; max-width: none; margin: 0; padding: 0 1.25rem 4.2rem; display: grid; align-items: end; gap: 0; }
  .mq--pin .mq-b { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(16px); pointer-events: none; transition: opacity .5s ease, transform .7s cubic-bezier(.2, .8, .2, 1), visibility 0s linear .5s; }
  .mq--pin .mq-b.on { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition-delay: 0s; }
  .mq--pin .mq-rail { display: flex; position: absolute; inset-inline: 1.25rem; bottom: 1.4rem; gap: .4rem; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .mq-rail li { flex: 1; height: 2px; background: rgb(255 255 255 / .2); transition: background .5s; }
  .mq-rail li.on { background: var(--gl); }
  .mq--pin .mq-h1 { font-size: clamp(2.5rem, 11vw, 3.6rem); }
  @media (max-height: 640px) and (max-width: 1023px) { .mq--pin .mq-lead { display: none; } }
  @media (min-width: 1024px) {
    .mq--pin { --mq-pad: max(2rem, calc((100vw - 80rem) / 2 + 1.5rem)); }
    .mq--pin .mq-ph { inset-inline-start: 34%; -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%); mask-image: linear-gradient(90deg, transparent 0%, #000 30%); }
    [dir="rtl"] .mq--pin .mq-ph { -webkit-mask-image: linear-gradient(270deg, transparent 0%, #000 30%); mask-image: linear-gradient(270deg, transparent 0%, #000 30%); }
    .mq--pin .mq-shade { background: linear-gradient(#00101f 0%, transparent 10%, transparent 90%, #00101f 100%); }
    .mq--pin .mq-ui { inset-inline-end: auto; width: min(48rem, 52%); padding: 0 2rem 0 var(--mq-pad); align-items: center; }
    [dir="rtl"] .mq--pin .mq-ui { padding: 0 var(--mq-pad) 0 2rem; }
    .mq--pin .mq-rail { inset-inline: var(--mq-pad) auto; width: min(24rem, 36%); bottom: 2.2rem; }
    .mq-big { font-size: clamp(3.6rem, 6.2vw, 6rem); }
    .mq-big--s { font-size: clamp(2.2rem, 3.4vw, 3.2rem); }
    .mq-zero { font-size: clamp(11rem, 19vw, 18rem); }
    .mq--pin .mq-h1 { font-size: clamp(3.4rem, 5.4vw, 5.6rem); }
    .mq-sm { font-size: 1.15rem; }
  }
</style>
