---
// A looping illustration of the waiting queue: when a hairdresser presses "Suivant" the next client takes the
// chair, the queue moves up and the estimate is recalculated. Invented first names, no real salon, and the
// estimate is always a range. With reduced motion the first state stays still.
const chairs = [['Salma', 'Hamza', 0.55], ['Imane', 'Leila', 0.3], ['Youssef', 'Rachid', 0.8]] as const;
const queue = [['Sanaa', 'qr'], ['Karim', 'door'], ['Maryam', 'qr'], ['Anas', 'door']] as const;
---
<div class="sl-nq mt-14 rounded-[2rem] bg-white/[0.06] p-5 ring-1 ring-white/15 md:p-8" data-nq>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">Voyez la file avancer.</p>
    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70 ring-1 ring-white/15">Exemple d’illustration</span>
  </div>
  <p class="sr-only">Illustration : la file avance chaque fois qu’un coiffeur appuie sur Suivant, et l’attente estimée se recalcule.</p>

  <div class="mt-7 grid gap-6 md:grid-cols-2 md:gap-8" aria-hidden="true">
    <div>
      <p class="text-sm font-semibold text-green">Au fauteuil</p>
      <ul class="mt-3 space-y-3">
        {chairs.map(([who, client, p]) => (
          <li class="flex items-center gap-3 rounded-2xl bg-white/[0.07] p-3 ring-1 ring-white/10" data-c data-p={p}>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-green text-sm font-bold text-navy">{who[0]}</span>
            <div class="min-w-0 flex-1">
              <p class="flex items-center justify-between gap-2"><span class="text-xs text-white/55">{who}</span><span class="sl-next rounded-full bg-white/15 px-2.5 py-0.5 text-[0.7rem] font-semibold text-white/80">Suivant</span></p>
              <p class="sl-cl truncate font-semibold" data-client>{client}</p>
              <span class="mt-1.5 block h-1.5 overflow-hidden rounded-full bg-white/10"><i class="sl-fill block h-full origin-left rounded-full bg-green rtl:origin-right" style={`transform:scaleX(${p})`}></i></span>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <p class="text-sm font-semibold text-green">En attente</p>
        <p class="flex items-center gap-2 text-sm text-white/65"><span class="sl-live size-2.5 rounded-full bg-green"></span>Attente estimée</p>
      </div>
      <p class="display mt-1 text-4xl text-green tabular-nums sm:text-5xl" data-wait>25 à 40 min</p>
      <ul class="relative mt-4 h-[16.25rem]" data-queue>
        {queue.map(([name, tag], i) => (
          <li class="sl-q absolute inset-x-0 top-0 flex h-[2.85rem] items-center gap-3 rounded-xl bg-white/10 px-3 ring-1 ring-white/10" style={`--i:${i}`} data-q>
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-white/15 text-xs font-bold" data-n>{i + 1}</span>
            <span class="font-semibold" data-name>{name}</span>
            <span class="ms-auto text-xs text-white/55" data-tag>{tag === 'qr' ? 'Via le QR' : 'Sur place'}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- texts the script reuses, so the English and Arabic pages translate them too -->
  <span hidden data-fmt>{'{a} à {b} min'}</span>
  <span hidden data-tag-qr>Via le QR</span>
  <span hidden data-tag-door>Sur place</span>
</div>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-nq]').forEach((root) => {
    if (still || !('IntersectionObserver' in window)) return;
    const txt = (s: string) => root.querySelector<HTMLElement>(s)?.textContent?.trim() ?? '';
    const fmt = txt('[data-fmt]') || '{a} à {b} min';
    const tags = { qr: txt('[data-tag-qr]'), door: txt('[data-tag-door]') };
    const waitEl = root.querySelector<HTMLElement>('[data-wait]')!;
    const list = root.querySelector<HTMLElement>('[data-queue]')!;
    const durs = [7500, 9500, 8500];
    const chairs = [...root.querySelectorAll<HTMLElement>('[data-c]')].map((el, i) => ({
      el, busy: false, dur: durs[i], start: -Number(el.dataset.p) * durs[i],
      client: el.querySelector<HTMLElement>('[data-client]')!,
      fill: el.querySelector<HTMLElement>('.sl-fill')!,
      next: el.querySelector<HTMLElement>('.sl-next')!,
    }));
    const tmpl = list.querySelector<HTMLElement>('[data-q]')!.cloneNode(true) as HTMLElement;
    let q = [...list.querySelectorAll<HTMLElement>('[data-q]')].map((el) => ({ el, name: el.querySelector('[data-name]')!.textContent!.trim() }));
    const pool = ['Hicham', 'Khadija', 'Adil', 'Nada', 'Reda', 'Ghita', 'Omar', 'Salwa', 'Yassine', 'Dounia'];
    let next = 0, door = false, clock = 0, visible = false;

    const layout = () => q.forEach((it, i) => { it.el.style.setProperty('--i', String(i)); it.el.querySelector('[data-n]')!.textContent = String(i + 1); });
    const estimate = () => {
      const w = (q.length / chairs.length) * 25;
      const lo = Math.max(5, Math.round((w - 7) / 5) * 5), hi = Math.round((w + 7) / 5) * 5;
      const t = fmt.replace('{a}', String(lo)).replace('{b}', String(hi));
      if (t === waitEl.textContent) return;
      waitEl.textContent = t; waitEl.classList.remove('sl-bump'); void waitEl.offsetWidth; waitEl.classList.add('sl-bump');
    };
    const arrive = () => {
      const el = tmpl.cloneNode(true) as HTMLElement;
      const name = pool[next++ % pool.length]; door = !door;
      el.querySelector('[data-name]')!.textContent = name;
      el.querySelector('[data-tag]')!.textContent = door ? tags.door : tags.qr;
      el.classList.add('sl-enter'); list.appendChild(el);
      q.push({ el, name }); layout();
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('sl-enter')));
    };
    const promote = (c: (typeof chairs)[number]) => {
      const it = q.shift();
      if (it) {
        c.client.textContent = it.name; c.client.classList.remove('sl-swap'); void c.client.offsetWidth; c.client.classList.add('sl-swap');
        it.el.classList.add('sl-leave'); setTimeout(() => it.el.remove(), 550);
      }
      if (q.length < 5 && (q.length < 3 || Math.random() < 0.6)) arrive();
      layout(); estimate();
      c.dur = 7000 + Math.random() * 4000; c.start = clock;
      c.fill.style.transition = 'none'; c.fill.style.transform = 'scaleX(0)'; void c.fill.offsetWidth; c.fill.style.transition = '';
    };
    const tick = () => {
      if (!visible || document.hidden) return;
      clock += 250;
      chairs.forEach((c) => {
        const k = Math.max(0, Math.min(1, (clock - c.start) / c.dur));
        if (!c.busy) c.fill.style.transform = `scaleX(${k})`;
        if (k >= 1 && !c.busy) {
          c.busy = true; c.next.classList.add('pressed');
          setTimeout(() => { c.next.classList.remove('pressed'); promote(c); c.busy = false; }, 450);
        }
      });
    };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.25 }).observe(root);
    setInterval(tick, 250);
  });
</script>
