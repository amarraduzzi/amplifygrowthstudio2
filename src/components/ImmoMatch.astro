---
// Agencies: a property comes in and the clients looking for it light up, each with a WhatsApp button that
// shows the message ready to send. Plays once when it comes into view; every button works.
// Demo property and clients (illustration photo).
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
const clients: [string, string, boolean][] = [
  ['Yasmine B.', tt('3 ch., Agdal ou Hay Riad, jusqu’à 1,6 M DH'), true],
  ['Karim E.', tt('Villa avec piscine, Harhoura'), false],
  ['Famille Tazi', tt('3 ch. avec balcon, Agdal, 1,3 à 1,5 M DH'), true],
  ['Omar L.', tt('Studio meublé à louer, Hay Riad'), false],
  ['Salma R.', tt('Appartement familial, Rabat centre ou Agdal'), true],
];
---
<div class="im grid min-w-0 grid-cols-1 gap-4" data-match>
  <!-- the property that comes in -->
  <div class="im-prop grid grid-cols-1 overflow-hidden rounded-[1.6rem] bg-white text-navy shadow-[0_40px_70px_-40px_rgba(0,30,62,.6)] ring-1 ring-line sm:grid-cols-[0.9fr_1.1fr]">
    <div class="relative aspect-[16/10] sm:aspect-auto">
      <img src="/img/immo/agdal-salon.webp" alt={tt('Salon lumineux d’un appartement à Agdal')} width="900" height="672" loading="lazy" class="size-full object-cover sm:absolute sm:inset-0" />
      <span class="absolute start-3 top-3 rounded-full bg-green px-2.5 py-1 text-xs font-bold text-navy">{tt('Nouveau bien')}</span>
    </div>
    <div class="p-4">
      <p class="font-bold">{tt('Appartement 3 chambres, Agdal')}</p>
      <p class="mt-1 text-sm text-muted">{tt('128 m², balcon, 4e étage')}</p>
      <p class="display mt-2 whitespace-nowrap text-2xl tabular-nums sm:text-3xl" dir="ltr">1 450 000 DH</p>
      <button type="button" class="mt-3 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-navy px-4 font-bold text-white transition-transform active:scale-[.98] disabled:opacity-40" data-add><Icon name="search" class="size-4" />{tt('Trouver les clients')}</button>
    </div>
  </div>
  <!-- the clients -->
  <div class="rounded-[1.6rem] bg-white/[0.06] p-4 ring-1 ring-white/10">
    <p class="flex flex-wrap items-center justify-between gap-2 text-sm font-semibold"><span>{tt('Vos clients')}</span><span class="im-count shrink-0 rounded-full bg-green px-2.5 py-0.5 text-xs font-bold text-navy opacity-0 transition-opacity" data-count></span></p>
    <ul class="mt-3 space-y-2">
      {clients.map(([n, w, hit]) => (
        <li class="im-c rounded-xl bg-white/[0.06] px-3 py-2.5 ring-1 ring-white/10 transition-all duration-500" data-hit={String(hit)}>
          <div class="flex items-center gap-3">
            <span class="min-w-0 flex-1"><span class="block text-sm font-bold">{n}</span><span class="block truncate text-xs text-white/60">{w}</span></span>
            {hit && <button type="button" class="im-wa hidden min-h-9 shrink-0 items-center gap-1.5 rounded-full bg-green px-3 text-xs font-bold text-navy" data-name={n.split(' ')[0]}><Icon name="phone" class="size-3.5" />WhatsApp</button>}
          </div>
          {hit && <p class="im-msg mt-2 hidden rounded-xl rounded-ss-sm bg-[#DCF8C6] px-3 py-2 text-xs leading-relaxed text-navy" data-msg></p>}
        </li>
      ))}
    </ul>
    <span hidden data-t-n>{tt('{n} clients cherchent ce bien')}</span>
    <span hidden data-t-msg>{tt('Bonjour {name}, un appartement de 3 chambres vient d’arriver à Agdal, 1 450 000 DH. Photos et visite : atlas-immo.ma/P-AB12')}</span>
  </div>
</div>

<style is:global>
  .im-c.is-hit { background: rgb(5 185 98 / .16); box-shadow: inset 0 0 0 1px rgb(5 185 98 / .6); transform: translateX(4px); }
  [dir="rtl"] .im-c.is-hit { transform: translateX(-4px); }
  .im-c.is-miss { opacity: .35; }
  .im-c.is-hit .im-wa { display: inline-flex; animation: im-pop .5s cubic-bezier(.3,1.6,.5,1); }
  .im-msg:not(.hidden) { animation: im-in .4s ease-out; }
  .im-prop.is-new { animation: im-new .8s cubic-bezier(.3,1.4,.5,1); }
  @keyframes im-pop { from { transform: scale(.4); opacity: 0; } }
  @keyframes im-in { from { opacity: 0; transform: translateY(6px); } }
  @keyframes im-new { 0% { transform: translateY(-30px) rotate(-2deg); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .im-c.is-hit, .im-c.is-hit .im-wa, .im-msg, .im-prop.is-new { animation: none; transform: none; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-match]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('.im-c')];
    const add = root.querySelector<HTMLButtonElement>('[data-add]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const tN = root.querySelector('[data-t-n]')!.textContent ?? '', tM = root.querySelector('[data-t-msg]')!.textContent ?? '';
    let touched = false;
    const find = () => {
      add.disabled = true;
      rows.forEach((r, i) => setTimeout(() => r.classList.add(r.dataset.hit === 'true' ? 'is-hit' : 'is-miss'), still ? 0 : 180 * i));
      setTimeout(() => { count.textContent = tN.replace('{n}', String(rows.filter(r => r.dataset.hit === 'true').length)); count.style.opacity = '1'; }, still ? 0 : 180 * rows.length);
    };
    const write = (b: HTMLButtonElement) => {
      const m = b.closest('li')!.querySelector<HTMLElement>('[data-msg]')!;
      m.textContent = tM.replace('{name}', b.dataset.name ?? ''); m.classList.toggle('hidden');
    };
    add.addEventListener('click', () => { touched = true; find(); });
    root.querySelectorAll<HTMLButtonElement>('.im-wa').forEach(b => b.addEventListener('click', () => { touched = true; write(b); }));
    if (!still && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return; io.disconnect();
        root.querySelector('.im-prop')!.classList.add('is-new');
        setTimeout(() => { if (!touched) find(); }, 1400);
        setTimeout(() => { if (!touched) write(root.querySelector<HTMLButtonElement>('.im-wa')!); }, 3000);
      }, { threshold: 0.4 });
      io.observe(root);
    }
  });
</script>
