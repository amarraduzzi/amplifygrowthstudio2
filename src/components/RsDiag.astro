---
// "Qu'est-ce qui vous coûte le plus ?" The visitor taps their problems; the plan builds itself on the
// right, in the order that usually pays back first, with the tool for each step. The selection is also
// sent with the WhatsApp message (here and in the final card).
import { rsOf } from '../i18n/content';
import { tr, langOf } from '../i18n/t';
const LG = langOf(Astro.url);
const tt = tr(LG);
const c = rsOf(LG);
import { ROUTES, type Lang } from '../i18n/routes';
import { waLink, signupUrl, OFFER } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = c.diag;
const P = { pos: ['Amplify POS', 'bg-blue text-white', ROUTES.pos[lang]], profit: ['Amplify Profit', 'bg-green text-navy', ROUTES.profit[lang]], site: ['Amplify Site', 'bg-white text-navy', ROUTES.site[lang]], marketing: ['Amplify Clients', 'bg-[#F5B301] text-navy', ROUTES.marketing[lang]] } as const;
// where the plan starts: the first product of the plan, its price and the way in
const START = {
  pos: { name: 'Amplify POS', price: tt('dès 199 DH HT / mois'), href: signupUrl(lang, 'pos'), cta: tt('Essayer 14 jours gratuits') },
  profit: { name: 'Amplify Profit', price: tt('dès 249 DH HT / mois'), href: signupUrl(lang, 'profit'), cta: tt('Essayer 14 jours gratuits') },
  site: { name: 'Amplify Site', price: `${OFFER.siteSetup} DH ${tt('une fois, puis')} ${OFFER.siteMonthly} DH / ${tt('mois')}`, href: ROUTES.site[lang], cta: tt('Voir l’offre à 250 DH') },
  marketing: { name: 'Amplify Clients', price: tt('sur devis'), href: ROUTES.marketing[lang], cta: tt('Voir Amplify Clients') },
};
const pre = ['marge', 'commandes'];
---
<section id="diagnostic" class="scroll-mt-20 border-y border-line bg-paper" data-rsdiag data-wa={c.wa} data-cost={tt('Ce qui me coûte le plus :')}>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="text-sm font-semibold text-green-deep">{d.kicker}</p>
    <h2 class="mt-2 text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{d.h2a}</span><span class="block text-green-deep">{d.h2b}</span></h2>
    <p class="mt-4 max-w-xl text-lg text-muted">{d.p}</p>

    <a href="#rd-plan" class="rd-jump sticky top-[4.6rem] z-20 mt-8 flex w-fit items-center gap-2 rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white shadow-lg lg:hidden"><span class="rd-n2 display text-lg text-green">0</span> étape(s) · Voir mon plan ↓</a>
    <div class="mt-6 grid gap-8 lg:mt-12 lg:grid-cols-[1fr_1fr] lg:gap-12">
      <!-- the problems -->
      <ul class="grid content-start gap-2.5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {d.pains.map(x => (
          <li>
            <button type="button" class="rd-pain group flex w-full items-center gap-3 rounded-2xl bg-white p-4 text-start ring-1 ring-line transition-all duration-300 hover:-translate-y-0.5 hover:ring-navy" aria-pressed={pre.includes(x.k) ? 'true' : 'false'} data-k={x.k}>
              <span class="rd-box grid size-6 shrink-0 place-items-center rounded-lg ring-2 ring-line transition-colors"><svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg></span>
              <span class="font-semibold leading-snug">{x.t}</span>
            </button>
          </li>
        ))}
      </ul>

      <!-- the plan -->
      <div id="rd-plan" class="scroll-mt-24 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[2rem] bg-navy p-6 text-white shadow-[0_40px_80px_-40px_rgba(0,30,62,0.6)] sm:p-8">
          <div class="flex items-center justify-between">
            <p class="display text-3xl">{d.plan}</p>
            <p class="text-sm text-white/60"><span class="rd-n display text-2xl text-green">0</span> étape(s)</p>
          </div>
          <ol class="rd-plan relative mt-6 space-y-3">
            {d.pains.slice().sort((a, b) => a.o - b.o).map(x => (
              <li class="rd-step hidden" data-k={x.k} data-p={x.p}>
                <div class="flex gap-4 rounded-2xl bg-white/[0.06] p-4 ring-1 ring-white/10">
                  <span class="rd-num display grid size-10 shrink-0 place-items-center rounded-full bg-white text-xl text-navy">1</span>
                  <div class="min-w-0">
                    <p class="flex flex-wrap items-center gap-2"><span class="text-lg font-bold">{x.step}</span><a href={P[x.p][2]} class={`rounded-full px-2 py-0.5 text-xs font-bold ${P[x.p][1]}`}>{P[x.p][0]}</a></p>
                    <p class="mt-1 text-sm text-white/70">{x.d}</p>
                  </div>
                </div>
              </li>
            ))}
          </ol>
          <p class="rd-empty hidden rounded-2xl border-2 border-dashed border-white/20 p-6 text-center text-white/60">{d.empty}</p>
          <!-- the first step, ready to start -->
          {Object.entries(START).map(([k, v]) => (
            <div class="rd-start mt-6 hidden rounded-2xl bg-green p-5 text-navy" data-p={k}>
              <p class="text-sm font-semibold">{tt('Commencez par')}</p>
              <p class="display mt-1 text-3xl">{v.name}</p>
              <p class="text-sm font-semibold text-navy/75">{v.price}</p>
              <a href={v.href} class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-full bg-navy px-5 font-semibold text-white transition-transform hover:scale-[1.03]">{v.cta}<span aria-hidden="true" class="rtl:rotate-180">→</span></a>
            </div>
          ))}
          <a href={waLink(c.wa)} target="_blank" rel="noopener" data-wa="restaurants-diag" class="rd-send mt-4 flex min-h-12 items-center justify-center gap-2.5 rounded-full bg-white/10 px-6 font-semibold text-white ring-1 ring-white/20 transition-colors hover:bg-white/15">
            <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path fill="currentColor" d="M3 20.5 21 12 3 3.5 3 10l12 2-12 2z"/></svg>{d.send}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { waLink } from '../config';
  document.querySelectorAll<HTMLElement>('[data-rsdiag]').forEach((root) => {
    const pains = [...root.querySelectorAll<HTMLButtonElement>('.rd-pain')];
    const steps = [...root.querySelectorAll<HTMLElement>('.rd-step')];
    const send = root.querySelector<HTMLAnchorElement>('.rd-send')!;
    const base = root.dataset.wa!;
    const render = () => {
      const on = new Set(pains.filter(p => p.getAttribute('aria-pressed') === 'true').map(p => p.dataset.k));
      let n = 0;
      steps.forEach(s => {
        const show = on.has(s.dataset.k);
        const was = !s.classList.contains('hidden');
        s.classList.toggle('hidden', !show);
        if (show) { n++; s.querySelector('.rd-num')!.textContent = String(n); if (!was) { s.classList.remove('rd-in'); void s.offsetWidth; s.classList.add('rd-in'); } }
      });
      const first = steps.find(st => !st.classList.contains('hidden'))?.dataset.p;
      root.querySelectorAll<HTMLElement>('.rd-start').forEach(b => { const on2 = b.dataset.p === first; if (on2 && b.classList.contains('hidden')) { b.classList.remove('rd-in'); void b.offsetWidth; b.classList.add('rd-in'); } b.classList.toggle('hidden', !on2); });
      root.querySelector('.rd-n')!.textContent = String(n); root.querySelector('.rd-n2')!.textContent = String(n);
      root.querySelector('.rd-empty')!.classList.toggle('hidden', n > 0);
      send.classList.toggle('pointer-events-none', n === 0); send.classList.toggle('opacity-40', n === 0);
      const list = pains.filter(p => on.has(p.dataset.k)).map(p => `- ${p.textContent!.trim()}`);
      const text = list.length ? `${base}\n${root.dataset.cost}\n${list.join('\n')}` : base;
      send.href = waLink(text);
      document.dispatchEvent(new CustomEvent('rs-diag', { detail: { text, items: pains.filter(p => on.has(p.dataset.k)).map(p => p.textContent!.trim()) } }));
    };
    pains.forEach(p => p.addEventListener('click', () => { p.setAttribute('aria-pressed', String(p.getAttribute('aria-pressed') !== 'true')); render(); }));
    render();
    addEventListener('load', render);
  });
</script>
