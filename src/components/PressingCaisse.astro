---
// "Le dépôt. En trente secondes.", played for real: a small till (same articles and prices as the demo shop),
// a timer, an express switch, a photo, deposit or paid in full, and a printed ticket with its tags and a WhatsApp
// when you save. A ghost cursor shows it once when the section is seen; touch the till and it is your turn.
// The till stays in French, like the real product. Demo shop, invented names and amounts.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const lang = langOf(Astro.url);
const tt = tr(lang);
const LOC = lang === 'ar' ? 'ar-MA-u-nu-latn' : lang === 'en' ? 'en-GB' : 'fr-FR';
const KEYS = ['Touchez un article…', '{n} pièces', '{n} pièce', 'Reste {n} MAD', 'Chemise', 'Pantalon', 'Costume 2 pièces', 'Veste', 'Djellaba', 'Caftan', 'Couette', 'Manteau', 's'];
const L = Object.fromEntries(KEYS.map((k) => [k, tt(k)]));
const items = [['Chemise', 20], ['Pantalon', 25], ['Costume 2 pièces', 70], ['Veste', 45], ['Djellaba', 60], ['Caftan', 120], ['Couette', 90], ['Manteau', 60]] as const;
const feats = [
  ['shirt', 'Votre liste de prix', 'Chemise, costume, djellaba, caftan, couette : à la pièce, ou au kilo pour le linge.'],
  ['clock', 'Express et date prévue', 'Un supplément en pourcentage, et la date proposée toute seule.'],
  ['camera', 'Photos au dépôt', 'Une tache, un bouton manquant : photographiés avec la tablette, gardés avec le dépôt.'],
  ['coins', 'Acompte ou tout payé', 'Rien, un acompte ou tout : le reste à payer est sur le ticket.'],
  ['printer', 'Ticket et étiquettes', 'Le ticket avec son QR pour le client, une étiquette par pièce pour l’atelier.'],
  ['message', 'Ticket sur WhatsApp', 'Le client perd son ticket ? Il l’a aussi sur son téléphone.'],
] as const;
const qr = Array.from({ length: 49 }, (_, i) => { const r = Math.floor(i / 7), c = i % 7; const corner = (r < 3 && c < 3) || (r < 3 && c > 3) || (r > 3 && c < 3); return corner ? (r % 2 === 1 && c % 2 === 1 ? 0 : 1) : ((i * 7 + r * 3) % 5 < 2 ? 1 : 0); });
---
<section id="depot" class="ck relative isolate scroll-mt-20 overflow-hidden bg-navy text-white" data-tf data-ck data-l={JSON.stringify(L)} data-loc={LOC}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.35fr] lg:items-center lg:gap-12">
      <div class="tf-x">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Le dépôt.')}</span><span class="block text-green">{tt('En trente secondes.')}</span></h2>
        <p class="mt-5 max-w-md text-lg text-white/70">{tt('Le client au comptoir, ses vêtements sur la table. Vous touchez les articles, vous notez la tache, vous prenez la photo. Le ticket sort, les étiquettes aussi.')}</p>
        <p class="mt-4 flex items-center gap-2 text-sm font-semibold text-green"><span class="sl-live size-2 rounded-full bg-green"></span>{tt('À vous de jouer : touchez les articles.')}</p>
      </div>

      <div class="tf relative" style="--d:150ms">
        <div class="ck-till relative overflow-hidden rounded-[1.4rem] bg-[#06162b] p-[2.2%] text-white shadow-[0_50px_90px_-40px_rgba(0,0,0,.8)] ring-1 ring-white/15" style="font-size:clamp(11px,1.25vw,14px)" dir={lang === 'ar' ? 'rtl' : 'ltr'} lang={lang}>
          <div class="flex items-center justify-between gap-2 pb-[0.8em]">
            <p class="font-semibold">Pressing Démo <span class="text-white/45">· {tt('Caisse')}</span></p>
            <p class="flex items-center gap-[0.5em] rounded-full bg-white/10 px-[0.9em] py-[0.3em] font-semibold tabular-nums"><Icon name="clock" class="size-[1.1em] text-green" /><span class="ck-timer display text-[1.5em] leading-none" data-timer>0,0 s</span></p>
          </div>
          <div class="grid gap-[1em] sm:grid-cols-[1.25fr_1fr]">
            <div class="grid auto-rows-min grid-cols-2 gap-[0.6em] sm:grid-cols-3">
              {items.map(([n, p], k) => (
                <button type="button" class="ck-it relative rounded-[0.8em] bg-white/[0.07] p-[0.8em] text-start ring-1 ring-white/10 transition-colors hover:bg-white/15" data-item={k} data-p={p}>
                  <span class="ck-c absolute -end-[0.4em] -top-[0.4em] hidden size-[1.8em] place-items-center rounded-full bg-green font-bold text-navy" data-c></span>
                  <span class="block font-semibold leading-tight">{tt(n)}</span><span dir="ltr" class="mt-[0.5em] block text-[0.85em] text-white/50">{p} MAD</span>
                </button>
              ))}
            </div>
            <div class="flex flex-col gap-[0.6em] rounded-[0.9em] bg-white/[0.05] p-[0.8em] ring-1 ring-white/10">
              <p class="flex items-center justify-between text-white/50"><span>0612 345 678</span><span>Nadia</span></p>
              <ul class="ck-lines min-h-[5.5em] space-y-[0.4em]" data-lines><li class="text-white/35">{tt('Touchez un article…')}</li></ul>
              <div class="flex gap-[0.5em]">
                <button type="button" class="ck-ph flex items-center gap-[0.4em] rounded-[0.6em] bg-white/10 px-[0.8em] py-[0.5em] font-semibold ring-1 ring-white/10" data-photo><Icon name="camera" class="size-[1.1em]" />{tt('Photo')}<span class="ck-ph-t hidden size-[1.9em] rounded-[0.4em] bg-gradient-to-br from-white to-[#cdd6e0] ring-2 ring-green"><i class="block size-[0.5em] translate-x-[1.1em] translate-y-[0.4em] rounded-full bg-[#7a4a22]"></i></span></button>
                <button type="button" class="ck-ex rounded-[0.6em] bg-white/10 px-[0.8em] py-[0.5em] font-semibold ring-1 ring-white/10" data-express>{tt('Express +50 %')}</button>
              </div>
              <p class="flex items-center gap-[0.5em] text-white/60"><Icon name="calendar" class="size-[1.1em]" />{tt('Prêt le')} <b class="text-white" data-date>—</b></p>
              <div class="grid grid-cols-3 gap-[0.3em] rounded-[0.7em] bg-white/[0.06] p-[0.25em] text-center text-[0.9em] font-semibold">
                <button type="button" class="ck-pay rounded-[0.5em] py-[0.45em]" data-pay="0">{tt('Au retrait')}</button>
                <button type="button" class="ck-pay rounded-[0.5em] py-[0.45em]" data-pay="1">{tt('Acompte')}</button>
                <button type="button" class="ck-pay rounded-[0.5em] py-[0.45em]" data-pay="2">{tt('Tout payer')}</button>
              </div>
              <div class="mt-auto flex items-end justify-between border-t border-white/10 pt-[0.6em]"><span class="text-[0.85em] leading-tight text-white/55"><span data-n>{tt('{n} pièces').replace('{n}', '0')}</span><br /><span data-rest dir="ltr">{tt('Reste {n} MAD').replace('{n}', '0')}</span></span><span class="display text-[2.1em] leading-none tabular-nums" data-total dir="ltr">0 MAD</span></div>
              <button type="button" class="ck-save rounded-[0.8em] bg-green py-[0.8em] font-bold text-navy transition-opacity disabled:opacity-40" data-save disabled>{tt('Enregistrer le dépôt')}</button>
            </div>
          </div>

          <!-- the ghost hand -->
          <span class="ck-ghost pointer-events-none absolute left-0 top-0 z-30 hidden size-[2.6em] -translate-x-1/2 -translate-y-1/4 text-white drop-shadow-lg" data-ghost aria-hidden="true"><svg viewBox="0 0 24 24" class="size-full" fill="currentColor" stroke="#001E3E" stroke-width="1.2"><path d="M5 3l14 7-6 2-2 6z" /></svg></span>

          <!-- after saving: the ticket, the tags, the WhatsApp -->
          <div class="ck-done absolute inset-0 z-20 grid place-items-center bg-[#06162b]/92 p-[3%] backdrop-blur-sm" data-done aria-live="polite">
            <div class="grid w-full max-w-[46em] items-center gap-[1.2em] sm:grid-cols-[0.9fr_1.1fr]">
              <div class="ck-tk relative rounded-[0.8em] bg-[#FAF8F3] p-[1.1em] text-[#001E3E] shadow-2xl">
                <p class="flex items-center justify-between text-[0.85em] font-semibold text-black/55"><span>Pressing Démo</span><span data-date2>—</span></p>
                <p class="display mt-[0.3em] text-[2.6em] leading-none">N° 1042</p>
                <div class="mt-[0.8em] flex items-center gap-[0.9em]">
                  <div class="grid size-[5.2em] shrink-0 grid-cols-7 gap-px rounded-[0.4em] bg-white p-[0.2em]">{qr.map((v) => <i class={v ? 'bg-[#001E3E]' : 'bg-white'}></i>)}</div>
                  <p class="text-[0.85em] leading-snug text-black/60"><span data-n2>—</span><br />{tt('Reste à payer')}<br /><b dir="ltr" class="display text-[1.5em] text-[#001E3E]" data-rest2>0 MAD</b></p>
                </div>
              </div>
              <div class="space-y-[0.9em]">
                <div class="flex flex-wrap gap-[0.5em]" data-tags></div>
                <p class="ck-wa flex items-center gap-[0.6em] rounded-[1em] bg-white p-[0.7em] text-[#001E3E] shadow-lg"><span class="grid size-[2.2em] shrink-0 place-items-center rounded-full bg-[#25D366] text-white"><Icon name="message" class="size-[1.2em]" /></span><span class="leading-tight"><b class="block">WhatsApp → Nadia</b><span class="text-black/55">{tt('Votre dépôt N° 1042 est enregistré.')}</span></span></p>
                <p class="flex items-center justify-between gap-3"><span class="display text-[1.5em] leading-tight text-green">{tt('Dépôt enregistré en')} <span data-took>0</span> s</span><button type="button" class="rounded-full bg-white/10 px-[1em] py-[0.5em] font-semibold ring-1 ring-white/20 hover:bg-white/20" data-reset>{tt('Recommencer')}</button></p>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-3 text-center text-xs text-white/45">{tt('Exemple d’illustration')}</p>
      </div>
    </div>
    <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
          {feats.map(([i, h, x], k) => (
            <li class="ck-f flex items-start gap-3 rounded-2xl p-2.5 ring-1 ring-white/10" data-f={k}>
              <span class="ck-fi grid size-9 shrink-0 place-items-center rounded-xl bg-white/10 text-green ring-1 ring-white/15"><Icon name={i} class="size-4" /><Icon name="check" class="ck-ok size-4" /></span>
              <span><b class="block text-[0.95rem]">{tt(h)}</b><span class="ck-fx block text-[0.82rem] leading-snug text-white/60">{tt(x)}</span></span>
            </li>
          ))}
    </ul>
  </div>
</section>

<style is:global>
  .ck-ok { display: none; }
  .ck-f { transition: background-color .4s, box-shadow .4s; }
  .ck-f.on { background: rgba(5, 185, 98, .12); box-shadow: inset 0 0 0 1px rgba(5, 185, 98, .5); }
  .ck-f.on .ck-fi { background: #05B962; color: #001E3E; }
  .ck-f.on .ck-fi > svg:first-child { display: none; }
  .ck-f.on .ck-ok { display: block; animation: ck-pop .5s cubic-bezier(.3,1.6,.5,1) both; }
  @keyframes ck-pop { from { transform: scale(.3); } }
  .ck-it.has { background: rgba(5, 185, 98, .16); box-shadow: inset 0 0 0 1px rgba(5, 185, 98, .6); }
  .ck-it.has .ck-c { display: grid; animation: ck-pop .35s cubic-bezier(.3,1.6,.5,1) both; }
  .ck-ex.on, .ck-pay.on { background: #05B962; color: #001E3E; }
  .ck-ph.on { background: rgba(5, 185, 98, .2); box-shadow: inset 0 0 0 1px #05B962; }
  .ck-ph.on .ck-ph-t { display: inline-block; animation: ck-pop .4s both; }
  .ck-ph.flash::after { content: ""; position: absolute; inset: 0; background: #fff; opacity: 0; animation: ck-flash .5s; pointer-events: none; }
  .ck-till.flash::after { content: ""; position: absolute; inset: 0; z-index: 40; background: #fff; opacity: 0; animation: ck-flash .5s; pointer-events: none; }
  @keyframes ck-flash { 0% { opacity: .85; } 100% { opacity: 0; } }
  .ck-done { opacity: 0; visibility: hidden; transition: opacity .4s, visibility .4s; }
  .ck.done .ck-done { opacity: 1; visibility: visible; }
  .ck-tk { transform: translateY(40%) rotate(-3deg); opacity: 0; }
  .ck.done .ck-tk { animation: ck-print .9s .2s cubic-bezier(.2,.9,.3,1) both; }
  @keyframes ck-print { to { transform: rotate(-1.5deg); opacity: 1; } }
  .ck-tag { animation: ck-pop .45s cubic-bezier(.3,1.6,.5,1) both; }
  .ck-wa { opacity: 0; }
  .ck.done .ck-wa { opacity: 1; animation: chat-in .5s 1.5s both; }
  .ck-ghost.show { display: block; }
  .ck-ghost { transition: transform .8s cubic-bezier(.4,0,.2,1); }
  .ck-ghost.tap { scale: .85; }
  @media (prefers-reduced-motion: reduce) { .ck-ghost { transition: none; } .ck.done .ck-tk, .ck.done .ck-wa { animation: none; opacity: 1; transform: none; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let L: Record<string, string> = {}, LOCALE = 'fr-FR';
  const t = (k: string) => L[k] ?? k;
  const tf = (k: string, v: Record<string, string | number>) => t(k).replace(/\{(\w+)\}/g, (_, x) => String(v[x]));
  const ARTICLES = ['Chemise', 'Pantalon', 'Costume 2 pièces', 'Veste', 'Djellaba', 'Caftan', 'Couette', 'Manteau'];
  document.querySelectorAll<HTMLElement>('[data-ck]').forEach((root) => {
    L = JSON.parse(root.dataset.l || '{}'); LOCALE = root.dataset.loc || 'fr-FR';
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const till = $('.ck-till'), ghost = $('[data-ghost]');
    const qty = ARTICLES.map(() => 0);
    let express = false, photo = false, pay = 0, t0 = 0, raf = 0, ghosting = false, saved = false, token = 0;
    const timers: number[] = [];
    const fmt = (n: number) => `${Math.round(n)} MAD`;
    const feat = (k: number, on: boolean) => root.querySelector(`[data-f="${k}"]`)?.classList.toggle('on', on);
    const date = () => { const d = new Date(); d.setDate(d.getDate() + (express ? 1 : 2)); return d.toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit' }); };
    const sum = () => qty.reduce((a, q, k) => a + q * Number(root.querySelector<HTMLElement>(`[data-item="${k}"]`)!.dataset.p), 0) * (express ? 1.5 : 1);
    const pieces = () => qty.reduce((a, b) => a + b, 0);
    const paid = (total: number) => (pay === 2 ? total : pay === 1 ? Math.min(50, total) : 0);
    const tick = () => { $('[data-timer]').textContent = `${((performance.now() - t0) / 1000).toFixed(1).replace('.', LOCALE.startsWith('fr') ? ',' : '.')} ${t('s')}`; raf = requestAnimationFrame(tick); };
    const begin = () => { if (!t0) { t0 = performance.now(); raf = requestAnimationFrame(tick); } };
    const render = () => {
      const total = sum(), n = pieces();
      root.querySelectorAll<HTMLElement>('[data-item]').forEach((b, k) => { b.classList.toggle('has', qty[k] > 0); b.querySelector<HTMLElement>('[data-c]')!.textContent = String(qty[k]); });
      const lines = $('[data-lines]');
      lines.innerHTML = n ? qty.map((q, k) => q ? `<li class="flex justify-between"><span>${t(ARTICLES[k])} × ${q}</span><span dir="ltr" class="tabular-nums text-white/60">${fmt(q * Number(root.querySelector<HTMLElement>(`[data-item="${k}"]`)!.dataset.p) * (express ? 1.5 : 1))}</span></li>` : '').join('') : `<li class="text-white/35">${t('Touchez un article…')}</li>`;
      $('[data-total]').textContent = fmt(total);
      $('[data-n]').textContent = n > 1 ? tf('{n} pièces', { n }) : tf('{n} pièce', { n });
      $('[data-rest]').textContent = tf('Reste {n} MAD', { n: Math.round(total - paid(total)) });
      $('[data-date]').textContent = date();
      $('[data-express]').classList.toggle('on', express);
      $('[data-photo]').classList.toggle('on', photo);
      root.querySelectorAll<HTMLElement>('[data-pay]').forEach((b) => b.classList.toggle('on', Number(b.dataset.pay) === pay));
      ($('[data-save]') as HTMLButtonElement).disabled = !n;
      feat(0, n > 0); feat(1, express); feat(2, photo); feat(3, pay > 0);
    };
    const add = (k: number) => { begin(); qty[k]++; render(); };
    const toggleExpress = () => { begin(); express = !express; render(); };
    const takePhoto = () => { begin(); photo = true; till.classList.remove('flash'); void till.offsetWidth; till.classList.add('flash'); render(); };
    const setPay = (p: number) => { begin(); pay = p; render(); };
    const save = () => {
      if (!pieces() || saved) return;
      begin(); saved = true; cancelAnimationFrame(raf);
      const took = (performance.now() - t0) / 1000, total = sum(), n = pieces();
      $('[data-took]').textContent = String(Math.max(1, Math.round(took)));
      $('[data-date2]').textContent = date();
      $('[data-n2]').textContent = n > 1 ? tf('{n} pièces', { n }) : tf('{n} pièce', { n });
      $('[data-rest2]').textContent = fmt(total - paid(total));
      const tags = $('[data-tags]'); tags.innerHTML = '';
      for (let i = 1; i <= Math.min(n, 6); i++) { const s = document.createElement('span'); s.className = 'ck-tag rounded-[0.5em] bg-white px-[0.7em] py-[0.4em] font-bold text-[#001E3E]'; s.style.animationDelay = `${0.9 + i * 0.15}s`; s.innerHTML = `<span dir="ltr" class="rounded bg-[#001E3E] px-1 text-green">1042-${i}</span>`; tags.appendChild(s); }
      root.classList.add('done'); feat(4, true); feat(5, true);
    };
    const reset = () => {
      token++; timers.forEach(clearTimeout); cancelAnimationFrame(raf);
      qty.fill(0); express = photo = saved = ghosting = false; pay = 0; t0 = 0;
      ghost.classList.remove('show'); root.classList.remove('done');
      $('[data-timer]').textContent = `0${LOCALE.startsWith('fr') ? ',' : '.'}0 ${t('s')}`; render(); root.querySelectorAll('.ck-f').forEach((f) => f.classList.remove('on'));
    };
    // touch = your turn
    root.querySelectorAll<HTMLElement>('[data-item]').forEach((b) => b.addEventListener('click', () => { if (!ghosting) add(Number(b.dataset.item)); }));
    $('[data-express]').addEventListener('click', () => { if (!ghosting) toggleExpress(); });
    $('[data-photo]').addEventListener('click', () => { if (!ghosting) takePhoto(); });
    root.querySelectorAll<HTMLElement>('[data-pay]').forEach((b) => b.addEventListener('click', () => { if (!ghosting) setPay(Number(b.dataset.pay)); }));
    $('[data-save]').addEventListener('click', () => { if (!ghosting) save(); });
    $('[data-reset]').addEventListener('click', reset);
    till.addEventListener('pointerdown', (e) => { if (ghosting && e.isTrusted) { ghosting = false; ghost.classList.remove('show'); token++; timers.forEach(clearTimeout); reset(); } });
    render();
    if (still) return;

    // the ghost plays the drop-off once
    const plan: [string, () => void][] = [
      ['[data-item="0"]', () => add(0)], ['[data-item="0"]', () => add(0)], ['[data-item="2"]', () => add(2)], ['[data-item="4"]', () => add(4)],
      ['[data-express]', toggleExpress], ['[data-photo]', takePhoto], ['[data-pay="1"]', () => setPay(1)], ['[data-save]', save],
    ];
    const play = () => {
      const my = ++token; ghosting = true; ghost.classList.add('show');
      let i = 0;
      const step = () => {
        if (my !== token) return;
        if (i >= plan.length) { ghosting = false; ghost.classList.remove('show'); return; }
        const [sel, act] = plan[i++];
        const el = root.querySelector<HTMLElement>(sel)!, a = el.getBoundingClientRect(), b = till.getBoundingClientRect();
        ghost.style.transform = `translate(${a.left - b.left + a.width * 0.6}px, ${a.top - b.top + a.height * 0.55}px)`;
        timers.push(window.setTimeout(() => { if (my !== token) return; ghost.classList.add('tap'); timers.push(window.setTimeout(() => { ghost.classList.remove('tap'); act(); }, 140)); }, 850));
        timers.push(window.setTimeout(step, 1750));
      };
      ghost.style.transition = 'none'; ghost.style.transform = 'translate(85%, 20%)'; void ghost.offsetWidth; ghost.style.transition = '';
      timers.push(window.setTimeout(step, 400));
    };
    new IntersectionObserver((es, io) => { if (es[0].isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.45 }).observe(till);
  });
</script>
