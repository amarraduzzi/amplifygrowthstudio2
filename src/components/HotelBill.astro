---
// The bill of a stay, played as a receipt rolling out of the reception's printer: the nights, the guest's orders, the
// restaurant bill sent to the room from the restaurant's till, the tourist tax, the deposit already paid. Then the
// payment, a "PAYÉ" stamp, and the invoice leaving as a WhatsApp message. Loops once in view. Demo riad, invented names.
import { tr, langOf } from '../i18n/t';
const lang = langOf(Astro.url);
const tt = tr(lang);
const LINES: [string, string, number][] = [
  [tt('Chambre'), tt('2 nuits · Suite'), 1300],
  [tt('Petit-déjeuner en chambre'), '× 2', 160],
  [tt('Restaurant · table 4'), tt('depuis la caisse du restaurant'), 240],
  [tt('Taxe de séjour'), tt('2 adultes · 2 nuits'), 60],
  [tt('Acompte reçu'), tt('à la réservation'), -500],
];
const fmt = (n: number) => `${n < 0 ? '− ' : ''}${Math.abs(n).toLocaleString('fr-FR').replace(/[  ]/g, ' ')} DH`;
const due = LINES.reduce((s, l) => s + l[2], 0);
---
<div class="hbl" data-hbl aria-hidden="true">
  <div class="hbl-printer"><span class="hbl-led"></span><span class="hbl-slot"></span><small>Amplify · {tt('Réception')}</small></div>
  <div class="hbl-roll">
    <div class="hbl-paper" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
      <p class="hbl-c" data-r><b>DAR LINA</b><small>{tt('Note du séjour')}</small><small>{tt('Chambre')} 102 · Fam. Idrissi</small></p>
      <p class="hbl-cut" data-r></p>
      {LINES.map(([l, d, a]) => (
        <p class="hbl-line" data-r><span><b>{l}</b><small>{d}</small></span><em dir="ltr" class={a < 0 ? 'neg' : ''}>{fmt(a)}</em></p>))}
      <p class="hbl-cut" data-r></p>
      <p class="hbl-tot" data-r><span>{tt('Reste à payer')}</span><b dir="ltr">{fmt(due)}</b></p>
      <p class="hbl-line" data-r><span><b>{tt('Espèces')}</b><small dir="ltr">14:32 · Youssef</small></span><em dir="ltr">{fmt(due)}</em></p>
      <p class="hbl-c hbl-end" data-r><small>{tt('Merci et à bientôt')}</small></p>
      <span class="hbl-stamp">{tt('Payé')}</span>
    </div>
  </div>
  <div class="hbl-wa">
    <p class="hbl-wh"><i>D</i><span><b>Dar Lina</b><small>{tt('en ligne')}</small></span></p>
    <p class="hbl-msg"><span class="hbl-pdf">PDF</span><span><b>{tt('Facture')} <span dir="ltr">2026-0142</span></b><small dir="ltr">{fmt(1760)} · ICE 002345678000091</small></span><em>✓✓</em></p>
  </div>
</div>

<style is:global>
  .hbl { position: relative; display: grid; justify-items: center; padding: 0 0 4rem; }
  .hbl-printer { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; width: min(23rem, 92%); height: 3.6rem; border-radius: 1.2rem 1.2rem .8rem .8rem; background: linear-gradient(#1B2B44, #0B1626); padding: 0 1.1rem; box-shadow: 0 24px 40px -22px rgba(0, 0, 0, .6); }
  .hbl-printer small { font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #5F7290; }
  .hbl-led { width: .55rem; height: .55rem; border-radius: 9px; background: #05B962; box-shadow: 0 0 10px #05B962; animation: hbl-blink 1.4s infinite; }
  @keyframes hbl-blink { 50% { opacity: .35; } }
  .hbl-slot { position: absolute; inset-inline: 1.6rem; bottom: .45rem; height: .3rem; border-radius: 9px; background: #000; }
  /* the paper comes out of the slot: the roll grows to the height JS gives it */
  .hbl-roll { position: relative; z-index: 1; width: min(20rem, 84%); height: var(--h, 0px); margin-top: -.55rem; overflow: hidden; transition: height .55s cubic-bezier(.3, .9, .3, 1); }
  .hbl.reset .hbl-roll { transition: height .4s ease-in; }
  .hbl-paper { position: relative; background: #FFFEFA; color: #1B2230; padding: 1.4rem 1.2rem 1.6rem; font-size: .88rem;
    box-shadow: inset 0 14px 14px -12px rgba(0, 0, 0, .28);
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 14px 100%; mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 14px 100%; }
  .hbl-c { display: grid; justify-items: center; text-align: center; gap: .1rem; }
  .hbl-c b { font-size: 1.2rem; letter-spacing: .3em; } .hbl-c small, .hbl-line small { color: #6B7280; font-size: .74rem; }
  .hbl-cut { margin: .8rem 0; border-top: 2px dashed #CBD2DA; }
  .hbl-line { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: .35rem 0; }
  .hbl-line span { display: grid; } .hbl-line em { font-style: normal; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; } .hbl-line em.neg { color: #0A7A43; }
  .hbl-tot { display: flex; justify-content: space-between; align-items: baseline; padding: .2rem 0 .6rem; font-weight: 800; }
  .hbl-tot b { font-size: 1.6rem; font-variant-numeric: tabular-nums; }
  .hbl-end { margin-top: .8rem; }
  .hbl-stamp { position: absolute; top: 46%; inset-inline-start: 50%; translate: -50% 0; border: 4px solid #0A7A43; border-radius: .6rem; padding: .2rem 1rem; color: #0A7A43; font-size: 2.4rem; font-weight: 900; letter-spacing: .18em; text-transform: uppercase;
    mix-blend-mode: multiply; opacity: 0; transform: rotate(-14deg) scale(2.4); pointer-events: none; }
  [dir="rtl"] .hbl-stamp { translate: 50% 0; }
  .hbl.paid .hbl-stamp { animation: hbl-stamp .45s cubic-bezier(.3, 1.6, .5, 1) forwards; }
  @keyframes hbl-stamp { to { opacity: .85; transform: rotate(-14deg) scale(1); } }
  .hbl.paid .hbl-roll { animation: hbl-thump .3s .3s; } @keyframes hbl-thump { 40% { transform: translateY(3px); } }
  /* the invoice leaves on WhatsApp */
  .hbl-wa { position: absolute; z-index: 3; inset-inline-end: 0; bottom: .5rem; width: min(17rem, 78%); border-radius: 1.2rem; background: #ECE5DD; padding: .6rem; box-shadow: 0 24px 50px -18px rgba(0, 0, 0, .45);
    opacity: 0; transform: translate(1.5rem, 1rem) scale(.92); transition: opacity .45s, transform .6s cubic-bezier(.2, .9, .25, 1.2); }
  [dir="rtl"] .hbl-wa { transform: translate(-1.5rem, 1rem) scale(.92); }
  .hbl.sent .hbl-wa { opacity: 1; transform: none; }
  @media (min-width: 1024px) { .hbl-wa { inset-inline-end: -1.5rem; } }
  .hbl-wh { display: flex; align-items: center; gap: .55rem; border-radius: .8rem; background: #075E54; color: #fff; padding: .45rem .6rem; }
  .hbl-wh i { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 99px; background: #fff; color: #075E54; font-style: normal; font-weight: 900; }
  .hbl-wh span { display: grid; line-height: 1.15; } .hbl-wh small { font-size: .68rem; opacity: .75; }
  .hbl-msg { display: flex; align-items: center; gap: .6rem; margin: .6rem 0 .2rem auto; width: 92%; border-radius: .8rem .2rem .8rem .8rem; background: #DCF8C6; padding: .55rem .6rem; color: #1B2230; font-size: .8rem; }
  [dir="rtl"] .hbl-msg { margin: .6rem auto .2rem 0; border-radius: .2rem .8rem .8rem .8rem; }
  .hbl-msg > span:nth-child(2) { display: grid; flex: 1; min-width: 0; } .hbl-msg small { font-size: .66rem; color: #4B5563; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hbl-pdf { display: grid; place-items: center; width: 2.3rem; height: 2.7rem; flex: none; border-radius: .35rem; background: #E5484D; color: #fff; font-size: .66rem; font-weight: 900; }
  .hbl-msg em { align-self: flex-end; font-style: normal; font-size: .7rem; color: #34B7F1; font-weight: 800; }
  @media (prefers-reduced-motion: reduce) { .hbl-roll, .hbl-wa { transition: none !important; } .hbl-stamp { animation: none !important; opacity: .85; transform: rotate(-14deg); } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hbl]').forEach((root) => {
    const roll = root.querySelector<HTMLElement>('.hbl-roll')!;
    const paper = root.querySelector<HTMLElement>('.hbl-paper')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-r]')];
    // the paper shows down to the bottom of row i (and the whole paper at the end)
    const upTo = (i: number) => { const r = rows[i]; roll.style.setProperty('--h', `${i >= rows.length - 1 ? paper.offsetHeight : r.offsetTop + r.offsetHeight + 12}px`); };
    let i = -1, t = 0, on = false;
    const tick = () => {
      if (!on) return;
      i++;
      if (i < rows.length) { root.classList.remove('reset'); upTo(i); t = window.setTimeout(tick, i === 1 ? 250 : i === rows.length - 3 ? 1100 : 650); return; }
      if (i === rows.length) { root.classList.add('paid'); t = window.setTimeout(tick, 1300); return; }
      if (i === rows.length + 1) { root.classList.add('sent'); t = window.setTimeout(tick, 4200); return; }
      // tear it off and print the next one
      root.classList.add('reset'); root.classList.remove('paid', 'sent'); roll.style.setProperty('--h', '0px'); i = -1; t = window.setTimeout(tick, 900);
    };
    if (still || !('IntersectionObserver' in window)) { root.classList.add('paid', 'sent'); roll.style.setProperty('--h', `${paper.offsetHeight}px`); return; }
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on) { on = true; t = window.setTimeout(tick, 500); }
      else if (!e.isIntersecting) { on = false; clearTimeout(t); }
    }, { threshold: 0.3 }).observe(root);
    addEventListener('resize', () => { if (i >= rows.length - 1) roll.style.setProperty('--h', `${paper.offsetHeight}px`); });
  });
</script>
