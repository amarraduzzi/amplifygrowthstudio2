---
// The bill of a stay, played live: the "Note du séjour" of the reception app. The nights, the guest's orders, the
// restaurant bill sent to the room from the restaurant's till, the tourist tax, the deposit already paid; then the
// payment, the departure, and the invoice ready to send. Plays in a loop once in view. Demo riad, invented names.
import { tr, langOf } from '../i18n/t';
const lang = langOf(Astro.url);
const tt = tr(lang);
// [label, detail, amount in DH (negative = paid)], each one arrives in turn
const LINES: [string, string, number][] = [
  [tt('Chambre'), tt('2 nuits · Suite'), 1300],
  [tt('Petit-déjeuner en chambre'), '× 2', 160],
  [tt('Restaurant · table 4'), tt('depuis la caisse du restaurant'), 240],
  [tt('Taxe de séjour'), tt('2 adultes · 2 nuits'), 60],
  [tt('Acompte reçu'), tt('à la réservation'), -500],
];
const fmt = (n: number) => `${n < 0 ? '− ' : ''}${Math.abs(n).toLocaleString('fr-FR').replace(/ /g, ' ')} DH`;
let run = 0;
const totals = LINES.map(l => (run += l[2]));
---
<div class="hbl" data-hbl data-s="0" aria-hidden="true">
  <div class="hbl-tab"><div class="hbl-scr" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <div class="hbl-top"><b>{tt('Note du séjour')} · Fam. Idrissi</b><span>{tt('Chambre')} 102</span></div>
    <div class="hbl-lines">
      {LINES.map(([l, d, a], i) => (
        <p class="hbl-l" style={`--i:${i}`} data-i={i}><span><b>{l}</b><small>{d}</small></span><em dir="ltr" class={a < 0 ? 'neg' : ''}>{fmt(a)}</em></p>))}
    </div>
    <div class="hbl-sum">
      <span>{tt('Reste à payer')}</span>
      <b dir="ltr">{totals.map((t, i) => <i data-t={i}>{fmt(t)}</i>)}<i data-t="paid">0 DH</i></b>
    </div>
    <div class="hbl-pay">
      <span class="on">{tt('Espèces')}</span><span>{tt('Carte')}</span><span>{tt('Virement')}</span>
      <b>{tt('Encaisser')} <span dir="ltr">{fmt(totals[totals.length - 1])}</span></b>
    </div>
    <p class="hbl-paid">✓ {tt('Payé')} · {tt('Départ fait')} · {tt('la chambre passe au ménage')}</p>
  </div></div>

  <div class="hbl-inv">
    <p class="hbl-ik">{tt('Facture')} <span dir="ltr">n° 2026-0142</span></p>
    <p class="hbl-ih">Dar Lina</p>
    <p class="hbl-ix">ICE 002345678000091 · {tt('TVA comprise')}</p>
    <div class="hbl-ir"><span>{tt('Total')}</span><b dir="ltr">{fmt(LINES.filter(l => l[2] > 0).reduce((s, l) => s + l[2], 0))}</b></div>
    <p class="hbl-ia"><span>PDF</span><span>WhatsApp</span></p>
  </div>
</div>

<style is:global>
  .hbl { position: relative; padding-bottom: 8.5rem; }
  .hbl-tab { border-radius: 1.6rem; background: #0B1422; padding: .65rem; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .55); }
  .hbl-scr { border-radius: 1.1rem; background: #0A1931; color: #fff; padding: 1.1rem 1.1rem 1.2rem; min-height: 26rem; }
  .hbl-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .3rem 1rem; padding-bottom: .8rem; border-bottom: 1px solid rgba(255, 255, 255, .08); }
  .hbl-top b { font-size: 1.05rem; } .hbl-top span { font-size: .8rem; font-weight: 700; color: #8FA3C2; }
  .hbl-lines { display: grid; gap: .4rem; margin-top: .9rem; min-height: 15.5rem; align-content: start; }
  .hbl-l { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-radius: .8rem; background: #0E2140; padding: .55rem .8rem; opacity: 0; transform: translateY(.5rem); transition: opacity .35s, transform .35s; }
  .hbl-l span { display: grid; } .hbl-l b { font-size: .9rem; } .hbl-l small { font-size: .72rem; color: #8FA3C2; }
  .hbl-l em { font-style: normal; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; } .hbl-l em.neg { color: #7BE3A9; }
  .hbl[data-s="1"] .hbl-l[data-i="0"], .hbl[data-s="2"] .hbl-l:is([data-i="0"], [data-i="1"]), .hbl[data-s="3"] .hbl-l:is([data-i="0"], [data-i="1"], [data-i="2"]),
  .hbl[data-s="4"] .hbl-l:not([data-i="4"]), .hbl:is([data-s="5"], [data-s="6"], [data-s="7"]) .hbl-l { opacity: 1; transform: none; }
  .hbl-l[data-i="2"] { box-shadow: inset 0 0 0 1px rgba(110, 143, 240, .4); }
  .hbl-sum { display: flex; align-items: baseline; justify-content: space-between; margin-top: .9rem; padding-top: .8rem; border-top: 2px solid rgba(255, 255, 255, .85); }
  .hbl-sum span { font-weight: 700; color: #B8C6DC; }
  .hbl-sum b { display: grid; font-size: 1.8rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .hbl-sum i { grid-area: 1 / 1; font-style: normal; text-align: end; opacity: 0; transition: opacity .3s; }
  .hbl[data-s="1"] [data-t="0"], .hbl[data-s="2"] [data-t="1"], .hbl[data-s="3"] [data-t="2"], .hbl[data-s="4"] [data-t="3"], .hbl[data-s="5"] [data-t="4"], .hbl:is([data-s="6"], [data-s="7"]) [data-t="paid"] { opacity: 1; }
  .hbl:is([data-s="6"], [data-s="7"]) .hbl-sum b { color: #05B962; }
  .hbl-pay { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .9rem; opacity: .35; transition: opacity .4s; }
  .hbl-pay span { border-radius: .7rem; background: #0E2140; padding: .55rem .8rem; font-size: .8rem; font-weight: 700; color: #B8C6DC; } .hbl-pay span.on { background: #fff; color: #0A1931; }
  .hbl-pay b { margin-inline-start: auto; display: inline-flex; gap: .4rem; border-radius: .8rem; background: #05B962; color: #062314; padding: .55rem 1rem; font-size: .85rem; transition: transform .2s; }
  .hbl-pay b.press { transform: scale(.94); }
  .hbl[data-s="5"] .hbl-pay { opacity: 1; } .hbl:is([data-s="6"], [data-s="7"]) .hbl-pay { opacity: 0; height: 0; margin: 0; overflow: hidden; }
  .hbl-paid { margin-top: .9rem; border-radius: .9rem; background: rgba(5, 185, 98, .15); color: #7BE3A9; padding: .7rem .9rem; font-size: .9rem; font-weight: 700; opacity: 0; transition: opacity .4s; }
  .hbl:is([data-s="6"], [data-s="7"]) .hbl-paid { opacity: 1; }
  /* the invoice, slipping out of the tablet */
  .hbl-inv { position: absolute; inset-inline-end: 1rem; bottom: 0; width: min(15rem, 70%); border-radius: 1rem; background: #fff; color: #0B1E33; padding: 1rem 1.1rem; box-shadow: 0 24px 50px -18px rgba(0, 0, 0, .45);
    opacity: 0; transform: translateY(1.5rem) rotate(4deg); transition: opacity .5s, transform .6s cubic-bezier(.2, .9, .25, 1.15); }
  [dir="rtl"] .hbl-inv { transform: translateY(1.5rem) rotate(-4deg); }
  .hbl[data-s="7"] .hbl-inv { opacity: 1; transform: rotate(3deg); } [dir="rtl"] .hbl[data-s="7"] .hbl-inv { transform: rotate(-3deg); }
  .hbl-ik { font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #5C6B7A; }
  .hbl-ih { margin-top: .3rem; font-size: 1.25rem; font-weight: 800; } .hbl-ix { font-size: .7rem; color: #5C6B7A; }
  .hbl-ir { display: flex; justify-content: space-between; align-items: baseline; margin-top: .7rem; padding-top: .5rem; border-top: 1px solid #E3E8EE; font-weight: 700; } .hbl-ir b { font-size: 1.15rem; }
  .hbl-ia { display: flex; gap: .4rem; margin-top: .7rem; } .hbl-ia span { border-radius: 99px; background: #EEF3F1; padding: .3rem .7rem; font-size: .72rem; font-weight: 800; } .hbl-ia span:last-child { background: #25D366; color: #fff; }
  @media (prefers-reduced-motion: reduce) { .hbl-l, .hbl-sum i, .hbl-inv, .hbl-pay, .hbl-paid { transition: none !important; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hbl]').forEach((root) => {
    let s = 0, t = 0, on = false;
    const pay = root.querySelector('.hbl-pay b');
    // 1-5: the lines arrive · 5: pay · 6: paid, departure · 7: the invoice · then again
    const tick = () => {
      if (!on) return;
      if (s === 5) { pay?.classList.add('press'); window.setTimeout(() => pay?.classList.remove('press'), 200); }
      s = (s + 1) % 8; root.dataset.s = String(s);
      t = window.setTimeout(tick, s === 7 ? 4200 : s === 0 ? 900 : s === 5 ? 1800 : 1300);
    };
    if (still || !('IntersectionObserver' in window)) { root.dataset.s = '7'; return; }
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on) { on = true; t = window.setTimeout(tick, 600); }
      else if (!e.isIntersecting) { on = false; clearTimeout(t); }
    }, { threshold: 0.35 }).observe(root);
  });
</script>
