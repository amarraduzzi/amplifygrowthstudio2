---
// "Trois problèmes. Trois points de départ.": the three routes side by side, so the owner compares
// them at a glance (margin with Profit, orders with POS, customers with Site and Clients). Each card:
// a large live visual that plays when the card comes into view, the owner's own words, what he gets,
// the starting price, WhatsApp and the product page. Cards rise one after the other; on a computer
// they tilt toward the mouse. No "most popular" badge: nothing invented.
import Icon from './Icon.astro';
import WaButton from './WaButton.astro';
import { copy } from '../i18n';
import { ROUTES, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const lang = Astro.props.lang;
const all = copy(lang);
const c = all.home.places;
const v = c.v;
// per route: the visual's background, the accent of the card
const LOOK: Record<string, { bg: string; accent: string; glow: string }> = {
  profit: { bg: 'bg-navy', accent: 'bg-green text-navy', glow: 'rgb(5 185 98 / .35)' },
  pos: { bg: 'bg-blue-2', accent: 'bg-white text-navy', glow: 'rgb(10 63 122 / .4)' },
  clients: { bg: 'bg-mint', accent: 'bg-navy text-white', glow: 'rgb(5 185 98 / .25)' },
};
---
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-routes>
  <h2 class="text-center text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{c.h2a}</span><span class="block text-green-deep">{c.h2b}</span></h2>
  <p class="mx-auto mt-6 max-w-xl text-center text-muted">{c.p}</p>

  <div class="mt-12 grid gap-5 lg:grid-cols-3" style="perspective:1400px">
    {c.sectors.map((s, i) => {
      const L = LOOK[s.key] ?? LOOK.profit;
      return (
        <article class="rt sec-panel group relative flex flex-col overflow-hidden rounded-[2rem] bg-paper ring-1 ring-line" style={`--i:${i};--glow:${L.glow}`} data-rt>
          <!-- the live visual -->
          <div class={`rt-vis relative grid min-h-52 place-items-center lg:h-[19rem] overflow-hidden ${L.bg} px-5 pb-6 pt-16`} aria-hidden="true">
            <span class={`absolute start-4 top-4 inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-bold ${L.accent}`}><Icon name={s.icon} class="size-4" />{s.label}</span>
            {s.visual === 'margin' && (
              <div class="w-full max-w-64 rounded-2xl bg-white p-4 text-navy shadow-2xl">
                <p class="flex items-center justify-between font-bold"><span>{v.margin.title}</span><span class="rounded-full bg-chalk px-2 py-0.5 text-[0.65rem] font-semibold text-muted">{v.margin.note}</span></p>
                <ul class="mt-3 space-y-2.5">
                  {v.margin.rows.map(([name, pct], k) => (
                    <li class="text-[0.8rem]">
                      <span class="flex justify-between"><span>{name}</span><span class={`font-bold tabular-nums ${pct < 40 ? 'text-[#B42318]' : 'text-green-deep'}`} dir="ltr">{pct} %</span></span>
                      <span class="mt-1 block h-1.5 overflow-hidden rounded-full bg-chalk"><span class={`m-bar block h-full rounded-full ${pct < 40 ? 'bg-[#F04438]' : 'bg-green'}`} style={`--w:${pct}%;--d:${400 + k * 250}ms`}></span></span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {s.visual === 'ticket' && (
              <div class="vis-ticket w-56 rounded-lg bg-white px-5 pb-5 pt-4 font-mono text-[0.78rem] text-navy shadow-2xl">
                <p class="pr-line text-center font-bold" style="--d:300ms">{v.ticket.title}</p>
                <p class="pr-line my-2 border-t border-dashed border-navy/30" style="--d:400ms"></p>
                {v.ticket.lines.map(([a, b], k) => <p class="pr-line flex justify-between" style={`--d:${550 + k * 250}ms`}><span>{a}</span><span>{b}</span></p>)}
                <p class="pr-line my-2 border-t border-dashed border-navy/30" style="--d:1050ms"></p>
                <p class="pr-line flex justify-between font-bold" style="--d:1200ms"><span>{v.ticket.total}</span><span>{v.ticket.amount}</span></p>
                <p class="pr-line mt-2 flex items-center gap-1.5 text-green-deep" style="--d:1500ms"><Icon name="chef" class="size-4" />{v.ticket.sent}</p>
                <p class="pr-line flex items-center gap-1.5 text-green-deep" style="--d:1750ms"><Icon name="chart" class="size-4" />{v.ticket.margin}</p>
              </div>
            )}
            {s.visual === 'google' && (
              <div class="w-full max-w-64 rounded-2xl bg-white p-4 text-navy shadow-2xl">
                <div class="flex items-center gap-3">
                  <span class="grid size-11 place-items-center rounded-xl bg-blue text-white"><Icon name="store" class="size-5" /></span>
                  <span><span class="block font-bold">{v.google.name}</span><span class="text-xs text-muted">{v.google.kind}</span></span>
                </div>
                <div class="mt-3 flex items-center gap-1.5 text-sm">
                  <span class="font-bold">5,0</span>
                  <span class="flex">{[0, 1, 2, 3, 4].map(k => <svg viewBox="0 0 20 20" class="g-star size-4" style={`--d:${400 + k * 180}ms`}><path fill="currentColor" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z"/></svg>)}</span>
                </div>
                <p class="mt-1 text-xs font-semibold text-green-deep">{v.google.open}</p>
                <div class="mt-3 grid grid-cols-3 gap-1.5">
                  {v.google.actions.map((a, k) => <span class={`sec-in rounded-full py-1.5 text-center text-[0.7rem] font-semibold ${k === 2 ? 'bg-green text-navy' : 'bg-chalk'}`} style={`--d:${1400 + k * 120}ms`}>{a}</span>)}
                </div>
              </div>
            )}
          </div>

          <!-- the words, the price, the way in -->
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <p class="text-xl font-semibold leading-snug tracking-tight">{s.quote}</p>
            <ul class="mt-5 hidden space-y-2.5 text-[0.95rem] sm:block">
              {s.does.map(d => (
                <li class="flex gap-2.5">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-3.5" /></span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-5 sm:pt-6">
              <p class="text-sm font-semibold text-muted">{s.price.split(/[,،]/)[0]}</p>
              <p class="display mt-1 text-[1.9rem] leading-none text-navy">{s.price.split(/[,،]/).slice(1).join(',').trim()}</p>
              <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
                <WaButton text={s.wa} label={all.ui.whatsapp} where={`home-route-${s.key}`} class="px-5" />
                <a href={ROUTES[s.link][lang]} class="font-semibold underline underline-offset-4 hover:text-green-deep">{c.more} {s.price.split(/[,،]/)[0]}</a>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  /* the cards rise one after the other; on hover the card lifts and glows in its colour */
  :global(.js) .rt { opacity: 0; transform: translateY(40px) rotateX(8deg); transition: opacity .6s ease, transform .8s cubic-bezier(.2,.8,.2,1), box-shadow .4s; transition-delay: calc(var(--i) * 140ms); transform-origin: 50% 100%; }
  :global(.js) .rt.is-on { opacity: 1; transform: none; }
  .rt:hover { box-shadow: 0 40px 80px -36px var(--glow), 0 0 0 2px var(--glow); }
  .rt.is-on.tilt { transition: transform .15s ease-out, box-shadow .4s; transition-delay: 0s; }
  .rt-vis > div { transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .rt:hover .rt-vis > div { transform: translateY(-6px) scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .rt { opacity: 1; transform: none; transition: none; }
    .rt:hover .rt-vis > div { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-routes]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-rt]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // the visuals play when the cards come into view (all three, one after the other)
    if (!('IntersectionObserver' in window) || still) cards.forEach(c => c.classList.add('is-on'));
    else {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); cards.forEach(c => c.classList.add('is-on')); } }, { threshold: 0.2 });
      io.observe(cards[0]);
    }
    // on a computer, the card tilts a little toward the mouse
    if (still || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    cards.forEach(card => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        card.classList.add('tilt');
        card.style.transform = `rotateY(${x * 7}deg) rotateX(${-y * 6}deg) translateY(-6px)`;
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; setTimeout(() => card.classList.remove('tilt'), 160); });
    });
  });
</script>
