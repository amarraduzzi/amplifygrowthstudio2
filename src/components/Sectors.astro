---
// "Choose your trade": the visitor picks a sector and the block speaks about their business,
// with a small live visual and a WhatsApp message written for that sector.
// Desktop: the Amplify logo as a hub with the four sectors around it; the chosen one turns to face the panel.
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import WaButton from './WaButton.astro';
import { copy } from '../i18n';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const all = copy(Astro.props.lang);
const c = all.home.places;
const v = c.v;
const N = c.sectors.length;
---
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-sectors>
  <h2 class="text-center text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{c.h2a}</span><span class="block">{c.h2b}</span></h2>
  <p class="mx-auto mt-6 max-w-xl text-center text-muted">{c.p}</p>

  <!-- the choice -->
  <div class="snap-row -mx-4 mt-10 flex gap-2 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:justify-center md:overflow-visible md:px-0" role="tablist" aria-label={c.choose}>
    {c.sectors.map((s, i) => (
      <button type="button" role="tab" id={`sec-tab-${s.key}`} aria-controls={`sec-${s.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-sec={i}
        class="sec-tab group relative flex shrink-0 items-center gap-2.5 overflow-hidden rounded-full bg-paper py-2 pe-5 ps-2 font-semibold ring-1 ring-line transition-colors hover:ring-navy aria-selected:bg-navy aria-selected:text-white aria-selected:ring-navy">
        <span class="grid size-9 place-items-center rounded-full bg-chalk text-navy group-aria-selected:bg-green group-aria-selected:text-navy"><Icon name={s.icon} class="size-5" /></span>
        <span class="whitespace-nowrap">{s.label}</span>
        <span class="sec-progress absolute inset-x-0 bottom-0 h-[3px] origin-left bg-green rtl:origin-right" style="transform:scaleX(0)" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div class="mt-10 grid items-center gap-10 lg:grid-cols-[20rem_1fr] lg:gap-14">
    <!-- hub (desktop) -->
    <div class="relative mx-auto hidden size-80 lg:block" aria-hidden="true">
      <div class="absolute inset-6 rounded-full border-2 border-dashed border-line"></div>
      <span class="hub-line absolute start-1/2 top-1/2 h-[3px] w-1/2 origin-left -translate-y-1/2 rounded-full bg-green"></span>
      <div class="hub-orbit absolute inset-0" style="--rot:0deg">
        {c.sectors.map((s, i) => (
          <span class="hub-sat absolute left-1/2 top-1/2 size-0" style={`--a:${(i * 360) / N}deg`} data-sat={i}>
            <span class="hub-sat-inner grid size-14 place-items-center rounded-2xl bg-paper text-navy shadow-lg ring-1 ring-line transition-all duration-500"><Icon name={s.icon} class="size-6" /></span>
          </span>
        ))}
      </div>
      <div class="absolute inset-[30%] grid place-items-center rounded-full bg-paper shadow-[0_20px_50px_-20px_rgba(0,30,62,0.35)] ring-1 ring-line">
        <Mark class="w-[62%]" id="hub" />
      </div>
    </div>

    <!-- the panels -->
    <div class="grid">
      {c.sectors.map((s, i) => (
        <div role="tabpanel" id={`sec-${s.key}`} aria-labelledby={`sec-tab-${s.key}`} data-secpanel={i} inert={i !== 0} aria-hidden={i !== 0 ? 'true' : undefined}
          class={`sec-panel col-start-1 row-start-1 grid items-center gap-6 rounded-[2rem] bg-paper p-5 ring-1 ring-line transition-opacity duration-300 md:grid-cols-[1.15fr_0.85fr] md:gap-8 md:p-10 ${i === 0 ? 'is-on' : 'invisible opacity-0'}`}>
          <div>
            <p class="sec-in text-xl font-semibold leading-snug tracking-tight sm:text-2xl md:text-[1.75rem]" style="--d:0ms">{s.quote}</p>
            <ul class="mt-6 space-y-3">
              {s.does.map((d, k) => (
                <li class="sec-in flex gap-3" style={`--d:${150 + k * 120}ms`}>
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
            <div class="sec-in mt-7" style="--d:550ms"><WaButton text={s.wa} label={all.ui.whatsapp} where={`home-sector-${s.key}`} class="px-6" /></div>
          </div>

          <!-- the live visual -->
          <div class="relative order-first grid min-h-56 place-items-center overflow-hidden rounded-[1.5rem] bg-chalk p-5 md:order-none md:min-h-64 md:p-6" aria-hidden="true">
            {s.visual === 'ticket' && (
              <div class="vis-ticket w-56 rounded-t-lg bg-white px-5 pb-6 pt-4 font-mono text-[0.8rem] text-navy shadow-xl">
                <p class="pr-line text-center font-bold" style="--d:200ms">{v.ticket.title}</p>
                <p class="pr-line my-2 border-t border-dashed border-navy/30" style="--d:300ms"></p>
                {v.ticket.lines.map(([a, b], k) => <p class="pr-line flex justify-between" style={`--d:${450 + k * 250}ms`}><span>{a}</span><span>{b}</span></p>)}
                <p class="pr-line my-2 border-t border-dashed border-navy/30" style="--d:950ms"></p>
                <p class="pr-line flex justify-between font-bold" style="--d:1100ms"><span>{v.ticket.total}</span><span>{v.ticket.amount}</span></p>
                <p class="pr-line mt-3 flex items-center gap-1.5 text-green-deep" style="--d:1400ms"><Icon name="chef" class="size-4" />{v.ticket.sent}</p>
                <p class="pr-line flex items-center gap-1.5 text-green-deep" style="--d:1650ms"><Icon name="chart" class="size-4" />{v.ticket.margin}</p>
              </div>
            )}
            {s.visual === 'queue' && (
              <div class="w-full max-w-60 space-y-2.5">
                {v.queue.map(([where, t, item], k) => (
                  <div class="q-card flex items-center justify-between rounded-xl bg-navy px-4 py-3 text-white shadow-lg" style={`--d:${200 + k * 300}ms`}>
                    <span><span class="block text-xs text-white/60">{where}</span><span class="font-semibold">{item}</span></span>
                    <span class={`rounded-lg px-2 py-1 text-xs font-bold ${k === 2 ? 'bg-[#F5B301] text-navy' : 'bg-white/10'}`}>{t}</span>
                  </div>
                ))}
              </div>
            )}
            {s.visual === 'google' && (
              <div class="w-full max-w-64 rounded-2xl bg-white p-4 text-navy shadow-xl">
                <div class="flex items-center gap-3">
                  <span class="grid size-11 place-items-center rounded-xl bg-blue text-white"><Icon name="store" class="size-5" /></span>
                  <span><span class="block font-bold">{v.google.name}</span><span class="text-xs text-muted">{v.google.kind}</span></span>
                </div>
                <div class="mt-3 flex items-center gap-1.5 text-sm">
                  <span class="font-bold">5,0</span>
                  <span class="flex">{[0, 1, 2, 3, 4].map(k => <svg viewBox="0 0 20 20" class="g-star size-4" style={`--d:${300 + k * 180}ms`}><path fill="currentColor" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z"/></svg>)}</span>
                </div>
                <p class="mt-1 text-xs font-semibold text-green-deep">{v.google.open}</p>
                <div class="mt-3 grid grid-cols-3 gap-1.5">
                  {v.google.actions.map((a, k) => <span class={`sec-in rounded-full py-1.5 text-center text-[0.7rem] font-semibold ${k === 2 ? 'bg-green text-navy' : 'bg-chalk'}`} style={`--d:${1300 + k * 120}ms`}>{a}</span>)}
                </div>
              </div>
            )}
            {s.visual === 'rdv' && (
              <div class="w-full max-w-64 overflow-hidden rounded-2xl bg-[#EFEAE2] text-[0.8rem] text-[#111] shadow-xl">
                <div class="flex items-center gap-2 bg-[#075E54] px-3 py-2.5 text-white"><span class="size-6 rounded-full bg-white/30"></span><span class="font-semibold">{v.rdv.title}</span></div>
                <div class="space-y-2 p-3">
                  <p class="sec-in ms-auto w-fit max-w-[85%] rounded-lg rounded-se-none bg-[#D9FDD3] px-3 py-2 leading-snug" style="--d:300ms">{v.rdv.ask}</p>
                  <p class="sec-in w-fit max-w-[85%] rounded-lg rounded-ss-none bg-white px-3 py-2 leading-snug" style="--d:1100ms">{v.rdv.reply}</p>
                  <p class="sec-in ms-auto w-fit max-w-[85%] rounded-lg rounded-se-none bg-[#D9FDD3] px-3 py-2 leading-snug" style="--d:1800ms">{v.rdv.ok}</p>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-sectors]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-sec]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-secpanel]')];
    const sats = [...root.querySelectorAll<HTMLElement>('[data-sat]')];
    const orbit = root.querySelector<HTMLElement>('.hub-orbit');
    const line = root.querySelector<HTMLElement>('.hub-line');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = tabs.length, STEP = 5500;
    let current = 0, auto = !still, timer = 0, rot = 0;

    const show = (i: number, fromUser = false) => {
      clearTimeout(timer);
      current = i;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', k === i ? 'true' : 'false'); t.tabIndex = k === i ? 0 : -1; t.classList.remove('running'); });
      panels.forEach((p, k) => { const on = k === i; p.inert = !on; if (on) p.removeAttribute('aria-hidden'); else p.setAttribute('aria-hidden', 'true'); p.classList.toggle('is-on', on); p.classList.toggle('invisible', !on); p.classList.toggle('opacity-0', !on); });
      sats.forEach((s, k) => s.classList.toggle('on', k === i));
      // turn the orbit, always in the same direction, so the chosen sector faces the panel (0 degrees)
      const target = -(i * 360) / N;
      let d = (target - rot) % 360; if (d > 0) d -= 360; rot += d;
      orbit?.style.setProperty('--rot', `${rot}deg`);
      if (line) { line.classList.remove('draw-line'); void line.offsetWidth; line.classList.add('draw-line'); }
      if (fromUser) tabs[i].scrollIntoView({ block: 'nearest', inline: 'center', behavior: still ? 'auto' : 'smooth' });
      if (auto) { void tabs[i].offsetWidth; tabs[i].classList.add('running'); timer = window.setTimeout(() => show((i + 1) % N), STEP); }
    };
    const stop = () => { auto = false; clearTimeout(timer); tabs.forEach(t => t.classList.remove('running')); };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); show(i, true); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; e.preventDefault(); stop(); const n = (current + d + N) % N; show(n, true); tabs[n].focus();
      });
    });
    sats.forEach((s, i) => s.addEventListener('click', () => { stop(); show(i); }));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); show(0); } }, { threshold: 0.35 });
      io.observe(root);
    }
  });
</script>
