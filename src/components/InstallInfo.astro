---
// How we set you up: by video everywhere in Morocco (included), on site in Rabat (one-off price,
// free with a yearly plan), and the launch offer while it lasts (OFFER.launchFreeInstall in config).
import Icon from './Icon.astro';
import { OFFER } from '../config';
import { tr, langOf } from '../i18n/t';
const LG = langOf(Astro.url);
const tt = tr(LG);
const gift = 12 - OFFER.yearPaidMonths;
---
<div class="rounded-[2rem] bg-paper p-6 ring-1 ring-line sm:p-8">
  <h3 class="text-2xl">{tt('Installation : comment on vous met en route')}</h3>
  {OFFER.launchFreeInstall > 0 && (
    <p class="mt-4 flex items-start gap-3 rounded-2xl bg-[#FFF4D6] px-4 py-3 font-semibold text-[#6B4E00]">
      <span class="text-lg leading-none" aria-hidden="true">★</span>
      <span>{tt('Offre de lancement : installation sur place offerte aux {n} premiers établissements de Rabat.').replace('{n}', String(OFFER.launchFreeInstall))}</span>
    </p>
  )}
  <ul class="mt-5 grid gap-3 md:grid-cols-3">
    <li class="rounded-2xl bg-chalk p-5">
      <span class="grid size-10 place-items-center rounded-xl bg-green text-navy"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="m16 10 6-3v10l-6-3"/></svg></span>
      <p class="mt-3 font-bold">{tt('Partout au Maroc')}</p>
      <p class="display mt-1 text-3xl text-green-deep">{tt('Inclus')}</p>
      <p class="mt-1 text-sm text-muted">{tt('Installation guidée en appel vidéo : votre carte, l’imprimante et la formation de l’équipe, avec nous.')}</p>
    </li>
    <li class="rounded-2xl bg-chalk p-5">
      <span class="grid size-10 place-items-center rounded-xl bg-navy text-white"><Icon name="store" class="size-5" /></span>
      <p class="mt-3 font-bold">{tt('Sur place à Rabat')}</p>
      <p class="display mt-1 text-3xl"><span dir="ltr">{OFFER.installRabat}</span> {tt('DH HT')}</p>
      <p class="mt-1 text-sm text-muted">{tt('Une seule fois. Nous venons installer la caisse et former votre équipe dans votre établissement.')}</p>
    </li>
    <li class="rounded-2xl bg-navy p-5 text-white">
      <span class="grid size-10 place-items-center rounded-xl bg-green text-navy"><Icon name="check" class="size-5" /></span>
      <p class="mt-3 font-bold">{tt('Avec l’abonnement annuel')}</p>
      <p class="display mt-1 text-3xl text-green">{tt('Offerte')}</p>
      <p class="mt-1 text-sm text-white/70">{tt('Installation sur place à Rabat offerte, en plus des {n} mois offerts.').replace('{n}', String(gift))}</p>
    </li>
  </ul>
</div>
