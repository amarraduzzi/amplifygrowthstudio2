---
// "Du premier clic au client qui revient": the Amplify loop. The section is pinned while you scroll:
// a light travels around the ring, each of the five stations lights up and the panel explains it.
// Without motion (or JS) it shows as a simple list.
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { copy } from '../i18n';
import { ROUTES, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang).home.loop;
const N = c.stations.length;
const R = 160, C = 2 * Math.PI * R;
const pos = (i: number) => { const a = (-90 + (i * 360) / N) * Math.PI / 180; return [200 + R * Math.cos(a), 200 + R * Math.sin(a)]; };
---
<section class="loop relative bg-blue text-white" data-loop style={`--n:${N}`}>
  <div class="loop-pin mx-auto flex max-w-6xl flex-col px-4 py-16 sm:px-6 md:py-20">
    <div class="loop-head">
      <h2 class="text-[2.5rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{c.h2a}</span><span class="block text-green">{c.h2b}</span></h2>
      <p class="mt-4 max-w-xl text-white/75 sm:text-lg">{c.p}</p>
    </div>

    <div class="loop-body mt-8 grid items-center md:flex-1 gap-6 md:mt-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] md:gap-12">
      <!-- the ring -->
      <div class="relative mx-auto aspect-square w-full max-w-[12.5rem] sm:max-w-xs md:max-w-md" aria-hidden="true">
        <svg viewBox="0 0 400 400" class="size-full overflow-visible">
          <circle cx="200" cy="200" r={R} fill="none" stroke="rgba(255,255,255,.12)" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round" />
          <circle class="loop-arc" cx="200" cy="200" r={R} fill="none" stroke="#05B962" stroke-width="5" stroke-linecap="round"
            stroke-dasharray={C.toFixed(1)} style={`--c:${C.toFixed(1)}`} transform="rotate(-90 200 200)" />
          <g class="loop-comet" style="transform-origin:200px 200px">
            <circle cx="200" cy={200 - R} r="16" fill="rgba(5,185,98,.25)" />
            <circle cx="200" cy={200 - R} r="8" fill="#fff" />
          </g>
        </svg>
        {c.stations.map((s, i) => {
          const [x, y] = pos(i);
          return (
            <span class="loop-node absolute grid size-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-2xl bg-navy text-white/60 ring-1 ring-white/15 transition-all duration-500 sm:size-14" style={`left:${x / 4}%;top:${y / 4}%`} data-node={i}>
              <Icon name={s.icon} class="size-5 sm:size-6" />
            </span>
          );
        })}
        <div class="absolute inset-[30%] grid place-items-center rounded-full bg-paper text-navy shadow-2xl">
          <Mark class="w-[58%]" id="loop" />
        </div>
      </div>

      <!-- the panel -->
      <div class="relative min-h-[16.5rem] sm:min-h-[16rem]">
        {c.stations.map((s, i) => (
          <article class={`loop-panel absolute inset-0 ${i === 0 ? 'is-on' : ''}`} data-panel={i}>
            <p class="display text-6xl text-green sm:text-8xl">{String(i + 1).padStart(2, '0')}<span class="text-3xl text-white/40 sm:text-4xl">/{String(N).padStart(2, '0')}</span></p>
            <h3 class="display mt-1 text-4xl sm:text-6xl">{s.h}</h3>
            <p class="mt-2 max-w-md text-white/80 sm:mt-3 sm:text-lg">{s.p}</p>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              {s.tags.map(tg => <span class="rounded-full bg-white/10 px-3 py-1 text-sm font-semibold ring-1 ring-white/15">{tg}</span>)}
              <a href={ROUTES[s.link][lang]} class="ms-1 text-sm font-semibold text-green underline underline-offset-4">{c.more}</a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- progress -->
    <div class="loop-steps mt-6 flex gap-1.5" aria-hidden="true">
      {c.stations.map((_, i) => <span class="h-1 flex-1 overflow-hidden rounded-full bg-white/15"><span class="loop-step block h-full origin-left scale-x-0 bg-green rtl:origin-right" data-step={i}></span></span>)}
    </div>
  </div>
</section>

<!-- the three ways in, right after the loop -->
<section class="bg-blue pb-20 text-white md:pb-24">
  <div class="mx-auto grid max-w-6xl gap-3 px-4 sm:px-6 md:grid-cols-3">
    {c.three.map(([name, sub, key]) => (
      <a href={ROUTES[key][lang]} class="group flex items-center justify-between gap-4 rounded-2xl bg-white/5 px-5 py-4 ring-1 ring-white/15 hover:bg-white/10">
        <span><span class="block text-lg font-semibold">{name}</span><span class="text-sm text-white/65">{sub}</span></span>
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-green text-navy transition-transform group-hover:translate-x-1 rtl:rotate-180" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-loop]').forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLElement>('[data-node]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const N = nodes.length;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still) { root.classList.add('loop-static'); return; }
    root.classList.add('loop-live');
    let current = -1;
    const update = () => {
      const r = root.getBoundingClientRect();
      const run = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / (run > 0 ? run : 1)));
      root.style.setProperty('--p', p.toFixed(4));
      const i = Math.min(N - 1, Math.floor(p * N * 0.999));
      nodes.forEach((n, k) => n.classList.toggle('lit', p >= k / N));
      steps.forEach((s, k) => { s.style.transform = `scaleX(${Math.min(1, Math.max(0, p * N - k))})`; });
      if (i !== current) {
        current = i;
        nodes.forEach((n, k) => n.classList.toggle('now', k === i));
        panels.forEach((pn, k) => pn.classList.toggle('is-on', k === i));
      }
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, { passive: true });
    addEventListener('resize', update);
    update();
  });
</script>
