---
// The client's phone in the hero: a live copy of the new tracking page (yellow ticket, status, timeline,
// the rail with the article photos). It loops through three moments while it is in view:
// dropped off, being cleaned, ready (the photos light up and the hangers sway). Demo shop, invented number.
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
const G = [['chemise', 'Chemise'], ['pantalon', 'Pantalon'], ['costume', 'Costume'], ['djellaba', 'Djellaba']] as const;
---
<div class="hp" data-hp data-s="2" dir={langOf(Astro.url) === 'ar' ? 'rtl' : 'ltr'} aria-hidden="true">
<div class="hp-in">
  <p class="hp-name">Pressing Démo</p>
  <div class="hp-tag" dir="ltr"><span>PRESSING DÉMO</span><b>1042</b><span>4 {tt('pièces')}</span></div>
  <p class="hp-hint">{tt('Montrez ce numéro ou votre ticket au comptoir.')}</p>
  <div class="hp-hw">
    <h3 class="hp-h"><span class="s0">{tt('Déposé.')}</span><span class="s1">{tt('Au nettoyage.')}</span><span class="s2">{tt('Prêt !')}</span></h3>
  </div>
  <p class="hp-sub">{tt('Prêt mardi 24 novembre.')}</p>
  <ol class="hp-tl" dir="ltr">
    <i class="hp-fill"></i>
    {['Déposé', 'En nettoyage', 'Prêt', 'Récupéré'].map((x, k) => <li data-k={k}><u></u><span>{tt(x)}</span></li>)}
  </ol>
  <div class="hp-rh"><b>{tt('Sur le portant')}</b></div>
  <div class="hp-rail"><i></i>
    <ul>
      {G.map(([f, n], k) => (
        <li style={`--dl:${k * 0.14}s`}><span class="hp-hg"></span><span class="hp-c"><img src={`/img/pressing/${f}.webp`} alt="" width="640" height="800" loading="eager" decoding="async" draggable="false" /></span><small>{tt(n)}</small></li>
      ))}
    </ul>
  </div>
</div>
</div>

<style is:global>
  .hp { container-type: inline-size; position: relative; aspect-ratio: 600 / 1180; overflow: hidden; background: #FAF7F0; color: #17140F; }
  .hp-in { font-size: 4.9cqw; padding: 2em 1em 0; }
  .hp-name { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; font-size: 1.1em; }
  .hp-tag { position: relative; margin: .9em auto 0; width: 92%; padding: .8em 1em 1.2em; background: #F4D84E; color: #2A2A26; font-family: ui-monospace, Menlo, monospace; font-size: .8em; transform: rotate(-3deg); box-shadow: 0 .6em 1em -.5em rgba(0, 0, 0, .35); clip-path: polygon(0 0, 100% 0, 100% 90%, 96% 100%, 92% 90%, 88% 100%, 84% 90%, 80% 100%, 76% 90%, 72% 100%, 68% 90%, 64% 100%, 60% 90%, 56% 100%, 52% 90%, 48% 100%, 44% 90%, 40% 100%, 36% 90%, 32% 100%, 28% 90%, 24% 100%, 20% 90%, 16% 100%, 12% 90%, 8% 100%, 4% 90%, 0 100%); }
  .hp-tag span { display: block; font-size: .8em; opacity: .7; letter-spacing: .08em; } .hp-tag b { display: block; font-size: 3.1em; line-height: 1.05; letter-spacing: .02em; }
  .hp-hint { margin-top: .6em; text-align: center; font-size: .62em; color: #736B60; }
  .hp-hw { margin-top: 1.4em; display: grid; } .hp-h { display: grid; font-family: Georgia, 'Times New Roman', serif; font-size: 2.1em; line-height: 1.05; font-weight: 700; }
  .hp-h span { grid-area: 1 / 1; opacity: 0; transform: translateY(.3em); transition: opacity .4s, transform .5s; }
  .hp[data-s="0"] .s0, .hp[data-s="1"] .s1, .hp[data-s="2"] .s2 { opacity: 1; transform: none; }
  .hp[data-s="2"] .s2 { color: #00804A; }
  .hp-sub { margin-top: .3em; font-size: .7em; color: #736B60; }
  .hp-tl { position: relative; display: flex; justify-content: space-between; margin-top: 1.1em; }
  .hp-tl::before { content: ""; position: absolute; inset: .45em .4em auto; height: .2em; background: #E2DED4; border-radius: 9px; }
  .hp-fill { position: absolute; inset: .45em auto auto .4em; height: .2em; width: 0; background: #00804A; border-radius: 9px; transition: width .8s cubic-bezier(.4, 0, .2, 1); }
  .hp[data-s="0"] .hp-fill { width: 0; } .hp[data-s="1"] .hp-fill { width: calc(33% - .2em); } .hp[data-s="2"] .hp-fill { width: calc(66% - .2em); }
  .hp-tl li { position: relative; display: grid; justify-items: center; gap: .35em; width: 25%; font-size: .55em; color: #8A8377; font-weight: 600; text-align: center; line-height: 1.15; }
  .hp-tl u { width: 1.5em; height: 1.5em; border-radius: 99px; background: #E2DED4; transition: background .4s, transform .4s; }
  .hp[data-s="0"] li[data-k="0"] u, .hp[data-s="1"] li[data-k="0"] u, .hp[data-s="1"] li[data-k="1"] u, .hp[data-s="2"] li[data-k="0"] u, .hp[data-s="2"] li[data-k="1"] u, .hp[data-s="2"] li[data-k="2"] u { background: #00804A; transform: scale(1.1); }
  .hp[data-s="0"] li[data-k="0"], .hp[data-s="1"] li[data-k="1"], .hp[data-s="2"] li[data-k="2"] { color: #17140F; }
  .hp-rh { margin-top: 1.5em; font-family: Georgia, 'Times New Roman', serif; font-size: .95em; }
  .hp-rail { position: relative; margin-top: .5em; } .hp-rail > i { position: absolute; inset: .15em 0 auto; height: .3em; background: linear-gradient(#E4E6EA, #A9AEB6, #7C828B); border-radius: 9px; }
  .hp-rail ul { position: relative; display: flex; gap: .6em; }
  .hp-rail li { flex: 0 0 30%; }
  .hp-hg { display: block; width: .1em; height: 1em; margin: 0 auto; border-inline-start: .12em solid #17140F; opacity: .55; transform-origin: 50% 0; }
  .hp-c { display: block; overflow: hidden; margin-top: -.15em; aspect-ratio: 4 / 5; border-radius: .5em; background: #fff; box-shadow: 0 .3em .8em -.4em rgba(0, 0, 0, .3); }
  .hp-c img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: .45; filter: grayscale(.9); transition: opacity .6s, filter .6s; }
  .hp[data-s="2"] .hp-c img { opacity: 1; filter: none; }
  .hp[data-s="2"] .hp-hg { animation: hp-sway 1.3s var(--dl, 0s) both; }
  .hp-rail small { display: block; margin-top: .4em; font-size: .6em; font-weight: 600; }
  @keyframes hp-sway { 0% { transform: rotate(-16deg); } 30% { transform: rotate(10deg); } 60% { transform: rotate(-4deg); } 100% { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hp * { transition: none !important; animation: none !important; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hp]').forEach((el) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let s = 0, timer = 0;
    const tick = () => { s = (s + 1) % 3; el.dataset.s = String(s); };
    new IntersectionObserver((es) => {
      clearInterval(timer);
      if (es[0].isIntersecting) { el.dataset.s = String(s); timer = window.setInterval(tick, 2800); }
    }, { threshold: 0.3 }).observe(el);
    el.dataset.s = '0';
  });

  // depth: the phone and the till tilt a little towards the pointer (desktop only)
  document.querySelectorAll<HTMLElement>('[data-hp]').forEach((el) => {
    const scene = el.closest<HTMLElement>('.isolate');
    const phone = el.closest<HTMLElement>('.drop')?.firstElementChild as HTMLElement | null;
    const till = scene?.querySelector<HTMLElement>('.land')?.firstElementChild as HTMLElement | null;
    if (!scene || !phone || matchMedia('(prefers-reduced-motion: reduce), (hover: none)').matches) return;
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const draw = () => {
      x += (tx - x) * 0.08; y += (ty - y) * 0.08;
      phone.style.transform = `perspective(900px) rotateY(${x * 9}deg) rotateX(${-y * 7}deg) translate(${x * -6}px, ${y * -4}px)`;
      if (till) till.style.transform = `perspective(1200px) rotateY(${x * 3}deg) rotateX(${-y * 2.5}deg)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.002 ? requestAnimationFrame(draw) : 0;
    };
    const go = () => { if (!raf) raf = requestAnimationFrame(draw); };
    scene.addEventListener('pointermove', (e) => { const r = scene.getBoundingClientRect(); tx = ((e.clientX - r.left) / r.width - 0.5) * 2; ty = ((e.clientY - r.top) / r.height - 0.5) * 2; go(); });
    scene.addEventListener('pointerleave', () => { tx = 0; ty = 0; go(); });
  });
</script>
