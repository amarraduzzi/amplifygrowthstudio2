---
// "Voyez le rail": the shop's rails as the owner sees them. Eight drop-offs hang on two rails: ready, in
// the works, late, not collected for 30+ days. Filter chips dim the rest, a tap opens a drop-off, "Marquer
// prêt" moves it to ready and "Envoyer le WhatsApp" sends it. Invented first names and figures, said as such.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
type S = 'ready' | 'work' | 'late' | 'lost';
const D: [number, string, S, number, number, string][] = [
  [1038, 'Nadia', 'ready', 12, 265, 'Chemises, robe'], [1039, 'Karim', 'ready', 3, 90, 'Costume 2 pièces'],
  [1045, 'Meryem', 'ready', 7, 200, 'Djellaba, caftan'], [1044, 'Sanaa', 'work', 0, 120, 'Couette'],
  [1041, 'Anas', 'work', 0, 75, 'Pantalons'], [1031, 'Salma', 'late', 5, 140, 'Manteau'],
  [1022, 'Youssef', 'late', 9, 60, 'Chemises'], [987, 'Imane', 'lost', 2, 380, 'Costume 3 pièces'],
];
const CHIP: Record<S, string> = { ready: 'Prêt', work: 'En cours', late: 'En retard', lost: 'Non récupéré' };
const MSG: Record<S, string> = {
  ready: 'Prêt sur son rail. Un WhatsApp, et le client vient.',
  work: 'Encore en traitement : rien à envoyer pour l’instant.',
  late: 'En retard : à traiter avant que le client appelle.',
  lost: 'Non récupéré depuis plus de 30 jours : il est sur la liste à relancer.',
};
const FILTERS: [string, string][] = [['all', 'Tout'], ['ready', 'Prêts'], ['late', 'En retard'], ['lost', 'Non récupérés']];
const num = (n: number) => n.toLocaleString('fr-FR');
---
<div class="rl-box rounded-[2rem] bg-navy p-5 text-white ring-1 ring-white/10 md:p-8" data-rl data-f="all" data-sel="0">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">{tt('Voyez le rail.')}</p>
    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70 ring-1 ring-white/15">{tt('Exemple d’illustration')}</span>
  </div>
  <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label={tt('Filtrer')}>
    {FILTERS.map(([k, l]) => <button type="button" class="rl-chip rounded-full px-4 py-2 text-sm font-semibold ring-1 ring-white/20" data-filter={k} aria-pressed={String(k === 'all')}>{tt(l)}</button>)}
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <ul class="grid grid-cols-2 gap-x-3 gap-y-7 sm:grid-cols-4">
      {D.map(([n, who, s, rail, due], i) => (
        <li class="rl-card relative pt-3" data-i={i} data-state={s} data-due={due}>
          <span class="absolute -inset-x-1.5 top-0 h-1 rounded-full bg-white/30" aria-hidden="true"></span>
          <button type="button" class="rl-hang block w-full rounded-2xl bg-white/[0.08] p-3 text-start ring-1 ring-white/15" data-pick={i}>
            <span class="rl-dot mb-2 block size-2.5 rounded-full"></span>
            <span class="display block text-2xl leading-none" dir="ltr">{n}</span>
            <span class="mt-1 block truncate text-sm font-semibold">{who}</span>
            <span class="rl-lab mt-2 block truncate text-[0.7rem] font-semibold uppercase tracking-wide">{tt(CHIP[s])}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="relative min-h-[17rem] rounded-[1.5rem] bg-white/[0.07] p-5 ring-1 ring-white/10" aria-live="polite">
      {D.map(([n, who, s, rail, due, what], i) => (
        <div class="rl-pan" data-pan={i} data-state={s}>
          <p class="flex items-center justify-between gap-2"><span class="display text-3xl" dir="ltr">N° {n}</span><span class="rl-pill rounded-full px-2.5 py-1 text-xs font-bold"><span class="rl-t-ready">{tt(CHIP.ready)}</span><span class="rl-t-work">{tt(CHIP.work)}</span><span class="rl-t-late">{tt(CHIP.late)}</span><span class="rl-t-lost">{tt(CHIP.lost)}</span></span></p>
          <p class="mt-1 font-semibold">{who}<span class="font-normal text-white/60"> · {tt(what)}</span></p>
          <p class="mt-4 text-[0.95rem] text-white/75"><span class="rl-t-ready">{tt(MSG.ready)}</span><span class="rl-t-work">{tt(MSG.work)}</span><span class="rl-t-late">{tt(MSG.late)}</span><span class="rl-t-lost">{tt(MSG.lost)}</span></p>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-white/65"><span class="rl-rail">{tt('Rail')} {rail || 4}</span><span dir="ltr">{tt('Reste à payer')} : <b class="text-white">{num(due)} DH</b></span></p>
          <button type="button" class="rl-mark mt-5 inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-5 font-semibold text-navy" data-mark={i}><Icon name="check" class="size-4" />{tt('Marquer prêt')}</button>
          <button type="button" class="rl-send mt-5 inline-flex min-h-11 items-center gap-2 rounded-full bg-green px-5 font-semibold text-navy" data-send={i}><Icon name="message" class="size-4" />{tt('Envoyer le WhatsApp')}</button>
          <p class="rl-sent mt-5 inline-flex items-center gap-2 rounded-full bg-[#25D366]/20 px-4 py-2 text-sm font-semibold text-[#6BE3A0]"><Icon name="check" class="size-4" />{tt('WhatsApp envoyé à')} {who}</p>
        </div>
      ))}
    </div>
  </div>
  <p class="mt-6 flex flex-wrap items-baseline gap-x-3"><span class="text-white/60">{tt('À encaisser sur ces dépôts')}</span><span class="display text-4xl text-green tabular-nums" dir="ltr"><span data-total>0</span> DH</span></p>
</div>

<style is:global>
  .rl-chip { transition: background-color .3s, color .3s; }
  .rl-chip[aria-pressed="true"] { background: #05B962; color: #001E3E; box-shadow: none; }
  .rl-card { transition: opacity .4s, transform .4s; transform-origin: top center; animation: rl-sway 5s ease-in-out infinite; animation-delay: calc(var(--i, 0) * -.7s); }
  .rl-hang { transition: transform .35s cubic-bezier(.3,1.6,.5,1), background-color .3s, box-shadow .3s; }
  .rl-card:hover .rl-hang { transform: translateY(3px); }
  .rl-box[data-f="ready"] .rl-card:not([data-state="ready"]), .rl-box[data-f="late"] .rl-card:not([data-state="late"]), .rl-box[data-f="lost"] .rl-card:not([data-state="lost"]) { opacity: .22; }
  .rl-card[data-on="1"] .rl-hang { background: #fff; color: #001E3E; box-shadow: 0 0 0 3px #05B962; }
  .rl-card[data-on="1"] .rl-lab { color: #00804A; }
  .rl-card[data-state="ready"] .rl-dot { background: #05B962; }
  .rl-card[data-state="work"] .rl-dot { background: #4EA3FF; }
  .rl-card[data-state="late"] .rl-dot { background: #F5B301; animation: rl-ping 1.6s infinite; }
  .rl-card[data-state="lost"] .rl-dot { background: #FF6B57; animation: rl-ping 1.6s infinite; }
  .rl-card[data-state="late"] .rl-lab { color: #F5B301; } .rl-card[data-state="lost"] .rl-lab { color: #FF8F7E; } .rl-card[data-state="ready"] .rl-lab { color: #5EE0A0; } .rl-card[data-state="work"] .rl-lab { color: #8CC4FF; }
  .rl-pan { display: none; } .rl-pan.on { display: block; animation: chat-in .45s cubic-bezier(.2,.7,.2,1) both; }
  .rl-pan [class^="rl-t-"] { display: none; }
  .rl-pan[data-state="ready"] .rl-t-ready, .rl-pan[data-state="work"] .rl-t-work, .rl-pan[data-state="late"] .rl-t-late, .rl-pan[data-state="lost"] .rl-t-lost { display: inline; }
  .rl-pill { background: rgba(255,255,255,.12); }
  .rl-pan[data-state="ready"] .rl-pill { background: #05B962; color: #001E3E; } .rl-pan[data-state="late"] .rl-pill { background: #F5B301; color: #001E3E; } .rl-pan[data-state="lost"] .rl-pill { background: #FF6B57; color: #001E3E; }
  .rl-mark, .rl-send, .rl-sent { display: none; }
  .rl-pan[data-state="work"] .rl-mark { display: inline-flex; }
  .rl-pan:not([data-state="work"]):not([data-sent]) .rl-send { display: inline-flex; }
  .rl-pan[data-sent]:not([data-state="work"]) .rl-sent { display: inline-flex; }
  .rl-pan[data-state="work"] .rl-rail { display: none; }
  @keyframes rl-sway { 0%, 100% { transform: rotate(-.8deg); } 50% { transform: rotate(.8deg); } }
  @keyframes rl-ping { 0% { box-shadow: 0 0 0 0 currentColor; } 70% { box-shadow: 0 0 0 8px transparent; } }
  .rl-card[data-state="late"] .rl-dot { color: rgba(245,179,1,.6); } .rl-card[data-state="lost"] .rl-dot { color: rgba(255,107,87,.6); }
  @media (prefers-reduced-motion: reduce) { .rl-card, .rl-dot, .rl-pan.on { animation: none !important; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rl]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.rl-card')];
    const pans = [...root.querySelectorAll<HTMLElement>('.rl-pan')];
    const total = root.querySelector<HTMLElement>('[data-total]')!;
    cards.forEach((c, i) => c.style.setProperty('--i', String(i)));
    const sum = () => {
      const f = root.dataset.f!;
      const n = cards.reduce((a, c) => a + (f === 'all' || c.dataset.state === f ? Number(c.dataset.due) : 0), 0);
      total.textContent = n.toLocaleString('fr-FR');
    };
    const pick = (i: number) => {
      cards.forEach((c, k) => { c.dataset.on = k === i ? '1' : '0'; });
      pans.forEach((p, k) => p.classList.toggle('on', k === i));
    };
    root.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
      root.dataset.f = b.dataset.filter!;
      root.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      sum();
      const first = cards.findIndex((c) => root.dataset.f === 'all' || c.dataset.state === root.dataset.f);
      if (first >= 0) pick(first);
    }));
    root.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => pick(Number(b.dataset.pick))));
    root.querySelectorAll<HTMLElement>('[data-mark]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.mark); cards[i].dataset.state = 'ready'; pans[i].dataset.state = 'ready'; sum();
    }));
    root.querySelectorAll<HTMLElement>('[data-send]').forEach((b) => b.addEventListener('click', () => {
      pans[Number(b.dataset.send)].dataset.sent = '1';
    }));
    pick(0); sum();
  });
</script>
