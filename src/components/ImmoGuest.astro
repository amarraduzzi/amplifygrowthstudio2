---
// After the booking: the guest's page (arrival, wifi, rules, WhatsApp) and the cleaner's page, without an
// account (her cleanings only, "Terminé" with a photo as proof). Tap "Copier" on the wifi and "Terminé" on the
// cleaning. Demo apartment, codes and names.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
---
<div class="ig grid gap-6 sm:grid-cols-2" data-guest>
  <!-- the guest -->
  <div>
    <p class="mb-3 text-center text-sm font-bold text-white/70">{tt('La page de l’invité')}</p>
    <div class="mx-auto max-w-[19rem] rounded-[2.4rem] bg-linear-to-b from-[#3A3F47] to-[#1C1F24] p-2 shadow-[0_40px_70px_-30px_rgba(0,0,0,.8)]">
      <div class="overflow-hidden rounded-[2rem] bg-[#FAF8F3] text-navy">
        <div class="relative h-28">
          <img src="/img/immo/hayriad-studio.webp" alt="" width="900" height="672" loading="lazy" class="size-full object-cover" />
          <span class="absolute inset-0 bg-linear-to-t from-navy/80 to-transparent"></span>
          <p class="absolute bottom-2 start-3 text-white"><span class="block text-xs">{tt('Bienvenue, Samir')}</span><span class="display block text-xl">{tt('Studio Hay Riad')}</span></p>
        </div>
        <div class="space-y-2 p-3 text-sm">
          <p class="flex items-center gap-3 rounded-xl bg-white px-3 py-2 ring-1 ring-line"><Icon name="clock" class="size-4 text-green-deep" /><span><b>{tt('Arrivée dès 15 h')}</b><span class="block text-xs text-muted">{tt('Boîte à clés, code 4 2 7 1')}</span></span></p>
          <div class="flex items-center gap-3 rounded-xl bg-white px-3 py-2 ring-1 ring-line">
            <Icon name="qr" class="size-4 text-green-deep" />
            <span class="min-w-0 flex-1"><b>Wifi</b><span class="block truncate text-xs text-muted" dir="ltr">StudioHayRiad / riad2026</span></span>
            <button type="button" class="ig-copy shrink-0 rounded-full bg-navy px-3 py-1 text-xs font-bold text-white" data-copy>{tt('Copier')}</button>
          </div>
          <ul class="rounded-xl bg-white px-3 py-2 text-xs ring-1 ring-line">
            {[tt('Pas de fête, silence après 23 h'), tt('Départ avant 11 h'), tt('Non-fumeur')].map(r => <li class="flex items-center gap-2 py-0.5"><Icon name="check" class="size-3.5 text-green-deep" />{r}</li>)}
          </ul>
          <p class="flex items-center justify-center gap-2 rounded-full bg-green px-3 py-2 text-xs font-bold"><Icon name="phone" class="size-3.5" />{tt('Une question ? WhatsApp')}</p>
          <p class="text-center text-[0.68rem] font-semibold text-muted">FR, AR, EN, NL</p>
        </div>
      </div>
    </div>
    <span hidden data-t-copied>{tt('Copié !')}</span>
  </div>

  <!-- the cleaner -->
  <div>
    <p class="mb-3 text-center text-sm font-bold text-white/70">{tt('La page du ménage')}</p>
    <div class="mx-auto max-w-[19rem] rounded-[2.4rem] bg-linear-to-b from-[#3A3F47] to-[#1C1F24] p-2 shadow-[0_40px_70px_-30px_rgba(0,0,0,.8)]">
      <div class="overflow-hidden rounded-[2rem] bg-[#FAF8F3] p-3 pt-6 text-navy">
        <p class="display px-1 text-xl">{tt('Bonjour Fatima')}</p>
        <p class="px-1 text-xs text-muted">{tt('Vos ménages de la semaine')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li class="ig-task rounded-xl bg-white p-3 ring-1 ring-line" data-task>
            <p class="flex justify-between gap-2"><b>{tt('Studio Hay Riad')}</b><span class="ig-done hidden rounded-full bg-green px-2 py-0.5 text-[0.65rem] font-bold">{tt('Fait')}</span></p>
            <p class="text-xs text-muted">{tt('Aujourd’hui, après le départ de 11 h')}</p>
            <div class="ig-photo mt-2 hidden h-16 overflow-hidden rounded-lg"><img src="/img/immo/hayriad-studio.webp" alt="" width="900" height="672" loading="lazy" class="size-full object-cover" /></div>
            <button type="button" class="ig-btn mt-2 inline-flex min-h-9 w-full items-center justify-center gap-1.5 rounded-full bg-navy text-xs font-bold text-white" data-done><Icon name="check" class="size-3.5" />{tt('Terminé, avec une photo')}</button>
          </li>
          <li class="rounded-xl bg-white p-3 opacity-70 ring-1 ring-line">
            <p><b>{tt('Villa Harhoura')}</b></p>
            <p class="text-xs text-muted">{tt('Samedi, départ à 12 h')}</p>
          </li>
        </ul>
        <p class="mt-3 px-1 text-[0.68rem] text-muted">{tt('Sans compte, sans mot de passe : un lien, ses ménages, rien d’autre.')}</p>
      </div>
    </div>
  </div>
</div>

<style is:global>
  [data-task].is-done { background: rgb(5 185 98 / .12); }
  [data-task].is-done .ig-done, [data-task].is-done .ig-photo { display: block; animation: fade-up .45s ease-out both; }
  [data-task].is-done .ig-btn { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-guest]').forEach((root) => {
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    const first = copy.textContent;
    copy.addEventListener('click', () => {
      copy.textContent = root.querySelector('[data-t-copied]')!.textContent;
      setTimeout(() => (copy.textContent = first), 1500);
    });
    const task = root.querySelector<HTMLElement>('[data-task]')!;
    let touched = false;
    root.querySelector('[data-done]')!.addEventListener('click', () => { touched = true; task.classList.add('is-done'); });
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return; io.disconnect();
      setTimeout(() => { if (!touched) task.classList.add('is-done'); }, 2200);
    }, { threshold: 0.4 });
    io.observe(root);
  });
</script>
