---
// "Combien en préparer demain ?": the production forecast drawn as it happens. Light section, navy stage.
// Step 1: the last four Thursdays grow as bars, the average lands (84). Step 2: sales + catering - display
// = what to make (90). Step 3: "Produire" presses itself. Step 4: three trays of 30 croissants slide in, the
// butter stock goes down (0,55 kg a batch) and the display counter goes up. Plays once when in view; the
// "Produire" button plays it again from the start. Demo numbers, labelled as an example.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
const lang = langOf(Astro.url);
const loc = lang === 'en' ? 'en-US' : lang === 'ar' ? 'ar-MA' : 'fr-FR';
const weeks: [string, number][] = [['J-28', 78], ['J-21', 90], ['J-14', 81], ['J-7', 87]];
const pts = [tt('Un clic sur « Produire » : la farine et le beurre sortent du stock, les croissants y entrent'), tt('Les pièces faites à l’avance et les préparations faites à la minute'), tt('Un bouton « 1 fournée » remplit la quantité d’une fournée entière'), tt('La prévision apparaît après une semaine de ventes en caisse, ou tout de suite avec votre historique de ventes importé')];
---
<section id="production" class="bp mx-auto max-w-6xl scroll-mt-24 px-4 py-14 sm:px-6 md:py-24" data-tf data-bp data-loc={loc}>
  <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Combien en préparer demain ?')}</span></h2>
      <p class="tf mt-5 max-w-md text-lg text-muted" style="--d:100ms">{tt('Chaque matin, la liste de ce qu’il faut produire : les ventes du même jour de la semaine, plus les commandes traiteur, moins ce qui est déjà en vitrine.')}</p>
      <ul class="mt-6 space-y-3">{pts.map((x, k) => <li class="bp-pt tf flex items-start gap-3" data-k={k + 1} style={`--d:${200 + k * 90}ms`}><span class="bp-chk mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-green/15 text-green-deep"><Icon name="check" class="size-3.5" /></span><span class="font-semibold">{x}</span></li>)}</ul>
    </div>

    <div class="tf bp-wrap" style="--d:150ms">
      <div class="bp-stage" role="img" aria-label={tt('Prévision de production : les ventes moyennes, plus le traiteur, moins la vitrine, donnent le nombre de croissants à produire ; le stock de beurre baisse et la vitrine se remplit')} data-stage>
        <div class="bp-top">
          <p class="bp-day"><Icon name="calendar" class="size-[1.1em]" />{tt('Demain · jeudi')}</p>
          <p class="bp-ex">{tt('Exemple')}</p>
        </div>

        <!-- 1: the last four Thursdays -->
        <div class="bp-hist" data-at="1">
          <p class="bp-k">{tt('Les 4 derniers jeudis')} · {tt('Croissants')}</p>
          <div class="bp-bars">
            {weeks.map(([w, v], i) => (
              <div class="bp-col" style={`--i:${i};--h:${v}%`}><b dir="ltr">{v}</b><span class="bp-bar"></span><small dir="ltr">{w}</small></div>
            ))}
            <span class="bp-avgline" aria-hidden="true"></span>
            <span class="bp-avgchip">{tt('Moyenne vendue')} <b dir="ltr" data-avg>0</b></span>
          </div>
        </div>

        <!-- 2: sales + catering - display = to make -->
        <div class="bp-eq" data-at="2">
          <p class="bp-t" style="--i:0"><span>{tt('Ventes')}</span><b dir="ltr">84</b></p>
          <i style="--i:1">+</i>
          <p class="bp-t bp-g" style="--i:1"><span>{tt('Traiteur')}</span><b dir="ltr">12</b></p>
          <i style="--i:2">−</i>
          <p class="bp-t" style="--i:2"><span>{tt('En vitrine')}</span><b dir="ltr">6</b></p>
          <i style="--i:3">=</i>
          <p class="bp-t bp-res" style="--i:3"><span>{tt('À produire')}</span><b dir="ltr" data-res>0</b></p>
        </div>

        <!-- 3: the button -->
        <div class="bp-go" data-at="3">
          <p class="bp-batches">{tt('3 fournées de 30')}</p>
          <button type="button" class="bp-btn" data-btn><Icon name="chef" class="size-[1.1em]" />{tt('Produire')}</button>
        </div>

        <!-- 4: trays and meters -->
        <div class="bp-trays" data-at="4">
          {[1, 2, 3].map((n, t) => (
            <div class="bp-tray" style={`--t:${t}`}>
              <p><span>{tt('Fournée')} {n}</span><b dir="ltr">30 {tt('pièces')}</b></p>
              <div class="bp-cr" aria-hidden="true">
                {Array.from({ length: 10 }, (_, c) => (
                  <svg viewBox="0 0 24 14" style={`--c:${c}`}><path d="M1 12.5C1 5.5 6 1 12 1s11 4.5 11 11.5c-3-3.2-6.500-4.300-11-4.300S4 9.300 1 12.500z" fill="#E9A84C" stroke="#B9731E" stroke-width="1" stroke-linejoin="round"/><path d="M8 3.500l1.500 4M12 2.800v4.700M16 3.500l-1.500 4" stroke="#B9731E" stroke-width=".9" stroke-linecap="round" fill="none"/></svg>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="bp-meters" data-at="4">
          <div class="bp-m">
            <p><span>{tt('Beurre en stock')}</span><b dir="ltr"><i data-butter>8,00</i> kg</b></p>
            <span class="bp-track"><span class="bp-fill bp-butter" data-bfill></span></span>
          </div>
          <div class="bp-m">
            <p><span>{tt('Croissants en vitrine')}</span><b dir="ltr" data-pcs>0</b></p>
            <span class="bp-track"><span class="bp-fill bp-disp" data-pfill></span></span>
          </div>
        </div>
      </div>
      <p class="mt-3 text-xs text-muted">{tt('Exemple avec des chiffres de démonstration : 0,55 kg de beurre par fournée de 30 croissants.')}</p>
    </div>
  </div>
</section>

<style>
  .bp-wrap { container-type: inline-size; }
  .bp-stage { position: relative; overflow: hidden; font-size: clamp(10.5px, 2.7cqw, 15px); padding: 1.4em; border-radius: 1.8em; color: #fff; background: radial-gradient(70% 60% at 88% 0%, rgba(5, 185, 98, .25), transparent 70%), linear-gradient(160deg, #0a2748, #001428); box-shadow: 0 4em 6em -3em rgba(0, 30, 62, .6); }
  .bp-top { display: flex; align-items: center; justify-content: space-between; gap: 1em; }
  .bp-day { display: flex; align-items: center; gap: .5em; font-weight: 700; }
  .bp-ex { padding: .25em .8em; border-radius: 999px; background: rgba(5, 185, 98, .2); color: #5EE0A0; font-size: .8em; font-weight: 700; }
  .bp-k { font-size: .75em; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .6); }

  /* what appears at which step */
  .bp [data-at] { opacity: 0; transform: translateY(1em); transition: opacity .5s, transform .6s cubic-bezier(.2, .8, .2, 1); }
  .bp.k1 [data-at="1"], .bp.k2 [data-at="2"], .bp.k3 [data-at="3"], .bp.k4 [data-at="4"] { opacity: 1; transform: none; }

  .bp-hist { margin-top: 1.2em; padding: 1em 1.1em .9em; border-radius: 1.1em; background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08); }
  .bp-bars { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: .9em; align-items: end; height: 8.5em; margin-top: .8em; padding-top: 1.6em; }
  .bp-col { display: grid; grid-template-rows: 1.2em 1fr 1.2em; justify-items: center; height: 100%; text-align: center; }
  .bp-col b { font-size: .9em; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, .85); }
  .bp-col small { font-size: .75em; color: rgba(255, 255, 255, .5); }
  .bp-bar { align-self: end; width: 100%; height: var(--h); border-radius: .5em .5em .2em .2em; background: linear-gradient(180deg, #7fb2ff, #3f7fe0); transform-origin: bottom; transform: scaleY(0); transition: transform .7s calc(var(--i) * .18s) cubic-bezier(.2, .9, .3, 1.15); }
  .bp.k1 .bp-bar { transform: scaleY(1); }
  .bp-avgline { position: absolute; inset-inline: 0; bottom: 4.98em; border-top: .15em dashed #05B962; opacity: 0; transition: opacity .4s 1s; }
  .bp.k1 .bp-avgline { opacity: 1; }
  .bp-avgchip { position: absolute; inset-inline-end: 0; top: 0; padding: .2em .7em; border-radius: 999px; background: #05B962; color: #001E3E; font-size: .8em; font-weight: 700; opacity: 0; transform: scale(.7); transition: opacity .3s 1.1s, transform .5s 1.1s cubic-bezier(.3, 1.6, .5, 1); }
  .bp-avgchip b { font-weight: 800; font-variant-numeric: tabular-nums; }
  .bp.k1 .bp-avgchip { opacity: 1; transform: none; }

  .bp-eq { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1.25fr; align-items: stretch; gap: .45em; margin-top: .9em; }
  .bp-eq i { align-self: center; font-style: normal; font-size: 1.5em; font-weight: 800; color: rgba(255, 255, 255, .5); opacity: 0; transform: scale(.4); transition: opacity .3s calc(var(--i) * .35s + .15s), transform .4s calc(var(--i) * .35s + .15s) cubic-bezier(.3, 1.6, .5, 1); }
  .bp-t { padding: .6em .5em; border-radius: .9em; background: rgba(255, 255, 255, .08); text-align: center; line-height: 1.15; opacity: 0; transform: translateY(.8em) scale(.92); transition: opacity .4s calc(var(--i) * .35s), transform .5s calc(var(--i) * .35s) cubic-bezier(.3, 1.5, .5, 1); }
  .bp-t span { display: block; font-size: .7em; color: rgba(255, 255, 255, .6); }
  .bp-t b { display: block; margin-top: .15em; font-size: 1.9em; font-weight: 800; font-variant-numeric: tabular-nums; }
  .bp-g b { color: #5EE0A0; }
  .bp-res { background: #05B962; color: #001E3E; box-shadow: 0 0 0 0 rgba(5, 185, 98, .6); }
  .bp-res span { color: rgba(0, 30, 62, .75); font-weight: 700; }
  .bp.k2 .bp-t, .bp.k2 .bp-eq i { opacity: 1; transform: none; }
  .bp.k2 .bp-res { animation: bp-ring 1.2s 1.5s ease-out; }
  @keyframes bp-ring { 0% { box-shadow: 0 0 0 0 rgba(5, 185, 98, .8); } 100% { box-shadow: 0 0 0 1em rgba(5, 185, 98, 0); } }

  .bp-go { display: flex; align-items: center; justify-content: space-between; gap: 1em; margin-top: 1em; }
  .bp-batches { font-weight: 700; color: rgba(255, 255, 255, .85); }
  .bp-btn { display: inline-flex; align-items: center; gap: .5em; min-height: 2.8em; padding: .5em 1.5em; border-radius: 999px; background: #05B962; color: #001E3E; font-weight: 800; font-size: 1.05em; transition: transform .15s, background .2s; }
  .bp-btn:hover { background: #04A859; }
  .bp-btn.press { transform: scale(.92); animation: bp-ring .6s ease-out; }

  .bp-trays { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6em; margin-top: 1em; }
  .bp-tray { padding: .6em .6em .7em; border-radius: .9em; background: rgba(255, 255, 255, .07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .1); opacity: 0; transform: translateX(-2.2em); transition: opacity .4s calc(var(--t) * .9s), transform .6s calc(var(--t) * .9s) cubic-bezier(.2, .8, .2, 1); }
  .bp.k4 .bp-tray { opacity: 1; transform: none; }
  .bp-tray p { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 .4em; font-size: .72em; color: rgba(255, 255, 255, .6); }
  .bp-tray b { color: #5EE0A0; font-weight: 700; }
  .bp-cr { display: grid; grid-template-columns: repeat(5, 1fr); gap: .3em; margin-top: .5em; }
  .bp-cr svg { width: 100%; height: auto; transform: scale(0); transition: transform .35s calc(var(--t, 0) * 0s + var(--c) * .07s + var(--tt, 0s)) cubic-bezier(.3, 1.8, .5, 1); }
  .bp-tray:nth-child(1) .bp-cr svg { --tt: .1s; } .bp-tray:nth-child(2) .bp-cr svg { --tt: 1s; } .bp-tray:nth-child(3) .bp-cr svg { --tt: 1.9s; }
  .bp.k4 .bp-cr svg { transform: scale(1); }

  .bp-meters { display: grid; grid-template-columns: 1fr 1fr; gap: .6em; margin-top: .8em; }
  .bp-m { padding: .7em .9em; border-radius: .9em; background: rgba(255, 255, 255, .07); }
  .bp-m p { display: flex; justify-content: space-between; gap: .5em; font-size: .78em; color: rgba(255, 255, 255, .6); }
  .bp-m b { color: #fff; font-size: 1.15em; font-weight: 800; font-variant-numeric: tabular-nums; } .bp-m i { font-style: normal; }
  .bp-track { display: block; height: .55em; margin-top: .5em; border-radius: 99px; background: rgba(255, 255, 255, .14); overflow: hidden; }
  .bp-fill { display: block; height: 100%; border-radius: 99px; }
  .bp-butter { width: 100%; background: #F5C04A; }
  .bp-disp { width: 0; background: #05B962; }
  .bp-pop { animation: bp-pop .4s cubic-bezier(.3, 1.6, .5, 1); }
  @keyframes bp-pop { 40% { transform: scale(1.15); } }

  .bp-pt .bp-chk { transition: background .4s, color .4s, transform .4s cubic-bezier(.3, 1.6, .5, 1); }
  .bp-pt.on .bp-chk { background: #05B962; color: #001E3E; transform: scale(1.15); }
  @media (prefers-reduced-motion: reduce) {
    .bp [data-at], .bp-bar, .bp-t, .bp-eq i, .bp-tray, .bp-cr svg, .bp-avgchip, .bp-avgline { transition: none !important; animation: none !important; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-bp]');
  if (root) {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const lang = document.documentElement.lang;
    const comma = lang !== 'en';
    const dec = (n: number) => n.toFixed(2).replace('.', comma ? ',' : '.');
    const avg = q('[data-avg]'), res = q('[data-res]'), butter = q('[data-butter]'), pcs = q('[data-pcs]');
    const bfill = q('[data-bfill]'), pfill = q('[data-pfill]'), btn = q<HTMLButtonElement>('[data-btn]');
    const points = [...root.querySelectorAll<HTMLElement>('.bp-pt')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 3 batches: 3 x 0,55 kg of butter out of 8 kg, 3 x 30 croissants into the display (bar full at 120)
    const B0 = 8, B1 = 8 - 3 * 0.55, P1 = 90;
    const tween = (from: number, to: number, ms: number, fn: (v: number) => void) => {
      const t0 = performance.now();
      const f = (t: number) => { const k = Math.min(1, (t - t0) / ms); fn(from + (to - from) * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(f); };
      requestAnimationFrame(f);
    };
    const setStock = (b: number, p: number) => {
      butter.textContent = dec(b); pcs.textContent = String(Math.round(p));
      bfill.style.width = `${(b / B0) * 100}%`; pfill.style.width = `${Math.min(100, (p / 120) * 100)}%`;
    };
    const step = (n: number) => {
      for (let k = 1; k <= 4; k++) root.classList.toggle('k' + k, k <= n);
      points.forEach((el, i) => el.classList.toggle('on', n >= [4, 4, 3, 1][i]));
    };
    let timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const settle = () => { step(4); avg.textContent = '84'; res.textContent = '90'; setStock(B1, P1); };
    const run = () => {
      timers.forEach(clearTimeout); timers = [];
      step(0); avg.textContent = '0'; res.textContent = '0'; setStock(B0, 0);
      at(300, () => { step(1); tween(0, 84, 1000, v => { avg.textContent = String(Math.round(v)); }); });
      at(1900, () => { step(2); at(1100, () => tween(0, 90, 800, v => { res.textContent = String(Math.round(v)); })); });
      at(4200, () => { step(3); btn.classList.add('press'); at(600, () => btn.classList.remove('press')); });
      at(4800, () => {
        step(4);
        tween(0, 1, 2800, k => setStock(B0 - (B0 - B1) * k, P1 * k));
      });
    };
    btn.addEventListener('click', () => { if (still) { settle(); return; } run(); });
    if (still || !('IntersectionObserver' in window)) { root.classList.add('in'); settle(); }
    else {
      new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { root.classList.add('in'); o.disconnect(); } }, { threshold: 0.12 }).observe(root);
      new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { o.disconnect(); run(); } }, { threshold: 0.45 }).observe(q('[data-stage]'));
    }
  }
</script>
