---
// The closing card of a product page. The light follows the mouse; on the right a stopwatch runs
// while the setup ticks itself off, step by step, until the place is open for service.
import WaButton from './WaButton.astro';
import Icon from './Icon.astro';
interface Props { title: string; text: string; cta: string; href: string; wa: string; waLabel: string; where: string; steps: string[]; done: string; secs?: number }
const { title, text, cta, href, wa, waLabel, where, steps, done, secs = 290 } = Astro.props;
const words = title.split(' ');
---
<section class="px-4 pb-24 sm:px-6" data-final data-secs={secs}>
  <div class="fin relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14 md:py-16 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- light that follows the mouse, and a faint grid -->
    <div class="fin-light pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 -z-20 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:44px_44px] [mask-image:radial-gradient(ellipse_at_70%_50%,black,transparent_75%)]" aria-hidden="true"></div>

    <div>
      <h2 class="text-[2.9rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl">
        {words.map((w, i) => <span class="-mt-[0.15em] inline-block overflow-hidden pb-[0.06em] pt-[0.15em] align-bottom"><span class={`fin-w inline-block ${i >= words.length - 2 ? 'text-green' : ''}`} style={`--d:${i * 70}ms`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</span>)}
      </h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">{text}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={href} class="fin-cta group relative inline-flex min-h-12 items-center gap-2 overflow-hidden rounded-full bg-green px-8 text-lg font-semibold text-navy transition-transform hover:scale-[1.03] hover:bg-[#04A859]">{cta}<span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></a>
        <WaButton text={wa} label={waLabel} where={where} tone="light" class="px-6" />
      </div>
    </div>

    <!-- the setup, against the clock -->
    <div class="fin-panel rounded-[1.75rem] bg-white/[0.06] p-5 ring-1 ring-white/15 backdrop-blur sm:p-6" aria-hidden="true">
      <div class="flex items-center justify-between">
        <span class="text-sm font-semibold text-white/60">Mise en route</span>
        <span class="flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-semibold tabular-nums">
          <svg viewBox="0 0 24 24" class="size-4 text-green" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9.5 2.5h5"/></svg>
          <span class="fin-clock">0:00</span>
        </span>
      </div>
      <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-white/10"><span class="fin-bar block h-full w-full origin-left rounded-full bg-green transition-transform duration-700 rtl:origin-right" style="transform:scaleX(0)"></span></div>
      <ol class="mt-5 space-y-2.5">
        {steps.map((s, i) => (
          <li class="fin-step flex items-center gap-3 rounded-xl bg-white/[0.04] px-3.5 py-3 ring-1 ring-white/10 transition-all duration-500" data-i={i}>
            <span class="fin-dot grid size-7 shrink-0 place-items-center rounded-full border-2 border-white/25 text-navy transition-all duration-300"><Icon name="check" class="size-4 opacity-0 transition-opacity" /></span>
            <span class="text-[0.95rem]">{s}</span>
          </li>
        ))}
      </ol>
      <p class="fin-done mt-4 flex items-center justify-center gap-2 rounded-full bg-green py-3 font-bold text-navy">
        <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-navy opacity-40"></span><span class="relative size-2.5 rounded-full bg-navy"></span></span>{done}
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-final]').forEach((root) => {
    const card = root.querySelector<HTMLElement>('.fin')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const steps = [...root.querySelectorAll<HTMLElement>('.fin-step')];
    const clock = root.querySelector<HTMLElement>('.fin-clock')!;
    const bar = root.querySelector<HTMLElement>('.fin-bar')!;
    const total = Number(root.dataset.secs) || 290;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const finish = () => { steps.forEach(s => s.classList.add('is-done')); clock.textContent = fmt(total); bar.style.transform = 'scaleX(1)'; root.classList.add('fin-open'); };

    // the light follows the mouse
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`); card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });

    if (still || !('IntersectionObserver' in window)) { root.classList.add('fin-seen'); finish(); return; }
    const run = () => {
      const DUR = 3600, t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / DUR);
        clock.textContent = fmt(total * k);
        bar.style.transform = `scaleX(${k})`;
        steps.forEach((s, i) => s.classList.toggle('is-done', k >= (i + 1) / steps.length));
        if (k < 1) requestAnimationFrame(tick); else root.classList.add('fin-open');
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect(); root.classList.add('fin-seen');
    }, { threshold: 0.25 });
    io.observe(root);
    // the stopwatch starts when the panel itself is in view (it sits below the text on a phone)
    const io2 = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io2.disconnect(); setTimeout(run, 600);
    }, { threshold: 0.6 });
    io2.observe(root.querySelector('.fin-panel')!);
  });
</script>
