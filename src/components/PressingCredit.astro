---
// Prepaid credit of the dry cleaners page, played live: the client tops up at the counter, the tier bonus
// lands on top, then the client comes back and pays a drop-off with a 4-digit code, and every movement
// writes itself into the ledger. Plays itself once when it comes into view; every control works.
// The four cards under the stage light up when the demo reaches what they say. Demo shop, invented figures.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
interface Props { cards: readonly (readonly [string, string, string])[] }
const { cards } = Astro.props;
const lang = langOf(Astro.url);
const tt = tr(lang);
const num = (n: number) => n.toLocaleString(lang === 'en' ? 'en-US' : 'fr-FR');
const TIERS: [number, number][] = [[200, 5], [500, 10], [1000, 15]];
const STEPS = [tt('Il recharge'), tt('Le bonus s’ajoute'), tt('Il paie avec son code')];
const FEAT = ['tier', 'code', 'gift', 'ledger'];
const coins = Array.from({ length: 10 }, (_, k) => {
  const a = (k / 10) * Math.PI * 2 - Math.PI / 2, r = 64 + (k % 3) * 14;
  return `--x:${Math.round(Math.cos(a) * r)}px;--y:${Math.round(Math.sin(a) * r)}px;--k:${k}`;
});
---
<div class="pc" data-credit data-lang={lang}>
  <div class="relative isolate overflow-hidden rounded-[2.5rem] bg-navy p-5 text-white shadow-[0_60px_100px_-55px_rgba(0,30,62,0.9)] sm:p-8 md:p-10">
    <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
    <span class="sl-blob sl-blob-b" aria-hidden="true"></span>

    <!-- the three beats -->
    <ol class="flex flex-wrap items-center gap-x-3 gap-y-3">
      {STEPS.map((s, i) => (
        <Fragment>
          <li class="pc-step flex items-center gap-2.5 text-sm font-semibold sm:text-base" data-s={i + 1}>
            <span class="pc-node grid size-8 place-items-center rounded-full text-sm font-bold ring-1 ring-white/25" dir="ltr">{i + 1}</span>{s}
          </li>
          {i < 2 && <li class="pc-sep h-px w-5 bg-white/25 sm:w-12" aria-hidden="true"></li>}
        </Fragment>
      ))}
    </ol>

    <div class="mt-8 grid items-stretch gap-5 lg:grid-cols-[1.05fr_0.8fr_1fr]">
      <!-- the till -->
      <div class="flex flex-col rounded-[1.75rem] bg-white/[0.07] p-5 ring-1 ring-white/10 sm:p-6">
        <p class="flex items-center gap-2 font-bold"><Icon name="till" class="size-5 text-green" />{tt('Recharge au comptoir')}</p>
        <p class="mt-5 text-sm text-white/60">{tt('Le client donne')}</p>
        <p class="display mt-1 text-5xl tabular-nums sm:text-6xl" dir="ltr"><span data-given>500</span> <span class="text-2xl text-white/70">DH</span></p>
        <div class="mt-5 grid grid-cols-3 gap-2" role="group" aria-label={tt('Montant de la recharge')}>
          {TIERS.map(([a, p]) => (
            <button type="button" class={`pc-chip flex min-h-14 flex-col items-center justify-center rounded-2xl px-1 py-2 ring-1 ring-white/20 ${a === 500 ? 'is-on' : ''}`} data-amt={a} data-p={p} aria-pressed={String(a === 500)}>
              <span class="display text-2xl tabular-nums" dir="ltr">{num(a)}</span>
              <span class="text-xs font-bold" dir="ltr">+{p} %</span>
            </button>
          ))}
        </div>
        <div class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-white/[0.07] px-4 py-3 ring-1 ring-white/10">
          <span class="text-sm text-white/75">{tt('Bonus de la tranche')}</span>
          <span class="pc-bonus display tabular-nums text-green" style="white-space:nowrap;font-size:2rem" dir="ltr" data-bonus-box>+ <span data-bonus>50</span> DH</span>
        </div>
        <p class="mt-4 flex-1 text-sm leading-relaxed text-white/60" data-note>{tt('Choisissez un montant : la tranche donne son bonus.')}</p>
        <button type="button" class="mt-4 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-green px-6 text-lg font-bold text-navy transition-transform active:scale-[.98]" data-act>
          <Icon name="coins" class="size-5" /><span data-act-label>{tt('Encaisser la recharge')}</span>
        </button>
      </div>

      <!-- the client's phone -->
      <div class="mx-auto w-full max-w-[20rem] self-center rounded-[2.4rem] bg-white/10 p-2.5 ring-1 ring-white/20 lg:max-w-none">
        <div class="rounded-[1.9rem] bg-white px-5 pb-5 pt-6 text-navy">
          <p class="text-center text-xs font-semibold text-muted">{tt('Mon crédit chez Pressing Démo')}</p>
          <div class="relative mt-3 text-center">
            <span class="pc-burst" data-burst aria-hidden="true">{coins.map(s => <i style={s}></i>)}</span>
            <span class="pc-bal display text-6xl tabular-nums" dir="ltr" data-bal>0</span> <span class="display text-2xl" dir="ltr">DH</span>
          </div>
          <p class="pc-pill mx-auto mt-2 w-fit rounded-full bg-mint px-3 py-1 text-xs font-bold text-green-deep" data-pill hidden><span dir="ltr">+ <span data-pill-v>50</span> DH</span> {tt('de bonus')}</p>
          <div class="pc-pay mt-5 rounded-2xl bg-chalk p-3.5" data-pay>
            <p class="flex items-center justify-between gap-3 text-sm"><span class="font-semibold">{tt('Dépôt n° 1043')}</span><span class="font-bold tabular-nums" dir="ltr">145 DH</span></p>
            <p class="mt-0.5 text-xs text-muted">{tt('2 chemises et un costume')}</p>
            <div class="mt-3 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-muted">{tt('Code à 4 chiffres')}</span>
              <span class="flex gap-1.5" dir="ltr">{[0, 1, 2, 3].map(() => <span class="pc-dot size-3.5 rounded-full border-2 border-line"></span>)}</span>
            </div>
            <p class="pc-ok mt-3 flex items-center justify-center gap-2 rounded-xl bg-green py-2 text-sm font-bold text-navy" data-ok hidden><Icon name="check" class="size-4" />{tt('Payé avec le crédit')}</p>
          </div>
        </div>
      </div>

      <!-- the ledger -->
      <div class="flex flex-col rounded-[1.75rem] bg-white p-5 text-navy sm:p-6" data-ledger-card>
        <p class="flex items-center gap-2 font-bold"><Icon name="book" class="size-5 text-green-deep" />{tt('Chaque mouvement est écrit')}</p>
        <div class="relative mt-4 min-h-[11rem] flex-1">
          <ul class="space-y-2" data-ledger></ul>
          <p class="pc-empty absolute inset-0 grid place-items-center px-4 text-center text-sm text-muted" data-empty>{tt('Le registre se remplit tout seul.')}</p>
        </div>
        <div class="mt-3 flex items-end justify-between gap-3 border-t border-line pt-3">
          <span class="min-w-0 text-sm leading-snug text-muted">{tt('Ce que vous devez encore à vos clients')}</span>
          <span class="display tabular-nums" style="white-space:nowrap;font-size:2rem" dir="ltr"><span data-owed>0</span> DH</span>
        </div>
      </div>
    </div>
  </div>

  <!-- the four promises, lit when the demo gets to them -->
  <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {cards.map(([i, h, x], k) => (
      <li class="tf pc-card rounded-[1.75rem] bg-paper p-6 ring-1 ring-line" data-feat={FEAT[k]} style={`--d:${k * 80}ms`}>
        <span class="pc-ic grid size-11 place-items-center rounded-2xl bg-navy text-green transition-colors duration-500"><Icon name={i} class="size-5" /></span>
        <p class="mt-4 font-semibold">{tt(h)}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{tt(x)}</p>
      </li>
    ))}
  </ul>

  <span hidden data-t="topup">{tt('Recharge')}</span>
  <span hidden data-t="bonus">{tt('Bonus')}</span>
  <span hidden data-t="spend">{tt('Dépôt n° 1043')}</span>
  <span hidden data-t="a-go">{tt('Encaisser la recharge')}</span>
  <span hidden data-t="a-back">{tt('Le client revient')}</span>
  <span hidden data-t="a-again">{tt('Rejouer')}</span>
  <span hidden data-t="n-idle">{tt('Choisissez un montant : la tranche donne son bonus.')}</span>
  <span hidden data-t="n-bonus">{tt('Le bonus reste dans le crédit. Jamais versé en argent.')}</span>
  <span hidden data-t="n-pay">{tt('Le client paie avec son code. Personne d’autre ne dépense son crédit.')}</span>
</div>

<style is:global>
  .pc-chip { color: rgb(255 255 255 / .85); transition: background-color .25s, color .25s, transform .2s; }
  .pc-chip:hover { background: rgb(255 255 255 / .08); }
  .pc-chip:active { transform: scale(.96); }
  .pc-chip.is-on { background: var(--color-green); color: var(--color-navy); box-shadow: none; }
  .pc-step { color: rgb(255 255 255 / .45); transition: color .4s; }
  .pc-step .pc-node { transition: background-color .4s, color .4s, transform .4s cubic-bezier(.3,1.6,.5,1); }
  .pc-step.on, .pc-step.done { color: #fff; }
  .pc-step.on .pc-node { background: var(--color-green); color: var(--color-navy); transform: scale(1.12); box-shadow: 0 0 0 6px rgb(5 185 98 / .2); }
  .pc-step.done .pc-node { background: rgb(5 185 98 / .25); color: var(--color-green); }
  .pc-bal.bump { animation: pc-bump .6s ease-out; }
  @keyframes pc-bump { 0% { color: var(--color-green-deep); transform: translateY(-4px) scale(1.06); } }
  .pc-bonus.pulse { animation: pc-pulse .9s ease-out; }
  @keyframes pc-pulse { 40% { transform: scale(1.12); } }
  .pc-pill:not([hidden]) { animation: pc-pop .6s cubic-bezier(.3,1.6,.5,1); }
  @keyframes pc-pop { from { opacity: 0; transform: translateY(8px) scale(.8); } }
  .pc-pay { opacity: .45; transition: opacity .5s, box-shadow .5s, background-color .5s; }
  .pc-pay.live { opacity: 1; box-shadow: 0 0 0 2px var(--color-green); background: #fff; }
  .pc-dot { transition: background-color .2s, border-color .2s, transform .3s cubic-bezier(.3,1.8,.5,1); }
  .pc-dot.on { background: var(--color-navy); border-color: var(--color-navy); transform: scale(1.2); }
  .pc-ok:not([hidden]) { animation: pc-pop .6s cubic-bezier(.3,1.6,.5,1); }
  .pc-row { animation: pc-row .6s cubic-bezier(.2,.9,.3,1.2) both; }
  @keyframes pc-row { from { opacity: 0; transform: translateX(18px); background-color: rgb(5 185 98 / .3); } }
  [dir="rtl"] .pc-row { animation-name: pc-row-rtl; }
  @keyframes pc-row-rtl { from { opacity: 0; transform: translateX(-18px); background-color: rgb(5 185 98 / .3); } }
  .pc-empty { transition: opacity .3s; }
  .pc-empty.gone { opacity: 0; pointer-events: none; }
  .pc-burst { position: absolute; inset-inline-start: 50%; top: 50%; width: 0; height: 0; pointer-events: none; z-index: 1; }
  .pc-burst i { position: absolute; width: .7rem; height: .7rem; margin: -.35rem; border-radius: 99px; background: #F5B301; opacity: 0; box-shadow: inset 0 0 0 2px rgb(0 0 0 / .12); }
  .pc-burst.go i { animation: pc-coin 1.1s cubic-bezier(.2,.8,.3,1) both; animation-delay: calc(var(--k) * 35ms); }
  @keyframes pc-coin { 0% { opacity: 1; transform: translate(0, 0) scale(.5); } 100% { opacity: 0; transform: translate(var(--x), var(--y)) scale(1.1); } }
  .pc-card { transition: box-shadow .5s, transform .5s cubic-bezier(.2,.8,.2,1); }
  .pc-card.is-on { box-shadow: 0 30px 60px -35px rgb(0 30 62 / .5), 0 0 0 2px var(--color-green); }
  .pc-card.is-on .pc-ic { background: var(--color-green); color: var(--color-navy); }
  @media (prefers-reduced-motion: reduce) {
    .pc-bal.bump, .pc-bonus.pulse, .pc-pill:not([hidden]), .pc-ok:not([hidden]), .pc-row, .pc-burst.go i { animation: none; }
    .pc-burst i { display: none; }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TIER: Record<number, number> = { 200: 5, 500: 10, 1000: 15 };
  const BILL = 145;
  document.querySelectorAll<HTMLElement>('[data-credit]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const T = (k: string) => root.querySelector(`[data-t="${k}"]`)?.textContent ?? '';
    const loc = root.dataset.lang === 'en' ? 'en-US' : 'fr-FR';
    const fmt = (n: number) => Math.round(n).toLocaleString(loc).replace(/ /g, ' ');
    const given = q('[data-given]'), bonusEl = q('[data-bonus]'), bonusBox = q('[data-bonus-box]');
    const bal = q('[data-bal]'), owed = q('[data-owed]'), pill = q('[data-pill]'), pillV = q('[data-pill-v]');
    const pay = q('[data-pay]'), ok = q('[data-ok]'), ledger = q('[data-ledger]'), empty = q('[data-empty]');
    const note = q('[data-note]'), act = q('[data-act]'), actLabel = q('[data-act-label]'), burst = q('[data-burst]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.pc-chip')];
    const dots = [...root.querySelectorAll<HTMLElement>('.pc-dot')];
    const steps = [...root.querySelectorAll<HTMLElement>('.pc-step')];
    const feats = [...root.querySelectorAll<HTMLElement>('[data-feat]')];
    let amt = 500, phase = 0, run = 0, balance = 0, touched = false;
    const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, still ? 0 : ms));
    const bonus = () => Math.round(amt * TIER[amt] / 100);

    const lit = (names: string[]) => feats.forEach((f) => f.classList.toggle('is-on', names.includes(f.dataset.feat!)));
    const stepTo = (n: number) => steps.forEach((s) => { const i = Number(s.dataset.s); s.classList.toggle('on', i === n); s.classList.toggle('done', i < n); });
    const paintAmt = () => {
      given.textContent = fmt(amt); bonusEl.textContent = fmt(bonus());
      chips.forEach((c) => { const on = Number(c.dataset.amt) === amt; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
    };
    const setBalance = (to: number, id: number, ms = 800) => new Promise<void>((resolve) => {
      const from = balance; balance = to;
      const done = () => { bal.textContent = fmt(to); owed.textContent = fmt(to); resolve(); };
      if (still || from === to) return done();
      const t0 = performance.now();
      const tick = (t: number) => {
        if (id !== run) return resolve();
        const k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 3), v = fmt(from + (to - from) * e);
        bal.textContent = v; owed.textContent = v;
        if (k < 1) requestAnimationFrame(tick); else { bal.classList.remove('bump'); void bal.offsetWidth; bal.classList.add('bump'); resolve(); }
      };
      requestAnimationFrame(tick);
    });
    const row = (label: string, v: number, plus: boolean) => {
      const li = document.createElement('li');
      li.className = 'pc-row flex items-center gap-3 rounded-xl bg-chalk px-3 py-2.5';
      const a = document.createElement('span');
      a.className = `grid size-7 shrink-0 place-items-center rounded-full text-sm font-bold ${plus ? 'bg-mint text-green-deep' : 'bg-navy/10 text-navy'}`;
      a.dir = 'ltr'; a.textContent = plus ? '+' : '−';
      const b = document.createElement('span'); b.className = 'min-w-0 flex-1 text-sm font-semibold'; b.textContent = label;
      const c = document.createElement('span'); c.className = 'text-sm font-bold tabular-nums'; c.dir = 'ltr'; c.textContent = `${plus ? '+' : '−'}${fmt(v)} DH`;
      li.append(a, b, c); ledger.append(li); empty.classList.add('gone');
    };
    const reset = () => {
      balance = 0; phase = 0; bal.textContent = '0'; owed.textContent = '0';
      ledger.innerHTML = ''; empty.classList.remove('gone'); pill.hidden = true; ok.hidden = true;
      pay.classList.remove('live'); dots.forEach((d) => d.classList.remove('on'));
      note.textContent = T('n-idle'); actLabel.textContent = T('a-go'); stepTo(0); lit([]);
    };

    const topup = async (): Promise<boolean> => {
      const id = ++run; reset(); paintAmt(); stepTo(1); lit(['gift', 'ledger']);
      await sleep(400); if (id !== run) return false;
      row(T('topup'), amt, true); await setBalance(amt, id); if (id !== run) return false;
      await sleep(600); if (id !== run) return false;
      stepTo(2); lit(['tier', 'ledger']);
      pillV.textContent = fmt(bonus()); pill.hidden = false;
      if (!still) { burst.classList.remove('go'); void burst.offsetWidth; burst.classList.add('go'); }
      bonusBox.classList.remove('pulse'); void bonusBox.offsetWidth; bonusBox.classList.add('pulse');
      row(`${T('bonus')} ${TIER[amt]} %`, bonus(), true); note.textContent = T('n-bonus');
      await setBalance(amt + bonus(), id); if (id !== run) return false;
      phase = 1; actLabel.textContent = T('a-back'); return true;
    };
    const spend = async (): Promise<boolean> => {
      const id = ++run; stepTo(3); lit(['code', 'ledger']); pill.hidden = true; note.textContent = T('n-pay');
      pay.classList.add('live'); await sleep(500); if (id !== run) return false;
      for (const d of dots) { d.classList.add('on'); await sleep(380); if (id !== run) return false; }
      ok.hidden = false; await sleep(300); if (id !== run) return false;
      row(T('spend'), BILL, false); await setBalance(balance - BILL, id); if (id !== run) return false;
      stepTo(4); phase = 2; actLabel.textContent = T('a-again'); return true;
    };

    act.addEventListener('click', () => { touched = true; if (phase === 1) void spend(); else void topup(); });
    chips.forEach((c) => c.addEventListener('click', () => {
      touched = true; amt = Number(c.dataset.amt);
      if (phase === 0) { paintAmt(); } else { void topup(); }
    }));

    reset(); paintAmt();
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return; io.disconnect();
        setTimeout(async () => { if (touched) return; if (await topup() && !touched) { await sleep(1300); if (!touched) void spend(); } }, 700);
      }, { threshold: 0.2 });
      io.observe(root.firstElementChild as HTMLElement);
    } else { void topup().then(() => spend()); }
  });
</script>
