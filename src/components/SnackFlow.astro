---
// Snack mode, from the counter to the TV: the order is taken on a first name, the options collapse into
// "Légumes : tout", the till collects first, and only then the kitchen gets the bon. On the pickup board
// (any TV, French and Arabic) the name goes from "En préparation" to "Prêtes" with a chime.
// Plays itself once when it comes into view; every button works. Demo names and prices.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
const veg = [tt('Tomate'), tt('Oignon'), tt('Salade'), tt('Maïs'), tt('Olives')];
---
<div class="sf grid gap-5 lg:grid-cols-[0.85fr_1.15fr]" data-snack>
  <!-- the till -->
  <div class="rounded-[2rem] bg-white p-5 text-navy shadow-[0_40px_80px_-40px_rgba(0,0,0,0.6)] sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <p class="flex items-center gap-2 font-bold"><Icon name="till" class="size-5 text-green-deep" />{tt('Comptoir')}</p>
      <span class="rounded-full bg-chalk px-3 py-1 text-sm font-bold ring-1 ring-line">{tt('Prénom :')} <span class="text-green-deep">Yassine</span></span>
    </div>
    <div class="mt-4 rounded-2xl bg-chalk p-4">
      <div class="flex items-baseline justify-between gap-3"><span class="font-bold">{tt('Bocadillo poulet')}</span><span class="font-bold tabular-nums" dir="ltr">35 DH</span></div>
      <div class="mt-2 flex flex-wrap gap-1.5" data-veg>
        {veg.map(v => <span class="sf-chip rounded-full bg-white px-2.5 py-1 text-xs font-bold ring-1 ring-line">{v}</span>)}
      </div>
      <p class="sf-all mt-2 hidden text-sm font-bold text-green-deep" data-all>{tt('Légumes : tout')}</p>
      <div class="mt-3 flex items-baseline justify-between gap-3 border-t border-line pt-3"><span class="font-bold">{tt('Frites')}</span><span class="font-bold tabular-nums" dir="ltr">10 DH</span></div>
    </div>
    <div class="mt-4 flex items-end justify-between gap-3">
      <span class="text-sm text-muted">{tt('Total')}</span>
      <span class="display whitespace-nowrap text-4xl tabular-nums sm:text-5xl" dir="ltr">45 DH</span>
    </div>
    <button type="button" class="mt-4 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-green px-6 text-lg font-bold text-navy transition-transform active:scale-[.98] disabled:opacity-40" data-pay>
      <Icon name="coins" class="size-5" />{tt('Encaisser, puis cuisine')}
    </button>
    <p class="mt-3 text-sm text-muted" data-sf-note>{tt('Tant que ce n’est pas payé, la cuisine ne reçoit rien.')}</p>
    <span hidden data-t-sent>{tt('Payé. Le bon est parti en cuisine, Yassine s’affiche sur la télé.')}</span>
  </div>

  <!-- the pickup board on the TV -->
  <div class="flex flex-col">
    <div class="rounded-[1.6rem] bg-[#0A0F1A] p-2.5 shadow-[0_50px_90px_-50px_rgba(0,0,0,0.9)] ring-1 ring-white/10">
      <div class="grid min-h-[12rem] grid-cols-2 sm:min-h-[19rem] gap-px overflow-hidden rounded-[1.1rem] bg-white/10">
        <div class="bg-navy p-4 sm:p-5">
          <p class="text-sm font-bold text-[#F5B301] sm:text-base">En préparation <span lang="ar" dir="rtl" class="opacity-70">قيد التحضير</span></p>
          <ul class="mt-4 space-y-2" data-col="prep">
            <li class="sf-name display" data-id="salma">Salma</li>
            <li class="sf-name display" data-id="omar">Omar</li>
          </ul>
        </div>
        <div class="bg-navy p-4 sm:p-5">
          <p class="text-sm font-bold text-green sm:text-base">Prêtes <span lang="ar" dir="rtl" class="opacity-70">جاهزة</span></p>
          <ul class="mt-4 space-y-2" data-col="ready">
            <li class="sf-name display" data-id="nadia">Nadia</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mx-auto h-5 w-24 rounded-b-xl bg-[#0A0F1A]/80" aria-hidden="true"></div>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold text-white/70">{tt('En cuisine :')}</span>
      <button type="button" class="min-h-10 rounded-full bg-white/10 px-4 text-sm font-bold text-white ring-1 ring-white/20 transition-colors hover:bg-white/15 disabled:opacity-40" data-ready disabled>{tt('Commande de Yassine prête')}</button>
      <span class="text-sm font-semibold text-white/70">{tt('Au comptoir :')}</span>
      <button type="button" class="min-h-10 rounded-full bg-white/10 px-4 text-sm font-bold text-white ring-1 ring-white/20 transition-colors hover:bg-white/15 disabled:opacity-40" data-given disabled>{tt('Remise au client')}</button>
    </div>
    <p class="mt-3 flex items-center gap-2 text-sm text-white/60"><Icon name="bell" class="size-4 text-green" /><span data-bell>{tt('Un son sur la télé quand une commande est prête.')}</span></p>
  </div>
</div>

<style is:global>
  .sf-name { font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1; color: #fff; transition: opacity .4s, transform .4s; }
  [data-col="ready"] .sf-name { color: var(--color-green); }
  .sf-name.sf-in { animation: sf-in .6s cubic-bezier(.3,1.5,.5,1); }
  [data-col="ready"] .sf-name.sf-in { animation: sf-ready 1.4s ease-out; }
  @keyframes sf-in { from { opacity: 0; transform: translateY(10px); } }
  @keyframes sf-ready { 0% { opacity: 0; transform: scale(.8); } 20% { opacity: 1; transform: scale(1.12); text-shadow: 0 0 24px rgb(5 185 98 / .9); } 100% { transform: none; } }
  .sf-name.sf-out { opacity: 0; transform: translateX(16px); }
  .sf-chip { transition: opacity .35s, transform .35s; }
  [data-snack].is-all .sf-chip { opacity: 0; transform: scale(.6); }
  @media (prefers-reduced-motion: reduce) { .sf-name.sf-in, [data-col="ready"] .sf-name.sf-in { animation: none; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-snack]').forEach((root) => {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const prep = $('[data-col="prep"]'), ready = $('[data-col="ready"]');
    const pay = $<HTMLButtonElement>('[data-pay]'), rd = $<HTMLButtonElement>('[data-ready]'), gv = $<HTMLButtonElement>('[data-given]');
    let touched = false;
    const add = (col: HTMLElement, id: string, name: string) => {
      const li = document.createElement('li'); li.className = 'sf-name display sf-in'; li.dataset.id = id; li.textContent = name;
      col.prepend(li);
    };
    // the five vegetables collapse into one line, as on the bon
    const collapse = () => {
      root.classList.add('is-all');
      setTimeout(() => { $('[data-veg]').classList.add('hidden'); $('[data-all]').classList.remove('hidden'); }, still ? 0 : 380);
    };
    const doPay = () => {
      pay.disabled = true; collapse();
      $('[data-sf-note]').textContent = $('[data-t-sent]').textContent;
      add(prep, 'yassine', 'Yassine'); rd.disabled = false;
    };
    const doReady = () => {
      rd.disabled = true;
      const li = prep.querySelector<HTMLElement>('[data-id="yassine"]');
      if (li) li.remove();
      add(ready, 'yassine', 'Yassine'); gv.disabled = false;
    };
    const doGiven = () => {
      gv.disabled = true;
      const li = ready.querySelector<HTMLElement>('[data-id="yassine"]');
      if (!li) return;
      li.classList.add('sf-out'); setTimeout(() => li.remove(), still ? 0 : 400);
    };
    pay.addEventListener('click', () => { touched = true; doPay(); });
    rd.addEventListener('click', () => { touched = true; doReady(); });
    gv.addEventListener('click', () => { touched = true; doGiven(); });
    if (!still && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return; io.disconnect();
        setTimeout(() => { if (!touched) doPay(); }, 1400);
        setTimeout(() => { if (!touched) doReady(); }, 3600);
      }, { threshold: 0.4 });
      io.observe(root);
    }
  });
</script>
