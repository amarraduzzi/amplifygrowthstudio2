---
import WaButton from './WaButton.astro';
import Bars from './Bars.astro';
import { copy } from '../i18n';
import type { Lang, PageKey } from '../i18n/routes';
interface Props { lang: Lang; page: PageKey; h2: string; p: string; wa: string }
const { lang, page, h2, p, wa } = Astro.props;
const t = copy(lang);
---
<section class="relative isolate overflow-hidden bg-blue text-white">
  <Bars class="absolute inset-x-0 bottom-0 -z-10 h-28" />
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-20 sm:px-6 md:flex-row md:items-end md:justify-between">
    <div>
      <h2 class="text-6xl md:text-7xl">{h2}</h2>
      <p class="mt-4 max-w-md text-lg text-white/75">{p}</p>
    </div>
    <WaButton text={wa} label={t.ui.whatsapp} where={`${page}-final`} class="shrink-0 px-8 text-lg" />
  </div>
</section>
