---
// The cagnotte, seen from both sides: the till (bill, 3/5/10 %, "Encaisser") and the guest's phone (the balance
// in dirhams and the menu, where what it already pays for lights up). What is earned waits for the next visit:
// "Visite suivante" moves it into the balance. Below, the ardoise settled with one tap on "Payé".
// Plays itself once when it comes into view; every control works. Demo guest and figures.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
const menu: [string, number][] = [
  [tt('Thé à la menthe'), 15],
  [tt('Café crème'), 18],
  [tt('Jus d’orange pressé'), 25],
  [tt('Msemen au miel'), 30],
  [tt('Tajine poulet citron'), 75],
];
---
<div class="cg grid gap-5 lg:grid-cols-[1fr_0.9fr]" data-cagnotte>
  <!-- the till -->
  <div class="relative isolate overflow-hidden rounded-[2rem] bg-navy p-5 text-white shadow-[0_50px_90px_-50px_rgba(0,30,62,0.8)] sm:p-7">
    <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_0%_100%,rgba(5,185,98,.2),transparent_70%)]" aria-hidden="true"></span>
    <p class="flex items-center gap-2 font-bold"><Icon name="till" class="size-5 text-green" />{tt('La caisse')}</p>
    <div class="mt-5 flex items-end justify-between gap-3">
      <label for="cg-bill" class="text-sm text-white/60">{tt('Addition de Sara')}</label>
      <span class="display text-4xl tabular-nums sm:text-5xl" dir="ltr"><span data-bill>200</span> DH</span>
    </div>
    <input id="cg-bill" type="range" min="50" max="600" step="10" value="200" class="cg-range mt-3 w-full" data-range />
    <p class="mt-5 text-sm text-white/60">{tt('Ce qui revient au client')}</p>
    <div class="mt-2 flex gap-2" role="group" aria-label={tt('Ce qui revient au client')}>
      {[3, 5, 10].map(p => <button type="button" class={`cg-pct min-h-11 flex-1 rounded-full text-lg font-bold ring-1 ring-white/20 ${p === 5 ? 'is-on' : ''}`} data-pct={p} aria-pressed={String(p === 5)} dir="ltr">{p} %</button>)}
    </div>
    <div class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-white/[0.07] px-4 py-3 ring-1 ring-white/10">
      <span class="text-sm text-white/75">{tt('Dans la cagnotte')}</span>
      <span class="display text-3xl tabular-nums text-green" dir="ltr">+ <span data-earn>10</span> DH</span>
    </div>
    <button type="button" class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-green px-6 text-lg font-bold text-navy transition-transform active:scale-[.98]" data-act>
      <Icon name="check" class="size-5" /><span data-act-label>{tt('Encaisser')}</span>
    </button>
    <p class="mt-3 text-center text-sm text-white/55" data-note>{tt('1 point = 1 DH. Rien à calculer pour l’équipe.')}</p>
    <span hidden data-t-pay>{tt('Encaisser')}</span>
    <span hidden data-t-next>{tt('Visite suivante')}</span>
    <span hidden data-t-wait>{tt('Gagné aujourd’hui, à dépenser à la prochaine visite. Jamais sur la même addition.')}</span>
    <span hidden data-t-in>{tt('Sara est revenue : sa cagnotte est prête à payer.')}</span>
  </div>

  <!-- the guest's phone -->
  <div class="mx-auto w-full max-w-[22rem] self-center rounded-[2.4rem] bg-navy p-2.5 shadow-[0_40px_80px_-40px_rgba(0,30,62,0.6)]">
    <div class="rounded-[1.9rem] bg-white px-5 pb-5 pt-6 text-navy">
      <p class="text-center text-xs font-semibold text-muted">{tt('Ma cagnotte chez Café Démo')}</p>
      <p class="mt-3 text-center"><span class="cg-bal display text-6xl tabular-nums" dir="ltr" data-bal>18</span> <span class="display text-2xl" dir="ltr">DH</span></p>
      <p class="cg-pend mx-auto mt-2 w-fit rounded-full border border-dashed border-green-deep/60 px-3 py-1 text-xs font-bold text-green-deep" data-pend hidden><span dir="ltr">+ <span data-pend-v>10</span> DH</span> {tt('à la prochaine visite')}</p>
      <p class="mt-5 text-sm font-semibold">{tt('Ce que ma cagnotte m’offre déjà')}</p>
      <ul class="mt-2 space-y-1.5">
        {menu.map(([n, p]) => (
          <li class="cg-item flex items-center gap-3 rounded-xl bg-chalk px-3 py-2.5 transition-colors duration-500" data-price={p}>
            <span class="cg-dot grid size-6 shrink-0 place-items-center rounded-full border-2 border-line transition-all duration-500"><Icon name="gift" class="size-3.5 opacity-0 transition-opacity" /></span>
            <span class="min-w-0 flex-1 text-sm font-semibold">{n}</span>
            <span class="text-sm font-bold tabular-nums" dir="ltr">{p} DH</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-center text-xs text-muted">{tt('Le menu est la liste des cadeaux.')}</p>
    </div>
  </div>

  <!-- the ardoise -->
  <div class="flex flex-wrap items-center gap-4 rounded-[1.75rem] bg-white p-5 ring-1 ring-line lg:col-span-2" data-ardoise>
    <span class="flex min-w-0 basis-full items-center gap-4 sm:basis-auto sm:flex-1">
      <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-mint text-green-deep"><Icon name="book" class="size-6" /></span>
      <span class="min-w-0 flex-1">
        <span class="block font-bold">{tt('L’ardoise de M. Karim')}</span>
        <span class="block text-sm text-muted" data-ard-sub>{tt('Il paie à la fin du mois. Plafond 500 DH.')}</span>
      </span>
    </span>
    <span class="ms-auto flex items-center gap-4">
      <span class="display whitespace-nowrap text-4xl tabular-nums" dir="ltr"><span data-ard>340</span> DH</span>
      <button type="button" class="min-h-11 rounded-full bg-navy px-6 font-bold text-white transition-transform active:scale-95" data-paid>{tt('Payé')}</button>
    </span>
    <span hidden data-t-clear>{tt('Soldée en un tap. Le relevé reste dans son historique.')}</span>
  </div>
</div>

<style is:global>
  .cg-range { accent-color: var(--color-green); height: 2.25rem; }
  .cg-pct { color: rgb(255 255 255 / .8); transition: background-color .25s, color .25s; }
  .cg-pct.is-on { background: var(--color-green); color: var(--color-navy); box-shadow: none; }
  .cg-item.is-free { background: rgb(5 185 98 / .12); }
  .cg-item.is-free .cg-dot { background: var(--color-green); border-color: var(--color-green); color: var(--color-navy); }
  .cg-item.is-free .cg-dot svg { opacity: 1; }
  .cg-item.is-new { animation: cg-pop .7s cubic-bezier(.3,1.6,.5,1); }
  @keyframes cg-pop { 40% { transform: scale(1.04); } }
  .cg-bal.bump { animation: cg-bump .6s ease-out; }
  @keyframes cg-bump { 0% { color: var(--color-green-deep); transform: translateY(-4px); } }
  .cg-pend:not([hidden]) { animation: cg-in .5s ease-out; }
  @keyframes cg-in { from { opacity: 0; transform: translateY(6px); } }
  [data-ardoise].is-clear [data-paid] { display: none; }
  [data-ardoise].is-clear { background: rgb(5 185 98 / .1); }
  @media (prefers-reduced-motion: reduce) { .cg-item.is-new, .cg-bal.bump, .cg-pend:not([hidden]) { animation: none; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const comma = document.documentElement.lang !== 'en';
  document.querySelectorAll<HTMLElement>('[data-cagnotte]').forEach((root) => {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const txt = (s: string) => $(s).textContent ?? '';
    const range = $<HTMLInputElement>('[data-range]');
    const bill = $('[data-bill]'), earnEl = $('[data-earn]'), bal = $('[data-bal]');
    const pend = $('[data-pend]'), pendV = $('[data-pend-v]'), note = $('[data-note]');
    const act = $('[data-act]'), actLabel = $('[data-act-label]');
    const items = [...root.querySelectorAll<HTMLElement>('.cg-item')];
    const show = (x: number) => (Math.round(x * 10) / 10).toString().replace('.', comma ? ',' : '.');
    let balance = 18, pct = 5, waiting = 0, touched = false;
    const earn = () => Number(range.value) * pct / 100;
    const paint = () => { bill.textContent = range.value; earnEl.textContent = show(earn()); };
    const light = () => items.forEach((it) => {
      const free = Number(it.dataset.price) <= balance;
      if (free && !it.classList.contains('is-free') && !still) { it.classList.add('is-new'); setTimeout(() => it.classList.remove('is-new'), 800); }
      it.classList.toggle('is-free', free);
    });
    const countTo = (to: number) => {
      const from = balance; balance = to;
      if (still) { bal.textContent = show(to); light(); return; }
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 700), e = 1 - Math.pow(1 - k, 3);
        bal.textContent = show(from + (to - from) * e);
        if (k < 1) requestAnimationFrame(tick); else { bal.classList.remove('bump'); void bal.offsetWidth; bal.classList.add('bump'); light(); }
      };
      requestAnimationFrame(tick);
    };
    const step = () => {
      if (!waiting) {
        // pay: the earned amount waits, it cannot be spent on this bill
        waiting = earn(); pendV.textContent = show(waiting); pend.hidden = false;
        note.textContent = txt('[data-t-wait]'); actLabel.textContent = txt('[data-t-next]');
      } else {
        // next visit: it joins the balance and the menu lights up
        pend.hidden = true; countTo(balance + waiting); waiting = 0;
        note.textContent = txt('[data-t-in]'); actLabel.textContent = txt('[data-t-pay]');
      }
    };
    range.addEventListener('input', () => { touched = true; paint(); });
    root.querySelectorAll<HTMLButtonElement>('.cg-pct').forEach(b => b.addEventListener('click', () => {
      touched = true; pct = Number(b.dataset.pct);
      root.querySelectorAll('.cg-pct').forEach(x => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      paint();
    }));
    act.addEventListener('click', () => { touched = true; step(); });

    const ard = $('[data-ardoise]'), ardV = $('[data-ard]');
    $('[data-paid]').addEventListener('click', () => {
      ard.classList.add('is-clear'); $('[data-ard-sub]').textContent = txt('[data-t-clear]');
      if (still) { ardV.textContent = '0'; return; }
      const t0 = performance.now();
      const tick = (t: number) => { const k = Math.min(1, (t - t0) / 600); ardV.textContent = String(Math.round(340 * (1 - k))); if (k < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    });

    paint(); light();
    if (!still && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return; io.disconnect();
        setTimeout(() => { if (!touched) step(); }, 1300);
        setTimeout(() => { if (!touched) step(); }, 3600);
      }, { threshold: 0.45 });
      io.observe(root);
    }
  });
</script>
