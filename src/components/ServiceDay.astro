---
// "Une journée de service": the six core features told as moments of one day in the restaurant.
// Desktop: a big clock stays on the left and moves with the scroll; the moment in the middle of the
// screen lights up and plays its small visual.
import Icon from './Icon.astro';
import { ROUTES, type Lang } from '../i18n/routes';
interface Props { lang: Lang; allCta: string; profitCta: string }
const { lang, allCta, profitCta } = Astro.props;
const moments = [
  { t: '08:00', h: 'Chaque serveur entre avec son code', p: 'Pas de mot de passe partagé : chacun a son code personnel, et la caisse se verrouille toute seule après quelques minutes.', v: 'pin' },
  { t: '12:30', h: 'Le rush, en quelques touches', p: 'Tables, commandes, remises et encaissement en quelques touches. La caisse suit, même quand la salle est pleine.', v: 'till' },
  { t: '12:31', h: 'Une commande arrive du QR', p: 'Le client scanne, choisit et commande depuis son téléphone. La caisse sonne, vous acceptez.', v: 'qr' },
  { t: '12:32', h: 'Les bons partent tout seuls', p: 'Chaque article part vers la bonne imprimante, cuisine ou bar, avec les précisions du client.', v: 'print' },
  { t: '16:10', h: 'Chaque dirham contrôlé', p: 'Une remise, une annulation, un remboursement : il faut le code du manager. Et tout reste tracé.', v: 'lock' },
  { t: '23:30', h: 'La clôture en un clic', p: 'Rapport Z, espèces attendues, ventes par employé. Tickets numérotés, avec l’ICE du client, et une archive infalsifiable.', v: 'z' },
];
---
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-day>
  <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Une journée</span><span class="block text-green-deep">de service.</span></h2>
      <p class="mt-5 max-w-sm text-lg text-muted">De l’ouverture à la clôture, voici ce que la caisse fait pour vous.</p>
      <!-- the clock (desktop) -->
      <div class="mt-10 hidden lg:block" aria-hidden="true">
        <p class="day-clock display text-[8rem] leading-none tabular-nums text-navy">08:00</p>
        <div class="relative mt-4 h-2 w-full max-w-sm overflow-hidden rounded-full bg-line">
          <span class="day-bar absolute inset-y-0 start-0 w-full origin-left rounded-full bg-linear-to-r from-[#F5B301] via-green to-blue transition-transform duration-500 rtl:origin-right" style="transform:scaleX(0.02)"></span>
        </div>
        <div class="mt-2 flex max-w-sm justify-between text-sm text-muted"><span>Ouverture</span><span>Rush</span><span>Clôture</span></div>
      </div>
      <div class="mt-8 hidden flex-wrap items-center gap-4 lg:flex">
        <a href={ROUTES.features[lang]} class="inline-flex min-h-12 items-center rounded-full bg-navy px-6 font-semibold text-white hover:bg-blue">{allCta}</a>
        <a href={ROUTES.profit[lang]} class="font-semibold text-green-deep underline underline-offset-4">{profitCta}</a>
      </div>
    </div>

    <ol class="space-y-4">
      {moments.map((m, i) => (
        <li class="day-card grid gap-5 rounded-[1.75rem] bg-paper p-6 ring-1 ring-line transition-all duration-500 sm:grid-cols-[1fr_10.5rem] sm:p-7" data-moment={i} data-time={m.t}>
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-chalk px-3 py-1 text-sm font-semibold tabular-nums"><span class="size-2 rounded-full bg-green"></span>{m.t}</span>
            <h3 class="mt-3 text-2xl">{m.h}</h3>
            <p class="mt-2 text-muted">{m.p}</p>
          </div>
          <div class="grid min-h-32 place-items-center rounded-2xl bg-navy p-4 text-white" aria-hidden="true">
            {m.v === 'pin' && (
              <div class="text-center">
                <p class="text-[0.7rem] text-white/60">Sara</p>
                <div class="mt-2 flex justify-center gap-2">{[0, 1, 2, 3].map(k => <span class="dv-pin size-3 rounded-full border-2 border-green" style={`--d:${200 + k * 200}ms`}></span>)}</div>
                <p class="dv dv-ok mt-3 rounded-full bg-green px-2.5 py-1 text-[0.7rem] font-bold text-navy" style="--d:1100ms">Bonjour Sara</p>
              </div>
            )}
            {m.v === 'till' && (
              <div class="w-full">
                <div class="grid grid-cols-3 gap-1">{['Café', 'Thé', 'Jus', 'Crêpe', 'Pizza', 'Msemen'].map((x, k) => <span class={`dv-tap grid h-7 place-items-center rounded-md bg-white/10 text-[0.6rem] ${[0, 1, 4].includes(k) ? 'tap' : ''}`} style={`--d:${200 + [0, 1, 4].indexOf(k) * 300}ms`}>{x}</span>)}</div>
                <p class="mt-2 flex justify-between text-[0.7rem]"><span class="text-white/60">Total</span><span class="dv font-bold text-green" style="--d:1200ms">68 MAD</span></p>
              </div>
            )}
            {m.v === 'qr' && (
              <div class="w-full space-y-2">
                <div class="dv flex items-center gap-2 rounded-lg bg-white px-2.5 py-2 text-navy shadow-lg" style="--d:300ms">
                  <span class="dv-ring grid size-6 shrink-0 place-items-center rounded-full bg-green"><Icon name="qr" class="size-3.5" /></span>
                  <span class="text-[0.65rem] font-semibold leading-tight">Table 9<span class="block font-normal text-muted">Nouvelle commande</span></span>
                </div>
                <p class="dv rounded-full bg-green py-1 text-center text-[0.65rem] font-bold text-navy" style="--d:1000ms">Accepter</p>
              </div>
            )}
            {m.v === 'print' && (
              <div class="flex w-full gap-2">
                {[['CUISINE', '1 × Pizza'], ['BAR', '2 × Thé']].map(([a, b], k) => (
                  <div class="dv-print flex-1 origin-top rounded-b bg-white px-1.5 pb-2 pt-1 font-mono text-[0.55rem] leading-snug text-navy" style={`--d:${200 + k * 450}ms`}>
                    <p class="font-bold">{a}</p><p class="border-t border-dashed border-navy/40">{b}</p><p class="text-muted">Table 9</p>
                  </div>
                ))}
              </div>
            )}
            {m.v === 'lock' && (
              <div class="w-full space-y-2 text-center">
                <p class="rounded-lg bg-white/10 py-1.5 text-[0.7rem]">Remise −10 %</p>
                <p class="dv flex items-center justify-center gap-1.5 rounded-lg bg-[#F5B301] py-1.5 text-[0.7rem] font-bold text-navy" style="--d:500ms">
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Code manager
                </p>
                <p class="dv text-[0.6rem] text-white/60" style="--d:1100ms">Tracé : Karim, 16:10</p>
              </div>
            )}
            {m.v === 'z' && (
              <div class="w-full rounded bg-white px-2.5 py-2 font-mono text-[0.55rem] leading-snug text-navy">
                <p class="dv font-bold" style="--d:150ms">RAPPORT Z</p>
                <p class="dv flex justify-between" style="--d:350ms"><span>Ventes</span><span>8 450</span></p>
                <p class="dv flex justify-between" style="--d:550ms"><span>Espèces</span><span>3 120</span></p>
                <p class="dv flex justify-between" style="--d:750ms"><span>Tickets</span><span>124</span></p>
                <p class="dv mt-1 border-t border-dashed border-navy/40 pt-1 font-bold text-green-deep" style="--d:1000ms">Journée clôturée</p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="mt-8 flex flex-wrap items-center gap-4 lg:hidden">
    <a href={ROUTES.features[lang]} class="inline-flex min-h-12 items-center rounded-full bg-navy px-6 font-semibold text-white hover:bg-blue">{allCta}</a>
    <a href={ROUTES.profit[lang]} class="font-semibold text-green-deep underline underline-offset-4">{profitCta}</a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-day]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-moment]')];
    const clock = root.querySelector<HTMLElement>('.day-clock');
    const bar = root.querySelector<HTMLElement>('.day-bar');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mins = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
    const START = mins('08:00'), END = mins('23:30');
    let shown = START, raf = 0;
    const run = (to: number) => {
      cancelAnimationFrame(raf);
      if (!clock) return;
      const from = shown, t0 = performance.now();
      const step = (t: number) => {
        const k = still ? 1 : Math.min(1, (t - t0) / 600);
        shown = Math.round(from + (to - from) * (1 - (1 - k) ** 3));
        clock.textContent = `${String(Math.floor(shown / 60)).padStart(2, '0')}:${String(shown % 60).padStart(2, '0')}`;
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const set = (i: number) => {
      cards.forEach((c, k) => { c.classList.toggle('is-on', k === i); if (k <= i) c.classList.add('seen'); });
      const to = mins(cards[i].dataset.time!);
      run(to);
      if (bar) bar.style.transform = `scaleX(${(to - START) / (END - START) || 0.02})`;
    };
    if (!('IntersectionObserver' in window)) { cards.forEach(c => c.classList.add('is-on', 'seen')); return; }
    root.classList.add('day-live');
    const io = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) set(cards.indexOf(e.target as HTMLElement)); }), { rootMargin: '-45% 0px -45% 0px' });
    cards.forEach(c => io.observe(c));
  });
</script>
