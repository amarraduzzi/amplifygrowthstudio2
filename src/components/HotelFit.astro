---
// "Pour qui": a riad, a hotel, a big hotel. One photo per size, and the switches that size usually turns on.
// Everything is in every plan; the switches only show what each place tends to use. Tabs cycle on their own until touched.
import { tr } from '../i18n/t';
import { SECTOR } from '../config';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const kinds = [
  { k: 'riad', name: tt('Riad'), rooms: tt('jusqu’à {n} chambres').replace('{n}', String(SECTOR.hotel.riadRooms)), img: 'patio', alt: tt('Patio d’un riad avec piscine et lanternes'),
    line: tt('Le propriétaire fait souvent tout : il veut un planning simple et son téléphone.') },
  { k: 'hotel', name: tt('Hôtel'), rooms: tt('jusqu’à {n} chambres').replace('{n}', String(SECTOR.hotel.hotelRooms)), img: 'chambre', alt: tt('Chambre d’hôtel marocaine avec tête de lit sculptée'),
    line: tt('Une réception, une équipe de ménage, plusieurs chambres identiques sur Booking.') },
  { k: 'grand', name: tt('Grand hôtel'), rooms: tt('plus de {n} chambres').replace('{n}', String(SECTOR.hotel.hotelRooms)), img: 'cour', alt: tt('Grande cour d’hôtel avec fontaine et orangers'),
    line: tt('Plusieurs employés à la caisse, un restaurant, un technicien et un propriétaire qui n’est pas là.') },
];
// [label, the sizes that usually switch it on]
const sw: [string, string][] = [
  [tt('Planning des chambres'), 'riad hotel grand'],
  [tt('Airbnb et Booking par calendrier'), 'riad hotel'],
  [tt('Beds24 pour plusieurs chambres identiques'), 'hotel grand'],
  [tt('Site de réservation sans commission'), 'riad hotel grand'],
  [tt('Fiche de police et taxe de séjour'), 'hotel grand'],
  [tt('Plan du ménage sur le téléphone'), 'hotel grand'],
  [tt('Caisse par employé'), 'grand'],
  [tt('Restaurant sur la note'), 'grand'],
  [tt('Bilan du soir sur le téléphone'), 'riad hotel grand'],
];
---
<section id="pour-qui" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
  <div class="hf grid items-stretch gap-6 lg:grid-cols-[1.25fr_1fr] lg:gap-10" data-t="riad" data-hf>
    <div class="tf relative isolate min-h-[22rem] overflow-hidden rounded-[1.75rem] bg-navy lg:min-h-[34rem]">
      {kinds.map((x, i) => (
        <img src={`/img/photos/hotel-${x.img}-1376.webp`} srcset={`/img/photos/hotel-${x.img}-800.webp 800w, /img/photos/hotel-${x.img}-1376.webp 1200w`} sizes="(min-width:1024px) 640px, 100vw"
          alt={x.alt} width="1200" height="896" loading="lazy" decoding="async" data-k={x.k} class={`hf-ph absolute inset-0 -z-10 h-full w-full object-cover ${i === 0 ? 'on' : ''}`} />
      ))}
      <span class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-t from-navy/90 to-transparent" aria-hidden="true"></span>
      <div class="flex h-full min-h-[inherit] flex-col justify-end p-5 text-white sm:p-7">
        {kinds.map(x => (
          <div class="hf-cap" data-k={x.k}>
            <p class="display text-[clamp(2.6rem,6vw,4.4rem)] leading-[0.9]">{x.name}</p>
            <p class="mt-1 text-lg font-semibold text-green">{x.rooms}</p>
            <p class="mt-2 max-w-md text-white/80">{x.line}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="tf flex flex-col" style="--d:120ms">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Petit riad ou grand hôtel.')}</span><span class="block text-green-deep">{tt('Vous allumez ce qui vous sert.')}</span></h2>
      <div class="mt-6 flex gap-1 rounded-full bg-paper p-1 ring-1 ring-line" role="tablist" aria-label={tt('Taille de l’établissement')}>
        {kinds.map((x, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-k={x.k} class="hf-tab min-h-11 flex-1 rounded-full px-3 text-sm font-semibold sm:text-base">{x.name}</button>)}
      </div>
      <ul class="mt-5 divide-y divide-line border-y border-line">
        {sw.map(([l, on]) => (
          <li class="hf-row flex items-center justify-between gap-4 py-2.5" data-on={on}>
            <span class="hf-l text-[0.95rem] sm:text-base">{l}</span>
            <span class="hf-sw relative h-6 w-10 shrink-0 rounded-full bg-line" aria-hidden="true"><span class="absolute left-0.5 top-0.5 size-5 rounded-full bg-white shadow"></span></span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-muted">{tt('Tout est inclus dans chaque formule. Le prix dépend seulement du nombre de chambres.')}</p>
    </div>
  </div>
</section>

<style>
  .hf-ph { opacity: 0; transform: scale(1.04); transition: opacity .7s ease, transform 6s ease; }
  .hf-ph.on { opacity: 1; transform: scale(1); }
  .hf-cap { display: none; }
  .hf[data-t='riad'] .hf-cap[data-k='riad'], .hf[data-t='hotel'] .hf-cap[data-k='hotel'], .hf[data-t='grand'] .hf-cap[data-k='grand'] { display: block; animation: hf-in .5s ease both; }
  @keyframes hf-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .hf-tab { color: var(--color-muted, #5b6b7b); transition: background-color .25s, color .25s; }
  .hf-tab[aria-selected='true'] { background: var(--color-navy, #001e3e); color: #fff; }
  /* the knob sits on the physical left; on moves it right (left in Arabic, where off sits right) */
  .hf-sw > span { --x: 0rem; transform: translateX(var(--x)); transition: transform .3s cubic-bezier(.3,1.4,.6,1); }
  :global([dir='rtl']) .hf-sw > span { --x: 1rem; }
  .hf-sw { transition: background-color .3s; }
  .hf-l { transition: color .3s; color: var(--color-muted, #5b6b7b); }
  .hf[data-t='riad'] .hf-row[data-on~='riad'] .hf-sw,
  .hf[data-t='hotel'] .hf-row[data-on~='hotel'] .hf-sw,
  .hf[data-t='grand'] .hf-row[data-on~='grand'] .hf-sw { background: var(--color-green, #05b962); }
  .hf[data-t='riad'] .hf-row[data-on~='riad'] .hf-sw > span,
  .hf[data-t='hotel'] .hf-row[data-on~='hotel'] .hf-sw > span,
  .hf[data-t='grand'] .hf-row[data-on~='grand'] .hf-sw > span { --x: 1rem; }
  :global([dir='rtl']) .hf[data-t='riad'] .hf-row[data-on~='riad'] .hf-sw > span,
  :global([dir='rtl']) .hf[data-t='hotel'] .hf-row[data-on~='hotel'] .hf-sw > span,
  :global([dir='rtl']) .hf[data-t='grand'] .hf-row[data-on~='grand'] .hf-sw > span { --x: 0rem; }
  .hf[data-t='riad'] .hf-row[data-on~='riad'] .hf-l,
  .hf[data-t='hotel'] .hf-row[data-on~='hotel'] .hf-l,
  .hf[data-t='grand'] .hf-row[data-on~='grand'] .hf-l { color: var(--color-navy, #001e3e); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .hf-ph, .hf-sw, .hf-sw > span { transition: none; } .hf-cap { animation: none !important; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hf]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.hf-tab')];
    const photos = [...root.querySelectorAll<HTMLElement>('.hf-ph')];
    const order = tabs.map((b) => b.dataset.k!);
    const set = (k: string) => {
      root.dataset.t = k;
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.k === k)));
      photos.forEach((p) => p.classList.toggle('on', p.dataset.k === k));
    };
    let timer = 0;
    const stop = () => { window.clearInterval(timer); timer = 0; };
    tabs.forEach((b) => b.addEventListener('click', () => { stop(); set(b.dataset.k!); }));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    // cycle only while on screen, until the visitor picks one
    let touched = false;
    tabs.forEach((b) => b.addEventListener('click', () => { touched = true; }));
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !touched && !timer) timer = window.setInterval(() => set(order[(order.indexOf(root.dataset.t!) + 1) % order.length]), 4200);
      else if (!e.isIntersecting) stop();
    }, { threshold: 0.4 }).observe(root);
  });
</script>
