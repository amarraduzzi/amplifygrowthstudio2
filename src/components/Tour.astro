---
// Interactive product tour. A camera glides over real screens: overview, then it zooms on each point
// with a short explanation, then moves to the next screen. The visitor can take over at any moment:
// tap a tab, tap a point (zoom in), tap the screen again (zoom out). Desktop: the device tilts with the mouse.
import Device from './Device.astro';
import { copy } from '../i18n';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const t = copy(Astro.props.lang).home.tour;
---
<section class="tour relative isolate overflow-hidden bg-blue py-20 text-white md:py-28" data-tour>
  <div class="pointer-events-none absolute inset-0 -z-10" style="background:radial-gradient(55% 45% at 50% 62%, rgba(5,185,98,.20), transparent 70%)" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-center text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{t.h2a}</span><span class="block text-green">{t.h2b}</span></h2>
    <p class="mx-auto mt-5 max-w-xl text-center text-white/70">{t.p}</p>

    <!-- tabs: one row, swipeable on phones -->
    <div class="snap-row -mx-4 mt-10 flex gap-2 overflow-x-auto px-4 md:mx-0 md:mt-12 md:flex-wrap md:justify-center md:overflow-visible md:px-0" role="tablist" aria-label={t.h2a}>
      {t.tabs.map((tab, i) => (
        <button type="button" role="tab" id={`tab-${tab.key}`} aria-controls={`panel-${tab.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} data-text={tab.text}
          class="tour-tab group relative shrink-0 overflow-hidden rounded-full py-2.5 pe-5 ps-3 ring-1 ring-white/20 transition-colors hover:bg-white/10 aria-selected:bg-paper aria-selected:text-navy aria-selected:ring-paper">
          <span class="flex items-center gap-2">
            <span class="grid size-7 place-items-center rounded-full bg-white/10 text-xs font-bold text-green group-aria-selected:bg-navy group-aria-selected:text-green">{i + 1}</span>
            <span class="whitespace-nowrap font-semibold">{tab.label}</span>
          </span>
          <span class="tour-progress absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-green rtl:origin-right" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <!-- the stage -->
    <div class="tour-stage relative -mx-2 mt-8 md:mx-0 md:mt-10" style="perspective:1600px">
      <div class="grid">
        {t.tabs.map((tab, i) => (
          <div role="tabpanel" id={`panel-${tab.key}`} aria-labelledby={`tab-${tab.key}`} data-panel={i} data-kind={tab.kind}
            class={`tour-panel col-start-1 row-start-1 grid place-items-center ${i === 0 ? 'is-on' : ''}`} hidden={i !== 0}>
            <div class={`tilt relative w-full ${tab.kind === 'phone' ? 'max-w-[17rem] sm:max-w-[19rem]' : 'max-w-5xl'} ${tab.img2 ? 'md:-translate-x-[38%]' : ''}`}>
              {tab.img2 && (
                <div class="second-phone pointer-events-none absolute top-[6%] hidden w-[92%] rotate-[5deg] md:block" style="inset-inline-start:78%" aria-hidden="true">
                  <Device kind="phone" src={tab.img2} alt="" w={tab.w} h={tab.h} />
                </div>
              )}
              <Device kind={tab.kind} src={tab.img || undefined} alt={tab.text} w={tab.w} h={tab.h} class={tab.kind === 'tablet' ? 'p-2! sm:p-3! rounded-[1.4rem]! sm:rounded-[2rem]!' : ''}>
                {!tab.img && (
                  <div slot="screen" class="flex aspect-[9/17] flex-col bg-[#EFEAE2] text-[0.72rem] text-[#111] sm:text-[0.8rem]">
                    <div class="flex items-center gap-2 bg-[#075E54] px-3 py-2.5 text-white"><span class="size-6 rounded-full bg-white/30"></span><span class="font-semibold">{t.chat.title}</span></div>
                    <div class="flex flex-1 flex-col gap-2.5 p-3">
                      <div class="chat-msg ms-auto max-w-[85%] rounded-lg rounded-se-none bg-[#D9FDD3] px-3 py-2 leading-snug shadow-sm">
                        {t.chat.order.map((l, k) => <span class={`block ${k === 0 ? 'font-bold' : ''}`}>{l}</span>)}
                      </div>
                      <div class="chat-msg chat-msg-2 max-w-[80%] rounded-lg rounded-ss-none bg-white px-3 py-2 leading-snug shadow-sm">{t.chat.reply}</div>
                    </div>
                  </div>
                )}
                {tab.spots.map(([x, y, label], k) => (
                  <span class="spot absolute z-10" style={`left:${x}%;top:${y}%`} data-x={x} data-y={y} data-k={k}>
                    <span class="spot-inner block -translate-x-1/2 -translate-y-1/2">
                      <button type="button" class="spot-btn relative block" aria-label={label} aria-expanded="false">
                        <span class="spot-ring absolute inset-0 rounded-full bg-green/60" aria-hidden="true"></span>
                        <span class="spot-dot relative grid size-6 place-items-center rounded-full bg-green text-xs font-bold leading-none text-navy shadow-lg ring-2 ring-white sm:size-7">{k + 1}</span>
                      </button>
                      <span class={`spot-tip pointer-events-none absolute top-9 hidden md:block z-20 w-max max-w-[14rem] rounded-xl bg-paper px-3.5 py-2.5 text-[0.85rem] font-semibold leading-snug text-navy opacity-0 shadow-2xl transition-opacity duration-300 sm:text-[0.95rem] ${x > 62 ? 'end-0' : x < 38 ? 'start-0' : 'start-1/2 -translate-x-1/2'}`} role="tooltip">{label}</span>
                    </span>
                  </span>
                ))}
              </Device>
            </div>
          </div>
        ))}
      </div>
      <!-- reflection on the floor -->
      <div class="pointer-events-none mx-auto -mt-2 h-8 w-3/4 rounded-[50%] bg-black/35 blur-2xl" aria-hidden="true"></div>
    </div>

    <div class="mt-4 flex flex-col items-center gap-4">
      <p class="tour-caption min-h-[3em] max-w-xl text-center text-lg text-white/85 transition-colors" aria-live="polite">{t.tabs[0].text}</p>
      <button type="button" class="tour-zoom inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold ring-1 ring-white/20 hover:bg-white/20 md:hidden">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>{t.zoom}
      </button>
    </div>
  </div>

  <dialog class="tour-dialog m-auto max-h-[92vh] w-[96vw] max-w-6xl rounded-2xl bg-navy p-2 backdrop:bg-navy/85">
    <img class="tour-dialog-img block h-auto max-h-[80vh] w-full rounded-xl object-contain" alt="" />
    <form method="dialog" class="mt-2 flex justify-end"><button class="rounded-full bg-paper px-5 py-2 font-semibold text-navy">{t.close}</button></form>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const caption = root.querySelector<HTMLElement>('.tour-caption')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const small = matchMedia('(max-width: 767px)');
    let current = 0, auto = !still, timers: number[] = [];
    const OVERVIEW = 1400, PER_SPOT = 2600, OUTRO = 900;

    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const cam = (i: number) => panels[i].querySelector<HTMLElement>('.cam')!;
    const spots = (i: number) => [...panels[i].querySelectorAll<HTMLElement>('.spot')];

    // zoom the camera so (x, y) (in %) comes to the centre, without showing the edges
    const zoomTo = (i: number, spot: HTMLElement | null) => {
      const c = cam(i);
      spots(i).forEach(s => { s.classList.toggle('open', s === spot); s.querySelector('button')?.setAttribute('aria-expanded', String(s === spot)); });
      // phones: the explanation goes under the device (no room on the screen itself)
      caption.textContent = spot ? `${Number(spot.dataset.k) + 1}. ${spot.querySelector('button')?.getAttribute('aria-label') ?? ''}` : (tabs[i].dataset.text ?? '');
      caption.classList.toggle('is-spot', !!spot);
      if (!spot) { c.style.setProperty('--s', '1'); c.style.setProperty('--tx', '0%'); c.style.setProperty('--ty', '0%'); c.classList.remove('zoomed'); return; }
      const s = panels[i].dataset.kind === 'phone' ? 1.55 : small.matches ? 2.4 : 2.1;
      const x = Number(spot.dataset.x) / 100, y = Number(spot.dataset.y) / 100;
      const tx = Math.min(0, Math.max(1 - s, 0.5 - s * x)), ty = Math.min(0, Math.max(1 - s, 0.5 - s * y));
      c.style.setProperty('--s', String(s)); c.style.setProperty('--tx', `${tx * 100}%`); c.style.setProperty('--ty', `${ty * 100}%`);
      c.classList.add('zoomed');
    };

    const show = (i: number, fromUser = false) => {
      clear();
      if (current !== i) zoomTo(current, null);
      current = i;
      tabs.forEach((tb, k) => { tb.setAttribute('aria-selected', k === i ? 'true' : 'false'); tb.tabIndex = k === i ? 0 : -1; tb.classList.remove('running'); });
      panels.forEach((p, k) => { p.hidden = k !== i; p.classList.toggle('is-on', k === i); });
      if (fromUser) tabs[i].scrollIntoView({ block: 'nearest', inline: 'center', behavior: still ? 'auto' : 'smooth' });
      zoomTo(i, null);
      if (!auto) return;
      // the guided camera: overview, each point, back out, next screen
      const list = spots(i);
      const total = OVERVIEW + list.length * PER_SPOT + OUTRO;
      tabs[i].style.setProperty('--dur', `${total}ms`); void tabs[i].offsetWidth; tabs[i].classList.add('running');
      list.forEach((s, k) => later(OVERVIEW + k * PER_SPOT, () => zoomTo(i, s)));
      later(OVERVIEW + list.length * PER_SPOT, () => zoomTo(i, null));
      later(total, () => show((i + 1) % tabs.length));
    };
    const stop = () => { auto = false; clear(); tabs.forEach(tb => tb.classList.remove('running')); };

    tabs.forEach((tb, i) => {
      tb.addEventListener('click', () => { stop(); show(i, true); });
      tb.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; e.preventDefault(); stop();
        const n = (current + d + tabs.length) % tabs.length; show(n, true); tabs[n].focus();
      });
    });
    panels.forEach((panel, i) => {
      panel.querySelectorAll<HTMLButtonElement>('.spot-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation(); stop();
          const spot = btn.closest<HTMLElement>('.spot')!;
          zoomTo(i, spot.classList.contains('open') ? null : spot);
        });
      });
      // tap the zoomed screen to zoom back out
      panel.addEventListener('click', () => { if (cam(i).classList.contains('zoomed')) { stop(); zoomTo(i, null); } });
    });

    // desktop: the device tilts gently with the mouse
    const stage = root.querySelector<HTMLElement>('.tour-stage')!;
    if (canHover && !still) {
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5, py = (e.clientY - r.top) / r.height - 0.5;
        stage.style.setProperty('--ry', `${(px * 7).toFixed(2)}deg`); stage.style.setProperty('--rx', `${(-py * 5).toFixed(2)}deg`);
      });
      stage.addEventListener('pointerleave', () => { stage.style.setProperty('--ry', '0deg'); stage.style.setProperty('--rx', '0deg'); });
    }

    // phones: open the current screen full size
    const dialog = root.querySelector<HTMLDialogElement>('.tour-dialog')!;
    const dImg = root.querySelector<HTMLImageElement>('.tour-dialog-img')!;
    root.querySelector('.tour-zoom')?.addEventListener('click', () => {
      stop();
      const img = panels[current].querySelector('img');
      if (!img) return;
      dImg.src = img.currentSrc || img.src; dImg.alt = img.alt;
      dialog.showModal();
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    // start once the section is on screen
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); show(0); } }, { threshold: 0.3 });
      io.observe(root);
    }
  });
</script>
