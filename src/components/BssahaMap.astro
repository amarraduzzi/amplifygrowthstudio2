---
// Le Rouleau, cities: a second receipt with Morocco drawn in dot-matrix dots. Open cities are marked in yellow, the next one pulses.
// Tapping a city re-colours the page in its petit-taxi colour. Only real numbers: the count is the number of listed restaurants.
import type { BssahaCopy } from '../i18n/bssaha';
export interface CityRow { id: string; name: string; lon: number; lat: number; open: boolean; soon: boolean; count: number; min: number; color: string; ink: string; ownerHref: string; dinerHref: string; listHref: string }
interface Props { c: BssahaCopy; rows: CityRow[]; otherHref: string }
const { c, rows, otherHref } = Astro.props;
const K = 48, X0 = -17.2, Y0 = 36.2;
const pt = (lon: number, lat: number) => `${((lon - X0) * K).toFixed(1)},${((Y0 - lat) * K).toFixed(1)}`;
// simplified outline (the whole kingdom), clockwise from Tangier; stylised on purpose
const outline = [[-5.9,35.8],[-6.4,34.8],[-6.85,34.0],[-7.6,33.6],[-8.5,33.25],[-9.25,32.3],[-9.8,31.5],[-9.65,30.5],[-10.2,29.4],[-11.1,28.45],[-12.9,27.95],[-13.2,27.15],[-14.5,26.1],[-15.9,23.7],[-16.6,22.3],[-17.1,21.35],[-13.17,21.35],[-13.2,27.67],[-8.67,27.67],[-8.67,28.72],[-7.5,29.4],[-5.8,29.95],[-4.8,30.5],[-3.7,30.95],[-3.6,31.65],[-2.8,32.0],[-1.25,32.1],[-1.7,32.6],[-1.5,33.2],[-1.7,34.0],[-1.9,34.7],[-2.2,35.1],[-2.95,35.2],[-3.95,35.2],[-4.6,35.2],[-5.35,35.55],[-5.35,35.9]].map(([x, y]) => pt(x, y)).join(' ');
const W = Math.round(16.2 * K), H = Math.round(15.2 * K);
const fill = (s: string, r: CityRow) => s.replace('{v}', r.name).replace('{n}', String(r.count)).replace('{m}', String(r.min));
const btn = 'inline-flex min-h-12 items-center justify-center rounded-full px-6 font-semibold';
const active = rows.filter(r => r.open || r.soon);
---
<section id="villes" class="bs-bg-deep scroll-mt-20">
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 md:py-20">
    <div class="[filter:drop-shadow(0_18px_22px_rgba(0,0,0,0.35))]">
      <div class="bs-paper bs-torn px-5 pb-14 pt-8 md:px-10">
        <h2 class="font-dot text-4xl leading-none md:text-5xl">{c.mapTitle}</h2>
        <p class="measure mt-3 font-sans text-base font-normal text-black/70">{c.mapLead}</p>
        <hr class="my-6 border-t-2 border-dashed border-black/40" />
        <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-start">
          <div>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={c.mapAria} class="mx-auto h-auto w-full max-w-xs md:max-w-none">
              <polygon points={outline} fill="none" stroke="#0a0a0a" stroke-width="3.5" stroke-dasharray="0.1 9" stroke-linecap="round" stroke-linejoin="round" />
              {rows.map(r => {
                const [x, y] = pt(r.lon, r.lat).split(',').map(Number);
                const left = r.id === 'casablanca' || r.id === 'marrakech' || r.id === 'agadir';
                const hot = r.open || r.soon;
                return (
                  <g {...(hot ? { 'data-theme-city': r.id, 'data-color': r.color, 'data-ink': r.ink, role: 'button', tabindex: 0, 'aria-label': r.name, style: 'cursor:pointer' } : {})}>
                    {hot && <circle cx={x} cy={y} r="9" class="bm-pulse" fill={r.open ? '#FFE600' : 'none'} stroke={r.open ? 'none' : '#0a0a0a'} stroke-width="2.5" />}
                    <circle cx={x} cy={y} r={hot ? 8 : 4.5} fill={r.open ? '#FFE600' : hot ? '#F5F7F7' : 'rgba(10,10,10,0.45)'} stroke={hot ? '#0a0a0a' : 'none'} stroke-width="3" />
                    <text x={left ? x - 16 : x + 16} y={y + 6} text-anchor={left ? 'end' : 'start'} font-size={hot ? 26 : 20} fill={hot ? '#0a0a0a' : 'rgba(10,10,10,0.55)'} class="font-dot" style="paint-order:stroke;stroke:#F5F7F7;stroke-width:5px">{r.name}</text>
                  </g>
                );
              })}
            </svg>
            <p class="mt-2 font-sans text-xs font-normal text-black/50">{c.mapNote}</p>
          </div>
          <ul class="grid gap-6">
            {active.map(r => (
              <li class="border-b-2 border-dashed border-black/40 pb-6">
                <button type="button" data-theme-city={r.id} data-color={r.color} data-ink={r.ink} class="font-dot flex w-full items-baseline gap-2 text-start text-3xl">
                  <span>{r.name}</span><span class="bs-leader"></span>
                  <span class={`text-base ${r.open ? 'bs-mark' : 'border-2 border-dashed border-black px-2'}`}>{r.open ? c.stLive : c.stSoon}</span>
                </button>
                {r.open
                  ? <><p class="mt-3 font-sans font-normal">{r.count === 1 ? c.countOne : c.countMany.replace('{n}', String(r.count))}. {c.liveLine}</p>
                      <a href={r.listHref} class={`${btn} mt-4 bg-[#0a0a0a] text-white`}>{c.ctaList}</a></>
                  : <><p class="mt-3 font-sans font-normal">{fill(c.soonLine, r)}</p>
                      {r.count > 0 && <div class="mt-4"><div class="h-3 border-2 border-black"><div class="h-full bg-[#FFE600]" style={`width:${Math.min(100, Math.round(r.count / r.min * 100))}%`}></div></div><p class="mt-2 font-sans text-sm font-normal">{fill(c.progress, r)}</p></div>}
                      <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                        <a href={r.ownerHref} target="_blank" rel="noopener" class={`${btn} bg-[#0a0a0a] text-white`}>{fill(c.btnOwner, r)}</a>
                        <a href={r.dinerHref} target="_blank" rel="noopener" class={`${btn} border-2 border-[#0a0a0a]`}>{c.btnDiner}</a>
                      </div></>}
              </li>
            ))}
            <li>
              <p class="font-dot text-2xl">{c.otherTitle}</p>
              <p class="mt-2 font-sans font-normal text-black/75">{c.otherLine}</p>
              <a href={otherHref} target="_blank" rel="noopener" class="mt-2 inline-block font-sans font-semibold underline underline-offset-4">{c.otherBtn}</a>
            </li>
          </ul>
        </div>
        <div class="bs-barcode mt-10" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
<style>
  .bm-pulse { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .bm-pulse { animation: bm-ring 2.2s ease-out infinite; }
    @keyframes bm-ring { from { transform: scale(1); opacity: .8; } to { transform: scale(2.6); opacity: 0; } }
  }
</style>
<script>
  // Tapping a city (map, city line or list tab) re-colours the page in that city's petit-taxi colour.
  const page = document.querySelector<HTMLElement>('.bs-page');
  const theme = (el: HTMLElement | null) => {
    if (!page || !el?.dataset.color) return;
    page.dataset.city = el.dataset.themeCity!;
    page.style.setProperty('--city', el.dataset.color);
    page.style.setProperty('--ink', el.dataset.ink || '#fff');
  };
  document.addEventListener('click', e => theme((e.target as Element).closest<HTMLElement>('[data-theme-city]')));
  document.addEventListener('keydown', e => {
    const t = (e.target as Element).closest<HTMLElement>('svg [data-theme-city]');
    if (t && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); theme(t); }
  });
</script>
