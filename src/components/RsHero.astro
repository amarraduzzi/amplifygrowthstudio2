---
// Restaurants hero. The restaurant seen from above, like an X-ray: a scan passes and shows what goes
// wrong today in each zone (red). Switch to "Avec Amplify" and every zone turns green with its fix.
import WaButton from './WaButton.astro';
import Icon from './Icon.astro';
import { rsOf } from '../i18n/content';
import { tr, langOf } from '../i18n/t';
const LG = langOf(Astro.url);
const tt = tr(LG);
const c = rsOf(LG);
const h = c.hero;
const Z = Object.fromEntries(h.zones.map(z => [z.k, z]));
const area: Record<string, string> = { salle: 'sa', cuisine: 'cu', caisse: 'ca', stock: 'st', bureau: 'bu', porte: 'po' };
---
<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{h.kicker}</p>
      <h1 class="mt-5 text-[clamp(3rem,6.2vw,5.4rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{h.h1a}</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:220ms">{h.h1b}</span></span>
      </h1>
      <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:350ms">{h.lead}</p>
      <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:450ms">
        <a href="#diagnostic" class="inline-flex min-h-12 items-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">{h.cta}</a>
        <WaButton text={c.wa} label={h.cta2} where="restaurants-hero" tone="light" class="px-6 text-lg ring-1 ring-line" />
      </div>
    </div>

    <div class="fade-up" style="--d:300ms" data-rshero data-mode="bad">
      <div class="mx-auto mb-4 flex w-fit rounded-full bg-paper p-1 text-sm font-semibold ring-1 ring-line" role="tablist" aria-label="Votre restaurant aujourd’hui ou avec Amplify">
        {h.modes.map((m, i) => <button type="button" role="tab" class="rs-tab rounded-full px-4 py-2 transition-colors" data-m={i ? 'good' : 'bad'} aria-selected={i ? 'false' : 'true'}>{m}</button>)}
      </div>
      <div class="rs-plan relative overflow-hidden rounded-[2rem] bg-navy p-3 shadow-[0_50px_90px_-40px_rgba(0,30,62,0.7)] sm:p-4" aria-hidden="true">
        <div class="rs-grid grid gap-2 sm:gap-2.5">
          {['salle', 'cuisine', 'stock', 'caisse', 'porte', 'bureau'].map(k => (
            <div class={`rs-zone relative overflow-hidden rounded-2xl bg-white/[0.06] p-2.5 ring-1 ring-white/10 sm:p-3`} style={`grid-area:${area[k]}`} data-z={k}>
              <p class="text-[0.6rem] font-bold uppercase tracking-widest text-white/50 sm:text-[0.65rem]">{Z[k].name}</p>
              <!-- decor -->
              {k === 'salle' && <div class="mt-2 grid grid-cols-3 gap-x-3 gap-y-3 px-1 py-1 sm:gap-y-5">{Array.from({ length: 9 }, (_, i) => <span class="rs-tbl relative mx-auto block size-7 rounded-md bg-white/15 sm:size-8" style={`--d:${i * 120}ms`}><span class="absolute -start-1.5 top-1/2 size-2 -translate-y-1/2 rounded-full bg-white/25"></span><span class="absolute -end-1.5 top-1/2 size-2 -translate-y-1/2 rounded-full bg-white/25"></span></span>)}</div>}
              {k === 'cuisine' && <div class="mt-2 grid w-fit grid-cols-2 gap-1.5">{[0, 1, 2, 3].map(() => <span class="rs-fire size-5 rounded-full border-2 border-white/25"></span>)}</div>}
              {k === 'stock' && <div class="mt-2 space-y-1.5">{[0, 1, 2].map(() => <span class="block h-1.5 w-full rounded bg-white/15"></span>)}</div>}
              {k === 'caisse' && <span class="mt-1.5 grid size-8 place-items-center rounded-lg bg-white/15"><Icon name="till" class="size-5 text-white/70" /></span>}
              {k === 'bureau' && <span class="mt-1.5 grid size-8 place-items-center rounded-lg bg-white/15"><Icon name="chart" class="size-5 text-white/70" /></span>}
              {k === 'porte' && <span class="mt-2 block h-1.5 w-1/2 rounded bg-white/25"></span>}
              <!-- status -->
              <p class="rs-chip absolute inset-x-2 bottom-2 flex items-start gap-1.5 rounded-lg px-2 py-1.5 text-[0.6rem] font-bold leading-tight sm:inset-x-2.5 sm:bottom-2.5 sm:text-[0.7rem]" style={`--d:${['salle', 'cuisine', 'stock', 'caisse', 'porte', 'bureau'].indexOf(k) * 220}ms`}>
                <span class="rs-ico grid size-4 shrink-0 place-items-center rounded-full text-[0.55rem]"></span>
                <span><span class="rs-bad">{Z[k].bad}</span><span class="rs-good">{Z[k].good}</span></span>
              </p>
            </div>
          ))}
        </div>
        <span class="rs-scan pointer-events-none absolute inset-x-0 top-0 h-24" aria-hidden="true"></span>
      </div>
      <p class="mt-3 text-center text-xs text-muted">Votre établissement vu d’en haut</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rshero]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.rs-tab')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const set = (m: string) => {
      root.dataset.mode = m; tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.m === m)));
      root.classList.remove('rs-run'); void root.offsetWidth; root.classList.add('rs-run');
    };
    let auto = !still, timer = 0;
    tabs.forEach(t => t.addEventListener('click', () => { auto = false; clearInterval(timer); set(t.dataset.m!); }));
    set('bad');
    if (auto) timer = window.setInterval(() => auto && set(root.dataset.mode === 'bad' ? 'good' : 'bad'), 5600);
  });
</script>
