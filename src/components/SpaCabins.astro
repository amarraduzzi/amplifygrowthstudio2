---
// A looping illustration of the spa's cabins: booking requests arrive, each one goes into a free cabin
// that fits the treatment (two massage cabins, a hammam for 4, a laser); when nothing fits, the next
// free time is offered instead of a double booking. Invented first names, no real spa. With reduced
// motion the first state stays still.
const cabins = [
  { id: 'atlas', name: 'Cabine Atlas', kind: 'massage', cap: 1, who: ['Leila'] },
  { id: 'oasis', name: 'Cabine Oasis', kind: 'massage', cap: 1, who: [] },
  { id: 'hammam', name: 'Hammam', kind: 'hammam', cap: 4, who: ['Sanaa', 'Hajar'] },
  { id: 'laser', name: 'Laser', kind: 'laser', cap: 1, who: [] },
] as const;
const requests = [['Meryem', 'massage'], ['Khadija', 'hammam'], ['Nadia', 'massage']] as const;
const SOIN: Record<string, string> = { massage: 'Massage 60 min', hammam: 'Hammam, gommage', laser: 'Épilation laser' };
---
<div class="mt-14 rounded-[2rem] bg-white/[0.06] p-5 ring-1 ring-white/15 md:p-8" data-spa>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">Voyez les cabines se remplir.</p>
    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70 ring-1 ring-white/15">Exemple d’illustration</span>
  </div>
  <p class="sr-only">Illustration : les demandes en ligne arrivent, chacune va dans une cabine libre qui convient. Quand plus rien n’est libre, l’horaire suivant est proposé.</p>

  <div class="mt-7 grid gap-6 lg:grid-cols-[0.8fr_1.6fr] lg:gap-8" aria-hidden="true">
    <div>
      <p class="text-sm font-semibold text-green">Demandes en ligne</p>
      <ul class="relative mt-3 h-[10rem]" data-req>
        {requests.map(([name, kind], i) => (
          <li class="sl-q absolute inset-x-0 top-0 flex h-[2.85rem] items-center gap-3 rounded-xl bg-white/10 px-3 ring-1 ring-white/10" style={`--i:${i}`} data-r data-kind={kind}>
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-white/15 text-xs font-bold" data-n>{name[0]}</span>
            <span class="font-semibold" data-name>{name}</span>
            <span class="ms-auto truncate text-xs text-white/55" data-soin>{SOIN[kind]}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 min-h-[2.75rem] rounded-xl bg-[#F5B301]/15 px-3 py-2 text-sm font-semibold text-[#F5B301] opacity-0 transition-opacity duration-500" data-full>Plus de cabine libre : 16 h proposé à la cliente.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {cabins.map(c => (
        <div class="flex min-h-[11rem] flex-col rounded-2xl bg-white/[0.07] p-3 ring-1 ring-white/10" data-cab={c.id} data-kind={c.kind} data-cap={c.cap}>
          <p class="font-semibold leading-tight">{c.name}</p>
          <p class="mt-0.5 text-xs text-white/55"><span data-count>{c.who.length}</span> / {c.cap}</p>
          <span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-white/10"><i class="block h-full origin-left rounded-full bg-green transition-transform duration-500 rtl:origin-right" style={`transform:scaleX(${c.who.length / c.cap})`} data-bar></i></span>
          <ul class="mt-3 space-y-1.5" data-in>
            {c.who.map(w => <li class="sl-swap truncate rounded-lg bg-green/90 px-2 py-1 text-xs font-semibold text-navy">{w}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <span hidden data-soin-massage>{SOIN.massage}</span>
  <span hidden data-soin-hammam>{SOIN.hammam}</span>
  <span hidden data-soin-laser>{SOIN.laser}</span>
</div>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-spa]').forEach((root) => {
    if (still || !('IntersectionObserver' in window)) return;
    const txt = (s: string) => root.querySelector<HTMLElement>(s)?.textContent?.trim() ?? '';
    const soin: Record<string, string> = { massage: txt('[data-soin-massage]'), hammam: txt('[data-soin-hammam]'), laser: txt('[data-soin-laser]') };
    const list = root.querySelector<HTMLElement>('[data-req]')!;
    const full = root.querySelector<HTMLElement>('[data-full]')!;
    const tmpl = list.querySelector<HTMLElement>('[data-r]')!.cloneNode(true) as HTMLElement;
    const cabs = [...root.querySelectorAll<HTMLElement>('[data-cab]')].map((el) => ({
      el, kind: el.dataset.kind!, cap: Number(el.dataset.cap),
      ul: el.querySelector<HTMLElement>('[data-in]')!, bar: el.querySelector<HTMLElement>('[data-bar]')!, count: el.querySelector<HTMLElement>('[data-count]')!,
      who: [...el.querySelectorAll('li')].map((li) => ({ li: li as HTMLElement, left: 3 + Math.floor(Math.random() * 4) })),
    }));
    let q = [...list.querySelectorAll<HTMLElement>('[data-r]')];
    const names = ['Imane', 'Salwa', 'Ghita', 'Dounia', 'Sofia', 'Rim', 'Houda', 'Zineb', 'Kenza', 'Amal'];
    const kinds = ['massage', 'hammam', 'massage', 'laser', 'hammam', 'massage', 'hammam'];
    let n = 0, visible = false;
    const draw = (c: (typeof cabs)[number]) => { c.count.textContent = String(c.who.length); c.bar.style.transform = `scaleX(${c.who.length / c.cap})`; };
    const layout = () => q.forEach((el, i) => el.style.setProperty('--i', String(i)));
    const arrive = () => {
      const el = tmpl.cloneNode(true) as HTMLElement; const name = names[n % names.length]; const kind = kinds[n % kinds.length]; n++;
      el.dataset.kind = kind; el.querySelector('[data-name]')!.textContent = name; el.querySelector('[data-n]')!.textContent = name[0];
      el.querySelector('[data-soin]')!.textContent = soin[kind];
      el.classList.add('sl-enter'); list.appendChild(el); q.push(el); layout();
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('sl-enter')));
    };
    const step = () => {
      if (!visible || document.hidden) return;
      // time passes: clients leave their cabin
      cabs.forEach((c) => { c.who = c.who.filter((w) => { w.left--; if (w.left <= 0) { w.li.remove(); return false; } return true; }); draw(c); });
      // the first request goes into a free cabin that fits, or gets the next free time
      const r = q[0];
      if (r) {
        const c = cabs.find((x) => x.kind === r.dataset.kind && x.who.length < x.cap);
        if (c) {
          const li = document.createElement('li');
          li.className = 'sl-swap truncate rounded-lg bg-green/90 px-2 py-1 text-xs font-semibold text-navy';
          li.textContent = r.querySelector('[data-name]')!.textContent; c.ul.appendChild(li);
          c.who.push({ li, left: 3 + Math.floor(Math.random() * 4) }); draw(c);
          full.style.opacity = '0';
        } else full.style.opacity = '1';
        q.shift(); r.classList.add('sl-leave'); setTimeout(() => r.remove(), 550);
      }
      if (q.length < 3) arrive();
      layout();
    };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.25 }).observe(root);
    setInterval(step, 2200);
  });
</script>
