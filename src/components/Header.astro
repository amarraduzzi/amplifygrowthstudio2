---
import Logo from './Logo.astro';
import WaButton from './WaButton.astro';
import { copy } from '../i18n';
import { tr } from '../i18n/t';
import { loginUrl, signupUrl } from '../config';
import { ROUTES, liveLanguages, type Lang, type PageKey } from '../i18n/routes';
import { featuresOf } from '../i18n/content';
import Icon from './Icon.astro';
interface Props { lang: Lang; page: PageKey; wa: string; langs?: Lang[]; toc?: { id: string; label: string }[] }
const { lang, page, wa, langs: langsProp, toc } = Astro.props;
const tt = tr(lang);
const t = copy(lang);
// Main menu: two panels (Products, Features) and plain links (Pricing, Blog, Contact).
const PRODUCTS = [
  { k: 'pos', short: 'Caisse et menu QR', icon: 'till', img: '/img/nav-pos.webp', pos: '60% 60%', text: 'La caisse, le menu QR et les commandes.' },
  { k: 'profit', short: 'Marges et stock', icon: 'chart', img: '/img/nav-profit.webp', pos: '70% 65%', text: 'Food cost, marges et stock, plat par plat.' },
  { k: 'site', short: 'Votre site web', icon: 'store', img: '/img/nav-site.webp', pos: '60% 45%', text: 'Le site de votre restaurant, fait pour vous.' },
  { k: 'marketing', short: 'Plus de clients', icon: 'megaphone', img: '/img/nav-clients.webp', pos: '50% 55%', text: 'Du marketing qui amène des clients à table.' },
] as const;
const MODULE_ICON: Record<string, string> = { bakery: 'cake', pos: 'till', waiter: 'phone', qr: 'qr', online: 'bag', loyalty: 'heart', margins: 'chart', stock: 'box', team: 'users', money: 'coins', trust: 'shield' };
const fx = featuresOf(lang);
const fxTotal = fx.modules.reduce((n, m) => n + m.items.length, 0);
// The 11 modules in three groups. The group heading carries the meaning, so every icon has the same calm brand colour.
const CHIP = 'bg-mint text-green-deep ring-1 ring-green/30';
const DOT = 'bg-green';
const GROUPS = [
  { k: 'sell', label: 'Vendre', chip: CHIP, dot: DOT, keys: ['pos', 'waiter', 'qr', 'online', 'loyalty'] },
  { k: 'make', label: 'Produire et acheter', chip: CHIP, dot: DOT, keys: ['margins', 'stock', 'bakery'] },
  { k: 'steer', label: 'Piloter', chip: CHIP, dot: DOT, keys: ['team', 'money', 'trust'] },
] as const;
const groups = GROUPS.map(g => ({ ...g, label: tt(g.label), modules: g.keys.map(k => fx.modules.find(m => m.key === k)).filter((m): m is (typeof fx.modules)[number] => !!m) }));
const fxLeft = fx.modules.filter(m => !GROUPS.some(g => (g.keys as readonly string[]).includes(m.key)));   // a module added later still shows up
if (fxLeft.length) groups[groups.length - 1].modules.push(...fxLeft);
const products = PRODUCTS.map(p => ({ ...p, label: t.nav[p.k], href: ROUTES[p.k][lang] }));
const productPages = ['pos', 'profit', 'site', 'marketing', 'restaurants', 'systems'];
const links = [
  { k: 'pricing', label: tt('Tarifs'), href: ROUTES.pricing[lang] },
  ...(lang === 'fr' ? [{ k: 'blog', label: 'Blog', href: ROUTES.blog[lang] }] : []),
  { k: 'contact', label: t.nav.contact, href: ROUTES.contact[lang] },
];
// Phone and tablet menu: Tarifs, Blog, Contact. The blog is French only, so other languages get a small FR label.
const menuLinks = links.filter(l => l.k !== 'blog') as { k: string; label: string; href: string; frOnly?: boolean }[];
menuLinks.splice(1, 0, { k: 'blog', label: tt('Blog'), href: ROUTES.blog[lang], frOnly: lang !== 'fr' });
const activeProducts = productPages.includes(page);
const activeFeatures = page === 'features';
const active = (k: string) => k === page;
const langs = langsProp ?? liveLanguages();
const LABEL: Record<Lang, string> = { fr: 'FR', ar: 'عربي', en: 'EN' };
const SHORT: Record<Lang, string> = { fr: 'FR', ar: 'ع', en: 'EN' };
const NAME: Record<Lang, string> = { fr: 'Français', ar: 'العربية', en: 'English' };
const trial = signupUrl(lang, page === 'profit' ? 'profit' : page === 'site' ? 'site' : page === 'pos' ? 'pos' : undefined);
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-chalk/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 md:gap-4 sm:px-6 2xl:max-w-7xl">
    <a href={ROUTES.home[lang]} aria-label="Amplify Growth Studio" class="me-auto"><Logo /></a>
    <nav class="hidden items-center gap-1 text-[0.95rem] xl:flex" aria-label="Navigation">
      <!-- Products panel -->
      <div class="group">
        <button type="button" aria-haspopup="true" class={`flex min-h-11 items-center gap-1.5 whitespace-nowrap rounded-full px-3.5 transition-colors hover:text-green-deep group-focus-within:text-green-deep ${activeProducts ? 'font-semibold text-green-deep' : 'text-navy'}`}>{tt('Produits')}<svg viewBox="0 0 24 24" class="size-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="invisible absolute inset-x-0 top-full border-b border-line bg-chalk opacity-0 shadow-[0_30px_60px_-30px_rgba(0,30,62,0.35)] transition-[opacity,visibility] duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          <div class="mx-auto grid max-w-6xl gap-3 px-6 py-6 lg:grid-cols-4 2xl:max-w-7xl">
            {products.map(p => (
              <a href={p.href} class="group/c relative isolate flex h-56 flex-col justify-end overflow-hidden rounded-[1.4rem] bg-navy p-5 text-white shadow-[0_18px_40px_-24px_rgba(0,30,62,0.6)] transition-transform duration-300 hover:-translate-y-0.5">
                <img src={p.img} alt="" width="800" height="597" loading="lazy" decoding="async" class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-700 ease-out group-hover/c:scale-105" style={`object-position:${p.pos}`} />
                <span class="absolute inset-0 -z-10 bg-linear-to-t from-navy/90 via-navy/35 to-transparent" aria-hidden="true"></span>
                <span class="absolute start-4 top-4 grid size-10 place-items-center rounded-xl bg-white/20 text-white ring-1 ring-white/30 backdrop-blur-md"><Icon name={p.icon} class="size-5" /></span>
                <span class="display text-[1.7rem] leading-none">{p.label}</span>
                <span class="mt-1.5 text-sm leading-snug text-white/85">{tt(p.text)}</span>
                <span class="absolute end-4 top-4 grid size-8 place-items-center rounded-full bg-green text-navy opacity-0 transition-opacity duration-300 group-hover/c:opacity-100" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-4 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
              </a>
            ))}
          </div>
          <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 border-t border-line px-6 py-3 text-sm 2xl:max-w-7xl">
            <span class="text-muted">{tt('Deux systèmes qui se parlent, et un marketing qui remplit la salle.')}</span>
            <a href={ROUTES.restaurants[lang]} class="font-semibold text-green-deep underline underline-offset-4">{t.nav.restaurants} →</a>
          </div>
        </div>
      </div>
      <!-- Features panel -->
      <div class="group">
        <button type="button" aria-haspopup="true" class={`flex min-h-11 items-center gap-1.5 whitespace-nowrap rounded-full px-3.5 transition-colors hover:text-green-deep group-focus-within:text-green-deep ${activeFeatures ? 'font-semibold text-green-deep' : 'text-navy'}`}>{t.nav.features}<svg viewBox="0 0 24 24" class="size-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="invisible absolute inset-x-0 top-full border-b border-line bg-chalk opacity-0 shadow-[0_30px_60px_-30px_rgba(0,30,62,0.35)] transition-[opacity,visibility] duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          <div class="mx-auto grid max-w-6xl gap-6 px-6 py-6 lg:grid-cols-[15rem_1fr] 2xl:max-w-7xl">
            <a href={ROUTES.features[lang]} class="group/all relative isolate flex min-h-80 flex-col justify-between overflow-hidden rounded-[1.4rem] bg-navy p-6 text-white shadow-[0_18px_40px_-24px_rgba(0,30,62,0.6)] transition-transform duration-300 hover:-translate-y-0.5">
              <img src="/img/nav-features.webp" alt="" width="540" height="720" loading="lazy" decoding="async" class="absolute inset-0 -z-20 size-full object-cover object-[50%_40%] transition-transform duration-700 ease-out group-hover/all:scale-105" />
              <span class="absolute inset-0 -z-10 bg-linear-to-t from-navy/95 via-navy/60 to-navy/80" aria-hidden="true"></span>
              <span class="display text-[4.5rem] leading-none text-green">{fxTotal}</span>
              <span>
                <span class="display block text-2xl leading-tight">{tt('fonctionnalités')}</span>
                <span class="mt-2 block text-sm leading-snug text-white/85">{tt('Tout est inclus, sans option payante.')}</span>
                <span class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-full bg-green px-5 text-[0.95rem] font-semibold text-navy transition-transform group-hover/all:translate-x-0.5 rtl:group-hover/all:-translate-x-0.5">{tt('Tout voir')} <span aria-hidden="true" class="rtl:-scale-x-100">→</span></span>
              </span>
            </a>
            <div class="grid grid-cols-3 gap-x-5">
              {groups.map(g => (
                <div>
                  <p class="mb-2 flex items-center gap-2 px-3 text-xs font-bold uppercase tracking-wider text-muted"><span class={`size-2 rounded-full ${g.dot}`} aria-hidden="true"></span>{g.label}</p>
                  <ul class="space-y-0.5">
                    {g.modules.map(m => (
                      <li><a href={`${ROUTES.features[lang]}#${m.key}`} class="flex items-center gap-3 rounded-xl px-3 py-2 transition-colors hover:bg-paper">
                        <span class={`grid size-9 shrink-0 place-items-center rounded-lg ${g.chip}`}><Icon name={MODULE_ICON[m.key] as any} class="size-5" /></span>
                        <span class="min-w-0 text-[0.95rem] font-medium leading-tight">{m.title}<span class="block text-xs font-normal text-muted">{m.items.length} {tt('fonctions')}</span></span>
                      </a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      {links.map(n => <a href={n.href} aria-current={active(n.k) ? 'page' : undefined}
        class={`flex min-h-11 items-center whitespace-nowrap rounded-full px-3.5 transition-colors hover:text-green-deep ${active(n.k) ? 'font-semibold text-green-deep' : 'text-navy'}`}>{n.label}</a>)}
    </nav>
    {langs.length > 1 && (
      <details class="lang-dd relative" data-lang-dd>
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 text-sm font-semibold text-muted transition-colors hover:bg-paper hover:text-navy [&::-webkit-details-marker]:hidden" aria-label={t.ui.langLabel}>
          <svg viewBox="0 0 24 24" class="size-[1.15rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z"/></svg>
          <span>{SHORT[lang]}</span>
          <svg viewBox="0 0 24 24" class="lang-chev size-3.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <ul class="absolute end-0 top-full z-50 mt-2 w-44 overflow-hidden rounded-2xl bg-paper p-1.5 shadow-[0_20px_50px_-15px_rgba(0,30,62,0.35)] ring-1 ring-line">
          {langs.map(l => (
            <li><a href={ROUTES[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}
              class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-[0.95rem] ${l === lang ? 'bg-chalk font-semibold text-navy' : 'text-navy hover:bg-chalk'}`}>
              <x-notr>{NAME[l]}</x-notr>{l === lang && <svg viewBox="0 0 24 24" class="size-4 text-green-deep" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>}
            </a></li>
          ))}
        </ul>
      </details>
    )}
    <a href={loginUrl(lang)} class="hidden whitespace-nowrap text-[0.95rem] text-muted hover:text-navy md:block xl:hidden 2xl:block">{t.nav.login}</a>
    <a href={trial} class="hidden min-h-11 items-center whitespace-nowrap rounded-full bg-navy px-5 text-[0.95rem] font-medium text-white hover:bg-blue md:inline-flex">{t.nav.trial}</a>
    <span class="hidden md:block"><WaButton text={wa} label="" where={`${page}-header`} class="min-h-11! size-11 px-0!" /></span>
    <details class="group xl:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-line" aria-label={t.ui.menu}>
        <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </summary>
      <nav class="absolute inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain bg-chalk px-4 pb-6 pt-2 shadow-2xl sm:px-6" aria-label="Navigation">
        <div class="mx-auto max-w-6xl">
        <details class="group/m border-b border-line" open>
          <summary class="display flex cursor-pointer list-none items-center justify-between py-4 text-3xl md:py-5 md:text-[1.9rem] [&::-webkit-details-marker]:hidden">{tt('Produits')}<svg viewBox="0 0 24 24" class="size-5 transition-transform group-open/m:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <div class="grid grid-cols-2 gap-2.5 pb-4 md:grid-cols-4 md:gap-3">
            {products.map(p => (
              <a href={p.href} class="relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-[1.25rem] bg-navy p-3.5 text-white active:scale-[0.98] md:aspect-auto md:h-48 md:p-4">
                <img src={p.img} alt="" width="800" height="597" loading="lazy" decoding="async" class="absolute inset-0 -z-20 size-full object-cover" style={`object-position:${p.pos}`} />
                <span class="absolute inset-0 -z-10 bg-linear-to-t from-navy/90 via-navy/25 to-transparent" aria-hidden="true"></span>
                <span class="absolute start-3 top-3 grid size-9 place-items-center rounded-xl bg-white/20 ring-1 ring-white/30 backdrop-blur-md"><Icon name={p.icon} class="size-[1.15rem]" /></span>
                <span class="display text-[1.35rem] leading-none md:text-[1.5rem]">{p.label.replace('Amplify ', '')}</span>
                <span class="mt-1 text-[0.8rem] leading-tight text-white/85 md:text-[0.85rem]">{tt(p.short)}</span>
              </a>
            ))}
          </div>
          <a href={ROUTES.restaurants[lang]} class="mb-4 flex min-h-12 items-center justify-between rounded-full bg-paper px-5 font-semibold ring-1 ring-line md:mt-1 md:px-6">{t.nav.restaurants}<span class="text-green-deep" aria-hidden="true">→</span></a>
        </details>
        <details class="group/m border-b border-line">
          <summary class="display flex cursor-pointer list-none items-center justify-between py-4 text-3xl md:py-5 md:text-[1.9rem] [&::-webkit-details-marker]:hidden">{t.nav.features}<svg viewBox="0 0 24 24" class="size-5 transition-transform group-open/m:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <div class="space-y-4 pb-3 md:grid md:grid-cols-3 md:gap-5 md:space-y-0">
            {groups.map(g => (
              <div>
                <p class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-muted"><span class={`size-2 rounded-full ${g.dot}`} aria-hidden="true"></span>{g.label}</p>
                <div class="grid grid-cols-2 gap-2 md:grid-cols-1">
                  {g.modules.map(m => (
                    <a href={`${ROUTES.features[lang]}#${m.key}`} class="flex items-start gap-2.5 rounded-2xl bg-paper p-3 ring-1 ring-line active:bg-mint">
                      <span class={`grid size-9 shrink-0 place-items-center rounded-lg ${g.chip}`}><Icon name={MODULE_ICON[m.key] as any} class="size-[1.15rem]" /></span>
                      <span class="min-w-0 text-[0.88rem] font-semibold leading-tight">{m.title}<span class="mt-0.5 block text-xs font-normal text-muted">{m.items.length} {tt('fonctions')}</span></span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <a href={ROUTES.features[lang]} class="mb-4 mt-2 grid min-h-12 place-items-center rounded-full bg-green px-5 font-semibold text-navy md:mt-5">{tt('Voir les {n} fonctionnalités').replace('{n}', String(fxTotal))} →</a>
        </details>
        <div class="grid gap-2.5 py-4 md:grid-cols-3 md:gap-3 md:border-b md:border-line md:py-5">
          {menuLinks.map(n => (
            <a href={n.href} class="display flex min-h-14 items-center justify-between gap-3 rounded-2xl border border-line bg-paper px-5 text-[1.5rem] active:bg-mint md:px-6">
              <span class="flex items-center gap-2.5">{n.label}{n.frOnly && <span lang="fr" class="rounded-full bg-chalk px-2 py-0.5 font-sans text-[0.7rem] font-bold tracking-wide text-muted ring-1 ring-line">FR</span>}</span>
              <span class="text-base text-green-deep rtl:-scale-x-100" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        {toc && toc.length > 0 && (
          <div class="border-t border-line pt-4 md:border-t-0 md:pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-muted">{tt('Sur cette page')}</p>
            <div class="mt-2.5 grid grid-cols-2 gap-2 md:grid-cols-4 md:gap-2.5">
              {toc.map(i => <a href={`#${i.id}`} data-toc class="inline-flex min-h-11 items-center justify-center rounded-2xl bg-paper px-3 text-center text-[0.9rem] font-semibold leading-tight ring-1 ring-line active:bg-mint md:rounded-full">{i.label}</a>)}
            </div>
          </div>
        )}
        <div class="mt-5 grid grid-cols-2 gap-2 md:hidden">
          <a href={loginUrl(lang)} class="grid min-h-12 place-items-center rounded-full border border-navy/25 font-medium">{t.nav.login}</a>
          <a href={trial} class="grid min-h-12 place-items-center rounded-full bg-navy font-medium text-white">{t.nav.trial}</a>
        </div>
        </div>
      </nav>
    </details>
  </div>
</header>
<script>
  // the in-page index closes the menu, then the page scrolls to the section
  document.querySelectorAll<HTMLAnchorElement>('[data-toc]').forEach((a) => a.addEventListener('click', () => { const d = a.closest('details'); if (d) d.open = false; }));
  // language menu: closes on outside click and on Escape
  document.querySelectorAll<HTMLDetailsElement>('[data-lang-dd]').forEach((dd) => {
    document.addEventListener('click', (e) => { if (dd.open && !dd.contains(e.target as Node)) dd.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dd.open = false; });
    // only one of the two open at a time (language menu / phone menu)
    const other = dd.closest('header')?.querySelector<HTMLDetailsElement>('details:not([data-lang-dd])');
    dd.addEventListener('toggle', () => { if (dd.open && other) other.open = false; });
    other?.addEventListener('toggle', () => { if (other.open) dd.open = false; });
  });
</script>
