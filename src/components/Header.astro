---
import Logo from './Logo.astro';
import WaButton from './WaButton.astro';
import { copy } from '../i18n';
import { ROUTES, liveLanguages, type Lang, type PageKey } from '../i18n/routes';
interface Props { lang: Lang; page: PageKey; wa: string }
const { lang, page, wa } = Astro.props;
const t = copy(lang);
const nav = (['systems', 'marketing', 'restaurants', 'contact'] as const).map(k => ({ k, label: t.nav[k], href: ROUTES[k][lang] }));
const langs = liveLanguages();
const LABEL: Record<Lang, string> = { fr: 'FR', ar: 'عربي', en: 'EN' };
---
<header class="sticky top-0 z-40 bg-blue/95 text-white backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href={ROUTES.home[lang]} aria-label="Amplify Growth Studio" class="me-auto"><Logo light /></a>
    <nav class="hidden items-center gap-7 text-[0.95rem] md:flex" aria-label="Navigation">
      {nav.map(n => <a href={n.href} aria-current={n.k === page ? 'page' : undefined}
        class={`transition-colors hover:text-green ${n.k === page ? 'font-semibold text-green' : 'text-white/85'}`}>{n.label}</a>)}
    </nav>
    {langs.length > 1 && (
      <div class="hidden items-center gap-1 text-sm md:flex" aria-label={t.ui.langLabel}>
        {langs.map(l => <a href={ROUTES[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}
          class={`rounded-md px-2 py-1 ${l === lang ? 'bg-white text-navy' : 'text-white/70 hover:text-white'}`}>{LABEL[l]}</a>)}
      </div>
    )}
    <span class="hidden md:block"><WaButton text={wa} label={t.ui.whatsappShort} where={`${page}-header`} class="min-h-11! px-5 text-[0.95rem]" /></span>
    <details class="group md:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/25" aria-label={t.ui.menu}>
        <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </summary>
      <nav class="absolute inset-x-0 top-16 bg-blue px-4 pb-6 pt-2 shadow-2xl" aria-label="Navigation">
        {nav.map(n => <a href={n.href} class="display block border-b border-white/15 py-4 text-3xl">{n.label}</a>)}
        {langs.length > 1 && <div class="mt-4 flex gap-2">{langs.map(l => <a href={ROUTES[page][l]} lang={l} class={`rounded-md px-3 py-2 ${l === lang ? 'bg-navy text-white' : 'border border-line'}`}>{LABEL[l]}</a>)}</div>}
      </nav>
    </details>
  </div>
</header>
