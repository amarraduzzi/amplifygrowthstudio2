---
import Icon from './Icon.astro';
// A looping illustration of the reminder the day before: the salon sends it from its own WhatsApp in one tap,
// one client confirms, another cancels and the slot is freed. Invented first names. With reduced motion the
// last state stays still.
const rows = [
  ['10:00', 'Leila', 'Coupe et brushing', 'ok'],
  ['11:30', 'Maryam', 'Brushing', 'wait'],
  ['14:00', 'Hajar', 'Manucure semi-permanent', 'free'],
] as const;
const label = { ok: 'Confirmé', wait: 'À confirmer', free: 'Place libérée' } as const;
---
<div class="sl-rm mt-14 rounded-[2rem] bg-paper p-5 ring-1 ring-line md:p-8" data-rm>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">Voyez le rappel de la veille.</p>
    <span class="rounded-full bg-chalk px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">Exemple d’illustration</span>
  </div>
  <p class="sr-only">Illustration : le salon envoie le rappel de la veille sur WhatsApp, le client confirme ou annule, et la place se libère.</p>

  <div class="mt-7 grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:gap-8" aria-hidden="true">
    <div>
      <p class="text-sm font-semibold text-muted">Demain</p>
      <ul class="mt-3 space-y-3">
        {rows.map(([time, name, service, st]) => (
          <li class="sl-r flex items-center gap-3 rounded-2xl bg-chalk p-3 ring-1 ring-line" data-r data-state={st}>
            <span class="rounded-xl bg-paper px-2.5 py-1.5 text-sm font-bold tabular-nums ring-1 ring-line" data-time>{time}</span>
            <div class="min-w-0 flex-1"><p class="sl-rn truncate font-semibold" data-rname>{name}</p><p class="truncate text-xs text-muted">{service}</p></div>
            <span class="sl-st shrink-0 rounded-full px-3 py-1 text-xs font-bold" data-st>{label[st]}</span>
          </li>
        ))}
      </ul>
      <p class="sl-send mt-4 inline-flex items-center gap-2 rounded-full bg-green px-4 py-2 text-sm font-semibold text-navy"><Icon name="bell" class="size-4" />Envoyer le rappel</p>
    </div>
    <div class="relative flex min-h-[15rem] flex-col rounded-[1.75rem] bg-[#EFEAE2] p-4">
      <p class="flex items-center gap-2 border-b border-black/10 pb-3 text-sm font-semibold"><span class="grid size-7 place-items-center rounded-full bg-navy text-[0.65rem] font-bold text-white">S</span>Salon Démo</p>
      <div class="mt-3 flex flex-1 flex-col justify-end gap-2" data-chat>
        <p class="sl-b max-w-[88%] self-start rounded-2xl rounded-ss-sm bg-[#DCF8C6] p-3 text-[0.78rem] leading-snug text-[#111B21] shadow-sm">Bonjour {'Hajar'}, rappel : votre rendez-vous est demain à 14:00 chez Salon Démo. Répondez OUI pour confirmer.</p>
        <p class="sl-b max-w-[70%] self-end rounded-2xl rounded-se-sm bg-white p-3 text-[0.78rem] leading-snug text-[#111B21] shadow-sm">Je dois annuler</p>
      </div>
    </div>
  </div>

  <!-- texts the script reuses, so the English and Arabic pages translate them too -->
  <span hidden data-msg>{'Bonjour {n}, rappel : votre rendez-vous est demain à {h} chez Salon Démo. Répondez OUI pour confirmer.'}</span>
  <span hidden data-yes>OUI</span>
  <span hidden data-no>Je dois annuler</span>
  <span hidden data-l-ok>Confirmé</span>
  <span hidden data-l-wait>À confirmer</span>
  <span hidden data-l-free>Place libérée</span>
</div>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-rm]').forEach((root) => {
    if (still || !('IntersectionObserver' in window)) return;
    const txt = (s: string) => root.querySelector<HTMLElement>(s)?.textContent?.trim() ?? '';
    const msg = txt('[data-msg]'), yes = txt('[data-yes]'), no = txt('[data-no]');
    const label = { ok: txt('[data-l-ok]'), wait: txt('[data-l-wait]'), free: txt('[data-l-free]') };
    const rows = [...root.querySelectorAll<HTMLElement>('[data-r]')];
    const chat = root.querySelector<HTMLElement>('[data-chat]')!;
    const send = root.querySelector<HTMLElement>('.sl-send')!;
    const say = (kind: 'out' | 'in', text: string) => {
      const p = document.createElement('p');
      p.className = 'sl-b sl-bin rounded-2xl p-3 text-[0.78rem] leading-snug text-[#111B21] shadow-sm ' +
        (kind === 'out' ? 'max-w-[88%] self-start rounded-ss-sm bg-[#DCF8C6]' : 'max-w-[70%] self-end rounded-se-sm bg-white');
      p.textContent = text; chat.appendChild(p);
    };
    const hello = (i: number) => msg.replace('{n}', rows[i].querySelector('[data-rname]')!.textContent!.trim()).replace('{h}', rows[i].querySelector('[data-time]')!.textContent!.trim());
    const set = (i: number, st: 'ok' | 'wait' | 'free') => {
      const r = rows[i]; r.dataset.state = st;
      const s = r.querySelector<HTMLElement>('[data-st]')!; s.textContent = label[st];
      s.classList.remove('sl-pop'); void s.offsetWidth; s.classList.add('sl-pop');
    };
    const press = () => { send.classList.add('pressed'); setTimeout(() => send.classList.remove('pressed'), 450); };
    const steps: [number, () => void][] = [
      [0, () => { chat.innerHTML = ''; set(0, 'wait'); set(1, 'wait'); set(2, 'wait'); }],
      [1200, press],
      [1700, () => say('out', hello(0))],
      [3400, () => { say('in', yes); set(0, 'ok'); }],
      [5600, () => { chat.innerHTML = ''; press(); }],
      [6200, () => say('out', hello(2))],
      [7900, () => { say('in', no); set(2, 'free'); }],
      [12000, () => {}],
    ];
    let clock = 0, idx = 0, visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.3 }).observe(root);
    setInterval(() => {
      if (!visible || document.hidden) return;
      clock += 100;
      while (idx < steps.length && clock >= steps[idx][0]) { steps[idx][1](); idx++; }
      if (idx >= steps.length) { idx = 0; clock = 0; }
    }, 100);
  });
</script>
