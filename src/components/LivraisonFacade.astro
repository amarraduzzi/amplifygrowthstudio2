---
// Livraison, hero "La Façade". A real 3D scene (three.js, loaded only here, in code, no image files).
// 1: your restaurant at night, your own name on the neon sign. 2: an orange app banner rolls over the sign, a "jusqu'à 30 %" sticker
// lands on the window, a delivery scooter parks and the money drops from the letterbox into its bag. 3: the visitor peels the banner
// off (drag, or it peels itself after about 3 s). 4: the front swings open like a dolls' house: five rooms light up while one order
// travels through them (Bssaha, your site, your till, your driver, the handover code). 5: the money lands in your till, the sign
// with your name goes to the roof. Plays once, stays on the finished scene.
// The restaurant name, the order (140 DH) and the code are examples. "jusqu'à 30 %" is a statement about what the apps charge, not about Amplify.
// No WebGL / no JavaScript / reduced motion: the finished result is shown (panel with 0 DH commission and 140 DH received).
import { tr } from '../i18n/t';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const tt = tr(Astro.props.lang);
const steps = ['Bssaha', 'Votre site de commande', 'Votre caisse', 'Votre livreur', 'Remise avec code'];
const caps: Record<string, string> = {
  '1': 'Votre restaurant. Votre nom. Vos clients.',
  '2': 'Puis une app s’installe sur votre enseigne.',
  '3': 'Elle garde jusqu’à 30 % de chaque commande.',
  '5': 'Arrachée. Votre nom est de retour.',
  '6': 'Bssaha : vos clients vous trouvent.',
  '7': 'Votre site : ils commandent chez vous.',
  '8': 'Votre caisse : la commande arrive.',
  '9': 'Votre livreur : la course part.',
  '10': 'Le code : la remise est prouvée.',
  '11': 'Votre argent reste chez vous.',
};
const tx = {
  banner: tt('App de livraison'),
  banner2: tt('Votre restaurant : un nom dans une liste'),
  stickerA: tt('jusqu’à'),
  stickerB: '30 %',
  name: tt('Chez Nour'),
  bssaha: 'Bssaha',
  order: '140 DH',
  code: '4827',
  total: tt('Total reçu'),
  exemple: tt('Exemple'),
};
---
<div class="fc" id="fc" data-s="11" data-c="11" data-tx={JSON.stringify(tx)}>
  <canvas class="fc-cv" id="fc-cv" aria-hidden="true"></canvas>
  <div class="fc-shade" aria-hidden="true"></div>
  <div class="fc-cap" aria-hidden="true">
    {Object.entries(caps).map(([k, v]) => <p data-k={k}>{tt(v)}</p>)}
  </div>
  <p class="sr-only">{tt('L’histoire en images : une commande avec une app, puis avec Amplify.')} {tt(caps['11'])}</p>
  <button type="button" class="fc-hint" id="fc-hint" hidden aria-label={tt('Tirez pour l’enlever')}><i aria-hidden="true"></i><span>{tt('Tirez pour l’enlever')}</span></button>
  <button type="button" class="fc-re" id="fc-re" hidden>{tt('Revoir l’histoire')}</button>
  <div class="fc-done">
    <p class="fc-ex">{tt('Exemple')} : 2 × {tt('Tajine poulet')}</p>
    <p class="fc-row fc-no"><s>{tt('Commission app')}</s><b dir="ltr">0 DH</b></p>
    <p class="fc-row fc-tot"><span>{tt('Total reçu')}</span><b class="font-dot" dir="ltr" id="fc-sum">140 DH</b></p>
  </div>
  <ol class="fc-steps" aria-hidden="true">
    {steps.map((s, i) => <li data-i={i}><i></i><span>{tt(s)}</span></li>)}
  </ol>
</div>
<script is:inline>
  (function () {
    var n = document.getElementById('fc');
    if (!n || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    n.dataset.s = '1'; n.dataset.c = '1'; n.classList.add('pre');
  })();
</script>
<script>
  // @ts-nocheck
  const root = document.getElementById('fc');
  const cv = document.getElementById('fc-cv');
  if (root && cv) {
    import('three').then(async (T) => {
      try { await document.fonts.ready; } catch (e) {}
      try { run(T); } catch (e) { console.warn('facade', e); root.classList.remove('pre'); root.classList.add('nogl'); root.dataset.s = '11'; root.dataset.c = '11'; }
    }).catch(() => { root.classList.remove('pre'); root.classList.add('nogl'); });
  }

  function run(T) {
    const D = JSON.parse(root.dataset.tx);
    const hint = document.getElementById('fc-hint');
    const re = document.getElementById('fc-re');
    const sum = document.getElementById('fc-sum');
    const dots = [...root.querySelectorAll('.fc-steps li')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GL = '#3DFFA0', CO = '#FF6B5B', OR = '#FF7A1F';
    const FONT = '"Archivo Variable","Readex Pro Variable",system-ui,sans-serif';
    const DOT = '"Doto Variable","Readex Pro Variable",ui-monospace,monospace';

    const renderer = new T.WebGLRenderer({ canvas: cv, antialias: true, powerPreference: 'high-performance' });
    renderer.outputColorSpace = T.SRGBColorSpace;
    renderer.toneMapping = T.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.15;
    renderer.shadowMap.enabled = true; renderer.shadowMap.type = T.PCFSoftShadowMap;
    const scene = new T.Scene();
    scene.background = new T.Color(0x050e1b);
    scene.fog = new T.Fog(0x061426, 18, 46);
    const cam = new T.PerspectiveCamera(30, 1, 0.1, 90);

    // ---------- helpers ----------
    const rnd = (a) => () => { a |= 0; a = (a + 0x6D2B79F5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const ss = (a, b, x) => { const k = clamp((x - a) / (b - a)); return k * k * (3 - 2 * k); };
    const lerp = (a, b, k) => a + (b - a) * k;
    const eo = (k) => 1 - Math.pow(1 - clamp(k), 3);
    const eb = (k) => { k = clamp(k); const c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(k - 1, 3) + c1 * Math.pow(k - 1, 2); };
    const ctex = (w, h, draw, opts = {}) => {
      const c = document.createElement('canvas'); c.width = w; c.height = h;
      draw(c.getContext('2d'), w, h);
      const t = new T.CanvasTexture(c); t.colorSpace = opts.linear ? T.NoColorSpace : T.SRGBColorSpace; t.anisotropy = 8;
      if (opts.repeat) { t.wrapS = t.wrapT = T.RepeatWrapping; t.repeat.set(opts.repeat[0], opts.repeat[1]); }
      return t;
    };
    const std = (color, o = {}) => new T.MeshStandardMaterial({ color, roughness: 0.85, metalness: 0, ...o });
    const basic = (color, o = {}) => new T.MeshBasicMaterial({ color, toneMapped: false, ...o });
    const box = (w, h, d, mat, x = 0, y = 0, z = 0, parent = scene, shadow = true) => {
      const m = new T.Mesh(new T.BoxGeometry(w, h, d), mat); m.position.set(x, y, z);
      if (shadow) { m.castShadow = true; m.receiveShadow = true; }
      parent.add(m); return m;
    };
    const fitText = (g, txt, maxW, size, weight, font) => { let s = size; g.font = `${weight} ${s}px ${font}`; while (g.measureText(txt).width > maxW && s > 10) { s -= 2; g.font = `${weight} ${s}px ${font}`; } return s; };
    const glowTex = (() => { const c = document.createElement('canvas'); c.width = c.height = 128; const g = c.getContext('2d'); const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64); gr.addColorStop(0, 'rgba(255,255,255,1)'); gr.addColorStop(.25, 'rgba(255,255,255,.45)'); gr.addColorStop(1, 'rgba(255,255,255,0)'); g.fillStyle = gr; g.fillRect(0, 0, 128, 128); const t = new T.CanvasTexture(c); t.colorSpace = T.SRGBColorSpace; return t; })();
    const glow = (color, size, x, y, z, op = 1, parent = scene) => {
      const s = new T.Sprite(new T.SpriteMaterial({ map: glowTex, color, transparent: true, opacity: op, depthWrite: false, blending: T.AdditiveBlending, toneMapped: false, fog: false }));
      s.scale.set(size, size, 1); s.position.set(x, y, z); parent.add(s); return s;
    };

    // ---------- sky, street, neighbours ----------
    const skyTex = ctex(1024, 512, (g, w, h) => {
      const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, '#02050d'); gr.addColorStop(.55, '#081a31'); gr.addColorStop(1, '#17415a');
      g.fillStyle = gr; g.fillRect(0, 0, w, h);
      const r = rnd(5);
      for (let i = 0; i < 160; i++) { g.fillStyle = `rgba(255,255,255,${.25 + r() * .6})`; const s = r() < .1 ? 2 : 1; g.fillRect(r() * w, r() * h * .55, s, s); }
      g.fillStyle = '#fdf6d8'; g.beginPath(); g.arc(w * .82, h * .2, 18, 0, 7); g.fill();
      const gm = g.createRadialGradient(w * .82, h * .2, 10, w * .82, h * .2, 120); gm.addColorStop(0, 'rgba(200,225,255,.35)'); gm.addColorStop(1, 'rgba(200,225,255,0)'); g.fillStyle = gm; g.fillRect(w * .82 - 130, h * .2 - 130, 260, 260);
      for (let layer = 0; layer < 2; layer++) {
        let x = 0; g.fillStyle = layer ? '#0a1a2c' : '#0c2236';
        while (x < w) { const bw = 30 + r() * 60, bh = (layer ? 60 : 110) + r() * (layer ? 80 : 120); g.fillRect(x, h - bh, bw, bh);
          for (let wy = h - bh + 8; wy < h - 6; wy += 14) for (let wx = x + 6; wx < x + bw - 6; wx += 12) if (r() < (layer ? .12 : .2)) { g.fillStyle = r() < .7 ? 'rgba(255,200,130,.75)' : 'rgba(120,255,200,.6)'; g.fillRect(wx, wy, 5, 7); }
          g.fillStyle = layer ? '#0a1a2c' : '#0c2236'; x += bw + 2 + r() * 8; }
      }
    });
    const sky = new T.Mesh(new T.PlaneGeometry(90, 40), new T.MeshBasicMaterial({ map: skyTex, fog: false, toneMapped: false }));
    sky.position.set(0, 12, -20); scene.add(sky);

    const roadTex = ctex(512, 512, (g, w, h) => {
      g.fillStyle = '#121a24'; g.fillRect(0, 0, w, h); const r = rnd(9);
      for (let i = 0; i < 2600; i++) { const v = 18 + Math.floor(r() * 26); g.fillStyle = `rgb(${v},${v + 6},${v + 14})`; g.fillRect(r() * w, r() * h, 2, 2); }
    }, { repeat: [10, 4] });
    const road = new T.Mesh(new T.PlaneGeometry(70, 26), std(0xffffff, { map: roadTex, roughness: 0.8, metalness: 0 }));
    road.rotation.x = -Math.PI / 2; road.position.set(0, 0, 4.2); road.receiveShadow = true; scene.add(road);
    const pave = std(0x39434f, { roughness: 0.7 });
    box(70, 0.14, 1.5, pave, 0, 0.07, 2.3 + 0.0, scene, true);
    box(70, 0.2, 0.14, std(0x59636f), 0, 0.1, 3.1, scene, false);
    for (let i = -8; i <= 8; i++) { const d = box(1.6, 0.012, 0.16, basic(0x6e7886), i * 3.4, 0.012, 8.3, scene, false); d.material.opacity = 0.5; d.material.transparent = true; }

    const winTex = (seed, lit) => ctex(256, 512, (g, w, h) => {
      const r = rnd(seed); g.fillStyle = lit ? '#000' : '#4a4f5c'; g.fillRect(0, 0, w, h);
      for (let y = 18; y < h - 30; y += 70) for (let x = 20; x < w - 30; x += 64) {
        const on = r() < 0.4; g.fillStyle = lit ? (on ? (r() < .7 ? '#ffc98a' : '#9effd0') : '#000') : (on ? '#2a2112' : '#1a2230'); g.fillRect(x, y, 38, 46);
        if (!lit) { g.fillStyle = '#6a6f7c'; g.fillRect(x - 4, y + 46, 46, 6); }
      }
    });
    const neighbour = (x0, x1, hgt, seed) => {
      const w = x1 - x0; const m = std(0xffffff, { map: winTex(seed, false), emissiveMap: winTex(seed, true), emissive: 0xffffff, emissiveIntensity: 0.9, roughness: 0.9 });
      m.map.repeat.set(w / 3.4, hgt / 6.8); m.map.wrapS = m.map.wrapT = T.RepeatWrapping; m.emissiveMap.repeat.copy(m.map.repeat); m.emissiveMap.wrapS = m.emissiveMap.wrapT = T.RepeatWrapping;
      box(w, hgt, 3.2, m, (x0 + x1) / 2, hgt / 2, 0);
    };
    neighbour(-12.5, -3.58, 6.4, 3); neighbour(3.58, 11, 4.4, 8); neighbour(-26, -12.6, 8, 13); neighbour(11.1, 26, 7, 21);

    // warm spill of the windows on the pavement
    [[-1.75, 0xffb869, 3.4], [1.75, 0xffb869, 3.4], [0, 0x3dffa0, 2.6]].forEach(([x, c, sz], i) => { const m = new T.Mesh(new T.PlaneGeometry(sz, 1.7), new T.MeshBasicMaterial({ map: glowTex, color: c, transparent: true, opacity: i === 2 ? 0.0 : 0.38, depthWrite: false, blending: T.AdditiveBlending, toneMapped: false, fog: false })); m.rotation.x = -Math.PI / 2; m.position.set(x, 0.16, 2.55); scene.add(m); });
    // ---------- lights ----------
    scene.add(new T.HemisphereLight(0x6f93c8, 0x1a1411, 0.55));
    const moon = new T.DirectionalLight(0x8fb1ff, 0.9); moon.position.set(-6, 10, 9); moon.castShadow = true;
    moon.shadow.mapSize.set(1024, 1024); const sc = moon.shadow.camera; sc.left = -9; sc.right = 9; sc.top = 9; sc.bottom = -4; sc.near = 1; sc.far = 40; moon.shadow.bias = -0.0006;
    scene.add(moon);
    const lampL = new T.PointLight(0xffc27a, 14, 12, 2); lampL.position.set(4.6, 3.3, 2.7); scene.add(lampL);
    // street lamp
    { const lp = std(0x1b232d, { metalness: .5, roughness: .5 }); box(0.1, 3.5, 0.1, lp, 4.6, 1.75, 2.7); box(0.5, 0.08, 0.08, lp, 4.4, 3.5, 2.7); box(0.3, 0.14, 0.2, basic(0xffe0a8), 4.2, 3.44, 2.7, scene, false); glow(0xffb869, 2.6, 4.2, 3.4, 2.75, 0.85); }

    // ---------- the building: shell, interior, five rooms ----------
    const plaster = ctex(512, 512, (g, w, h) => {
      g.fillStyle = '#d8c5a4'; g.fillRect(0, 0, w, h); const r = rnd(2);
      for (let i = 0; i < 5000; i++) { const v = r() < .5 ? 0 : 255; g.fillStyle = `rgba(${v},${v},${v},${.03 + r() * .05})`; g.fillRect(r() * w, r() * h, 1 + r() * 3, 1 + r() * 3); }
    }, { repeat: [1, 1] });
    const wallMat = std(0xffffff, { map: plaster, bumpMap: plaster, bumpScale: 1.2, roughness: 0.9, side: T.DoubleSide });
    const trim = std(0x0d2a45, { roughness: 0.5 });
    const innerMat = (c) => std(c, { roughness: 0.9 });
    const shell = new T.Group(); scene.add(shell);
    const slabMat = std(0xb9a98c);
    box(7.7, 0.22, 3.9, slabMat, 0, 5.09, 0, shell);       // roof
    box(7.2, 0.16, 3.2, slabMat, 0, 2.6, 0, shell);        // mid slab
    box(7.2, 0.12, 3.2, std(0x6b5a45, { roughness: .6 }), 0, 0.2, 0, shell); // ground floor (above pavement)
    box(0.16, 5.1, 3.2, wallMat, -3.55, 2.55, 0, shell); box(0.16, 5.1, 3.2, wallMat, 3.55, 2.55, 0, shell);
    box(0.1, 2.45, 3.2, wallMat, -1.2, 1.4, 0, shell); box(0.1, 2.45, 3.2, wallMat, 1.2, 1.4, 0, shell);
    box(0.1, 2.3, 3.2, wallMat, 0, 3.85, 0, shell);
    box(7.4, 0.5, 0.2, std(0x0d2a45), 0, 5.35, 1.5, shell);   // parapet
    const rooms = [
      { x0: -3.5, x1: 0, y0: 2.68, y1: 5.0, c: 0x17344f, lx: -1.75, ly: 3.9 },   // Bssaha
      { x0: 0, x1: 3.5, y0: 2.68, y1: 5.0, c: 0x1c3b42, lx: 1.75, ly: 3.9 },     // site
      { x0: -3.5, x1: -1.2, y0: 0.26, y1: 2.55, c: 0x5b3b2a, lx: -2.35, ly: 1.5 },    // till
      { x0: 1.2, x1: 3.5, y0: 0.26, y1: 2.55, c: 0x24313c, lx: 2.35, ly: 1.5 },       // driver
      { x0: -1.2, x1: 1.2, y0: 0.26, y1: 2.55, c: 0x3a2f3f, lx: 0, ly: 1.5 },        // code
    ];
    rooms.forEach((r, i) => {
      const w = r.x1 - r.x0, h = r.y1 - r.y0, cx = (r.x0 + r.x1) / 2, cy = (r.y0 + r.y1) / 2;
      const back = new T.Mesh(new T.PlaneGeometry(w, h), innerMat(r.c)); back.position.set(cx, cy, -1.5); back.receiveShadow = true; shell.add(back);
      r.light = new T.PointLight(0xffc98a, 0, 7, 1.6); r.light.position.set(r.lx, r.ly + 0.5, 0.5); shell.add(r.light);
      r.fmat = basic(0x1d4a3d);
      const t = 0.07, z = 1.56;
      [[w, t, cx, r.y0 + t / 2], [w, t, cx, r.y1 - t / 2], [t, h, r.x0 + t / 2, cy], [t, h, r.x1 - t / 2, cy]].forEach(([bw, bh, bx, by]) => box(bw, bh, 0.05, r.fmat, bx, by, z, shell, false));
      r.halo = glow(0x3dffa0, Math.max(w, h) * 1.15, cx, cy, -1.2, 0, shell); r.k = 0; r.target = 0;
    });
    // --- room 0: Bssaha (a map with pins) ---
    {
      const mapTex = ctex(768, 432, (g, w, h) => {
        g.fillStyle = '#0a1d33'; g.fillRect(0, 0, w, h); g.strokeStyle = 'rgba(61,255,160,.16)'; g.lineWidth = 2;
        for (let x = 0; x < w; x += 48) { g.beginPath(); g.moveTo(x, 0); g.lineTo(x, h); g.stroke(); } for (let y = 0; y < h; y += 48) { g.beginPath(); g.moveTo(0, y); g.lineTo(w, y); g.stroke(); }
        g.strokeStyle = 'rgba(255,255,255,.22)'; g.lineWidth = 7; g.beginPath(); g.moveTo(0, 300); g.bezierCurveTo(200, 240, 360, 360, w, 200); g.stroke(); g.beginPath(); g.moveTo(180, 0); g.bezierCurveTo(260, 140, 320, 260, 280, h); g.stroke();
        [[160, 150], [330, 250], [520, 120], [610, 300], [430, 70]].forEach(([x, y], i) => { g.fillStyle = i === 1 ? GL : 'rgba(61,255,160,.55)'; g.beginPath(); g.arc(x, y, i === 1 ? 17 : 10, 0, 7); g.fill(); });
        g.fillStyle = 'rgba(255,255,255,.95)'; g.beginPath(); if (g.roundRect) g.roundRect(60, 28, 360, 56, 28); else g.rect(60, 28, 360, 56); g.fill();
        g.fillStyle = '#0a1d33'; g.font = `800 30px ${FONT}`; g.textBaseline = 'middle'; g.fillText(D.bssaha, 92, 57);
      });
      const scr = new T.Mesh(new T.PlaneGeometry(2.7, 1.52), basic(0xffffff, { map: mapTex })); scr.position.set(-1.75, 4.05, -1.45); shell.add(scr);
      box(2.9, 0.05, 0.9, std(0x2b2f36), -1.75, 2.9, -0.9, shell);
      const pin = new T.Group(); const pm = basic(0x3dffa0);
      const ball = new T.Mesh(new T.SphereGeometry(0.2, 20, 14), pm); ball.position.y = 0.32; pin.add(ball);
      const cone = new T.Mesh(new T.ConeGeometry(0.16, 0.38, 20), pm); cone.rotation.x = Math.PI; cone.position.y = 0.1; pin.add(cone);
      pin.position.set(-1.75, 3.2, -0.5); shell.add(pin); rooms[0].pin = pin; glow(0x3dffa0, 1.2, -1.75, 3.5, -0.5, 0.6, shell);
    }
    // --- room 1: your site (a monitor with the menu and a QR code) ---
    {
      const siteTex = ctex(640, 400, (g, w, h) => {
        g.fillStyle = '#f7f2e8'; g.fillRect(0, 0, w, h); g.fillStyle = '#0d2a45'; g.fillRect(0, 0, w, 74);
        g.fillStyle = '#fff'; g.font = `800 36px ${FONT}`; g.textBaseline = 'middle'; g.fillText(D.name, 28, 38);
        g.fillStyle = GL; g.beginPath(); g.arc(w - 40, 37, 9, 0, 7); g.fill();
        const r = rnd(4); [[28, 100], [28, 180], [28, 260]].forEach(([x, y]) => { g.fillStyle = '#e4dccb'; g.fillRect(x, y, 90, 62); g.fillStyle = '#0d2a45'; g.fillRect(x + 108, y + 8, 150 + r() * 40, 14); g.fillStyle = '#b8ad97'; g.fillRect(x + 108, y + 34, 100 + r() * 60, 10); });
        g.fillStyle = '#05B962'; if (g.roundRect) { g.beginPath(); g.roundRect(28, 336, 190, 44, 22); g.fill(); } else g.fillRect(28, 336, 190, 44);
        const qx = 400, qy = 110, q = 190, n = 17, c = q / n; g.fillStyle = '#fff'; g.fillRect(qx - 8, qy - 8, q + 16, q + 16); g.fillStyle = '#0a0f18';
        const rr = rnd(77); for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) { const fin = (i < 5 && j < 5) || (i > n - 6 && j < 5) || (i < 5 && j > n - 6); if (fin) continue; if (rr() < .5) g.fillRect(qx + i * c, qy + j * c, c, c); }
        [[0, 0], [n - 5, 0], [0, n - 5]].forEach(([i, j]) => { g.fillRect(qx + i * c, qy + j * c, 5 * c, 5 * c); g.fillStyle = '#fff'; g.fillRect(qx + (i + 1) * c, qy + (j + 1) * c, 3 * c, 3 * c); g.fillStyle = '#0a0f18'; g.fillRect(qx + (i + 2) * c, qy + (j + 2) * c, c, c); });
      });
      box(2.6, 0.06, 0.95, std(0x2b2f36), 1.75, 2.95, -0.2, shell);
      box(0.12, 0.35, 0.1, std(0x15191f), 1.75, 3.16, -0.45, shell);
      box(1.7, 1.08, 0.06, std(0x0b0f14), 1.75, 3.86, -0.5, shell);
      const scr = new T.Mesh(new T.PlaneGeometry(1.6, 1.0), basic(0xffffff, { map: siteTex })); scr.position.set(1.75, 3.86, -0.465); shell.add(scr);
      box(0.5, 0.5, 0.03, basic(0xffffff), 2.85, 3.55, -1.4, shell, false);
    }
    // --- room 2: the till ---
    let tillScreen;
    {
