---
// Livraison: a restaurant can deliver without the delivery apps. One ecosystem, four steps (order site, till,
// driver request, handover with a 4-digit code), usable all together or one module at a time.
// No prices or percentages are written here: restaurants will pay a small fee later, so the page only says
// "simple, transparent rates, shared before you start". Drivers: their first 50 rides are free (the only number).
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import FinalCta from '../FinalCta.astro';
import WaButton from '../WaButton.astro';
import { APPS, isPlaceholder, waLink } from '../../config';
import { tr } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais livrer mes commandes moi-même, sans app de livraison. Pouvez-vous m’expliquer ?');
const waRider = tt('Bonjour, je voudrais devenir livreur Amplify.');
const riderUrl = isPlaceholder(APPS.rider) ? waLink(waRider) : APPS.rider;
const title = tt('Livraison sans apps de livraison pour restaurants | Amplify Growth Studio');
const description = tt('Commandes en ligne, caisse, livreur et suivi : un restaurant livre lui-même, sans passer par les apps de livraison. Tout ensemble ou module par module.');

// three things that stay with the restaurant
const pillars = [
  ['qr', 'Votre site et votre page de commande', 'Vos clients commandent chez vous, sous votre nom, sans place de marché au milieu.'],
  ['wallet', 'Zéro commission', 'Aucune commission prélevée sur vos commandes. Des tarifs simples et transparents, communiqués avant de commencer.'],
  ['truck', 'Votre transport', 'Vos propres livreurs, ou ceux d’Amplify. Vous décidez à chaque commande.'],
] as const;
// the journey of one order, in detail
const chapters = [
  ['qr', 'Votre site et votre page de commande', 'Le client commande directement chez vous, sans passer par une place de marché.', [
    'Votre propre site : votre marque, vos photos, votre menu.',
    'Une page de commande à partager par lien ou par QR code : Instagram, Google, WhatsApp, vos tables.',
    'Pas encore de site ? Nous pouvons le créer avec vous.',
    'Aucune commission sur vos commandes.',
  ]],
  ['till', 'La caisse', 'Chaque commande arrive tout de suite dans votre système.', [
    'Rien à retaper : la commande, l’adresse et le numéro du client sont déjà là.',
    'Les commandes en livraison apparaissent en direct dans l’écran des commandes.',
    'Un message WhatsApp au client en un clic, avec son code de livraison.',
    'Vos ventes et vos chiffres restent au même endroit.',
  ]],
  ['truck', 'Le transport : le vôtre ou celui d’Amplify', 'Vous choisissez, commande par commande.', [
    'Votre propre livreur : vous l’assignez depuis la caisse, comme avant.',
    'Amplify Livreur : en un clic, un livreur est demandé et vous voyez son numéro de téléphone.',
    'Vous pouvez mélanger : vos livreurs d’un côté, Amplify quand il vous en manque un.',
    'Vous suivez la course : en route vers le client, puis remise faite.',
  ]],
  ['shield', 'Le suivi et la remise', 'Le client sait où en est sa commande, et la remise est prouvée.', [
    'Le client suit sa commande sur une page de suivi.',
    'Un code à 4 chiffres s’affiche chez lui : il le donne au livreur à la remise.',
    'Le code prouve que la commande est remise à la bonne personne.',
    'Paiement en espèces ou en ligne : les deux fonctionnent.',
  ]],
] as const;
// apps vs Amplify
const compare = [
  ['Commission sur vos ventes', 'Une commission sur chaque commande', 'Aucune commission sur vos commandes'],
  ['Vos clients', 'Les clients restent à l’app', 'Leur numéro arrive dans votre caisse'],
  ['Votre marque', 'Votre restaurant est un nom dans une liste', 'Votre site, votre page, votre nom'],
  ['Le transport', 'Le livreur de l’app, à ses conditions', 'Votre livreur, ou un livreur Amplify'],
  ['Les commandes', 'Un autre écran, à retaper ou à synchroniser', 'Directement dans votre caisse'],
] as const;
const scenarios = [
  ['J’ai déjà mes livreurs', 'Utilisez le site de commande et la caisse. Vous livrez avec votre équipe, comme avant.'],
  ['Je n’ai pas de livreur', 'Prenez tout le parcours : les commandes arrivent en caisse et vous demandez un livreur Amplify en un clic.'],
  ['Je veux d’abord essayer', 'Commencez par un seul module, ajoutez le reste quand vous êtes prêt.'],
] as const;
const modules = ['Site et commandes en ligne', 'Caisse', 'Amplify Livreur', 'Suivi et code de remise'];
const faq = [
  ['Dois-je quitter les apps de livraison ?', 'Non. Vous pouvez les garder. Amplify vous donne simplement la possibilité de livrer vous-même les clients qui commandent chez vous.'],
  ['Y a-t-il une commission sur mes commandes ?', 'Non. Amplify ne prélève aucune commission sur vos commandes. Les tarifs sont simples et transparents, communiqués avant de commencer.'],
  ['Faut-il déjà avoir un site ?', 'Non. Si vous n’en avez pas, nous pouvons le créer avec vous. Vous pouvez aussi commencer avec une simple page de commande à partager par lien ou QR code.'],
  ['Je dois tout prendre en même temps ?', 'Non. Vous pouvez commencer par un seul module et ajouter les autres plus tard. Tout ensemble, c’est simplement plus simple.'],
  ['Puis-je garder mes propres livreurs ?', 'Oui. Pour chaque commande, vous choisissez : votre livreur ou un livreur Amplify.'],
  ['Comment le client paie-t-il ?', 'En espèces à la remise ou en ligne. Les deux fonctionnent.'],
  ['Combien ça coûte ?', 'Des tarifs simples et transparents, communiqués avant de commencer. Écrivez-nous sur WhatsApp : nous vous les donnons pour votre restaurant.'],
];
const toc = [
  { id: 'parcours', label: tt('Le parcours') },
  { id: 'comparaison', label: tt('Apps ou Amplify') },
  { id: 'ensemble', label: tt('Ensemble ou séparé') },
  { id: 'livreurs', label: tt('Livreurs') },
  { id: 'faq', label: tt('Questions fréquentes') },
];
const schema = [serviceSchema(tt('Livraison sans apps de livraison'), description, abs(ROUTES.livraison[lang])), faqSchema(faq.map(([q, a]) => [tt(q), tt(a)]))].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="livraison" title={title} description={description} wa={wa} schema={schema} toc={toc}>
  <!-- HERO: the promise, and one order card that travels from "received" to "delivered" -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt('Amplify Livraison')}</p>
      <h1 class="mt-5 text-[clamp(2.4rem,5.6vw,4.8rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{tt('Votre livraison,')}</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:200ms">{tt('sans passer par les apps de livraison.')}</span></span>
      </h1>
      <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">{tt('Vos clients commandent chez vous. La commande arrive dans votre caisse. Un livreur est demandé en un clic. Tout est entre vos mains, de la commande à la remise.')}</p>
      <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
        <WaButton text={wa} label={tt('Parler de ma livraison')} where="livraison-hero" class="px-7 text-lg" />
        <a href="#parcours" class="inline-flex min-h-12 items-center gap-2 rounded-full px-6 font-semibold ring-1 ring-line hover:bg-paper">{tt('Voir le parcours')}<span aria-hidden="true">↓</span></a>
      </div>
      <ul class="fade-up mt-6 flex flex-wrap gap-2" style="--d:480ms">
        {['Zéro commission', 'Votre site', 'Votre transport'].map(x => <li class="inline-flex min-h-10 items-center gap-2 rounded-full bg-green/15 px-4 font-semibold text-navy ring-1 ring-green/30"><Icon name="check" class="size-4 text-green-deep" />{tt(x)}</li>)}
      </ul>
    </div>
    <div class="fade-up relative mx-auto w-full max-w-sm" style="--d:350ms" aria-hidden="true">
      <div class="rounded-[2rem] bg-navy p-5 text-white shadow-[0_40px_80px_-40px_rgba(0,30,62,0.6)]">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-white/60">{tt('Commande en livraison')}</span>
          <span class="rounded-full bg-green px-3 py-1 text-xs font-bold text-navy">{tt('En route')}</span>
        </div>
        <ol class="mt-5 space-y-3">
          {['Commande reçue', 'Livreur demandé', 'En route vers le client'].map((x, i) => (
            <li class="flex items-center gap-3"><span class="grid size-7 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span><span class="font-semibold">{tt(x)}</span></li>
          ))}
          <li class="flex items-center gap-3 text-white/55"><span class="size-7 rounded-full ring-2 ring-white/25"></span><span class="font-semibold">{tt('Remis au client')}</span></li>
        </ol>
        <div class="mt-6 rounded-2xl bg-white/[0.07] p-4 text-center">
          <p class="text-xs font-semibold text-white/60">{tt('Code de livraison')}</p>
          <p class="display mt-1 text-5xl tracking-[0.3em] text-green" dir="ltr">• • • •</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE THINGS THAT STAY WITH THE RESTAURANT -->
  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Trois choses')}</span><span class="block text-green-deep">{tt('qui restent à vous.')}</span></h2>
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {pillars.map(([i, h, x], k) => (
        <div class={`tf rounded-[2rem] p-7 ${k === 1 ? 'bg-green text-navy' : k === 2 ? 'bg-navy text-white' : 'bg-paper ring-1 ring-line'}`} style={`--d:${k * 120}ms`}>
          <span class={`grid size-14 place-items-center rounded-2xl ${k === 1 ? 'bg-navy text-green' : 'bg-green text-navy'}`}><Icon name={i as 'till'} class="size-7" /></span>
          <h3 class="display mt-5 text-2xl sm:text-3xl">{tt(h)}</h3>
          <p class={`mt-3 text-lg ${k === 1 ? 'text-navy/80' : k === 2 ? 'text-white/75' : 'text-muted'}`}>{tt(x)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- THE JOURNEY: one order, four chapters -->
  <section id="parcours" class="relative isolate scroll-mt-20 overflow-hidden bg-navy py-14 text-white md:py-24" data-tf>
    <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_60%_at_50%_100%,rgba(5,185,98,.22),transparent_70%)]" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Une commande,')}</span><span class="block text-green">{tt('quatre étapes, chez vous.')}</span></h2>
      <p class="tf mt-4 max-w-2xl text-lg text-white/75" style="--d:100ms">{tt('Pas d’app au milieu. La commande suit une seule ligne, de votre client jusqu’à sa porte.')}</p>
      <ol class="mt-12 space-y-5">
        {chapters.map(([i, h, intro, pts], k) => (
          <li class="tf grid gap-6 rounded-[2rem] bg-white/[0.05] p-6 ring-1 ring-white/10 md:grid-cols-[0.9fr_1.1fr] md:p-9" style="--d:80ms">
            <div>
              <div class="flex items-center gap-4">
                <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-green text-navy"><Icon name={i as 'till'} class="size-7" /></span>
                <p class="text-sm font-semibold text-green">{tt('Étape')} {k + 1}</p>
              </div>
              <h3 class="display mt-4 text-2xl sm:text-3xl">{tt(h)}</h3>
              <p class="mt-3 text-lg text-white/75">{tt(intro)}</p>
            </div>
            <ul class="space-y-3 self-center">
              {pts.map(x => (
                <li class="flex gap-3"><span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span><span class="text-white/90">{tt(x)}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- APPS OR AMPLIFY -->
  <section id="comparaison" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Moins d’apps,')}</span><span class="block text-green-deep">{tt('plus de contrôle.')}</span></h2>
    <p class="tf mt-4 max-w-2xl text-lg text-muted" style="--d:100ms">{tt('Ce qui change quand la commande passe par vous au lieu de passer par une app de livraison.')}</p>
    <div class="mt-10 overflow-hidden rounded-[2rem] ring-1 ring-line">
      <div class="hidden bg-navy px-6 py-4 text-sm font-semibold text-white md:grid md:grid-cols-[1fr_1.2fr_1.2fr] md:gap-6">
        <span></span><span class="text-white/70">{tt('Apps de livraison')}</span><span class="text-green">{tt('Avec Amplify')}</span>
      </div>
      {compare.map(([h, a, b]) => (
        <div class="tf grid gap-2 border-t border-line px-5 py-5 first:border-t-0 md:grid-cols-[1fr_1.2fr_1.2fr] md:gap-6 md:px-6">
          <p class="font-semibold">{tt(h)}</p>
          <p class="text-muted"><span class="font-semibold md:hidden">{tt('Apps de livraison')} : </span>{tt(a)}</p>
          <p class="font-semibold text-green-deep"><span class="md:hidden">{tt('Avec Amplify')} : </span>{tt(b)}</p>
        </div>
      ))}
    </div>
    <p class="tf mt-5 rounded-2xl bg-paper px-5 py-4 text-lg ring-1 ring-line">{tt('Vous pouvez garder les apps en plus : Amplify s’ajoute, il ne vous oblige à rien quitter.')}</p>
  </section>

  <!-- TOGETHER OR MODULE BY MODULE -->
  <section id="ensemble" class="scroll-mt-20 bg-chalk py-14 md:py-24" data-tf>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Tout ensemble,')}</span><span class="block text-green-deep">{tt('ou module par module.')}</span></h2>
      <p class="tf mt-4 max-w-2xl text-lg text-muted" style="--d:100ms">{tt('Les quatre étapes forment un seul ensemble. Mais vous n’êtes pas obligé de tout prendre d’un coup : commencez par ce dont vous avez besoin.')}</p>
      <ul class="tf mt-6 flex flex-wrap gap-2" style="--d:150ms">
        {modules.map(x => <li class="inline-flex min-h-10 items-center gap-2 rounded-full bg-white px-4 font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt(x)}</li>)}
      </ul>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {scenarios.map(([h, x], k) => (
          <div class="tf rounded-[2rem] bg-white p-7 ring-1 ring-line" style={`--d:${k * 100}ms`}>
            <h3 class="display text-2xl">{tt(h)}</h3>
            <p class="mt-3 text-muted">{tt(x)}</p>
          </div>
        ))}
      </div>
      <div class="tf mt-4 rounded-[2rem] bg-green p-7 text-navy">
        <h3 class="display text-3xl">{tt('Tout ensemble')}</h3>
        <p class="mt-3 text-lg">{tt('La commande arrive seule dans la caisse, le livreur est demandé depuis la même commande, et le client suit sa livraison. Rien à retaper, rien à rappeler.')}</p>
      </div>
    </div>
  </section>

  <!-- DRIVERS -->
  <section id="livreurs" class="relative isolate scroll-mt-20 overflow-hidden bg-blue text-white" data-tf>
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between md:py-20">
      <div class="max-w-xl">
        <span class="grid size-14 place-items-center rounded-2xl bg-white text-navy"><Icon name="truck" class="size-7" /></span>
        <h2 class="tf mt-5 text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{tt('Vous voulez livrer ?')}</h2>
        <p class="tf mt-4 text-lg text-white/80" style="--d:100ms">{tt('Inscrivez-vous comme livreur, recevez des courses de restaurants et livrez. Vos 50 premières courses sont offertes.')}</p>
      </div>
      <a href={riderUrl} target="_blank" rel="noopener" data-wa="livraison-livreur" class="inline-flex min-h-14 shrink-0 items-center gap-2 rounded-full bg-green px-8 text-lg font-semibold text-navy hover:bg-[#04A859]">{tt('Devenir livreur')}<span aria-hidden="true" class="rtl:rotate-180">→</span></a>
    </div>
  </section>

  <div id="faq"><Faq lang={lang} items={faq.map(([q, a]) => [tt(q), tt(a)])} wa={wa} /></div>

  <FinalCta lang={lang} page="livraison" h2={tt('Livrez par vous-même.')} p={tt('Dites-nous comment vous travaillez aujourd’hui. Nous vous montrons ce qui peut changer.')} wa={wa} />
</Base>

<script>
  // blocks reveal as they scroll in; if anything fails they are shown anyway, so no content stays hidden
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  const showAll = () => roots.forEach((r) => r.classList.add('in'));
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) showAll();
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0, rootMargin: '0px 0px -8% 0px' });
    roots.forEach((r) => io.observe(r));
    window.setTimeout(showAll, 4000);
  }
</script>
