---
// Livraison: a restaurant can deliver without the delivery apps. One ecosystem, five steps: Bssaha (the marketing: customers find you),
// your order site, the till, the driver, the handover with a 4-digit code. Usable all together or one module at a time.
// Style: "Le Terminal", shared with Bssaha (src/styles/bssaha.css). Bssaha is a part of this page (BssahaDirectory) and keeps its own page.
// No prices or percentages are written here: restaurants will pay a small fee later, so the page only says
// "simple, transparent rates, shared before you start". Drivers: their first 50 rides are free (the only number).
import '../../styles/bssaha.css';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import FinalCta from '../FinalCta.astro';
import BxArrow from '../BxArrow.astro';
import BssahaFx from '../BssahaFx.astro';
import BssahaDirectory from '../BssahaDirectory.astro';
import LivraisonFilm from '../LivraisonFilm.astro';
import { bssahaModel } from '../../lib/bssahaModel';
import { APPS, isPlaceholder, waLink } from '../../config';
import { tr } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const m = bssahaModel(lang);
const { c, restos, first } = m;
const wa = tt('Bonjour, je voudrais livrer mes commandes moi-même, sans app de livraison. Pouvez-vous m’expliquer ?');
const waRider = tt('Bonjour, je voudrais devenir livreur Amplify.');
const riderUrl = isPlaceholder(APPS.rider) ? waLink(waRider) : APPS.rider;
const title = tt('Livraison sans apps de livraison pour restaurants | Amplify Growth Studio');
const description = tt('Commandes en ligne, caisse, livreur et suivi : un restaurant livre lui-même, sans passer par les apps de livraison. Tout ensemble ou module par module.');

// three things that stay with the restaurant
const pillars = [
  ['qr', 'Votre site et votre page de commande', 'Vos clients commandent chez vous, sous votre nom, sans place de marché au milieu.'],
  ['wallet', 'Zéro commission', 'Aucune commission prélevée sur vos commandes. Des tarifs simples et transparents, communiqués avant de commencer.'],
  ['truck', 'Votre transport', 'Vos propres livreurs, ou ceux d’Amplify. Vous décidez à chaque commande.'],
] as const;
// the journey of one order, in detail
const chapters = [
  ['search', 'Bssaha : vos clients vous trouvent', 'La partie marketing de l’écosystème : un annuaire de restaurants où l’on commande sans commission.', [
    'Votre restaurant apparaît dans l’annuaire Bssaha, par ville et par quartier.',
    'Le client voit si vous êtes ouvert et choisit son mode : commande directe, WhatsApp, livraison ou à emporter.',
    'Un clic l’amène sur votre page de commande ou sur votre WhatsApp, pas sur une app.',
    'Aucune commission sur les commandes qui viennent de Bssaha.',
  ]],
  ['qr', 'Votre site et votre page de commande', 'Le client commande directement chez vous, sans passer par une place de marché.', [
    'Votre propre site : votre marque, vos photos, votre menu.',
    'Une page de commande à partager par lien ou par QR code : Instagram, Google, WhatsApp, vos tables.',
    'Pas encore de site ? Nous pouvons le créer avec vous.',
    'Aucune commission sur vos commandes.',
  ]],
  ['till', 'La caisse', 'Chaque commande arrive tout de suite dans votre système.', [
    'Rien à retaper : la commande, l’adresse et le numéro du client sont déjà là.',
    'Les commandes en livraison apparaissent en direct dans l’écran des commandes.',
    'Un message WhatsApp au client en un clic, avec son code de livraison.',
    'Vos ventes et vos chiffres restent au même endroit.',
  ]],
  ['truck', 'Le transport : le vôtre ou celui d’Amplify', 'Vous choisissez, commande par commande.', [
    'Votre propre livreur : vous l’assignez depuis la caisse, comme avant.',
    'Amplify Livreur : en un clic, un livreur est demandé et vous voyez son numéro de téléphone.',
    'Vous pouvez mélanger : vos livreurs d’un côté, Amplify quand il vous en manque un.',
    'Vous suivez la course : en route vers le client, puis remise faite.',
  ]],
  ['shield', 'Le suivi et la remise', 'Le client sait où en est sa commande, et la remise est prouvée.', [
    'Le client suit sa commande sur une page de suivi.',
    'Un code à 4 chiffres s’affiche chez lui : il le donne au livreur à la remise.',
    'Le code prouve que la commande est remise à la bonne personne.',
    'Paiement en espèces ou en ligne : les deux fonctionnent.',
  ]],
] as const;
// apps vs Amplify
const compare = [
  ['Commission sur vos ventes', 'Une commission sur chaque commande', 'Aucune commission sur vos commandes'],
  ['Vos clients', 'Les clients restent à l’app', 'Leur numéro arrive dans votre caisse'],
  ['Votre marque', 'Votre restaurant est un nom dans une liste', 'Votre site, votre page, votre nom'],
  ['Le transport', 'Le livreur de l’app, à ses conditions', 'Votre livreur, ou un livreur Amplify'],
  ['Les commandes', 'Un autre écran, à retaper ou à synchroniser', 'Directement dans votre caisse'],
] as const;
const scenarios = [
  ['J’ai déjà mes livreurs', 'Utilisez le site de commande et la caisse. Vous livrez avec votre équipe, comme avant.'],
  ['Je n’ai pas de livreur', 'Prenez tout le parcours : les commandes arrivent en caisse et vous demandez un livreur Amplify en un clic.'],
  ['Je veux d’abord essayer', 'Commencez par un seul module, ajoutez le reste quand vous êtes prêt.'],
] as const;
const modules = ['Site et commandes en ligne', 'Caisse', 'Amplify Livreur', 'Suivi et code de remise'];
const faq = [
  ['Dois-je quitter les apps de livraison ?', 'Non. Vous pouvez les garder. Amplify vous donne simplement la possibilité de livrer vous-même les clients qui commandent chez vous.'],
  ['Y a-t-il une commission sur mes commandes ?', 'Non. Amplify ne prélève aucune commission sur vos commandes. Les tarifs sont simples et transparents, communiqués avant de commencer.'],
  ['Faut-il déjà avoir un site ?', 'Non. Si vous n’en avez pas, nous pouvons le créer avec vous. Vous pouvez aussi commencer avec une simple page de commande à partager par lien ou QR code.'],
  ['Je dois tout prendre en même temps ?', 'Non. Vous pouvez commencer par un seul module et ajouter les autres plus tard. Tout ensemble, c’est simplement plus simple.'],
  ['Puis-je garder mes propres livreurs ?', 'Oui. Pour chaque commande, vous choisissez : votre livreur ou un livreur Amplify.'],
  ['Comment le client paie-t-il ?', 'En espèces à la remise ou en ligne. Les deux fonctionnent.'],
  ['Combien ça coûte ?', 'Des tarifs simples et transparents, communiqués avant de commencer. Écrivez-nous sur WhatsApp : nous vous les donnons pour votre restaurant.'],
];
const toc = [
  { id: 'parcours', label: tt('Le parcours') },
  { id: 'bssaha', label: 'Bssaha' },
  { id: 'comparaison', label: tt('Apps ou Amplify') },
  { id: 'ensemble', label: tt('Ensemble ou séparé') },
  { id: 'livreurs', label: tt('Livreurs') },
  { id: 'faq', label: tt('Questions fréquentes') },
];
const ticker = [tt('Zéro commission'), tt('Votre site'), c.badge, tt('Votre transport'), tt('Code de livraison'), `0 DH ${c.zeroLabel}`];
const schema = [serviceSchema(tt('Livraison sans apps de livraison'), description, abs(ROUTES.livraison[lang])), faqSchema(faq.map(([q, a]) => [tt(q), tt(a)]))].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="livraison" title={title} description={description} wa={wa} schema={schema} toc={toc}>
  <div class="bx-page" data-city={first.id} data-number="212611053649" data-one={c.countOne} data-many={c.countMany} data-list-city={c.listCity} data-first={first.id}
    data-m-direct={c.modes.direct} data-m-whatsapp={c.modes.whatsapp} data-m-livraison={c.modes.livraison} data-m-emporter={c.modes.emporter} data-sending={c.sending} style={`--city:${first.glow}`}>
  <BssahaFx />

  <!-- ============ HERO: the promise, and one order travelling through the ecosystem ============ -->
  <section class="bx-hero">
    <canvas id="bx-net" aria-hidden="true"></canvas>
    <div class="bx-floor" aria-hidden="true"><i></i></div>
    <div class="bx-grain" aria-hidden="true"></div>
    <div class="bx-scan" aria-hidden="true"></div>
    <div class="mx-auto grid w-full max-w-6xl gap-x-14 gap-y-6 px-4 py-8 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:py-12">
      <div class="lg:col-start-1 lg:row-start-1">
        <p class="bx-badge rv"><span class="bx-dot"></span><span class="font-dot text-sm tracking-widest">{tt('Amplify Livraison')}</span></p>
        <h1 class="bx-h1 lv-h1 mt-5 lg:mt-6"><span class="block" data-scramble>{tt('Votre livraison,')}</span><span class="block bx-hot" data-scramble>{tt('sans passer par les apps de livraison.')}</span><span class="bx-under" aria-hidden="true"></span></h1>
      </div>
      <div class="rv lg:col-start-2 lg:row-span-3 lg:row-start-1" style="--d:200ms"><LivraisonFilm lang={lang} /></div>
      <div class="lg:col-start-1 lg:row-start-2">
        <p class="measure rv text-base bx-mute sm:text-lg md:text-xl" style="--d:200ms">{tt('Vos clients commandent chez vous. La commande arrive dans votre caisse. Un livreur est demandé en un clic. Tout est entre vos mains, de la commande à la remise.')}</p>
        <div class="rv mt-6 flex flex-col gap-3 sm:flex-row md:mt-8" style="--d:320ms">
          <a href={waLink(wa)} target="_blank" rel="noopener" data-wa="livraison-hero" class="bx-btn bx-btn--go" data-mag>{tt('Parler de ma livraison')}<BxArrow /></a>
          <a href="#parcours" class="bx-btn bx-btn--ghost" data-mag>{tt('Voir le parcours')}</a>
        </div>
      </div>
      <div class="bx-stats rv lg:col-start-1 lg:row-start-3" style="--d:440ms">
        <div class="bx-stat"><b class="bx-led" dir="ltr">0 DH</b><span>{c.zeroLabel}</span></div>
        <div class="bx-stat"><b class="bx-led" dir="ltr">{restos.length}</b><span>{c.restos}</span></div>
      </div>
    </div>
  </section>

  <div class="bx-marq" aria-hidden="true">
    <div class="bx-marq-track">
      {[0, 1, 2, 3].map(() => ticker.map((t, i) => <span><b class={`display ${i % 2 ? 'out' : ''}`}>{t}</b></span>))}
    </div>
  </div>

  <!-- ============ THREE THINGS THAT STAY WITH THE RESTAURANT ============ -->
  <section class="bx-sec px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="rv">
        <h2 class="bx-h2"><span class="block">{tt('Trois choses')}</span><span class="block bx-hot-line">{tt('qui restent à vous.')}</span></h2>
        <span class="bx-glow-line" aria-hidden="true"></span>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {pillars.map(([i, h, x], k) => (
          <div class={`bx-glass lv-pillar rv ${k === 1 ? 'lv-pillar--zero' : ''}`} style={`--d:${k * 110}ms`}>
            <span class="ic"><Icon name={i as 'till'} class="size-7" /></span>
            <h3 class="display">{tt(h)}</h3>
            <p class="text-lg bx-mute">{tt(x)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ THE JOURNEY: one order, five steps, Bssaha first ============ -->
  <section id="parcours" class="bx-sec bx-sec--alt scroll-mt-20 px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="rv">
        <h2 class="bx-h2"><span class="block">{tt('Un seul écosystème,')}</span><span class="block bx-hot-line">{tt('de Bssaha jusqu’à la remise.')}</span></h2>
        <span class="bx-glow-line" aria-hidden="true"></span>
        <p class="measure mt-5 text-lg bx-mute">{tt('Cinq étapes, une seule ligne. Aucune place de marché au milieu : la commande va de votre client à sa porte en passant par vous.')}</p>
      </div>
      <ol class="bx-steps mt-12" id="bx-steps">
        {chapters.map(([i, h, intro, pts], k) => (
          <li class="bx-step">
            <span class="num font-dot" aria-hidden="true">{String(k + 1).padStart(2, '0')}</span>
            <div>
              <span class="lv-chapter-ic" aria-hidden="true"><Icon name={i as 'till'} class="size-6" /></span>
              <h3 class="display mt-3">{tt(h)}</h3>
              <p class="mt-2 text-lg bx-mute">{tt(intro)}</p>
              <ul class="lv-pts">{pts.map(x => <li>{tt(x)}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ BSSAHA: the marketing part, live ============ -->
  <section id="bssaha" class="bx-sec scroll-mt-20 px-4 pt-16 sm:px-6 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <div class="rv">
        <p class="bx-eyebrow">{c.badge}</p>
        <h2 class="bx-h2 mt-3">{tt('Bssaha, la vitrine de l’écosystème')}</h2>
        <span class="bx-glow-line" aria-hidden="true"></span>
        <p class="measure mt-5 text-lg bx-mute">{tt('Bssaha est la partie marketing : un annuaire où les clients trouvent les restaurants et commandent directement chez eux, sans commission.')}</p>
      </div>
    </div>
  </section>
  <BssahaDirectory m={m} how={false} />

  <!-- ============ APPS OR AMPLIFY ============ -->
  <section id="comparaison" class="bx-sec scroll-mt-20 px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="rv">
        <h2 class="bx-h2"><span class="block">{tt('Moins d’apps,')}</span><span class="block bx-hot-line">{tt('plus de contrôle.')}</span></h2>
        <span class="bx-glow-line" aria-hidden="true"></span>
        <p class="measure mt-5 text-lg bx-mute">{tt('Ce qui change quand la commande passe par vous au lieu de passer par une app de livraison.')}</p>
      </div>
      <div class="lv-cmp rv mt-10">
        <div class="lv-cmp-head"><span></span><span class="bx-mute">{tt('Apps de livraison')}</span><span class="text-[#3DFFA0]">{tt('Avec Amplify')}</span></div>
        {compare.map(([h, a, b]) => (
          <div class="lv-cmp-row">
            <p class="font-semibold">{tt(h)}</p>
            <p class="no"><span class="font-semibold md:hidden">{tt('Apps de livraison')} : </span>{tt(a)}</p>
            <p class="yes"><span class="md:hidden">{tt('Avec Amplify')} : </span>{tt(b)}</p>
          </div>
        ))}
      </div>
      <p class="rv bx-glass mt-5 px-5 py-4 text-lg">{tt('Vous pouvez garder les apps en plus : Amplify s’ajoute, il ne vous oblige à rien quitter.')}</p>
    </div>
  </section>

  <!-- ============ TOGETHER OR MODULE BY MODULE ============ -->
  <section id="ensemble" class="bx-sec bx-sec--alt scroll-mt-20 px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="rv">
        <h2 class="bx-h2"><span class="block">{tt('Tout ensemble,')}</span><span class="block bx-hot-line">{tt('ou module par module.')}</span></h2>
        <span class="bx-glow-line" aria-hidden="true"></span>
        <p class="measure mt-5 text-lg bx-mute">{tt('Les quatre étapes forment un seul ensemble. Mais vous n’êtes pas obligé de tout prendre d’un coup : commencez par ce dont vous avez besoin.')}</p>
      </div>
      <ul class="rv mt-6 flex flex-wrap gap-2">
        {modules.map(x => <li class="bx-chip direct !px-4 !py-2 !text-sm">{tt(x)}</li>)}
      </ul>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {scenarios.map(([h, x], k) => (
          <div class="bx-glass lv-pillar rv" style={`--d:${k * 100}ms`}>
            <h3 class="display !text-2xl">{tt(h)}</h3>
            <p class="bx-mute">{tt(x)}</p>
          </div>
        ))}
      </div>
      <div class="bx-glass lv-pillar lv-pillar--zero rv mt-5">
        <h3 class="display">{tt('Tout ensemble')}</h3>
        <p class="text-lg">{tt('La commande arrive seule dans la caisse, le livreur est demandé depuis la même commande, et le client suit sa livraison. Rien à retaper, rien à rappeler.')}</p>
      </div>
    </div>
  </section>

  <!-- ============ DRIVERS ============ -->
  <section id="livreurs" class="bx-sec scroll-mt-20 px-4 py-16 sm:px-6 md:py-24">
    <div class="bx-glass rv mx-auto flex max-w-6xl flex-col items-start gap-8 p-7 md:flex-row md:items-center md:justify-between md:p-12">
      <div class="max-w-xl">
        <span class="lv-chapter-ic" aria-hidden="true"><Icon name="truck" class="size-6" /></span>
        <h2 class="bx-h2 mt-4 !text-[clamp(2.2rem,5vw,3.6rem)]">{tt('Vous voulez livrer ?')}</h2>
        <p class="mt-4 text-lg bx-mute">{tt('Inscrivez-vous comme livreur, recevez des courses de restaurants et livrez. Vos 50 premières courses sont offertes.')}</p>
      </div>
      <a href={riderUrl} target="_blank" rel="noopener" data-wa="livraison-livreur" class="bx-btn bx-btn--go shrink-0" data-mag>{tt('Devenir livreur')}<BxArrow /></a>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="bx-sec bx-sec--alt scroll-mt-20 px-4 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="rv">
        <h2 class="bx-h2 !text-[clamp(2.4rem,5.5vw,4rem)]">{tt('Questions fréquentes')}</h2>
        <span class="bx-glow-line" aria-hidden="true"></span>
      </div>
      <div class="lv-faq mt-10">
        {faq.map(([q, a]) => <details><summary>{tt(q)}</summary><p>{tt(a)}</p></details>)}
      </div>
    </div>
  </section>

  <FinalCta lang={lang} page="livraison" h2={tt('Livrez par vous-même.')} p={tt('Dites-nous comment vous travaillez aujourd’hui. Nous vous montrons ce qui peut changer.')} wa={wa} />
  </div>

  <script>
    // safety net: if the reveal observer fails for any reason, nothing stays hidden
    setTimeout(() => document.querySelectorAll('.rv').forEach(e => e.classList.add('in')), 4000);
  </script>
</Base>
