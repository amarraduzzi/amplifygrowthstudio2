---
// Amplify Site: the restaurant website sold on its own (sign-up ?produit=site, or made by us).
// Real screenshots of the demo café Dar Nour in the three styles. French inline; EN and AR come
// from the dictionaries (middleware). Prices: OFFER in config.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import ProductFinal from '../ProductFinal.astro';
import { SITE, OFFER, signupUrl, waLink } from '../../config';
import { copy } from '../../i18n';
import { tr, langOf } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const tt = tr(langOf(Astro.url));
const title = tt('Site web pour restaurant au Maroc | Amplify Site');
const description = tt('Un beau site pour votre restaurant ou votre café, avec votre carte, vos photos et les commandes sur WhatsApp. 14 jours gratuits, puis 100 DH par mois.');
const wa = tt('Bonjour, j’ai une question sur Amplify Site.');
const doneForYou = tt('Bonjour, je veux que vous créiez le site de mon restaurant (offre à 250 DH).');
const signup = signupUrl(lang, 'site');
const styles = [
  { k: 'riad', name: 'Riad', img: '/img/s-riad.webp', url: 'darnour.ma', text: 'Arches, zellige et une carte à l’ancienne. Pour une cuisine marocaine ou un lieu de caractère.' },
  { k: 'nuit', name: 'Nuit', img: '/img/s-nuit.webp', url: 'darnour.ma', text: 'Plein écran, comme au cinéma. Une grande photo ou une vidéo, vos plats en bande défilante.' },
  { k: 'moderne', name: 'Moderne', img: '/img/s-moderne.webp', url: 'darnour.ma', text: 'Clair et net, en grandes cartes photo. Pour un snack, un brunch ou une chaîne.' },
];
const included = [
  ['search', 'Trouvé sur Google', 'Votre carte, vos horaires et votre adresse sont lisibles par Google, avec les informations que Google Maps attend.'],
  ['phone', 'Parfait sur téléphone', 'Appeler, trouver l’itinéraire, voir la carte ou commander : tout se fait au pouce.'],
  ['cup', 'Votre carte à jour', 'Vous changez un prix ou un plat dans votre espace, le site suit tout de suite.'],
  ['users', 'Français, arabe, anglais', 'Les touristes comme les habitués lisent votre carte dans leur langue.'],
  ['check', 'Ouvert ou fermé, en direct', 'Vos horaires du jour et un badge « ouvert maintenant », calculés à l’heure du Maroc.'],
  ['store', 'À votre nom', 'Votre logo, vos photos, et votre propre domaine si vous le souhaitez.'],
] as const;
const faq = ([
  ['Faut-il un nom de domaine ?', 'Non. Votre site est en ligne tout de suite sur une adresse Amplify. Si vous avez déjà un domaine, nous le relions à votre site pour 150 DH, une seule fois.'],
  ['Comment se passent les commandes sur WhatsApp ?', 'Le client choisit ses plats sur votre site, puis WhatsApp s’ouvre avec sa commande déjà écrite : les plats, le total, son prénom et le mode (à emporter, livraison ou sur place). Vous la recevez comme un message normal. Aucune commission.'],
  ['Je peux changer de style ou de photos plus tard ?', 'Oui, à tout moment, depuis votre espace. Le style, les photos, les textes et la carte se changent en quelques clics.'],
  ['Comment payer ?', 'Par virement ou CashPlus. Nous activons votre site dès réception. Pas de carte bancaire demandée pour l’essai.'],
  ['Que comprend l’offre à 250 DH ?', 'Nous créons votre site pour vous : la carte à partir d’une photo, jusqu’à 10 photos, les trois langues et une série de corrections. Ensuite, 100 DH par mois comme pour tout le monde.'],
  ['Et si j’arrête ?', 'Sans engagement. Si l’abonnement n’est pas renouvelé, votre site se met en pause. Vous pouvez le relancer quand vous voulez, tout est gardé.'],
]).map(([q, a]) => [tt(q), tt(a)]);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Amplify Site', serviceType: tt('Site web pour restaurant'), areaServed: 'MA', url: abs(ROUTES.site[lang]), description,
    offers: [{ '@type': 'Offer', name: tt('Abonnement mensuel'), price: String(OFFER.siteMonthly), priceCurrency: 'MAD' }, { '@type': 'Offer', name: tt('Création par Amplify'), price: String(OFFER.siteSetup), priceCurrency: 'MAD' }],
    provider: { '@id': `${SITE.url}/#business` } },
  faqSchema(faq),
].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="site" title={title} description={description} wa={wa} schema={schema}>
  <!-- hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-8 sm:px-6 lg:grid-cols-[1fr_1.15fr] lg:pt-14">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Site</p>
      <h1 class="mt-5 text-[clamp(2.5rem,4.3vw,4.1rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Un vrai site</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:160ms">pour votre restaurant.</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:260ms">En ligne ce soir.</span></span>
      </h1>
      <p class="fade-up mt-4 max-w-xl text-lg text-muted" style="--d:340ms">Votre carte, vos photos, vos horaires, l’itinéraire et les commandes sur WhatsApp. Sur Google, sur le téléphone, en trois langues.</p>
      <!-- the price, impossible to miss -->
      <div class="fade-up relative mt-6 inline-flex flex-wrap items-center gap-x-6 gap-y-3 rounded-[1.8rem] bg-navy py-4 pe-7 ps-6 sm:flex-nowrap text-white shadow-[0_30px_60px_-30px_rgba(0,30,62,0.7)]" style="--d:420ms" data-price>
        <span class="price-stamp absolute -end-4 -top-5 rotate-[8deg] rounded-full bg-green px-3.5 py-1.5 text-sm font-bold text-navy shadow-lg">Offre de lancement</span>
        <div>
          <p class="text-sm font-semibold text-white/60">Nous créons votre site</p>
          <p class="display flex items-baseline gap-2 leading-none"><span class="text-[4.2rem] text-green tabular-nums sm:text-[4.8rem]" data-count={OFFER.siteSetup}>{OFFER.siteSetup}</span><span class="text-3xl">DH</span></p>
        </div>
        <div class="border-white/15 text-white/80 sm:border-s sm:ps-6">
          <p class="text-lg font-semibold text-white">une seule fois</p>
          <p>puis {OFFER.siteMonthly} DH par mois</p>
          <p class="text-sm text-white/55">hébergement compris, sans engagement</p>
        </div>
      </div>
      <div class="fade-up mt-5 flex flex-wrap items-center gap-3" style="--d:500ms">
        <a href={waLink(doneForYou)} target="_blank" rel="noopener" data-wa="site-hero" class="cta-glow inline-flex min-h-12 items-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">Je veux mon site à 250 DH</a>
        <a href={signup} class="inline-flex min-h-12 items-center rounded-full border border-navy/25 px-6 text-lg hover:border-navy">Ou le créer moi-même, gratuitement</a>
      </div>
    </div>

    <!-- the site on a laptop, the phone menu, and orders arriving on WhatsApp, one after the other -->
    <div class="relative pb-10 [perspective:1400px] lg:pb-16" aria-hidden="true" data-hero>
      <div class="hero-tilt relative transition-transform duration-300 ease-out [transform-style:preserve-3d]">
        <div class="as-rv overflow-hidden rounded-[1.2rem] bg-[#0B1422] shadow-[0_40px_80px_-35px_rgba(0,30,62,0.6)] ring-1 ring-black/10" style="--d:120ms">
          <div class="flex items-center gap-2 px-4 py-2.5"><span class="size-2.5 rounded-full bg-[#FF5F57]"></span><span class="size-2.5 rounded-full bg-[#FEBC2E]"></span><span class="size-2.5 rounded-full bg-[#28C840]"></span>
            <span class="ms-3 flex-1 truncate rounded-full bg-white/10 px-4 py-1 text-xs text-white/70" dir="ltr">darnour.ma</span></div>
          <img src="/img/s-riad.webp" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" class="block h-auto w-full" />
        </div>
        <div class="hero-far as-rv as-drop absolute -bottom-2 start-[-4%] w-[30%] max-w-[13rem]" style="--d:380ms"><div class="hero-float"><Device kind="phone" src="/img/s-phone-menu.webp" alt="" w={600} h={1298} screenBg="#EFE3D1" class="-rotate-[4deg]" /></div></div>
        <div class="hero-near absolute -bottom-4 end-[2%] w-[56%] max-w-[19rem]">
          <div dir="ltr" class="wa-card rounded-2xl bg-[#E7FFDB] p-3.5 text-[0.8rem] leading-snug text-[#111B21] shadow-[0_24px_50px_-20px_rgba(0,30,62,0.55)] ring-1 ring-black/5 sm:text-sm" data-wa-card>
            <p class="mb-1.5 flex items-center gap-1.5 text-xs font-bold text-[#128C7E]"><svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2z"/></svg><span>Nouvelle commande</span><span class="wa-ping ms-auto size-2 rounded-full bg-[#25D366]"></span></p>
            <p class="wa-typing inline-flex gap-1 py-1.5">{[0, 1, 2].map(i => <span class="size-1.5 rounded-full bg-[#128C7E]/60" style={`animation:dot 1.2s ${i * .15}s infinite`}></span>)}</p>
            <x-notr><div class="wa-body" data-wa-body><p>Bonjour Dar Nour, je souhaite commander :</p><p class="mt-1">2 × Café noir<br />1 × Chocolat chaud<br />1 × Double expresso</p><p class="mt-1 font-semibold">Total : 56 DH · À emporter</p></div></x-notr>
            <p class="mt-1 text-end text-[0.65rem] text-[#667781]"><span data-wa-time>12:41</span> <span class="wa-ticks">✓✓</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- a band that keeps moving: what 250 DH buys -->
  <div class="mq relative overflow-hidden border-y border-navy bg-navy py-4 text-white" aria-hidden="true">
    <div class="mq-track flex w-max gap-10 whitespace-nowrap">
      {[0, 1].map(() => ['Votre site à 250 DH', 'Prêt en quelques jours', 'Sur Google', 'Français, arabe, anglais', 'Commandes sur WhatsApp', 'Itinéraire en un clic', 'Votre carte toujours à jour'].map((x, i) => <span class="display flex items-center gap-10 text-2xl sm:text-3xl"><span class={i === 0 ? 'text-green' : ''}>{x}</span><span class="text-green">✦</span></span>))}
    </div>
  </div>

  <!-- 2030: why a website now -->
  <section class="relative overflow-hidden bg-[#001E3E] text-white" data-as data-y2030>
    <div class="pointer-events-none absolute -end-40 -top-40 size-[40rem] rounded-full bg-green/15 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <p class="as-rv inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold ring-1 ring-white/15"><span class="size-2 rounded-full bg-green"></span>Maroc 2030</p>
      <h2 class="as-rv mt-5 max-w-4xl text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl" style="--d:80ms"><span class="block">Le monde arrive.</span><span class="block text-green">Il vous cherchera sur Google.</span></h2>
      <p class="as-rv mt-6 max-w-2xl text-lg text-white/75" style="--d:160ms">Un touriste ne connaît pas votre rue. Avant de venir, il cherche sur Google ou demande à une IA. Ce qu’il trouve en ligne décide s’il pousse votre porte ou celle d’à côté.</p>
      <div class="mt-14 grid gap-5 lg:grid-cols-[1.25fr_1fr]">
        <!-- tourists: 2025 to the 2030 goal -->
        <div class="as-rv rounded-[2rem] bg-white/[0.06] p-7 ring-1 ring-white/10 sm:p-9" data-bars>
          <p class="font-semibold text-white/70">Touristes au Maroc, par an</p>
          <div class="mt-8 flex items-end gap-6 sm:gap-10">
            <div class="flex h-full flex-1 flex-col justify-end">
              <p class="display whitespace-nowrap text-3xl sm:text-5xl"><span data-count="19.8" data-dec="1">19,8</span> M</p>
              <div class="mt-3 flex h-36 items-end"><div class="bar w-full rounded-t-2xl bg-white/25" style="--h:76%"></div></div>
              <p class="mt-3 text-sm text-white/60">2025, un record (+14 %)</p>
            </div>
            <div class="flex h-full flex-1 flex-col justify-end">
              <p class="display whitespace-nowrap text-3xl text-green sm:text-5xl"><span data-count="26">26</span> M</p>
              <div class="mt-3 flex h-36 items-end"><div class="bar w-full rounded-t-2xl bg-green" style="--h:100%; --bd:300ms"></div></div>
              <p class="mt-3 text-sm text-white/60">2030, l’objectif du Maroc</p>
            </div>
          </div>
        </div>
        <div class="grid gap-5">
          <div class="as-rv flex flex-col items-start gap-3 rounded-[2rem] bg-green p-7 text-navy sm:flex-row sm:items-center sm:gap-5" style="--d:120ms">
            <span class="display text-6xl leading-none">2030</span>
            <p class="text-lg font-semibold leading-snug">La Coupe du monde, coorganisée par le Maroc, l’Espagne et le Portugal.</p>
          </div>
          <div class="as-rv rounded-[2rem] bg-white/[0.06] p-7 ring-1 ring-white/10" style="--d:200ms">
            <p class="display text-5xl text-green">3 langues</p>
            <p class="mt-2 text-white/75">Votre carte en français, en arabe et en anglais. Le visiteur la lit dans sa langue, avant même d’arriver.</p>
          </div>
        </div>
      </div>
      <p class="mt-6 text-xs text-white/40">Sources : chiffres du ministère du Tourisme repris par la presse marocaine, janvier 2026 ; objectif national de 26 millions de touristes en 2030.</p>
    </div>
  </section>

  <!-- searched on Google, asked to an AI: what each one finds -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-as data-search>
    <h2 class="as-rv max-w-4xl text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Sans site, Google et l’IA</span><span class="block text-green-deep">n’ont rien à dire sur vous.</span></h2>
    <p class="as-rv mt-5 max-w-2xl text-lg text-muted" style="--d:100ms">Google et les assistants IA répondent avec ce qu’ils trouvent en ligne. Votre site leur donne votre carte, vos prix, vos horaires et votre adresse, dans un format qu’ils lisent.</p>
    <div class="mt-12 grid gap-5 lg:grid-cols-2" aria-hidden="true">
      <!-- a search -->
      <div class="as-rv overflow-hidden rounded-[2rem] bg-paper ring-1 ring-line">
        <div class="border-b border-line p-5">
          <div class="flex items-center gap-3 rounded-full bg-chalk px-4 py-3 ring-1 ring-line">
            <svg viewBox="0 0 24 24" class="size-5 text-muted" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="flex-1 font-medium"><span data-type="tajine près de moi ouvert maintenant">tajine près de moi ouvert maintenant</span><span class="caret">|</span></span>
          </div>
        </div>
        <div class="space-y-3 p-5">
          <div class="sr-res rounded-2xl bg-chalk p-4 ring-2 ring-green" style="--i:0">
            <div class="flex items-start gap-3">
              <img src="/img/n-site-phone.webp" alt="" class="size-14 rounded-xl object-cover object-top" width="56" height="56" loading="lazy" />
              <div class="min-w-0 flex-1">
                <p class="font-semibold">Dar Nour</p>
                <p class="text-sm text-muted"><span class="font-semibold text-green-deep">Ouvert</span> · jusqu’à 23:00 · Agdal, Rabat</p>
                <p class="mt-1 text-sm text-muted">Tajine poulet citron, msemen, jus pressés</p>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-2 text-xs font-semibold">{['Site web', 'Carte', 'Itinéraire', 'Appeler'].map(x => <span class="rounded-full bg-navy px-3 py-1.5 text-white">{x}</span>)}</div>
          </div>
          {[0, 1].map(i => (
            <div class="sr-res rounded-2xl p-4 opacity-60 ring-1 ring-line" style={`--i:${i + 1}`}>
              <p class="font-semibold">{i ? 'Café sans site' : 'Restaurant sans site'}</p>
              <p class="text-sm text-muted">Horaires non communiqués · Pas de carte</p>
            </div>
          ))}
        </div>
      </div>
      <!-- an AI assistant -->
      <div class="as-rv flex flex-col overflow-hidden rounded-[2rem] bg-navy text-white" style="--d:120ms">
        <div class="flex items-center gap-2 border-b border-white/10 p-5 font-semibold"><span class="grid size-8 place-items-center rounded-full bg-green text-navy">✦</span>Assistant IA</div>
        <div class="flex flex-1 flex-col justify-end gap-3 p-5">
          <p class="ai-q ms-auto max-w-[85%] rounded-2xl rounded-se-none bg-white/15 px-4 py-3">Où manger un bon tajine à Rabat ce soir ?</p>
          <p class="ai-typing inline-flex w-fit gap-1 rounded-2xl bg-white/10 px-4 py-3">{[0, 1, 2].map(i => <span class="size-1.5 rounded-full bg-white/70" style={`animation:dot 1.2s ${i * .15}s infinite`}></span>)}</p>
          <div class="ai-a max-w-[92%] rounded-2xl rounded-ss-none bg-white px-4 py-3 text-navy">
            <p>D’après son site, <b>Dar Nour</b> à Agdal est ouvert jusqu’à 23:00. Leur tajine poulet citron est à 95 DH, et l’on peut commander sur WhatsApp.</p>
            <p class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-chalk px-3 py-1 text-xs font-semibold text-green-deep">darnour.ma</p>
          </div>
        </div>
      </div>
    </div>
    <p class="as-rv mt-4 text-sm text-muted">Illustration avec le café de démonstration Dar Nour.</p>
    <!-- what Google itself says -->
    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {[
        ['Des informations complètes', 'Google l’écrit lui-même : les établissements avec des informations complètes et exactes ont plus de chances d’apparaître dans les recherches locales.'],
        ['Des liens vers vous', 'Pour juger si un lieu est connu, Google regarde entre autres combien de sites parlent de lui et combien d’avis il a. Votre site est le premier de ces liens.'],
        ['La langue de Google', 'Votre site décrit votre restaurant, votre carte et vos horaires en données structurées (schema.org), le format que les moteurs de recherche savent lire.'],
      ].map(([h, x], i) => (
        <div class="as-rv rounded-3xl bg-paper p-6 ring-1 ring-line" style={`--d:${i * 90}ms`}>
          <p class="display text-4xl text-green-deep">0{i + 1}</p>
          <p class="mt-2 text-lg font-semibold">{h}</p><p class="mt-1 leading-relaxed text-muted">{x}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm text-muted">Source : Google, « Améliorer votre classement local sur Google ». Un site ne garantit pas une place précise : il donne à Google ce qu’il demande.</p>
  </section>

  <!-- from a photo of the menu to the site: the scan line reads the card, the site fills itself -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-scan>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <h2 class="as-rv text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Une photo de votre carte.</span><span class="block text-green-deep">Le site se remplit tout seul.</span></h2>
        <p class="as-rv mt-5 max-w-lg text-lg text-muted" style="--d:100ms">Prenez votre carte en photo. L’IA lit les plats, les prix et les catégories, puis les met en page dans le style choisi. Vous relisez, vous corrigez si besoin, c’est en ligne.</p>
        <ul class="as-rv mt-8 space-y-3" style="--d:180ms">
          {['Les plats et les prix, sans rien taper', 'Les catégories rangées dans l’ordre', 'Traduit en arabe et en anglais'].map(x => <li class="flex items-center gap-3 text-lg"><span class="grid size-7 place-items-center rounded-full bg-green/15 text-green-deep"><Icon name="check" class="size-4" /></span>{x}</li>)}
        </ul>
      </div>
      <div class="as-rv relative grid grid-cols-[1fr_auto_1fr] items-center gap-3 sm:gap-5" style="--d:120ms" aria-hidden="true">
        <!-- the paper menu, being read -->
        <div class="scan-paper relative -rotate-[3deg] overflow-hidden rounded-md bg-[#FBF6EA] p-4 font-serif text-[#3A2A1E] shadow-[0_30px_60px_-30px_rgba(0,30,62,0.5)] ring-1 ring-black/5 sm:p-6">
          <p class="text-center text-lg italic sm:text-2xl">Dar Nour</p>
          <p class="mt-1 text-center text-[0.6rem] tracking-[0.3em] text-[#3A2A1E]/60 sm:text-xs"><x-notr>CAFÉ · RABAT</x-notr></p>
          {[['Boissons', [['Café noir', '16'], ['Thé à la menthe', '16'], ['Jus d’orange', '22']]], ['Cuisine', [['Msemen au miel', '18'], ['Tajine poulet citron', '95'], ['Pizza Margherita', '36']]]].map(([cat, rows], ci) => (
            <div class="mt-3 sm:mt-4">
              <p class="scan-row text-[0.7rem] font-bold uppercase tracking-wider sm:text-sm" data-r={ci * 4}><x-notr>{cat}</x-notr></p>
              {(rows as string[][]).map(([n, pr], ri) => <p class="scan-row flex items-baseline gap-1 text-[0.68rem] sm:text-[0.95rem]" data-r={ci * 4 + ri + 1}><x-notr>{n}</x-notr><span class="mx-1 flex-1 border-b border-dotted border-[#3A2A1E]/35"></span>{pr}</p>)}
            </div>
          ))}
          <span class="scan-beam pointer-events-none absolute inset-x-0 top-0 h-16"></span>
        </div>
        <span class="scan-arrow grid size-10 place-items-center rounded-full bg-navy text-green sm:size-12"><svg viewBox="0 0 24 24" class="size-5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        <!-- the site, filling in -->
        <div class="rounded-[1.6rem] bg-[#0B1422] p-1.5 shadow-[0_40px_80px_-30px_rgba(0,30,62,0.6)]">
          <div dir="ltr" class="overflow-hidden rounded-[1.2rem] bg-[#EFE3D1] px-3 pb-4 pt-3 text-[#2E1F17] sm:px-4">
            <p class="text-center font-serif text-base sm:text-xl">Dar Nour</p>
            <div class="mx-auto mt-1 h-2 w-16 opacity-70 [background:radial-gradient(circle,#B8862B_1.2px,transparent_1.6px)_0_0/8px_8px]"></div>
            {[0, 4].map(c => (
              <div class="mt-2.5">
