---
// Amplify Site: the restaurant website sold on its own (sign-up ?produit=site, or made by us).
// Real screenshots of the demo café Dar Nour in the three styles. French inline; EN and AR come
// from the dictionaries (middleware). Prices: OFFER in config.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import ProductFinal from '../ProductFinal.astro';
import { SITE, OFFER, signupUrl, waLink } from '../../config';
import { copy } from '../../i18n';
import { tr, langOf } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const tt = tr(langOf(Astro.url));
const title = tt('Site web pour restaurant au Maroc | Amplify Site');
const description = tt('Un beau site pour votre restaurant ou votre café, avec votre carte, vos photos et les commandes sur WhatsApp. 14 jours gratuits, puis 100 DH par mois.');
const wa = tt('Bonjour, j’ai une question sur Amplify Site.');
const doneForYou = tt('Bonjour, je veux que vous créiez le site de mon restaurant (offre à 250 DH).');
const signup = signupUrl(lang, 'site');
const styles = [
  { k: 'riad', name: 'Riad', img: '/img/s-riad.webp', url: 'darnour.ma', text: 'Arches, zellige et une carte à l’ancienne. Pour une cuisine marocaine ou un lieu de caractère.' },
  { k: 'nuit', name: 'Nuit', img: '/img/s-nuit.webp', url: 'darnour.ma', text: 'Plein écran, comme au cinéma. Une grande photo ou une vidéo, vos plats en bande défilante.' },
  { k: 'moderne', name: 'Moderne', img: '/img/s-moderne.webp', url: 'darnour.ma', text: 'Clair et net, en grandes cartes photo. Pour un snack, un brunch ou une chaîne.' },
];
const included = [
  ['search', 'Trouvé sur Google', 'Votre carte, vos horaires et votre adresse sont lisibles par Google, avec les informations que Google Maps attend.'],
  ['phone', 'Parfait sur téléphone', 'Appeler, trouver l’itinéraire, voir la carte ou commander : tout se fait au pouce.'],
  ['cup', 'Votre carte à jour', 'Vous changez un prix ou un plat dans votre espace, le site suit tout de suite.'],
  ['users', 'Français, arabe, anglais', 'Les touristes comme les habitués lisent votre carte dans leur langue.'],
  ['check', 'Ouvert ou fermé, en direct', 'Vos horaires du jour et un badge « ouvert maintenant », calculés à l’heure du Maroc.'],
  ['store', 'À votre nom', 'Votre logo, vos photos, et votre propre domaine si vous le souhaitez.'],
] as const;
const faq = ([
  ['Faut-il un nom de domaine ?', 'Non. Votre site est en ligne tout de suite sur une adresse Amplify. Si vous avez déjà un domaine, nous le relions à votre site pour 150 DH, une seule fois.'],
  ['Comment se passent les commandes sur WhatsApp ?', 'Le client choisit ses plats sur votre site, puis WhatsApp s’ouvre avec sa commande déjà écrite : les plats, le total, son prénom et le mode (à emporter, livraison ou sur place). Vous la recevez comme un message normal. Aucune commission.'],
  ['Je peux changer de style ou de photos plus tard ?', 'Oui, à tout moment, depuis votre espace. Le style, les photos, les textes et la carte se changent en quelques clics.'],
  ['Comment payer ?', 'Par virement ou CashPlus. Nous activons votre site dès réception. Pas de carte bancaire demandée pour l’essai.'],
  ['Que comprend l’offre à 250 DH ?', 'Nous créons votre site pour vous : la carte à partir d’une photo, jusqu’à 10 photos, les trois langues et une série de corrections. Ensuite, 100 DH par mois comme pour tout le monde.'],
  ['Et si j’arrête ?', 'Sans engagement. Si l’abonnement n’est pas renouvelé, votre site se met en pause. Vous pouvez le relancer quand vous voulez, tout est gardé.'],
]).map(([q, a]) => [tt(q), tt(a)]);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Amplify Site', serviceType: tt('Site web pour restaurant'), areaServed: 'MA', url: abs(ROUTES.site[lang]), description,
    offers: [{ '@type': 'Offer', name: tt('Abonnement mensuel'), price: String(OFFER.siteMonthly), priceCurrency: 'MAD' }, { '@type': 'Offer', name: tt('Création par Amplify'), price: String(OFFER.siteSetup), priceCurrency: 'MAD' }],
    provider: { '@id': `${SITE.url}/#business` } },
  faqSchema(faq),
].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="site" title={title} description={description} wa={wa} schema={schema}>
  <!-- hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-8 sm:px-6 lg:grid-cols-[1fr_1.15fr] lg:pt-14">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Site</p>
      <h1 class="mt-5 text-[clamp(2.7rem,5vw,4.8rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Un vrai site</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:160ms">pour votre restaurant.</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:260ms">En ligne ce soir.</span></span>
      </h1>
      <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:340ms">Votre carte en photo, vos horaires, l’itinéraire et un bouton pour commander sur WhatsApp. Envoyez une photo de votre menu, le site se construit tout seul.</p>
      <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:420ms">
        <a href={signup} class="inline-flex min-h-12 items-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">Créer mon site gratuitement</a>
        <a href={waLink(doneForYou)} target="_blank" rel="noopener" data-wa="site-hero" class="inline-flex min-h-12 items-center rounded-full border border-navy/25 px-6 text-lg hover:border-navy">On le fait pour vous</a>
      </div>
      <p class="fade-up mt-3 text-sm text-muted" style="--d:480ms">14 jours gratuits, puis {OFFER.siteMonthly} DH par mois. Sans engagement.</p>
    </div>

    <!-- the site on a laptop, the phone menu, and orders arriving on WhatsApp, one after the other -->
    <div class="relative pb-10 [perspective:1400px] lg:pb-16" aria-hidden="true" data-hero>
      <div class="hero-tilt relative transition-transform duration-300 ease-out [transform-style:preserve-3d]">
        <div class="as-rv overflow-hidden rounded-[1.2rem] bg-[#0B1422] shadow-[0_40px_80px_-35px_rgba(0,30,62,0.6)] ring-1 ring-black/10" style="--d:120ms">
          <div class="flex items-center gap-2 px-4 py-2.5"><span class="size-2.5 rounded-full bg-[#FF5F57]"></span><span class="size-2.5 rounded-full bg-[#FEBC2E]"></span><span class="size-2.5 rounded-full bg-[#28C840]"></span>
            <span class="ms-3 flex-1 truncate rounded-full bg-white/10 px-4 py-1 text-xs text-white/70" dir="ltr">darnour.ma</span></div>
          <img src="/img/s-riad.webp" alt="" width="1600" height="1000" fetchpriority="high" decoding="async" class="block h-auto w-full" />
        </div>
        <div class="hero-far as-rv as-drop absolute -bottom-2 start-[-4%] w-[30%] max-w-[13rem]" style="--d:380ms"><div class="hero-float"><Device kind="phone" src="/img/s-phone-menu.webp" alt="" w={600} h={1298} screenBg="#EFE3D1" class="-rotate-[4deg]" /></div></div>
        <div class="hero-near absolute -bottom-4 end-[2%] w-[56%] max-w-[19rem]">
          <div dir="ltr" class="wa-card rounded-2xl bg-[#E7FFDB] p-3.5 text-[0.8rem] leading-snug text-[#111B21] shadow-[0_24px_50px_-20px_rgba(0,30,62,0.55)] ring-1 ring-black/5 sm:text-sm" data-wa-card>
            <p class="mb-1.5 flex items-center gap-1.5 text-xs font-bold text-[#128C7E]"><svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2z"/></svg><span>Nouvelle commande</span><span class="wa-ping ms-auto size-2 rounded-full bg-[#25D366]"></span></p>
            <p class="wa-typing inline-flex gap-1 py-1.5">{[0, 1, 2].map(i => <span class="size-1.5 rounded-full bg-[#128C7E]/60" style={`animation:dot 1.2s ${i * .15}s infinite`}></span>)}</p>
            <x-notr><div class="wa-body" data-wa-body><p>Bonjour Dar Nour, je souhaite commander :</p><p class="mt-1">2 × Café noir<br />1 × Chocolat chaud<br />1 × Double expresso</p><p class="mt-1 font-semibold">Total : 56 DH · À emporter</p></div></x-notr>
            <p class="mt-1 text-end text-[0.65rem] text-[#667781]"><span data-wa-time>12:41</span> <span class="wa-ticks">✓✓</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- from a photo of the menu to the site: the scan line reads the card, the site fills itself -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-scan>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <h2 class="as-rv text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Une photo de votre carte.</span><span class="block text-green-deep">Le site se remplit tout seul.</span></h2>
        <p class="as-rv mt-5 max-w-lg text-lg text-muted" style="--d:100ms">Prenez votre carte en photo. L’IA lit les plats, les prix et les catégories, puis les met en page dans le style choisi. Vous relisez, vous corrigez si besoin, c’est en ligne.</p>
        <ul class="as-rv mt-8 space-y-3" style="--d:180ms">
          {['Les plats et les prix, sans rien taper', 'Les catégories rangées dans l’ordre', 'Traduit en arabe et en anglais'].map(x => <li class="flex items-center gap-3 text-lg"><span class="grid size-7 place-items-center rounded-full bg-green/15 text-green-deep"><Icon name="check" class="size-4" /></span>{x}</li>)}
        </ul>
      </div>
      <div class="as-rv relative grid grid-cols-[1fr_auto_1fr] items-center gap-3 sm:gap-5" style="--d:120ms" aria-hidden="true">
        <!-- the paper menu, being read -->
        <div class="scan-paper relative -rotate-[3deg] overflow-hidden rounded-md bg-[#FBF6EA] p-4 font-serif text-[#3A2A1E] shadow-[0_30px_60px_-30px_rgba(0,30,62,0.5)] ring-1 ring-black/5 sm:p-6">
          <p class="text-center text-lg italic sm:text-2xl">Dar Nour</p>
          <p class="mt-1 text-center text-[0.6rem] tracking-[0.3em] text-[#3A2A1E]/60 sm:text-xs"><x-notr>CAFÉ · RABAT</x-notr></p>
          {[['Boissons', [['Café noir', '16'], ['Thé à la menthe', '16'], ['Jus d’orange', '22']]], ['Cuisine', [['Msemen au miel', '18'], ['Tajine poulet citron', '95'], ['Pizza Margherita', '36']]]].map(([cat, rows], ci) => (
            <div class="mt-3 sm:mt-4">
              <p class="scan-row text-[0.7rem] font-bold uppercase tracking-wider sm:text-sm" data-r={ci * 4}><x-notr>{cat}</x-notr></p>
              {(rows as string[][]).map(([n, pr], ri) => <p class="scan-row flex items-baseline gap-1 text-[0.68rem] sm:text-[0.95rem]" data-r={ci * 4 + ri + 1}><x-notr>{n}</x-notr><span class="mx-1 flex-1 border-b border-dotted border-[#3A2A1E]/35"></span>{pr}</p>)}
            </div>
          ))}
          <span class="scan-beam pointer-events-none absolute inset-x-0 top-0 h-16"></span>
        </div>
        <span class="scan-arrow grid size-10 place-items-center rounded-full bg-navy text-green sm:size-12"><svg viewBox="0 0 24 24" class="size-5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        <!-- the site, filling in -->
        <div class="rounded-[1.6rem] bg-[#0B1422] p-1.5 shadow-[0_40px_80px_-30px_rgba(0,30,62,0.6)]">
          <div dir="ltr" class="overflow-hidden rounded-[1.2rem] bg-[#EFE3D1] px-3 pb-4 pt-3 text-[#2E1F17] sm:px-4">
            <p class="text-center font-serif text-base sm:text-xl">Dar Nour</p>
            <div class="mx-auto mt-1 h-2 w-16 opacity-70 [background:radial-gradient(circle,#B8862B_1.2px,transparent_1.6px)_0_0/8px_8px]"></div>
            {[0, 4].map(c => (
              <div class="mt-2.5">
                <p class="site-row text-center font-serif text-[0.8rem] font-semibold sm:text-base" data-r={c}><x-notr>{c === 0 ? 'Boissons' : 'Cuisine'}</x-notr></p>
                {[1, 2, 3].map(k => {
                  const rows = [['Café noir', '16'], ['Thé à la menthe', '16'], ['Jus d’orange', '22'], ['Msemen au miel', '18'], ['Tajine poulet citron', '95'], ['Pizza Margherita', '36']];
                  const [n, pr] = rows[(c ? 3 : 0) + k - 1];
                  return <p class="site-row mt-1 flex items-baseline gap-1 text-[0.62rem] sm:text-[0.82rem]" data-r={c + k}><span class="font-serif font-semibold"><x-notr>{n}</x-notr></span><span class="flex-1 border-b border-dotted border-[#2E1F17]/30"></span><b>{pr} DH</b></p>;
                })}
              </div>
            ))}
            <p class="site-row mt-3 rounded-full bg-[#1FA855] py-1.5 text-center text-[0.65rem] font-bold text-white sm:text-xs" data-r="8">Commander sur WhatsApp</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- three styles: pinned while you scroll, each style wipes over the previous one -->
  <section class="st-root relative bg-navy text-white" data-styles>
    <div class="st-pin relative overflow-hidden">
      <div class="pointer-events-none absolute -start-40 top-20 size-[34rem] rounded-full bg-green/15 blur-3xl" aria-hidden="true"></div>
      <div class="st-inner relative mx-auto grid max-w-6xl content-center 2xl:max-w-7xl gap-6 px-4 py-20 sm:px-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-10">
        <div>
          <h2 class="max-w-3xl text-[2.4rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-[3.4rem]"><span class="block">Trois styles.</span><span class="block text-green">Aucun ne ressemble à un modèle.</span></h2>
          <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Style">
            {styles.map((s, i) => <button type="button" role="tab" data-style={s.k} aria-selected={i === 0 ? 'true' : 'false'} class="st-tab relative min-h-11 overflow-hidden rounded-full px-5 font-semibold ring-1 ring-white/20 transition-colors"><span class="st-fill absolute inset-0 origin-left bg-green/25" aria-hidden="true"></span><span class="relative">{s.name}</span></button>)}
          </div>
          <div class="relative mt-5 min-h-[5.5rem] text-white/75 sm:min-h-[3.5rem] sm:text-lg lg:min-h-[6rem]">
            {styles.map((s, i) => <p data-desc={s.k} class={`st-desc absolute inset-x-0 top-0 max-w-2xl ${i === 0 ? 'on' : ''}`}>{s.text}</p>)}
          </div>
          <p class="mt-2 hidden text-sm text-white/50 lg:block">Captures réelles du café de démonstration Dar Nour.</p>
        </div>
        <div>
          <div class="st-frame mx-auto w-full overflow-hidden rounded-[1.4rem] bg-[#0B1422] shadow-[0_50px_100px_-40px_rgba(0,0,0,0.8)] ring-1 ring-white/10">
            <div class="flex items-center gap-2 px-4 py-3"><span class="size-3 rounded-full bg-[#FF5F57]"></span><span class="size-3 rounded-full bg-[#FEBC2E]"></span><span class="size-3 rounded-full bg-[#28C840]"></span>
              <span class="ms-3 flex-1 truncate rounded-full bg-white/10 px-4 py-1 text-xs text-white/70" dir="ltr">darnour.ma</span></div>
            <div class="relative aspect-[16/10] overflow-hidden">
              {styles.map((s, i) => <img src={s.img} alt={tt('Le site de Dar Nour, style') + ' ' + s.name} width="1600" height="1000" loading={i ? 'lazy' : 'eager'} decoding="async" data-shot={s.k} class={`st-shot absolute inset-0 h-full w-full object-cover object-top ${i === 0 ? 'on' : ''}`} />)}
              <span class="st-edge pointer-events-none absolute inset-y-0 w-[3px] bg-green shadow-[0_0_30px_6px_rgba(5,185,98,.6)]" aria-hidden="true"></span>
            </div>
          </div>
          <p class="mt-4 text-sm text-white/50 lg:hidden">Captures réelles du café de démonstration Dar Nour.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WhatsApp orders, in three steps -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-as>
    <div class="max-w-3xl">
      <h2 class="as-rv text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Pas de caisse ?</span><span class="block text-green-deep">Les commandes arrivent sur WhatsApp.</span></h2>
      <p class="as-rv mt-5 text-lg text-muted" style="--d:100ms">Le client remplit son panier sur votre site. Vous recevez une commande claire, déjà écrite. Pas d’application à installer, 0 % de commission.</p>
    </div>
    <ol class="mt-14 grid gap-10 md:grid-cols-3">
      {[
        ['Le client choisit ses plats', 'Avec les photos, les prix et les formats. Il ajoute au panier d’un seul geste.', '/img/s-phone-menu.webp'],
        ['Il envoie en un clic', 'Prénom, à emporter, livraison ou sur place : WhatsApp s’ouvre avec le message prêt.', '/img/s-phone-wa.webp'],
        ['Vous recevez la commande', 'Les plats, les quantités et le total. Vous répondez comme d’habitude.', ''],
      ].map(([h, x, img], i) => (
        <li class="as-rv" style={`--d:${i * 120}ms`} data-chat={img ? undefined : ''}>
          <div class="mx-auto w-[72%] max-w-[15rem]">
            {img ? <Device kind="phone" src={img} alt="" w={600} h={1298} screenBg="#EFE3D1" /> : (
              <div class="rounded-[2.2rem] bg-[#0B1422] p-2 shadow-[0_40px_80px_-30px_rgba(0,0,0,0.5)]" aria-hidden="true">
                <div dir="ltr" class="flex aspect-[600/1298] flex-col overflow-hidden rounded-[1.8rem] bg-[#EFEAE2]">
                  <div class="flex items-center gap-2 bg-[#008069] px-3 pb-2.5 pt-6 text-white"><span class="grid size-7 place-items-center rounded-full bg-white/25 text-xs font-bold">Y</span><span class="text-sm font-semibold">Yassine</span></div>
                  <div class="flex flex-1 flex-col justify-end gap-2 p-2.5 text-[0.72rem] leading-snug text-[#111B21]">
                    <div class="chat-in max-w-[88%] rounded-lg rounded-ss-none bg-white p-2 shadow-sm" style="--d:200ms"><x-notr>Bonjour Dar Nour, je souhaite commander :<br /><br />2 × Café noir (22,40 DH)<br />1 × Chocolat chaud (16,80 DH)<br />1 × Double expresso (16,80 DH)<br /><br />Total : 56 DH<br />À emporter<br />Nom : Yassine</x-notr><span class="mt-1 block text-end text-[0.6rem] text-[#667781]">12:41</span></div>
                    <p class="chat-in chat-typing ms-auto inline-flex w-fit gap-1 rounded-lg bg-[#D9FDD3] px-2.5 py-2" style="--d:1100ms">{[0, 1, 2].map(i => <span class="size-1.5 rounded-full bg-[#128C7E]/60" style={`animation:dot 1.2s ${i * .15}s infinite`}></span>)}</p>
                    <div class="chat-in chat-reply ms-auto max-w-[70%] rounded-lg rounded-se-none bg-[#D9FDD3] p-2 shadow-sm" style="--d:2300ms"><x-notr>C’est noté, prêt dans 10 minutes.</x-notr><span class="mt-1 block text-end text-[0.6rem] text-[#53BDEB]">12:42 ✓✓</span></div>
                  </div>
                </div>
              </div>
            )}
          </div>
          <p class="mt-6 flex items-baseline gap-3"><span class="display text-4xl text-green-deep tabular-nums">{i + 1}</span><span class="text-xl font-semibold">{h}</span></p>
          <p class="mt-2 text-muted">{x}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- what is included -->
  <section class="border-y border-line bg-paper" data-as>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <h2 class="as-rv max-w-3xl text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Tout ce qu’un client cherche</span><span class="block text-green-deep">avant de venir.</span></h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {included.map(([i, h, x], k) => (
          <div class="as-rv rounded-3xl bg-chalk p-6 ring-1 ring-line" style={`--d:${(k % 3) * 90}ms`}>
            <Icon name={i} class="size-6 text-green-deep" /><p class="mt-3 text-lg font-semibold">{h}</p><p class="mt-1 leading-relaxed text-muted">{x}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- pricing -->
  <section id="tarifs" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6" data-as>
    <h2 class="as-rv max-w-3xl text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Moins cher qu’un flyer.</span><span class="block text-green-deep">Visible toute l’année.</span></h2>
    <p class="as-rv mt-4 max-w-2xl text-lg text-muted" style="--d:80ms">Un seul abonnement. Hébergement, mises à jour et sécurité compris.</p>
    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      <div class="as-rv flex flex-col rounded-[2rem] bg-paper p-8 ring-1 ring-line">
        <p class="text-lg font-semibold">Je le fais moi-même</p>
        <p class="mt-1 text-muted">Une photo de votre carte, une photo de votre salle, un style. Dix minutes suffisent.</p>
        <p class="mt-6 flex items-end gap-2"><span class="display text-6xl tabular-nums">{OFFER.siteMonthly}</span><span class="pb-2 font-semibold">DH / mois</span></p>
        <p class="text-sm text-muted">Création gratuite. 14 jours offerts.</p>
        <ul class="mt-6 flex-1 space-y-2.5">{['Votre carte importée depuis une photo', 'Les trois styles, à changer quand vous voulez', 'Commandes sur WhatsApp', 'Français, arabe, anglais'].map(x => <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-green-deep" />{x}</li>)}</ul>
        <a href={signup} class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-navy px-7 text-lg font-semibold text-white hover:bg-navy/90">Créer mon site gratuitement</a>
      </div>
      <div class="as-rv relative flex flex-col rounded-[2rem] bg-navy p-8 text-white" style="--d:120ms">
        <p class="absolute end-6 top-6 rounded-full bg-green px-3 py-1 text-sm font-bold text-navy">Offre de lancement</p>
        <p class="text-lg font-semibold">On le fait pour vous</p>
        <p class="mt-1 max-w-sm text-white/70">Envoyez-nous votre carte et vos photos sur WhatsApp. Nous vous rendons un site prêt.</p>
        <p class="mt-6 flex items-end gap-2"><span class="display text-6xl tabular-nums">{OFFER.siteSetup}</span><span class="pb-2 font-semibold">DH, une fois</span></p>
        <p class="text-sm text-white/60">Puis {OFFER.siteMonthly} DH par mois.</p>
        <ul class="mt-6 flex-1 space-y-2.5 text-white/85">{['Votre carte saisie par nous, à partir d’une photo', 'Jusqu’à 10 photos mises en valeur', 'Les trois langues relues', 'Une série de corrections comprise'].map(x => <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-green" />{x}</li>)}</ul>
        <a href={waLink(doneForYou)} target="_blank" rel="noopener" data-wa="site-pricing" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">Demander sur WhatsApp</a>
      </div>
    </div>
    <p class="as-rv mt-5 flex flex-wrap items-center gap-2 rounded-2xl bg-paper px-5 py-4 ring-1 ring-line"><Icon name="store" class="size-5 text-green-deep" /><b>Votre propre domaine</b><span class="text-muted">Vous avez déjà un domaine, par exemple www.monrestaurant.ma ? Nous le relions à votre site : {OFFER.siteDomain} DH, une seule fois.</span></p>
  </section>

  <!-- the next step: the till -->
  <section class="px-4 sm:px-6" data-as>
    <div class="as-rv mx-auto grid max-w-6xl items-center gap-6 rounded-[2rem] bg-mint/60 p-8 ring-1 ring-green/20 md:grid-cols-[1fr_auto] md:p-10">
      <div>
        <p class="text-2xl font-semibold">Le jour où vous voulez plus</p>
        <p class="mt-2 max-w-2xl text-muted">Avec Amplify POS, les commandes de votre site arrivent directement en caisse et en cuisine, avec le QR à table, la livraison et les réservations. Votre site reste le même.</p>
      </div>
      <a href={ROUTES.pos[lang]} class="inline-flex min-h-12 items-center justify-center rounded-full border border-navy/25 bg-chalk px-6 text-lg font-semibold hover:border-navy">Découvrir Amplify POS</a>
    </div>
  </section>

  <Faq lang={lang} items={faq} wa={wa} />

  <ProductFinal title={tt('Votre site, en ligne ce soir.')} text={tt('Envoyez une photo de votre carte. Choisissez un style. Partagez le lien.')} cta={tt('Créer mon site gratuitement')} href={signup} wa={wa} waLabel={t.ui.whatsapp} where="site-final"
    steps={['Compte créé', 'Carte importée en photo', 'Style choisi', 'Site en ligne'].map(tt)} done={tt('Votre site est en ligne')} secs={540} />
</Base>

<style is:global>
  .js .as-rv:not(.seen) { opacity: 0; transform: translateY(18px); }
  .as-rv.seen { animation: as-in .7s cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--d, 0ms); }
  .as-drop.seen { animation-name: as-drop; }
  @keyframes as-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes as-drop { from { opacity: 0; transform: translateY(50px) rotate(-3deg); } to { opacity: 1; transform: none; } }
  @keyframes dot { 0%, 60%, 100% { opacity: .3; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }

  /* hero: the phone floats, the card follows the pointer a little more than the laptop */
  .hero-float { animation: float 6s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-10px); } }
  .hero-near, .hero-far { transition: transform .3s ease-out; }
  /* the WhatsApp card: typing, then the order, then read */
  .wa-card { transform-origin: 100% 100%; transition: opacity .45s, transform .45s cubic-bezier(.2,.8,.2,1); }
  .wa-card.out { opacity: 0; transform: translateY(14px) scale(.94); }
  .wa-body p { opacity: 0; transform: translateY(6px); transition: opacity .35s, transform .35s; }
  .wa-card.show .wa-body p { opacity: 1; transform: none; }
  .wa-card.show .wa-body p:nth-child(2) { transition-delay: .25s; }
  .wa-card.show .wa-body p:nth-child(3) { transition-delay: .5s; }
  .wa-typing { display: none; }
  .wa-card.typing .wa-typing { display: inline-flex; }
  .wa-card.typing .wa-body { display: none; }
  .wa-ticks { transition: color .4s; }
  .wa-card.read .wa-ticks { color: #53BDEB; }
  .wa-ping { box-shadow: 0 0 0 0 rgba(37,211,102,.7); }
  .wa-card.typing .wa-ping { animation: ping 1s ease-out infinite; }
  @keyframes ping { to { box-shadow: 0 0 0 10px rgba(37,211,102,0); } }

  /* the scan */
  .scan-beam { opacity: 0; background: linear-gradient(180deg, transparent, rgba(5,185,98,.28) 70%, #05B962 96%, transparent); }
  [data-scan].run .scan-beam { animation: beam 3.2s cubic-bezier(.45,0,.55,1) forwards; }
  @keyframes beam { 0% { opacity: 0; transform: translateY(-4rem); } 8% { opacity: 1; } 92% { opacity: 1; } 100% { opacity: 0; transform: translateY(calc(var(--h, 300px))); } }
  .scan-row { transition: color .3s, background-color .3s; border-radius: 3px; }
  .scan-row.read { background: rgba(5,185,98,.14); }
  .site-row { opacity: 0; transform: translateX(14px); transition: opacity .4s, transform .5s cubic-bezier(.2,.8,.2,1); }
  .site-row.in { opacity: 1; transform: none; }
  .scan-arrow { transition: transform .4s; }
  [data-scan].run .scan-arrow { animation: nudge 1s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateX(5px); } }
  [dir="rtl"] [data-scan].run .scan-arrow { animation-name: nudge-rtl; }
  @keyframes nudge-rtl { 50% { transform: translateX(-5px); } }

  /* the styles: pinned with JS, a wipe from one to the next */
  .st-root.live { height: 320vh; }
  .st-root.live .st-pin { position: sticky; top: 0; height: 100vh; height: 100svh; }
  .st-root.live .st-inner { height: 100%; padding-top: 5rem; padding-bottom: 1.5rem; }
  .st-root.live .st-frame { width: min(100%, calc((100svh - 19rem) * 1.6)); }
  @media (min-width: 1024px) { .st-root.live .st-frame { width: min(100%, calc((100svh - 10rem) * 1.6)); } }
  .st-shot { clip-path: inset(0 0 0 0); }
  .st-root:not(.live) .st-shot { opacity: 0; transition: opacity .6s ease; }
  .st-root:not(.live) .st-shot.on { opacity: 1; }
  .st-edge { display: none; }
  .st-root.live .st-edge { display: block; }
  .st-tab[aria-selected="true"] { background: #05B962; color: #001E3E; }
  .st-tab[aria-selected="true"] .st-fill { opacity: 0; }
  .st-fill { transform: scaleX(var(--f, 0)); }
  [dir="rtl"] .st-fill { transform-origin: right; }
  .st-desc { opacity: 0; transform: translateY(8px); transition: opacity .4s, transform .4s; }
  .st-desc.on { opacity: 1; transform: none; }

  /* the chat in step 3 */
  .chat-in { opacity: 0; transform: translateY(10px) scale(.96); }
  [data-chat].seen .chat-in { animation: as-in .45s cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--d); }
  [data-chat].seen .chat-typing { animation: typing-in-out 1.2s ease both; animation-delay: var(--d); }
  @keyframes typing-in-out { 0% { opacity: 0; } 15%, 85% { opacity: 1; } 100% { opacity: 0; height: 0; padding: 0; margin: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .js .as-rv:not(.seen), .as-rv.seen, .chat-in, .site-row, .wa-body p { opacity: 1; transform: none; animation: none; }
    .hero-float, .wa-ping, .scan-arrow { animation: none; }
    .chat-typing, .scan-beam { display: none; }
  }
</style>
<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('seen'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.as-rv, [data-chat]').forEach(n => io.observe(n));
  const wait = (ms: number) => new Promise(r => setTimeout(r, ms));
  const visible = (el: Element, cb: (on: boolean) => void) => new IntersectionObserver(([e]) => cb(e.isIntersecting), { threshold: 0.25 }).observe(el);

  // hero: orders keep arriving on WhatsApp; the scene leans towards the pointer
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(root => {
    const card = root.querySelector<HTMLElement>('[data-wa-card]')!, body = root.querySelector<HTMLElement>('[data-wa-body]')!, time = root.querySelector<HTMLElement>('[data-wa-time]')!;
    const orders = [
      ['2 × Café noir<br>1 × Chocolat chaud<br>1 × Double expresso', 'Total : 56 DH · À emporter'],
      ['1 × Tajine poulet citron<br>2 × Thé à la menthe', 'Total : 127 DH · Livraison'],
      ['2 × Pizza Margherita<br>2 × Jus d’orange', 'Total : 116 DH · Sur place'],
    ];
    if (still) { card.classList.add('show', 'read'); return; }
    let on = false, n = 0, running = false, min = 41;
    visible(root, v => { on = v; if (v && !running) loop(); });
    async function loop() {
      running = true;
      while (on) {
        const [lines, total] = orders[n++ % orders.length];
        body.children[1].innerHTML = lines; body.children[2].textContent = total; time.textContent = `12:${String(min++ % 60).padStart(2, '0')}`;
        card.classList.remove('out', 'show', 'read'); card.classList.add('typing');
        await wait(1500); card.classList.remove('typing'); card.classList.add('show');
        await wait(1600); card.classList.add('read');
        await wait(3200); card.classList.add('out');
        await wait(600);
      }
      card.classList.remove('out', 'typing'); card.classList.add('show', 'read');
      running = false;
    }
    if (!matchMedia('(pointer: fine)').matches) return;
    const tilt = root.querySelector<HTMLElement>('.hero-tilt')!, near = root.querySelector<HTMLElement>('.hero-near')!, far = root.querySelector<HTMLElement>('.hero-far')!;
    root.addEventListener('pointermove', e => {
      const r = root.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      tilt.style.transform = `rotateY(${x * 7}deg) rotateX(${-y * 5}deg)`;
      near.style.transform = `translate3d(${x * 22}px, ${y * 16}px, 40px)`;
      far.style.transform = `translate3d(${x * -14}px, ${y * -10}px, 20px)`;
    });
    root.addEventListener('pointerleave', () => { tilt.style.transform = ''; near.style.transform = ''; far.style.transform = ''; });
  });

  // the scan: the line reads the paper menu, each line read appears on the site; again while in view
  document.querySelectorAll<HTMLElement>('[data-scan]').forEach(root => {
    const paper = root.querySelector<HTMLElement>('.scan-paper')!;
    const reads = [...root.querySelectorAll<HTMLElement>('.scan-row')], rows = [...root.querySelectorAll<HTMLElement>('.site-row')];
    const show = (all: boolean) => { reads.forEach(r => r.classList.toggle('read', false)); rows.forEach(r => r.classList.toggle('in', all)); };
    if (still) { show(true); return; }
    let on = false, running = false;
    visible(root, v => { on = v; if (v && !running) loop(); });
    async function loop() {
      running = true;
      while (on) {
        show(false); root.classList.remove('run'); void root.offsetWidth;
        paper.style.setProperty('--h', `${paper.offsetHeight + 64}px`);
        root.classList.add('run');
        const top = paper.getBoundingClientRect().top, h = paper.offsetHeight;
        // each line lights up when the beam passes it, then shows on the site
        await Promise.all(reads.map(r => {
          const at = ((r.getBoundingClientRect().top - top) / h) * 3000;
          return wait(at + 250).then(() => { r.classList.add('read'); root.querySelectorAll<HTMLElement>(`.site-row[data-r="${r.dataset.r}"]`).forEach(x => x.classList.add('in')); });
        }));
        await wait(500); rows.forEach(x => x.classList.add('in'));
        await wait(3500);
      }
      running = false;
    }
  });

  // the styles: pinned while scrolling, the next style wipes over the previous one
  document.querySelectorAll<HTMLElement>('[data-styles]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-style]')];
    const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
    const descs = [...root.querySelectorAll<HTMLElement>('[data-desc]')];
    const edge = root.querySelector<HTMLElement>('.st-edge')!;
    const rtl = document.documentElement.dir === 'rtl';
    const N = tabs.length;
    let cur = 0;
    const select = (i: number) => {
      if (i === cur) return; cur = i;
      tabs.forEach((b, k) => b.setAttribute('aria-selected', String(k === i)));
      descs.forEach((d, k) => d.classList.toggle('on', k === i));
      shots.forEach((d, k) => d.classList.toggle('on', k === i));
    };
    if (still) { tabs.forEach((b, k) => b.addEventListener('click', () => { cur = -1; select(k); })); return; }
    root.classList.add('live');
    const update = () => {
      const r = root.getBoundingClientRect(), run = r.height - innerHeight;
      const t = Math.min(1, Math.max(0, -r.top / (run > 0 ? run : 1))) * (N - 0.4) + 0.2;
      let edgeAt = -1;
      shots.forEach((img, k) => {
        if (!k) return;
        const v = Math.min(1, Math.max(0, (t - (k - 0.3)) / 0.6));
        const hide = `${((1 - v) * 100).toFixed(2)}%`;
        img.style.clipPath = rtl ? `inset(0 0 0 ${hide})` : `inset(0 ${hide} 0 0)`;
        if (v > 0 && v < 1) edgeAt = v;
      });
      edge.style.opacity = edgeAt < 0 ? '0' : '1';
      if (edgeAt >= 0) edge.style[rtl ? 'right' : 'left'] = `calc(${(edgeAt * 100).toFixed(2)}% - 1px)`;
      tabs.forEach((b, k) => b.style.setProperty('--f', String(Math.min(1, Math.max(0, t - k + 1)))));
      select(Math.min(N - 1, Math.max(0, Math.round(t - 0.5))));
    };
    tabs.forEach((b, k) => b.addEventListener('click', () => {
      const run = root.offsetHeight - innerHeight;
      scrollTo({ top: root.getBoundingClientRect().top + scrollY + run * Math.min(1, Math.max(0, (k + 0.3) / (N - 0.4))), behavior: 'smooth' });
    }));
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, { passive: true });
    addEventListener('resize', update);
    update();
  });
</script>
