---
// Garage page (workshops, mechanics): linked from the products menu and the footer.
// Same look as the pressing and salons pages. No screenshots yet: the hero shows a small mock-up with an
// invented car and invented prices. No clients, results or prices are claimed: the price is given on request.
import Base from '../../layouts/Base.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import CountUp from '../CountUp.astro';
import { tr } from '../../i18n/t';
import { ROUTES, type Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais voir Amplify pour mon garage.');
const today = [
  'Un carnet, et une voiture dont plus personne ne sait ce qui a été promis.',
  'Un devis donné de vive voix, contesté à la remise des clés.',
  'Le téléphone qui sonne : « Elle est prête ? »',
  'Une vidange que le client oublie, et qui ne revient jamais.',
  'Des véhicules qui attendent au fond de la cour.',
];
const withUs = [
  'Un ordre de réparation par voiture : plaque, kilométrage, client.',
  'Le devis chiffré, envoyé sur WhatsApp, accepté depuis le téléphone du client.',
  'Les remises et les annulations réservées au manager.',
  'Les rappels vidange et visite technique, par date ou par kilométrage.',
  'Tout ce qui est à l’atelier, et ce qu’il reste à encaisser, d’un coup d’œil.',
];
const steps = [
  ['door', 'Réception', 'La plaque, le kilométrage, ce que le client signale.'],
  ['message', 'Devis', 'Main d’œuvre et pièces chiffrées, envoyées sur WhatsApp.'],
  ['check', 'Accord', 'Le client accepte depuis son téléphone, dans le délai du devis.'],
  ['wallet', 'Remise', 'Réparation terminée, le client paie, l’OR est fermé.'],
] as const;
const reception = [
  ['door', 'La voiture, une fois', 'Plaque, marque, modèle, année et kilométrage : la fiche est gardée pour les prochaines visites.'],
  ['search', 'Retrouvée en une seconde', 'Par plaque, nom, téléphone ou numéro d’OR, même une voiture passée l’an dernier.'],
  ['tag', 'Votre liste de prestations', 'Vidange, filtres, plaquettes, batterie, courroie, climatisation : une liste type à adapter à vos prix.'],
  ['coins', 'Main d’œuvre et pièces', 'Un prix habituel pour chaque ligne, modifiable sur chaque OR.'],
  ['clock', 'Tarif horaire', 'Proposé à chaque OR si vous en avez un, à fixer à la main sinon.'],
  ['printer', 'Bon et ticket', 'Une ligne de votre choix en bas, par exemple vos conditions de garde des véhicules.'],
] as const;
const counter = [
  ['clock', 'Devis en attente', 'Ceux que le client n’a pas encore acceptés, avant qu’ils ne soient oubliés.'],
  ['wallet', 'Encaissé aujourd’hui', 'Ce qui est entré dans la caisse de l’atelier depuis ce matin.'],
  ['shield', 'Remises et annulations', 'Réservées au manager, avec le motif noté sur l’OR.'],
  ['box', 'L’historique', 'Tout ce qui a été remis, à portée de recherche, sans carnet à fouiller.'],
] as const;
const reminders = [
  ['calendar', 'Par date', 'Visite technique, assurance : le client est à prévenir à une date précise.'],
  ['pin', 'Par kilométrage', 'Vidange, pneus : le prochain passage calculé à partir du kilométrage de la voiture.'],
  ['message', 'Un WhatsApp prêt', 'Le message est déjà écrit : vous l’envoyez en un geste.'],
  ['bell', 'La liste à appeler', 'Les clients à prévenir sur la période, au lieu de les chercher dans un carnet.'],
] as const;
const evening = [
  ['wallet', 'La caisse de l’atelier', 'Les OR payés, remis et annulés de la journée, au même endroit.'],
  ['users', 'Votre équipe', 'Un code par personne de l’atelier, un manager pour les remises.'],
  ['phone', 'Sur votre téléphone', 'Depuis l’espace gérant : ce qui est à l’atelier, et ce qu’il reste à encaisser.'],
  ['shield', 'Vos réglages', 'Durée du devis, intervalle de vidange, tarif horaire : vous les fixez une fois.'],
] as const;
const faq = [
  ['Mes clients doivent-ils installer une application ?', 'Non. Ils reçoivent le devis sur WhatsApp et l’acceptent depuis le lien. Rien à installer, rien à créer.'],
  ['Il me faut quel matériel ?', 'Une tablette ou un ordinateur au comptoir, et une imprimante de tickets si vous voulez un bon papier. Nous vous conseillons si vous n’avez rien.'],
  ['Et si le client tarde à répondre ?', 'Le devis a une durée de validité que vous choisissez. Passé ce délai, le client ne peut plus accepter depuis son téléphone : il vous appelle, et vous décidez à la caisse.'],
  ['Puis-je changer un prix sur un OR ?', 'Oui. La liste donne un prix habituel, mais chaque ligne reste modifiable sur l’OR. Les remises et les annulations passent par le manager.'],
  ['Les rappels partent-ils tout seuls ?', 'Non. Vous voyez la liste des clients à prévenir, avec un WhatsApp prêt : c’est vous qui l’envoyez, d’un geste.'],
  ['Je travaille avec des sociétés ou des flottes.', 'Un client professionnel est un client comme un autre : chaque voiture a sa fiche, chaque passage son OR.'],
  ['Qui installe tout ?', 'Nous. Votre liste de prestations, votre équipe et votre caisse, et nous montrons tout à votre équipe. C’est offert.'],
  ['Et si j’arrête ?', 'Sans engagement : vous arrêtez d’un mois à l’autre. Les 14 premiers jours sont gratuits.'],
];
---
<Base lang={lang} page="garage" title={tt('Amplify pour les garages et ateliers | Amplify Growth Studio')} description={tt('La caisse des garages : un ordre de réparation par voiture, le devis accepté sur WhatsApp, les remises réservées au manager, les rappels vidange et visite technique. À Rabat et Salé.')} wa={wa}>
  <!-- hero: the repair order lands, the quote goes out on WhatsApp -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-14">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Garages et ateliers</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Chaque voiture suivie.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Chaque devis accepté.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Un ordre de réparation par voiture, le devis envoyé sur WhatsApp et accepté depuis le téléphone du client. À l’atelier, plus de promesse oubliée, et les clients de la vidange reviennent au bon moment.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="garage-hero" class="px-7 text-lg" />
          <a href="#devis" class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-paper">Voir le devis</a>
        </div>
      </div>

      <div class="relative isolate aspect-[4/3.7] overflow-hidden rounded-[1.75rem] bg-navy lg:aspect-[5/4.7] lg:rounded-[2.25rem]">
        <span class="sl-scene absolute inset-0 -z-20" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
        <span class="shadow-in absolute start-[10%] top-[78%] h-6 w-[60%] rounded-[50%] bg-black/55 blur-xl" style="--d:700ms" aria-hidden="true"></span>
        <!-- the repair order (example: invented car, invented prices) -->
        <div class="land absolute start-[6%] top-[16%] w-[66%] rounded-2xl bg-paper p-4 text-navy shadow-2xl sm:p-5" style="--d:300ms" aria-hidden="true">
          <div class="flex items-center justify-between gap-2"><p class="display text-xl sm:text-2xl">OR n° 214</p><p class="rounded-full bg-green/20 px-2.5 py-0.5 text-[0.65rem] font-semibold text-green-deep sm:text-xs">Devis accepté</p></div>
          <p class="mt-1 text-[0.7rem] text-muted sm:text-sm" dir="ltr">Dacia Logan · 48213-B-6 · 126 400 km</p>
          <ul class="mt-3 space-y-1.5 border-t border-line pt-3 text-[0.72rem] sm:text-sm">
            <li class="flex justify-between gap-3"><span>Vidange + filtre à huile</span><span class="tabular-nums" dir="ltr">430 DH</span></li>
            <li class="flex justify-between gap-3"><span>Plaquettes avant</span><span class="tabular-nums" dir="ltr">520 DH</span></li>
            <li class="flex justify-between gap-3"><span>Main d’œuvre, 1,5 h</span><span class="tabular-nums" dir="ltr">300 DH</span></li>
          </ul>
          <p class="mt-3 flex justify-between border-t border-line pt-3 font-semibold"><span>Total</span><span class="tabular-nums" dir="ltr">1 250 DH</span></p>
        </div>
        <div class="absolute start-[5%] top-[4%] z-10"><div class="tf-float"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:2300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-green text-navy sm:size-7"><Icon name="door" class="size-3.5 sm:size-4" /></span>Voiture reçue</p></div></div>
        <div class="absolute end-[4%] top-[14%] z-10 sm:top-[6%]"><div class="tf-float" style="--d:1200ms"><p class="chat-in flex items-center gap-2 rounded-full bg-green py-1.5 pe-3.5 ps-3 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:3300ms" aria-hidden="true"><span class="sl-live size-2 rounded-full bg-navy"></span>Réparation en cours</p></div></div>
        <div class="absolute bottom-[6%] end-[5%] z-10"><div class="tf-float" style="--d:2400ms"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:4300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-[#25D366] text-white sm:size-7"><Icon name="message" class="size-3.5 sm:size-4" /></span>Devis envoyé sur WhatsApp</p></div></div>
      </div>
    </div>

    <!-- three facts -->
    <div class="border-y border-line bg-paper">
      <ul class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:py-6">
        {[['1', 'ordre de réparation par voiture, avec son devis'], ['14', 'jours gratuits, sans engagement'], ['3', 'langues : français, arabe et anglais']].map(([n, l]) => (
          <li class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><span class="display text-5xl text-navy md:text-6xl" data-count={n} dir="ltr">{n}</span><span class="text-[0.78rem] leading-snug text-muted md:max-w-[13rem] md:text-[0.95rem]">{l}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- today / with Amplify -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="tf rounded-[2rem] bg-paper p-7 ring-1 ring-line">
        <p class="text-sm font-semibold text-muted">Aujourd’hui</p>
        <ul class="mt-4 space-y-3">{today.map((x, i) => <li class="tf-x flex gap-3 text-lg" style={`--d:${200 + i * 90}ms`}><span class="mt-2 size-2 shrink-0 rounded-full bg-muted/50"></span>{x}</li>)}</ul>
      </div>
      <div class="tf rounded-[2rem] bg-navy p-7 text-white" style="--d:120ms">
        <p class="text-sm font-semibold text-green">Avec Amplify</p>
        <ul class="mt-4 space-y-3">{withUs.map((x, i) => <li class="tf-x flex gap-3 text-lg" style={`--d:${320 + i * 90}ms`}><span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>{x}</li>)}</ul>
      </div>
    </div>

    <!-- the life of a repair: four steps that light up one after the other -->
    <ol class="pr-steps mt-14 grid gap-3 sm:grid-cols-4" data-steps>
      {steps.map(([i, h, x], k) => (
        <li class="pr-step tf relative rounded-[1.75rem] bg-paper p-6 ring-1 ring-line" style={`--d:${k * 120}ms; --k:${k}`}>
          <span class="flex items-center justify-between"><span class="pr-ic grid size-12 place-items-center rounded-2xl bg-navy text-green transition-colors duration-500"><Icon name={i} class="size-6" /></span><span class="display text-4xl text-line" dir="ltr">{k + 1}</span></span>
          <p class="mt-5 text-xl font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
          {k < 3 && <span class="pr-link absolute -end-3 top-1/2 z-10 hidden h-0.5 w-6 bg-green sm:block rtl:-scale-x-100" aria-hidden="true"></span>}
        </li>
      ))}
    </ol>
  </section>

  <!-- the reception -->
  <section id="reception" class="relative isolate scroll-mt-20 overflow-hidden bg-navy text-white" data-tf>
    <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
    <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="tf-x">
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">La réception.</span><span class="block text-green">Une fois, bien faite.</span></h2>
          <p class="mt-5 max-w-md text-lg text-white/70">La voiture arrive. Vous saisissez la plaque, le kilométrage, ce que le client signale. La fiche est créée, et l’ordre de réparation s’ouvre avec votre liste de prestations.</p>
        </div>
        <div class="tf aspect-[4/3]" style="--d:150ms"><img src="/img/photos/garage-atelier-1200.webp" alt={tt('Un mécanicien penché sur le moteur d’une voiture, dans un petit atelier de quartier')} width="1200" height="896" loading="lazy" decoding="async" class="size-full rounded-[2rem] object-cover ring-1 ring-line " /></div>
      </div>
      <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {reception.map(([i, h, x], k) => (
          <li class="tf" style={`--d:${k * 80}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-green ring-1 ring-white/15"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-white/65">{x}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- the quote on WhatsApp -->
  <section id="devis" class="scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="tf relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:grid-cols-[1fr_0.8fr] md:p-14">
      <div>
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">« C’était combien déjà ? »</span><span class="block text-green-deep">Le devis est écrit.</span></h2>
        <p class="mt-5 max-w-md text-lg text-muted">Vous chiffrez la main d’œuvre et les pièces sur l’OR, puis vous envoyez le devis sur WhatsApp. Le client l’accepte depuis son téléphone : la promesse est écrite, des deux côtés.</p>
        <ul class="mt-8 space-y-3">
          {['Devis envoyé', 'Devis accepté', 'Réparation en cours', 'Voiture remise'].map((x, k) => (
            <li class="flex items-center gap-3 text-lg"><span class={`grid size-8 shrink-0 place-items-center rounded-full font-bold ${k < 3 ? 'bg-navy text-green' : 'bg-white text-muted ring-1 ring-line'}`} dir="ltr">{k < 2 ? <Icon name="check" class="size-4" /> : k + 1}</span>{x}</li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-muted">Sans application, sans compte. Passé le délai que vous avez choisi, le client vous appelle et vous décidez à la caisse.</p>
      </div>
      <div class="mx-auto w-full max-w-[19rem]" aria-hidden="true"><div class="tf-float rounded-[1.75rem] bg-[#E7F5EC] p-4 shadow-xl ring-1 ring-line">
        <p class="rounded-2xl rounded-es-sm bg-white p-3 text-[0.85rem] leading-snug text-navy shadow-sm">Bonjour Karim, voici le devis pour votre Logan : vidange, plaquettes avant, main d’œuvre.</p>
        <p class="mt-2 rounded-2xl rounded-es-sm bg-white p-3 text-[0.85rem] leading-snug text-navy shadow-sm"><span class="block font-semibold">Total : <span dir="ltr">1 250 DH</span></span><span class="mt-1 block rounded-full bg-green px-3 py-1.5 text-center font-semibold">Accepter le devis</span></p>
        <p class="mt-2 ms-auto w-fit rounded-2xl rounded-ee-sm bg-[#D1F4CC] px-3 py-2 text-[0.85rem] text-navy shadow-sm">Accepté ✓</p>
      </div></div>
    </div>
  </section>

  <!-- the workshop counter -->
  <section id="atelier" class="relative isolate scroll-mt-20 overflow-hidden bg-navy text-white" data-tf>
    <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div class="tf order-last aspect-[4/3] lg:order-first" style="--d:150ms"><img src="/img/photos/garage-comptoir-1200.webp" alt={tt('Deux hommes au comptoir d’un garage : le mécanicien montre un message sur son téléphone au client')} width="1200" height="896" loading="lazy" decoding="async" class="size-full rounded-[2rem] object-cover ring-1 ring-line " /></div>
        <div class="tf-x">
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">À l’atelier.</span><span class="block text-green">Tout est sur l’OR.</span></h2>
          <p class="mt-5 max-w-md text-lg text-white/70">Ce qui est à l’atelier, les devis qui attendent, ce qui a été remis. Remises et annulations se font ici, par le manager, avec le motif.</p>
        </div>
      </div>
      <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {counter.map(([i, h, x], k) => (
          <li class="tf" style={`--d:${k * 90}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-green ring-1 ring-white/15"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-white/65">{x}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- the reminders -->
  <section id="rappels" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Le client revient.</span><span class="block text-green-deep">Au bon moment.</span></h2>
        <p class="tf mt-4 max-w-xl text-lg text-muted" style="--d:100ms">Vidange, visite technique, assurance, pneus : vous indiquez une date ou un kilométrage, et la liste des clients à prévenir se remplit toute seule.</p>
      </div>
      <div class="tf aspect-[4/3]" style="--d:150ms"><img src="/img/photos/garage-rappel-1200.webp" alt={tt('Le compteur d’une voiture à 126 048 km, avec le voyant d’entretien allumé, et un téléphone au premier plan')} width="1200" height="896" loading="lazy" decoding="async" class="size-full rounded-[2rem] object-cover ring-1 ring-line " /></div>
    </div>
    <ul class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {reminders.map(([i, h, x], k) => (
        <li class="tf" style={`--d:${k * 90}ms`}>
          <span class="grid size-11 place-items-center rounded-2xl bg-green/15 text-green-deep"><Icon name={i} class="size-5" /></span>
          <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- the evening -->
  <section id="caisse" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Le soir, la caisse.</span><span class="block text-green-deep">Et vos chiffres.</span></h2>
    <p class="tf mt-4 max-w-2xl text-lg text-muted" style="--d:100ms">Ce qui a été payé, remis ou annulé dans la journée, au même endroit. Et sur votre téléphone, sans passer à l’atelier.</p>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {evening.map(([i, h, x], k) => (
        <li class="tf rounded-[1.75rem] bg-paper p-6 ring-1 ring-line" style={`--d:${k * 80}ms`}>
          <span class="grid size-11 place-items-center rounded-2xl bg-navy text-green"><Icon name={i} class="size-5" /></span>
          <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- the customers who do not come back, with the garage's own numbers -->
  <section id="calcul" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-rails data-tf>
    <div class="tf-x mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div>
        <h2 class="text-[2.2rem] leading-[0.95] sm:text-[2.8rem]"><span class="block">Combien de clients</span><span class="block text-green-deep">ne reviennent pas ?</span></h2>
        <p class="mt-4 text-muted">Faites le calcul avec vos propres chiffres. Rien n’est envoyé, tout reste sur votre téléphone.</p>
        <div class="mt-8 space-y-6">
          <label class="block"><span class="flex justify-between font-semibold"><span>Voitures par semaine</span><span class="rl-v tabular-nums" data-for="dep">30</span></span>
