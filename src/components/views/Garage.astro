<style>
  /* the four steps light up one after the other, then stay lit */
  .js [data-steps].in .pr-ic { animation: pr-lit .6s ease both; animation-delay: calc(var(--k) * 450ms + 500ms); }
  @keyframes pr-lit { 0% { background: #001E3E; color: #05B962; } 50% { background: #05B962; color: #001E3E; transform: scale(1.08); } 100% { background: #05B962; color: #001E3E; } }
  .js [data-steps] .pr-link { transform-origin: left; transform: scaleX(0); }
  .js [data-steps].in .pr-link { transition: transform .4s ease; transition-delay: calc(var(--k) * 450ms + 800ms); transform: scaleX(1); }
  :global(html[dir="rtl"]) .js [data-steps].in .pr-link { transform: scaleX(-1); }
  @media (prefers-reduced-motion: reduce) { .js [data-steps].in .pr-ic { animation: none; background: #05B962; color: #001E3E; } .js [data-steps] .pr-link { transform: none; } }
</style>

<script>
  // the calculator: the garage's own numbers, nothing is sent
  document.querySelectorAll<HTMLElement>('[data-rails]').forEach((root) => {
    const val = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value);
    const out = root.querySelector<HTMLElement>('.rl-out')!;
    const fmt = (n: number) => Math.round(n).toLocaleString('fr-FR').replace(/ | /g, ' ');
    const run = () => {
      root.querySelectorAll<HTMLElement>('.rl-v').forEach(v => { v.textContent = String(val(v.dataset.for!)); });
      out.textContent = fmt(val('dep') * 4.3 * (val('taux') / 100) * val('prix'));
    };
    root.querySelectorAll('.rl-r').forEach(r => r.addEventListener('input', run));
    run();
  });
  // sections reveal as they scroll in
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  if (still || !('IntersectionObserver' in window)) roots.forEach((r) => r.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.18 });
    roots.forEach((r) => io.observe(r));
  }
</script>
