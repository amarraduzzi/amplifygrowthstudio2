---
// All features (was posamplify.pages.dev/fonctionnalites): every module in detail.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import { signupUrl } from '../../config';
import { copy } from '../../i18n';
import { featuresFr as f } from '../../i18n/products-fr';
import { ROUTES, type Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const total = f.modules.reduce((n, m) => n + m.items.length, 0);
const title = 'Toutes les fonctionnalités de la caisse | Amplify POS';
const description = `Les ${total} fonctionnalités d’Amplify POS et Amplify Profit : caisse, commande à table, menu QR, marges, stock, équipe et charges. Tout est inclus.`;
const wa = 'Bonjour, j’ai une question sur les fonctionnalités d’Amplify.';
const ICON = { pos: 'till', waiter: 'bag', qr: 'qr', margins: 'chart', stock: 'store', team: 'briefcase', money: 'chart', trust: 'check' } as const;
const stats = [[String(f.modules.length), f.hero.stats[0]], [`${total}`, f.hero.stats[1]], ['2', f.hero.stats[2]]] as [string, [string, string]][];
---
<Base lang={lang} page="features" title={title} description={description} wa={wa}>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-10 sm:px-6 md:pt-16">
    <h1 class="max-w-4xl text-[clamp(2.8rem,6vw,5.2rem)]"><span class="block">{f.hero.title1}</span><span class="block text-green-deep">{f.hero.title2}</span></h1>
    <p class="mt-5 max-w-2xl text-lg text-muted md:text-xl">{f.hero.text}</p>
    <dl class="mt-10 grid max-w-3xl grid-cols-3 gap-3">
      {stats.map(([n, [l, s]]) => (
        <div class="rounded-[1.5rem] bg-paper p-4 ring-1 ring-line sm:p-5"><dt class="display text-5xl text-navy sm:text-6xl">{n}</dt><dd class="mt-1 text-sm font-semibold">{l}<span class="block font-normal text-muted">{s}</span></dd></div>
      ))}
    </dl>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={signupUrl(lang)} class="inline-flex min-h-12 items-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">{f.hero.cta}</a>
      <a href={`${ROUTES.pos[lang]}#tarifs`} class="inline-flex min-h-12 items-center rounded-full border border-navy/25 px-6 text-lg hover:border-navy">{f.hero.cta2}</a>
    </div>
  </section>

  <!-- jump to a module -->
  <nav class="sticky top-16 z-30 border-y border-line bg-chalk/95 backdrop-blur" aria-label={f.jump}>
    <div class="snap-row mx-auto flex max-w-6xl gap-2 overflow-x-auto px-4 py-2.5 sm:px-6">
      {f.modules.map(m => <a href={`#${m.key}`} class="flex shrink-0 items-center gap-2 rounded-full bg-paper px-3.5 py-2 text-sm font-semibold ring-1 ring-line hover:ring-navy"><Icon name={ICON[m.key]} class="size-4 text-green-deep" />{m.title}</a>)}
    </div>
  </nav>

  <div class="mx-auto max-w-6xl space-y-20 px-4 py-20 sm:px-6">
    {f.modules.map((m, mi) => (
      <section id={m.key} class="scroll-mt-36 grid gap-8 lg:grid-cols-[0.8fr_1.6fr]">
        <div class="lg:sticky lg:top-36 lg:self-start">
          <span class={`grid size-14 place-items-center rounded-2xl ${m.tag === 'Amplify Profit' ? 'bg-green text-navy' : 'bg-blue text-white'}`}><Icon name={ICON[m.key]} class="size-7" /></span>
          <p class="mt-5 text-sm font-semibold text-green-deep">{m.tag}, {String(mi + 1).padStart(2, '0')}</p>
          <h2 class="mt-1 text-[2.4rem] leading-[0.95] sm:text-5xl">{m.title}</h2>
          <p class="mt-3 text-muted">{m.text}</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {m.items.map(([h, p]) => (
            <article class="rounded-[1.4rem] bg-paper p-5 ring-1 ring-line">
              <h3 class="flex items-start gap-2 text-lg"><Icon name="check" class="mt-1 size-4 shrink-0 text-green-deep" />{h}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">{p}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="px-4 pb-24 sm:px-6">
    <div class="mx-auto max-w-6xl rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <h2 class="max-w-3xl text-6xl sm:text-7xl">{f.final.title}</h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">{f.final.text}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={signupUrl(lang)} class="inline-flex min-h-12 items-center rounded-full bg-green px-8 text-lg font-semibold text-navy hover:bg-[#04A859]">{f.final.cta}</a>
        <a href={`${ROUTES.pos[lang]}#tarifs`} class="inline-flex min-h-12 items-center rounded-full border border-white/30 px-6 hover:border-white">{f.final.pricing}</a>
        <WaButton text={wa} label={t.ui.whatsapp} where="features-final" tone="light" class="px-6" />
      </div>
    </div>
  </section>
</Base>
