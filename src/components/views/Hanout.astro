<style is:global>
  /* the modules: on = navy tile with a green icon, off = quiet */
  .hm-mod { background: #001E3E; color: #fff; --tw-ring-color: #001E3E; }
  .hm-mod .hm-ic { background: #05B962; color: #001E3E; }
  .hm-mod[aria-pressed="false"] { background: #fff; color: #001E3E; --tw-ring-color: rgb(0 30 62 / .12); }
  .hm-mod[aria-pressed="false"] .hm-ic { background: rgb(0 30 62 / .06); color: rgb(0 30 62 / .45); }
  .hm-mod[aria-pressed="false"] > span:not(.hm-ic) { opacity: .55; }
  .hm-mod:focus-visible, .hm-tab:focus-visible { outline: 3px solid #05B962; outline-offset: 2px; }
  .hm-mod.pop { animation: hm-pop .35s ease; }
  @keyframes hm-pop { 50% { transform: scale(1.04); } }
  .hm-tab[aria-selected="true"] { background: #001E3E; color: #05B962; --tw-ring-color: #001E3E; }
  /* the four steps of an order light up one after the other */
  .js [data-tf].in .hq-ic { animation: hq-lit .6s ease both; animation-delay: calc(var(--k) * 450ms + 600ms); }
  @keyframes hq-lit { 0% { background: #fff; color: #54637A; } 50% { background: #05B962; color: #001E3E; transform: scale(1.12); } 100% { background: #001E3E; color: #05B962; } }
  /* the old notebook gets struck out line by line, the Amplify checks pop in after */
  .hm-strike { background: linear-gradient(currentColor, currentColor) left .62em / 0% 2px no-repeat; }
  [dir="rtl"] .hm-strike { background-position: right .62em; }
  .js [data-tf].in .hm-strike { background-size: 100% 2px; color: rgb(84 99 122 / .75); transition: background-size .55s var(--sd) cubic-bezier(.6,0,.2,1), color .4s calc(var(--sd) + .2s); }
  .js [data-tf] .hm-pop { transform: scale(0); }
  .js [data-tf].in .hm-pop { animation: hm-check .5s var(--sd) cubic-bezier(.3,1.6,.5,1) both; }
  @keyframes hm-check { from { transform: scale(0) rotate(-40deg); } to { transform: none; } }
  /* the order line draws down through the four steps, in step with the lights */
  .hq-line { transform-origin: top; }
  .js [data-tf] .hq-line { transform: scaleY(0); }
  .js [data-tf].in .hq-line { transform: scaleY(1); transition: transform 1.7s .6s linear; }
  /* the live reminder: typing dots, message, blue ticks, the money coming back */
  .hm-typing { display: none; }
  .hm-typing i { width: .45rem; height: .45rem; border-radius: 99px; background: #667781; animation: hm-dot 1s infinite ease-in-out; }
  .hm-typing i:nth-child(2) { animation-delay: .15s; } .hm-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes hm-dot { 0%, 60%, 100% { transform: none; opacity: .5; } 30% { transform: translateY(-4px); opacity: 1; } }
  .hm-bubble, .hm-chip { transition: opacity .45s, transform .5s cubic-bezier(.2,.8,.2,1); }
  .hm-ticks { transition: color .4s; }
  .js [data-live]:not(.all) .hm-bubble, .js [data-live]:not(.all) .hm-chip { opacity: 0; transform: translateY(12px) scale(.97); }
  .js [data-live].t1 .hm-typing { display: flex; }
  .js [data-live].t2 .hm-typing { display: none; }
  .js [data-live].t2 .hm-bubble, .js [data-live].t4 .hm-chip { opacity: 1; transform: none; }
  .js [data-live].t3 .hm-ticks, .js [data-live].all .hm-ticks { color: #53BDEB; }
  .hm-bubble:active { transform: scale(.98); }
  /* the barcode beam sweeps the till, the chips pop in around the phones */
  .hm-beam i { position: absolute; inset-inline: 0; top: 0; height: 3px; background: #05B962; box-shadow: 0 0 18px 6px rgb(5 185 98 / .55); animation: hm-sweep 3.2s ease-in-out infinite; opacity: 0; }
  @keyframes hm-sweep { 0% { top: 8%; opacity: 0; } 12% { opacity: .9; } 50% { top: 62%; opacity: .9; } 62% { opacity: 0; } 100% { top: 62%; opacity: 0; } }
  .js [data-tf] .hm-chipx { opacity: 0; }
  .js [data-tf].in .hm-chipx { animation: hm-chip .55s var(--cd) cubic-bezier(.2,.8,.2,1) both; }
