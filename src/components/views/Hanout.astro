<script>
  // the modules: a start lights its modules, a tap switches one
  document.querySelectorAll<HTMLElement>('[data-mods]').forEach((root) => {
    const mods = [...root.querySelectorAll<HTMLButtonElement>('.hm-mod')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.hm-tab')];
    const n = root.querySelector<HTMLElement>('.hm-n')!;
    const count = () => { n.textContent = String(mods.filter(m => m.getAttribute('aria-pressed') === 'true').length); };
    const pick = (p: string) => {
      tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.prof === p)));
      root.querySelectorAll<HTMLElement>('[data-why]').forEach(w => { w.hidden = w.dataset.why !== p; });
      mods.forEach((m, i) => {
        const on = m.dataset.mod!.includes(p);
        if ((m.getAttribute('aria-pressed') === 'true') !== on) window.setTimeout(() => { m.setAttribute('aria-pressed', String(on)); m.classList.remove('pop'); void m.offsetWidth; m.classList.add('pop'); count(); }, i * 45);
      });
      window.setTimeout(count, mods.length * 45 + 20);
    };
    tabs.forEach(t => t.addEventListener('click', () => pick(t.dataset.prof!)));
    mods.forEach(m => m.addEventListener('click', () => {
      // the kridi is the heart: it stays on
      if (m.dataset.mod!.includes('k')) { m.classList.remove('pop'); void m.offsetWidth; m.classList.add('pop'); return; }
      m.setAttribute('aria-pressed', String(m.getAttribute('aria-pressed') !== 'true'));
      tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
      root.querySelectorAll<HTMLElement>('[data-why]').forEach(w => { w.hidden = true; });
      count();
    }));
  });
  // the calculator: the shop's own numbers, nothing is sent
  document.querySelectorAll<HTMLElement>('[data-cahier]').forEach((root) => {
    const val = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value);
    const fmt = (x: number) => Math.round(x).toLocaleString('fr-FR').replace(/ | /g, ' ');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cur = new WeakMap<HTMLElement, number>();
    const tween = (el: HTMLElement, to: number) => {
      const from = cur.get(el) ?? to;
      if (still || from === to) { cur.set(el, to); el.textContent = fmt(to); return; }
      const t0 = performance.now(), id = (el as any)._t = ((el as any)._t || 0) + 1;
      const tick = (t: number) => {
        if ((el as any)._t !== id) return;
        const k = Math.min(1, (t - t0) / 450), v = from + (to - from) * (1 - Math.pow(1 - k, 3));
        cur.set(el, v); el.textContent = fmt(v);
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const run = () => {
      root.querySelectorAll<HTMLElement>('.ck-v').forEach(v => { v.textContent = String(val(v.dataset.for!)); });
      const all = val('cli') * val('moy');
      tween(root.querySelector<HTMLElement>('.ck-all')!, all);
      tween(root.querySelector<HTMLElement>('.ck-out')!, all * val('taux') / 100);
    };
    root.querySelectorAll('.ck-r').forEach(r => r.addEventListener('input', run));
    run();
  });
  // the reminder plays by itself when it scrolls in, and again when you tap it
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((el) => {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = el.querySelector<HTMLElement>('[data-live-n]')!;
    const timers: number[] = [];
    const play = () => {
      timers.forEach(window.clearTimeout); timers.length = 0;
      el.classList.remove('all', 't1', 't2', 't3', 't4'); n.textContent = '0';
      const t0 = performance.now();
      const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1000); n.textContent = String(Math.round(320 * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
      [[1100, 't1'], [2300, 't2'], [3100, 't3'], [3700, 't4']].forEach(([ms, c]) => timers.push(window.setTimeout(() => el.classList.add(c as string), ms as number)));
    };
    if (still || !('IntersectionObserver' in window)) { el.classList.add('all'); return; }
    el.querySelector('.hm-bubble')!.addEventListener('click', play);
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.disconnect(); play(); } }), { threshold: 0.6 });
    io.observe(el);
  });
  // sections reveal as they scroll in
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  if (still || !('IntersectionObserver' in window)) roots.forEach((r) => r.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.18 });
    roots.forEach((r) => io.observe(r));
  }
</script>
