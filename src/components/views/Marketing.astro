---
// Marketing page. Our view: horeca marketing has to put people at the table, not collect views.
import Base from '../../layouts/Base.astro';
import MkHero from '../MkHero.astro';
import MkBeliefs from '../MkBeliefs.astro';
import MkSite from '../MkSite.astro';
import MkWhatsApp from '../MkWhatsApp.astro';
import Proof from '../Proof.astro';
import PhotoBand from '../PhotoBand.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import { copy } from '../../i18n';
import { mkOf } from '../../i18n/content';
import { tr, langOf } from '../../i18n/t';
const LG = langOf(Astro.url);
const tt = tr(LG);
const c = mkOf(LG);
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const schema = [serviceSchema(`${c.hero.h1a} ${c.hero.h1b}`, c.meta.description, abs(ROUTES.marketing[lang])), faqSchema(c.faq)].filter(Boolean) as Record<string, unknown>[];
const ICONS = ['🍽️', '💡', '🚀', '📈'];
---
<Base lang={lang} page="marketing" title={c.meta.title} description={c.meta.description} wa={c.wa} schema={schema}>
  <MkHero waLabel={t.ui.whatsapp} />

  <!-- statement -->
  <section class="border-y border-line bg-paper px-4 py-24 sm:px-6 md:py-32">
    <h2 class="mx-auto max-w-5xl text-center text-[2.4rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-[5rem]" data-scrub="words">
      <span class="block">{c.statement.a}</span>
      <span class="block">{c.statement.b.split(' ').map((w, i, a) => <><span class={`word ${i >= a.length - 4 ? 'mk-red' : ''}`}>{w}</span>{' '}</>)}</span>
    </h2>
  </section>

  <PhotoBand name="mk-terrasse" alt="Une terrasse de café pleine à Rabat en fin de journée" kicker="Notre travail" title="Remplir cette terrasse. Le reste suit." class="py-16 md:py-24" pos="50% 60%" />

  <MkBeliefs />

  <MkWhatsApp />

  <MkSite />

  <!-- visible or sold -->
  <section class="border-y border-line bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.compare.h2a}</span><span class="block text-green-deep">{c.compare.h2b}</span></h2>
      <div class="mt-12 overflow-hidden rounded-[2rem] bg-white ring-1 ring-line" data-scrub="steps">
        <div class="grid grid-cols-[0.8fr_1fr_1fr] border-b border-line text-sm font-bold sm:text-base">
          <span class="p-4 sm:p-5"></span>
          <span class="p-4 text-muted sm:p-5">{c.compare.cols[0]}</span>
          <span class="bg-navy p-4 text-white sm:p-5">{c.compare.cols[1]}</span>
        </div>
        {c.compare.rows.map(([k, a, b]) => (
          <div class="step mkc-row grid grid-cols-[0.8fr_1fr_1fr] border-b border-line text-sm last:border-0 sm:text-base">
            <span class="p-4 font-semibold sm:p-5">{k}</span>
            <span class="relative p-4 text-muted sm:p-5"><span class="mkc-a">{a}</span></span>
            <span class="mkc-b bg-navy p-4 font-semibold text-white sm:p-5"><span class="me-1.5 text-green">✓</span>{b}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- how we work -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.process.h2a}</span><span class="block text-green-deep">{c.process.h2b}</span></h2>
    <ol class="relative mt-14 grid gap-5 md:grid-cols-4" data-scrub="steps">
      <span class="absolute start-6 top-0 bottom-0 w-1 rounded-full bg-line md:start-[12.5%] md:end-[12.5%] md:top-7 md:bottom-auto md:h-1 md:w-auto" aria-hidden="true"><span class="mkp-line absolute rounded-full bg-green"></span></span>
      {c.process.steps.map(([h, p], i) => (
        <li class="step mkp-st relative ps-16 md:ps-0 md:text-center">
          <span class="mkp-dot absolute start-0 top-0 z-10 grid size-14 place-items-center rounded-full bg-paper text-2xl ring-1 ring-line transition-all duration-500 md:relative md:mx-auto">{ICONS[i]}</span>
          <p class="display mt-0 text-sm text-green-deep md:mt-5">{tt('ÉTAPE')} {i + 1}</p>
          <h3 class="mt-1 text-xl">{h}</h3>
          <p class="mt-2 text-muted">{p}</p>
        </li>
      ))}
    </ol>
    <!-- content made in your place -->
    <figure class="mkx relative mt-16 overflow-hidden rounded-[2rem] bg-navy">
      <img src="/img/mk-content.webp" alt={tt('Une équipe Amplify filme un cuisinier qui dresse un tajine dans sa cuisine')} width="1376" height="768" loading="lazy" decoding="async" class="mkx-img aspect-[16/9] h-auto w-full object-cover md:aspect-[21/9]" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/20 to-transparent"></div>
      <figcaption class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-4 p-6 text-white md:p-10">
        <p class="display max-w-2xl text-3xl leading-[0.95] sm:text-5xl">{tt('Tourné chez vous.')}<span class="block text-green">{tt('Votre cuisine, votre équipe.')}</span></p>
        <p class="mkx-rec inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 text-sm font-semibold backdrop-blur"><span class="size-2.5 rounded-full bg-[#F04438]"></span>{tt('En tournage')}</p>
      </figcaption>
    </figure>
  </section>

  <!-- for all of horeca -->
  <section class="overflow-hidden border-y border-line bg-navy py-10 text-white" aria-label={c.sectorsH}>
    <p class="mb-6 text-center text-sm font-semibold text-green">{c.sectorsH}</p>
    {[0, 1].map(r => (
      <div class="flex overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_10%,black_90%,transparent)]">
        <ul class={`mk-marquee flex shrink-0 gap-3 pe-3 ${r ? 'mk-rev mt-3' : ''}`} aria-hidden={r ? 'true' : undefined}>
          {[...c.sectors, ...c.sectors].map((x, i) => <li class={`display whitespace-nowrap rounded-full px-5 py-2 text-2xl sm:text-3xl ${(i + r) % 3 === 0 ? 'bg-green text-navy' : 'bg-white/10'}`}>{x}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <!-- what you receive each month -->
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[1fr_1fr]" data-mkrep>
    <div>
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.report.h2a}</span><span class="block text-green-deep">{c.report.h2b}</span></h2>
      <p class="mt-5 max-w-md text-lg text-muted">{c.report.p}</p>
      <!-- more Google reviews: the QR on the table -->
      <figure class="mkx relative mt-8 max-w-md overflow-hidden rounded-[2rem]">
        <img src="/img/mk-review.webp" alt={tt('Un client laisse un avis Google en scannant le QR posé sur sa table')} width="896" height="1200" loading="lazy" decoding="async" class="mkx-img aspect-[4/3] h-auto w-full object-cover object-[50%_45%]" />
        <figcaption class="mkx-chip absolute bottom-4 start-4 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-navy shadow-xl"><span class="text-[#F5B301]">★</span>{tt('Un QR sur la table, plus d’avis Google')}</figcaption>
      </figure>
    </div>
    <div aria-hidden="true">
      <div class="mx-auto max-w-sm rounded-[1.75rem] bg-[#E9E2D7] p-4 shadow-[0_40px_80px_-40px_rgba(0,30,62,0.5)]">
        <div class="mkr-msg ms-auto max-w-[92%] rounded-2xl rounded-se-none bg-[#D9FDD3] p-4 text-navy shadow-sm">
          <p class="font-bold">{c.report.title}</p>
          <ul class="mt-3 space-y-2 text-sm">
            {c.report.rows.map(([l, v], i) => <li class="mkr-row flex items-center justify-between gap-3 rounded-lg bg-white/70 px-3 py-2" style={`--d:${500 + i * 250}ms`}><span>{l}</span><span class="display text-xl text-green-deep">{v}</span></li>)}
          </ul>
          <p class="mkr-row mt-3 text-sm font-semibold text-green-deep" style="--d:1600ms">✓ {c.report.keep}</p>
          <p class="mkr-row text-sm font-semibold text-[#C4282D]" style="--d:1800ms">✕ {c.report.stop}</p>
          <p class="mt-2 text-end text-[0.65rem] text-muted">09:30 ✓✓</p>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-muted">{c.report.note}</p>
    </div>
  </section>

  <Proof h2={c.proof.h2} ph={c.proof.ph} />

  <Faq lang={lang} items={c.faq} wa={c.wa} />

  <!-- final: the room fills -->
  <section class="px-4 pb-24 sm:px-6" data-mkfin>
    <div class="relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14 lg:grid-cols-[1.2fr_1fr]">
      <img src="/img/photos/mk-salle-pleine-1600.webp" srcset="/img/photos/mk-salle-pleine-800.webp 800w, /img/photos/mk-salle-pleine-1600.webp 1536w" sizes="(min-width: 1152px) 1152px, 100vw" alt="" width="1536" height="1024" loading="lazy" class="mkf-photo absolute inset-0 -z-20 size-full object-cover" />
      <span class="absolute inset-0 -z-10 bg-linear-to-r from-navy via-navy/85 to-navy/40" aria-hidden="true"></span>
      <div>
        <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.final.h2a}</span><span class="block text-green">{c.final.h2b}</span></h2>
        <p class="mt-5 max-w-xl text-lg text-white/75">{c.final.p}</p>
        <div class="mt-8"><WaButton text={c.wa} label={c.final.cta} where="marketing-final" class="whitespace-nowrap px-7 text-base sm:px-8 sm:text-lg" /></div>
      </div>
      <div class="relative" aria-hidden="true">
        <div class="mx-auto grid max-w-sm grid-cols-8 gap-2 rounded-[1.5rem] bg-navy/60 p-5 ring-1 ring-white/15 backdrop-blur-md">
          {Array.from({ length: 40 }, (_, i) => <span class="mkf-seat aspect-square rounded-full bg-white/10" style={`--d:${(i * 17 % 40) * 55}ms`}></span>)}
        </div>
        <p class="mkf-full absolute -end-3 -top-4 rotate-6 rounded-xl bg-green px-4 py-2 text-xl font-black uppercase text-navy shadow-xl">Complet</p>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-mkfin], [data-mkrep]').forEach((root) => {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) { root.classList.add('in'); return; }
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { root.classList.add('in'); io.disconnect(); } }, { threshold: 0.4 });
    io.observe(root);
  });
</script>

<style is:global>
  .mkx-img { transform: scale(1.1); transition: transform 2.6s cubic-bezier(.2,.8,.2,1); }
  .mkx.seen .mkx-img { transform: scale(1); }
  .mkx-rec span { animation: mkx-blink 1.2s steps(1) infinite; }
  @keyframes mkx-blink { 50% { opacity: .2; } }
  .js .mkx-chip { opacity: 0; transform: translateY(12px); }
  .mkx.seen .mkx-chip { animation: mkx-in .6s cubic-bezier(.2,.8,.2,1) .8s both; }
  @keyframes mkx-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .mkx-img { transform: none; transition: none; } .mkx-rec span, .mkx.seen .mkx-chip { animation: none; } .js .mkx-chip { opacity: 1; transform: none; } }
</style>
<script>
  const mkx = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('seen'); mkx.unobserve(e.target); } }), { threshold: 0.25 });
  document.querySelectorAll('.mkx').forEach(n => mkx.observe(n));
</script>
