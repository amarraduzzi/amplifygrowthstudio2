---
import Base from '../../layouts/Base.astro';
import ChatThread from '../ChatThread.astro';
import WaButton from '../WaButton.astro';
import Device from '../Device.astro';
import Bars from '../Bars.astro';
import Icon from '../Icon.astro';
import Ph from '../Ph.astro';
import Mark from '../Mark.astro';
import { SITE, CONTACT } from '../../config';
import { copy } from '../../i18n';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const c = t.home;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: SITE.url,
    logo: abs('/favicon.svg'), email: CONTACT.email, telephone: `+${CONTACT.whatsapp}` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: abs(ROUTES.home[lang]), inLanguage: lang },
  faqSchema(c.faq),
].filter(Boolean) as Record<string, unknown>[];
const ICONS = ['qr', 'till', 'chef', 'chart', 'megaphone'] as const;
const TILE = ['bg-blue text-white', 'bg-navy text-green', 'bg-green text-navy', 'bg-navy text-white', 'bg-green-deep text-white'];
const PLACE_ICONS = ['cup', 'bag', 'store', 'briefcase'] as const;
const SIZES: Record<string, [number, number]> = { caisse: [1600, 937], tables: [1600, 937], cuisine: [1600, 937], marges: [1400, 714], 'menu-qr': [780, 1688] };
---
<Base lang={lang} page="home" title={c.meta.title} description={c.meta.description} wa={c.wa} schema={schema}>

  <!-- HERO: light, the promise left, the real product on a mint panel right.
       One orchestrated moment: an order travels from the QR menu to the kitchen to the margin. -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 pb-10 pt-5 sm:px-6 md:grid-cols-[1fr_1.05fr] md:items-center md:gap-10 md:pb-14 md:pt-14 lg:gap-12">
      <div>
        <h1 class="text-[clamp(2.75rem,12.5vw,3.4rem)] md:text-[clamp(3.1rem,5.6vw,5.4rem)]">{c.hero.h1.map((l, i) => (
          <span class="block overflow-hidden pb-[0.04em]"><span class={`rise relative inline-block whitespace-nowrap ${i === 2 ? 'text-green-deep' : ''}`} style={`--d:${i * 130}ms`}>{l}{i === 2 && <span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.05em] origin-left rounded-full bg-green md:h-[0.07em] rtl:origin-right" style="--d:650ms" aria-hidden="true"></span>}</span></span>
        ))}</h1>
        <p class="fade-up mt-4 max-w-xl text-[1.05rem] leading-snug text-muted md:mt-5 md:text-xl" style="--d:300ms"><span class="md:hidden">{c.hero.leadShort}</span><span class="hidden md:inline">{c.hero.lead}</span></p>
        <div id="hero-cta" class="fade-up mt-5 flex items-center gap-3.5 md:mt-7 md:gap-3" style="--d:400ms">
          <WaButton text={c.wa} label={t.ui.whatsapp} where="home-hero" class="whitespace-nowrap px-4 text-[0.95rem] md:px-7 md:text-lg" />
          <a href={SITE.demoUrl} target="_blank" rel="noopener" class="inline-flex items-center whitespace-nowrap text-sm font-medium underline underline-offset-4 md:min-h-12 md:rounded-full md:border md:border-navy/25 md:px-7 md:text-lg md:font-normal md:no-underline md:hover:border-navy">{t.ui.demo}</a>
        </div>
        <ul class="fade-up mt-4 flex items-center gap-x-4 text-[0.8rem] md:mt-6 md:gap-x-6 md:text-[0.95rem]" style="--d:500ms">
          <li>
            <a href={CONTACT.googleProfileUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:underline md:gap-2">
              <span class="flex text-[#F5B301]" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" class="size-3.5 md:size-4"><path fill="currentColor" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z"/></svg>)}</span>
              <span><strong class="font-semibold">{CONTACT.googleRating}</strong> {c.hero.rating}</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-muted"><span class="size-2 shrink-0 rounded-full bg-green" aria-hidden="true"></span>{c.hero.local}</li>
        </ul>
      </div>

      <div>
        <div class="relative isolate aspect-[4/3.1] overflow-hidden rounded-[1.75rem] bg-mint md:aspect-[5/4.3] md:rounded-[2.25rem]">
          <!-- a café counter in Rabat (AI image), behind the real product -->
          <img src="/img/comptoir-1200.webp" srcset="/img/comptoir-760.webp 760w, /img/comptoir-1200.webp 1200w" sizes="(min-width: 768px) 50vw, 100vw"
            alt="" width="1200" height="900" decoding="async" class="absolute inset-0 -z-20 size-full object-cover object-[50%_75%]" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy/10 via-transparent to-navy/30" aria-hidden="true"></div>

          <!-- phones: the iPhone in front, a narrow crop of the ticket behind; no labels on the picture -->
          <div class="absolute inset-0 md:hidden">
            <span class="shadow-in absolute bottom-[7%] end-[6%] h-5 w-[52%] rounded-[50%] bg-black/45 blur-lg" style="--d:700ms" aria-hidden="true"></span>
            <span class="shadow-in absolute bottom-[3%] start-[12%] h-4 w-[26%] rounded-[50%] bg-black/50 blur-md" style="--d:900ms" aria-hidden="true"></span>
            <div class="land absolute bottom-[10%] end-[5%] w-[56%]" style="--d:450ms">
              <Device src="/img/caisse-ticket-m.webp" alt={c.hero.shotAlt} w={900} h={888} eager class="rounded-[1.1rem]! p-1.5!">
                <span class="glow absolute start-[34%] top-[84.5%] h-[10%] w-[32%] rounded-md ring-2 ring-green" style="--d:1700ms" aria-hidden="true"></span>
              </Device>
            </div>
            <div class="drop absolute bottom-[5%] start-[9%] w-[31%]" style="--d:700ms"><Device kind="phone" src="/img/menu-liste.webp" alt={c.hero.phoneAlt} w={600} h={1298} eager class="-rotate-[3deg]" /></div>
          </div>

          <!-- desktop: tablet on the counter, labels on the picture -->
          <div class="absolute inset-0 hidden md:block">
            <span class="shadow-in absolute bottom-[10%] end-[8%] h-7 w-[66%] rounded-[50%] bg-black/45 blur-xl" style="--d:700ms" aria-hidden="true"></span>
            <span class="shadow-in absolute bottom-[4%] start-[7%] h-5 w-[22%] rounded-[50%] bg-black/50 blur-lg" style="--d:900ms" aria-hidden="true"></span>
            <div class="land absolute bottom-[13%] end-[5%] w-[74%]" style="--d:450ms">
              <Device src="/img/caisse-ticket.webp" alt={c.hero.shotAlt} w={1200} h={878} eager>
                <span class="glow absolute start-[52.9%] top-[85.9%] h-[9.4%] w-[22.2%] rounded-[0.6rem] ring-[3px] ring-green" style="--d:1700ms" aria-hidden="true"></span>
              </Device>
            </div>
            <div class="drop absolute bottom-[6%] start-[5%] w-[25%]" style="--d:700ms"><Device kind="phone" src="/img/menu-liste.webp" alt={c.hero.phoneAlt} w={600} h={1298} eager class="-rotate-[4deg]" /></div>
            <ol class="pointer-events-none text-sm font-semibold" aria-hidden="true">
              {c.hero.flow.map((label, i) => (
                <li class={`chat-in absolute flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-navy shadow-[0_12px_30px_-12px_rgba(0,30,62,0.45)] ${['top-5 start-5', 'top-[17%] end-5', 'bottom-4 end-5'][i]}`} style={`--d:${1200 + i * 550}ms`}>
                  <span class="grid size-7 place-items-center rounded-full bg-navy text-xs font-bold text-white">{i + 1}</span>
                  <Icon name={(['qr', 'chef', 'chart'] as const)[i]} class="size-4 text-green-deep" />
                  {label}
                </li>
              ))}
            </ol>
          </div>
        </div>
        <!-- phones: the order flow as three steps under the picture -->
        <ol class="mt-3 grid grid-cols-3 gap-2 md:hidden" aria-label="Commande">
          {c.hero.flowShort.map((label, i) => (
            <li class="chat-in flex items-center gap-1.5 rounded-xl bg-paper px-2 py-2 text-[0.72rem] font-semibold leading-tight text-navy ring-1 ring-line" style={`--d:${1200 + i * 550}ms`}>
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-navy text-[0.65rem] font-bold text-white">{i + 1}</span>{label}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="border-y border-line bg-paper">
      <dl class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:gap-6 md:py-7">
        {c.hero.facts.map(([n, l]) => (
          <div class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><dt class="display text-5xl text-navy md:text-6xl">{n}</dt><dd class="text-[0.78rem] leading-snug text-muted md:max-w-[14rem] md:text-[0.95rem]">{l}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- STATEMENT: the second line fills in as you scroll; the five steps get connected by a line that grows with the scroll -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="text-center text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-[5.5rem]" data-scrub="words">
      <span class="block">{c.statement.a}</span>
      <span class="block">{c.statement.b.split(' ').map((w, i) => <><span class="word">{w}</span>{' '}</>)}</span>
    </h2>
    <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-muted">{c.statement.p}</p>

    <ol class="relative mx-auto mt-14 grid max-w-md gap-7 lg:max-w-none lg:grid-cols-5 lg:gap-3" data-scrub="steps">
      <!-- the connecting line: vertical on phones, horizontal on desktop -->
      <span class="absolute start-[1.375rem] top-[1.375rem] bottom-[1.375rem] w-[3px] -translate-x-1/2 rounded-full bg-line lg:hidden rtl:translate-x-1/2" aria-hidden="true"><span class="flow-y block size-full rounded-full bg-green"></span></span>
      <span class="absolute top-[1.375rem] hidden h-[3px] -translate-y-1/2 rounded-full bg-line lg:block" style="inset-inline-start:1.375rem;inset-inline-end:calc((100% - 3rem) / 5 - 1.375rem)" aria-hidden="true"><span class="flow-x block size-full rounded-full bg-green"></span></span>
      {c.statement.items.map(([h, p], i) => (
        <li class="step relative grid grid-cols-[2.75rem_1fr] items-start gap-4 lg:block" style={`--i:${i}`}>
          <span class={`node relative z-10 grid size-11 place-items-center rounded-full ring-4 ring-chalk transition-all duration-500 ${TILE[i]}`}><Icon name={ICONS[i]} /></span>
          <div class="lg:mt-5 lg:pe-4">
            <h3 class="text-xl">{h}</h3>
            <p class="mt-1 text-[0.95rem] leading-snug text-muted">{p}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- TOUR: real screenshots -->
  <section class="bg-blue py-24 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl">{c.tour.h2}</h2>
      <p class="mt-5 text-center text-white/70">{c.tour.p}</p>
    </div>
    <ul class="snap-row mt-14 flex gap-5 overflow-x-auto pb-4" style="padding-inline:max(1rem,calc((100vw - 72rem) / 2 + 1.5rem));scroll-padding-inline:max(1rem,calc((100vw - 72rem) / 2 + 1.5rem))">
      {c.tour.cards.map(([h, p, img], i) => (
        <li class={`flex w-[82%] shrink-0 flex-col overflow-hidden rounded-[1.75rem] sm:w-[25rem] ${i % 2 ? 'bg-green text-navy' : 'bg-paper text-navy'}`}>
          <div class={`flex h-64 items-end justify-center overflow-hidden px-5 pt-5 ${i % 2 ? 'bg-[#0FA85C]' : 'bg-mint'}`}>
            <img src={`/img/${img}.webp`} alt={`${h} : ${p}`} width={SIZES[img][0]} height={SIZES[img][1]} loading={i < 2 ? 'eager' : 'lazy'} decoding="async"
              class={img === 'menu-qr' ? 'w-40 rounded-t-[1.4rem] shadow-xl' : 'w-full rounded-t-xl object-cover object-left-top shadow-xl'} />
          </div>
          <div class="p-6"><h3 class="display text-4xl">{h}</h3><p class="mt-2 text-[0.95rem] leading-snug opacity-80">{p}</p></div>
        </li>
      ))}
      <li class="flex w-[82%] shrink-0 flex-col justify-between overflow-hidden rounded-[1.75rem] bg-navy p-6 ring-1 ring-white/15 sm:w-[25rem]">
        <div class="space-y-2 pt-4">
          <p class="ms-auto w-fit max-w-[85%] rounded-2xl rounded-se-md bg-mint px-3.5 py-2 text-[0.95rem] text-navy">{t.marketing.wa}</p>
          <p class="w-fit max-w-[85%] rounded-2xl rounded-ss-md bg-paper px-3.5 py-2 text-[0.95rem] text-navy">{t.ui.chatReply}</p>
        </div>
        <div><h3 class="display text-4xl text-green">{c.tour.marketing[0]}</h3><p class="mt-2 text-[0.95rem] leading-snug text-white/75">{c.tour.marketing[1]}</p>
          <a href={ROUTES.marketing[lang]} class="mt-4 inline-block font-semibold text-green underline underline-offset-4">{c.paths.marketing.link}</a></div>
      </li>
    </ul>
  </section>

  <!-- PLACES -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="text-center text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{c.places.h2a}</span><span class="block">{c.places.h2b}</span></h2>
    <p class="mx-auto mt-6 max-w-xl text-center text-muted">{c.places.p}</p>
    <div class="mt-14 grid items-center gap-6 md:grid-cols-[1fr_auto_1fr]">
      <ul class="grid gap-6">{c.places.items.slice(0, 2).map(([h, p], i) => (
        <li class="md:text-end"><span class="inline-grid size-11 place-items-center rounded-xl bg-blue text-white"><Icon name={PLACE_ICONS[i]} /></span><h3 class="mt-3 text-xl">{h}</h3><p class="mt-1 text-muted">{p}</p></li>))}</ul>
      <div class="mx-auto grid size-56 place-items-center rounded-full bg-green md:size-64" aria-hidden="true">
        <Mark class="w-36" id="pl" />
      </div>
      <ul class="grid gap-6">{c.places.items.slice(2).map(([h, p], i) => (
        <li><span class="inline-grid size-11 place-items-center rounded-xl bg-green text-navy"><Icon name={PLACE_ICONS[i + 2]} /></span><h3 class="mt-3 text-xl">{h}</h3><p class="mt-1 text-muted">{p}</p></li>))}</ul>
    </div>
  </section>

  <!-- PROOF -->
  <section class="relative isolate overflow-hidden bg-blue py-24 text-white">
    <Bars class="absolute inset-x-0 bottom-0 -z-10 h-32" />
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 md:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{c.proof.h2a}</span><span class="block text-green">{c.proof.h2b}</span></h2>
        <p class="measure mt-6 text-white/75">{c.proof.p}</p>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <div class="absolute inset-0 translate-x-5 -translate-y-5 rotate-3 rounded-[1.75rem] bg-green" aria-hidden="true"></div>
        <div class="absolute inset-0 -translate-x-3 translate-y-3 -rotate-2 rounded-[1.75rem] bg-mint" aria-hidden="true"></div>
        <div class="relative rounded-[1.75rem] bg-paper p-8 text-navy">
          <p class="text-lg"><Ph value={c.proof.ph} /></p>
          <ul class="mt-6 flex flex-wrap gap-2">{c.proof.tags.map(tag => <li class="rounded-full bg-chalk px-3 py-1 text-sm font-medium">{tag}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-14 px-4 py-24 sm:px-6 md:grid-cols-[1.1fr_1fr] md:items-center">
    <ol class="grid gap-4 md:col-start-1 md:row-start-1">
      {c.steps.items.map(([h, p], i) => (
        <li class={`flex gap-5 rounded-[1.5rem] bg-paper p-6 shadow-[0_20px_40px_-30px_rgba(0,30,62,0.35)] ${['', 'md:ms-12', 'md:ms-4', 'md:ms-16'][i]}`}>
          <span class="display text-5xl text-green-deep">{String(i + 1).padStart(2, '0')}</span>
          <div><h3 class="text-xl">{h}</h3><p class="mt-1 text-muted"><Ph value={p} /></p></div>
        </li>
      ))}
    </ol>
    <div class="md:col-start-2 md:row-start-1">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl"><span class="block">{c.steps.h2a}</span><span class="fade-2 block">{c.steps.h2b}</span></h2>
      <p class="mt-5 text-lg text-muted">{c.steps.p}</p>
      <WaButton text={c.wa} label={t.ui.whatsapp} where="home-steps" class="mt-8 px-7" />
    </div>
  </section>

  <!-- PATHS -->
  <section class="relative isolate overflow-hidden bg-blue py-24 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="max-w-3xl text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9] lg:text-7xl">{c.paths.h2}</h2>
      <p class="mt-5 text-lg text-white/75">{c.paths.p}</p>
      <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-5 md:grid-cols-[1.15fr_1fr]">
        {(['systems', 'marketing'] as const).map((k, i) => {
          const p = c.paths[k];
          return (
            <a href={ROUTES[k][lang]} class={`group flex flex-col rounded-[1.75rem] p-8 md:p-10 ${i === 0 ? 'bg-green text-navy' : 'bg-paper text-navy'}`}>
              <span class="display text-6xl">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display mt-6 text-5xl">{p.h3}</h3>
              <p class="mt-3 max-w-md">{p.p}</p>
              <ul class="mt-6 divide-y divide-navy/15 border-y border-navy/15">
                {p.list.map(x => <li class="flex items-center gap-3 py-3 font-medium"><Icon name="check" class="size-5" />{x}</li>)}
              </ul>
              <span class="mt-8 font-semibold underline-offset-4 group-hover:underline">{p.link}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-24 sm:px-6 md:grid-cols-[1fr_1.4fr]">
    <div>
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{t.ui.faq}</h2>
      <p class="mt-5 text-muted">{t.ui.faqCta}</p>
      <WaButton text={c.wa} label={t.ui.whatsapp} where="home-faq" class="mt-6 px-7" />
    </div>
    <div class="grid gap-3">
      {c.faq.map(([q, a], i) => (
        <details class="group rounded-2xl bg-paper px-6 py-5 open:ring-2 open:ring-blue" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold">{q}
            <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg bg-blue text-white transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
          <p class="mt-3 text-muted"><Ph value={a} /></p>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL -->
  <section class="px-4 pb-24 sm:px-6">
    <div class="relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-blue px-6 py-14 text-white md:grid-cols-[1.1fr_1fr] md:px-14">
      <Bars class="absolute inset-x-0 bottom-0 -z-10 h-28" />
      <div>
        <h2 class="text-6xl sm:text-7xl lg:text-[6rem]">{c.final.h2}</h2>
        <p class="mt-5 text-lg text-white/75">{c.final.p}</p>
        <WaButton text={c.wa} label={t.ui.whatsapp} where="home-final" class="mt-8 px-8 text-lg" />
      </div>
      <ChatThread lang={lang} message={c.wa} reply={t.ui.chatReply} dark />
    </div>
  </section>
</Base>
