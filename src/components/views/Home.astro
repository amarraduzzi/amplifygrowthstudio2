<style>
  @media (prefers-reduced-motion: no-preference) {
    .js [data-tf]:not(.in) .ms-photo { scale: 1.14; }
    .ms-photo { transition: scale 1.8s cubic-bezier(.2,.8,.2,1), transform .7s ease-out; }
  }
  /* the leaks: off = the leak plays, on = Amplify closed it */
  [data-leaks] .lv-btn { color: rgb(255 255 255 / .75); }
  [data-leaks][data-mode="off"] .lv-btn[data-set="off"], [data-leaks][data-mode="on"] .lv-btn[data-set="on"] { color: #001E3E; }
  [data-leaks][data-mode="on"] .lv-thumb { transform: translateX(100%); background: #05B962; }
  :global(html[dir="rtl"]) [data-leaks][data-mode="on"] .lv-thumb { transform: translateX(-100%); }
  [data-leaks][data-mode="on"] .lv-card { background-color: rgb(5 185 98 / .10); box-shadow: inset 0 0 0 1px rgb(5 185 98 / .45); }
  [data-leaks][data-mode="off"] .lv-on, [data-leaks][data-mode="on"] .lv-off { display: none; }
  /* 1. the drawer drains, coins drip; with Amplify it fills back and the drips stop */
  .lv-fill { height: 82%; transition: height 1s cubic-bezier(.2,.8,.2,1); }
  [data-leaks][data-mode="off"].in .lv-fill { animation: lv-drain 6s ease-in-out infinite; }
  @keyframes lv-drain { 0% { height: 82%; } 70% { height: 30%; } 100% { height: 82%; } }
  .lv-drop { opacity: 0; }
  [data-leaks][data-mode="off"].in .lv-drop { animation: lv-fall 1.8s ease-in infinite; animation-delay: calc(var(--k) * 600ms); }
  @keyframes lv-fall { 0% { opacity: 0; transform: translate(-50%, -6px) scale(.6); } 15% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, 44px) scale(1) rotate(160deg); } }
  .lv-crack { transition: opacity .5s; }
  [data-leaks][data-mode="on"] .lv-crack { opacity: 0; }
  /* 2. the notebook sleeps; with Amplify every line is paid */
  .lv-paid { opacity: 0; transform: scale(.4); transition: opacity .4s, transform .4s cubic-bezier(.3,1.6,.5,1); transition-delay: calc(var(--j) * 180ms); }
  [data-leaks][data-mode="on"] .lv-paid { opacity: 1; transform: none; }
  [data-leaks][data-mode="on"] .lv-amt { text-decoration: line-through; color: rgb(0 30 62 / .45); transition: color .4s calc(var(--j) * 180ms); }
  [data-leaks][data-mode="on"] .lv-zz { opacity: 0; }
  [data-leaks][data-mode="off"].in .lv-zz { animation: lv-zz 2.4s ease-in-out infinite; animation-delay: calc(var(--j) * 400ms); }
  @keyframes lv-zz { 0%, 100% { opacity: .2; transform: translateY(2px); } 50% { opacity: .8; transform: translateY(-4px); } }
  [data-leaks][data-mode="off"].in .lv-book { animation: lv-breathe 4s ease-in-out infinite; }
  @keyframes lv-breathe { 0%, 100% { transform: rotate(-2deg) translateY(0); } 50% { transform: rotate(-2.5deg) translateY(-3px); } }
  /* 3. five clients walk away; with Amplify they come back */
  .lv-cl { transition: opacity .6s, transform .6s cubic-bezier(.2,.8,.2,1), box-shadow .6s; }
  [data-leaks][data-mode="off"].in .lv-go { animation: lv-away 3.6s ease-in-out infinite; animation-delay: calc(var(--j) * 170ms); }
  @keyframes lv-away { 0%, 15% { opacity: 1; transform: none; } 55%, 80% { opacity: .15; transform: translateX(14px) scale(.85); } 100% { opacity: 1; transform: none; } }
  .lv-back { opacity: 0; transform: scale(.4); transition: opacity .4s, transform .4s cubic-bezier(.3,1.6,.5,1); transition-delay: calc(var(--j) * 60ms); }
  [data-leaks][data-mode="on"] .lv-go { box-shadow: 0 0 0 3px #05B962; }
  [data-leaks][data-mode="on"] .lv-go .lv-back { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-leaks] .lv-fill, [data-leaks] .lv-drop, [data-leaks] .lv-zz, [data-leaks] .lv-book, [data-leaks] .lv-go { animation: none !important; } }
</style>

<script>
  // the leaks: the year's loss ticks up while it leaks; after a few seconds in view, the section shows the same cards with Amplify
  document.querySelectorAll<HTMLElement>('[data-leaks]').forEach((root) => {
    const count = root.querySelector<HTMLElement>('.lv-count');
    let lost = 0, touched = false, timer = 0;
    const set = (m: 'on' | 'off') => {
      root.dataset.mode = m;
      root.querySelectorAll<HTMLElement>('.lv-btn').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.set === m)));
    };
    root.querySelectorAll<HTMLButtonElement>('.lv-btn').forEach(b => b.addEventListener('click', () => { touched = true; window.clearTimeout(timer); set(b.dataset.set as 'on' | 'off'); }));
    window.setInterval(() => {
      if (root.dataset.mode !== 'off' || !root.classList.contains('in') || document.visibilityState !== 'visible') return;
      lost += 7 + Math.floor(Math.random() * 17);
      if (count) count.textContent = lost.toLocaleString('fr-FR').replace(/ | /g, ' ');
    }, 90);
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); timer = window.setTimeout(() => { if (!touched) set('on'); }, 6500); } }, { threshold: 0.15 });
    io.observe(root);
  });
  // sections reveal as they scroll in
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  if (still || !('IntersectionObserver' in window)) roots.forEach((r) => r.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
    roots.forEach((r) => io.observe(r));
  }
  // the facts under the hero count up when they come into view
  const cio = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return; cio.unobserve(e.target);
    const el = e.target as HTMLElement, to = Number(el.dataset.count);
    if (still || !to) return;
    const t0 = performance.now(), dur = 1200;
    const step = (now: number) => { const k = Math.min(1, (now - t0) / dur); el.textContent = String(Math.max(k > 0 ? 1 : 0, Math.round(to * (1 - Math.pow(1 - k, 3))))); if (k < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }), { threshold: 0.6 });
  document.querySelectorAll('[data-count]').forEach(n => cio.observe(n));
</script>
