---
import Base from '../../layouts/Base.astro';
import ChatThread from '../ChatThread.astro';
import WaButton from '../WaButton.astro';
import Device from '../Device.astro';
import Bars from '../Bars.astro';
import Icon from '../Icon.astro';
import Ph from '../Ph.astro';
import Mark from '../Mark.astro';
import { SITE, CONTACT } from '../../config';
import { copy } from '../../i18n';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const c = t.home;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: SITE.url,
    logo: abs('/favicon.svg'), email: CONTACT.email, telephone: `+${CONTACT.whatsapp}` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: abs(ROUTES.home[lang]), inLanguage: lang },
  faqSchema(c.faq),
].filter(Boolean) as Record<string, unknown>[];
const ICONS = ['till', 'chef', 'qr', 'chart', 'megaphone'] as const;
const TILE = ['bg-green text-navy', 'bg-blue text-white', 'bg-mint text-navy', 'bg-navy text-green', 'bg-paper text-navy ring-1 ring-line'];
const PLACE_ICONS = ['cup', 'bag', 'store', 'briefcase'] as const;
const SIZES: Record<string, [number, number]> = { caisse: [1600, 937], tables: [1600, 937], cuisine: [1600, 937], marges: [1400, 714], 'menu-qr': [780, 1688] };
---
<Base lang={lang} page="home" title={c.meta.title} description={c.meta.description} wa={c.wa} schema={schema}>

  <!-- HERO: light, the promise left, the real product on a mint panel right.
       One orchestrated moment: an order travels from the QR menu to the kitchen to the margin. -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 pb-14 pt-10 sm:px-6 md:grid-cols-[1fr_1.05fr] md:items-center md:pt-14 lg:gap-12">
      <div>
        <h1 class="text-[clamp(3rem,5.6vw,5.4rem)]">{c.hero.h1.map((l, i) => <span class={`block whitespace-nowrap ${i === 2 ? 'text-green-deep' : ''}`}>{l}</span>)}</h1>
        <p class="mt-5 max-w-xl text-xl leading-snug text-muted">{c.hero.lead}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <WaButton text={c.wa} label={t.ui.whatsapp} where="home-hero" class="px-7 text-lg" />
          <a href={SITE.demoUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center justify-center rounded-full border border-navy/25 px-7 text-lg hover:border-navy">{t.ui.demo}</a>
        </div>
        <ul class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.95rem]">
          <li>
            <a href={CONTACT.googleProfileUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:underline">
              <span class="flex text-[#F5B301]" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" class="size-4"><path fill="currentColor" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z"/></svg>)}</span>
              <span><strong class="font-semibold">{CONTACT.googleRating}</strong> {c.hero.rating}</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-muted"><span class="size-2 rounded-full bg-green" aria-hidden="true"></span>{c.hero.local}</li>
        </ul>
      </div>

      <div class="relative isolate aspect-[5/4.3] overflow-hidden rounded-[2.25rem] bg-mint">
        <!-- a café counter in Rabat (AI image), behind the real product -->
        <img src="/img/comptoir-1200.webp" srcset="/img/comptoir-760.webp 760w, /img/comptoir-1200.webp 1200w" sizes="(min-width: 768px) 50vw, 100vw"
          alt="" width="1200" height="900" decoding="async" fetchpriority="low" class="absolute inset-0 -z-20 size-full object-cover object-[50%_75%]" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy/10 via-transparent to-navy/30" aria-hidden="true"></div>
        <!-- the devices stand on the counter: same eye level as the photo, contact shadows underneath -->
        <div class="absolute inset-0">
          <span class="absolute bottom-[10%] end-[8%] h-7 w-[66%] rounded-[50%] bg-black/45 blur-xl" aria-hidden="true"></span>
          <span class="absolute bottom-[4%] start-[7%] h-5 w-[22%] rounded-[50%] bg-black/50 blur-lg" aria-hidden="true"></span>
          <Device src="/img/caisse-ticket.webp" alt={c.hero.shotAlt} w={1200} h={878} eager class="absolute bottom-[13%] end-[5%] w-[74%]" />
          <Device kind="phone" src="/img/menu-liste.webp" alt={c.hero.phoneAlt} w={600} h={1298} eager class="absolute bottom-[6%] start-[5%] w-[25%] -rotate-[4deg]" />
        </div>
        <ol class="pointer-events-none text-sm font-semibold" aria-label="Commande">
          {c.hero.flow.map((label, i) => (
            <li class={`chat-in absolute flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-navy shadow-[0_12px_30px_-12px_rgba(0,30,62,0.45)] ${['top-5 start-5', 'top-[17%] end-5', 'bottom-4 end-5'][i]}`} style={`--d:${500 + i * 800}ms`}>
              <span class="grid size-7 place-items-center rounded-full bg-navy text-xs font-bold text-white">{i + 1}</span>
              <Icon name={(['qr', 'chef', 'chart'] as const)[i]} class="size-4 text-green-deep" />
              {label}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="border-y border-line bg-paper">
      <dl class="mx-auto grid max-w-6xl gap-6 px-4 py-7 sm:grid-cols-3 sm:px-6">
        {c.hero.facts.map(([n, l]) => (
          <div class="flex items-center gap-4"><dt class="display text-6xl text-navy">{n}</dt><dd class="max-w-[14rem] text-[0.95rem] leading-snug text-muted">{l}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="text-center text-5xl sm:text-6xl lg:text-[5.5rem]"><span class="block">{c.statement.a}</span><span class="fade-2 block">{c.statement.b}</span></h2>
    <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-muted">{c.statement.p}</p>
    <ul class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {c.statement.items.map(([h, p], i) => (
        <li class="rounded-2xl border border-line bg-paper p-5">
          <span class={`grid size-11 place-items-center rounded-xl ${TILE[i]}`}><Icon name={ICONS[i]} /></span>
          <h3 class="mt-4 text-lg">{h}</h3>
          <p class="mt-1 text-[0.95rem] leading-snug text-muted">{p}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- TOUR: real screenshots -->
  <section class="bg-blue py-24 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center text-5xl sm:text-6xl lg:text-7xl">{c.tour.h2}</h2>
      <p class="mt-5 text-center text-white/70">{c.tour.p}</p>
    </div>
    <ul class="snap-row mt-14 flex gap-5 overflow-x-auto pb-4" style="padding-inline:max(1rem,calc((100vw - 72rem) / 2 + 1.5rem));scroll-padding-inline:max(1rem,calc((100vw - 72rem) / 2 + 1.5rem))">
      {c.tour.cards.map(([h, p, img], i) => (
        <li class={`flex w-[82%] shrink-0 flex-col overflow-hidden rounded-[1.75rem] sm:w-[25rem] ${i % 2 ? 'bg-green text-navy' : 'bg-paper text-navy'}`}>
          <div class={`flex h-64 items-end justify-center overflow-hidden px-5 pt-5 ${i % 2 ? 'bg-[#0FA85C]' : 'bg-mint'}`}>
            <img src={`/img/${img}.webp`} alt={`${h} : ${p}`} width={SIZES[img][0]} height={SIZES[img][1]} loading={i < 2 ? 'eager' : 'lazy'} decoding="async"
              class={img === 'menu-qr' ? 'w-40 rounded-t-[1.4rem] shadow-xl' : 'w-full rounded-t-xl object-cover object-left-top shadow-xl'} />
          </div>
          <div class="p-6"><h3 class="display text-4xl">{h}</h3><p class="mt-2 text-[0.95rem] leading-snug opacity-80">{p}</p></div>
        </li>
      ))}
      <li class="flex w-[82%] shrink-0 flex-col justify-between overflow-hidden rounded-[1.75rem] bg-navy p-6 ring-1 ring-white/15 sm:w-[25rem]">
        <div class="space-y-2 pt-4">
          <p class="ms-auto w-fit max-w-[85%] rounded-2xl rounded-se-md bg-mint px-3.5 py-2 text-[0.95rem] text-navy">{t.marketing.wa}</p>
          <p class="w-fit max-w-[85%] rounded-2xl rounded-ss-md bg-paper px-3.5 py-2 text-[0.95rem] text-navy">{t.ui.chatReply}</p>
        </div>
        <div><h3 class="display text-4xl text-green">{c.tour.marketing[0]}</h3><p class="mt-2 text-[0.95rem] leading-snug text-white/75">{c.tour.marketing[1]}</p>
          <a href={ROUTES.marketing[lang]} class="mt-4 inline-block font-semibold text-green underline underline-offset-4">{c.paths.marketing.link}</a></div>
      </li>
    </ul>
  </section>

  <!-- PLACES -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="text-center text-5xl sm:text-6xl lg:text-7xl"><span class="block">{c.places.h2a}</span><span class="block">{c.places.h2b}</span></h2>
    <p class="mx-auto mt-6 max-w-xl text-center text-muted">{c.places.p}</p>
    <div class="mt-14 grid items-center gap-6 md:grid-cols-[1fr_auto_1fr]">
      <ul class="grid gap-6">{c.places.items.slice(0, 2).map(([h, p], i) => (
        <li class="md:text-end"><span class="inline-grid size-11 place-items-center rounded-xl bg-blue text-white"><Icon name={PLACE_ICONS[i]} /></span><h3 class="mt-3 text-xl">{h}</h3><p class="mt-1 text-muted">{p}</p></li>))}</ul>
      <div class="mx-auto grid size-56 place-items-center rounded-full bg-green md:size-64" aria-hidden="true">
        <Mark class="w-36" id="pl" />
      </div>
      <ul class="grid gap-6">{c.places.items.slice(2).map(([h, p], i) => (
        <li><span class="inline-grid size-11 place-items-center rounded-xl bg-green text-navy"><Icon name={PLACE_ICONS[i + 2]} /></span><h3 class="mt-3 text-xl">{h}</h3><p class="mt-1 text-muted">{p}</p></li>))}</ul>
    </div>
  </section>

  <!-- PROOF -->
  <section class="relative isolate overflow-hidden bg-blue py-24 text-white">
    <Bars class="absolute inset-x-0 bottom-0 -z-10 h-32" />
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 md:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-5xl sm:text-6xl lg:text-7xl"><span class="block">{c.proof.h2a}</span><span class="block text-green">{c.proof.h2b}</span></h2>
        <p class="measure mt-6 text-white/75">{c.proof.p}</p>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <div class="absolute inset-0 translate-x-5 -translate-y-5 rotate-3 rounded-[1.75rem] bg-green" aria-hidden="true"></div>
        <div class="absolute inset-0 -translate-x-3 translate-y-3 -rotate-2 rounded-[1.75rem] bg-mint" aria-hidden="true"></div>
        <div class="relative rounded-[1.75rem] bg-paper p-8 text-navy">
          <p class="text-lg"><Ph value={c.proof.ph} /></p>
          <ul class="mt-6 flex flex-wrap gap-2">{c.proof.tags.map(tag => <li class="rounded-full bg-chalk px-3 py-1 text-sm font-medium">{tag}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-14 px-4 py-24 sm:px-6 md:grid-cols-[1.1fr_1fr] md:items-center">
    <ol class="grid gap-4 md:col-start-1 md:row-start-1">
      {c.steps.items.map(([h, p], i) => (
        <li class={`flex gap-5 rounded-[1.5rem] bg-paper p-6 shadow-[0_20px_40px_-30px_rgba(0,30,62,0.35)] ${['', 'md:ms-12', 'md:ms-4', 'md:ms-16'][i]}`}>
          <span class="display text-5xl text-green-deep">{String(i + 1).padStart(2, '0')}</span>
          <div><h3 class="text-xl">{h}</h3><p class="mt-1 text-muted"><Ph value={p} /></p></div>
        </li>
      ))}
    </ol>
    <div class="md:col-start-2 md:row-start-1">
      <h2 class="text-5xl sm:text-6xl lg:text-7xl"><span class="block">{c.steps.h2a}</span><span class="fade-2 block">{c.steps.h2b}</span></h2>
      <p class="mt-5 text-lg text-muted">{c.steps.p}</p>
      <WaButton text={c.wa} label={t.ui.whatsapp} where="home-steps" class="mt-8 px-7" />
    </div>
  </section>

  <!-- PATHS -->
  <section class="relative isolate overflow-hidden bg-blue py-24 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="max-w-3xl text-5xl sm:text-6xl lg:text-7xl">{c.paths.h2}</h2>
      <p class="mt-5 text-lg text-white/75">{c.paths.p}</p>
      <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-5 md:grid-cols-[1.15fr_1fr]">
        {(['systems', 'marketing'] as const).map((k, i) => {
          const p = c.paths[k];
          return (
            <a href={ROUTES[k][lang]} class={`group flex flex-col rounded-[1.75rem] p-8 md:p-10 ${i === 0 ? 'bg-green text-navy' : 'bg-paper text-navy'}`}>
              <span class="display text-6xl">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display mt-6 text-5xl">{p.h3}</h3>
              <p class="mt-3 max-w-md">{p.p}</p>
              <ul class="mt-6 divide-y divide-navy/15 border-y border-navy/15">
                {p.list.map(x => <li class="flex items-center gap-3 py-3 font-medium"><Icon name="check" class="size-5" />{x}</li>)}
              </ul>
              <span class="mt-8 font-semibold underline-offset-4 group-hover:underline">{p.link}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-24 sm:px-6 md:grid-cols-[1fr_1.4fr]">
    <div>
      <h2 class="text-5xl sm:text-6xl">{t.ui.faq}</h2>
      <p class="mt-5 text-muted">{t.ui.faqCta}</p>
      <WaButton text={c.wa} label={t.ui.whatsapp} where="home-faq" class="mt-6 px-7" />
    </div>
    <div class="grid gap-3">
      {c.faq.map(([q, a], i) => (
        <details class="group rounded-2xl bg-paper px-6 py-5 open:ring-2 open:ring-blue" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold">{q}
            <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg bg-blue text-white transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
          <p class="mt-3 text-muted"><Ph value={a} /></p>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL -->
  <section class="px-4 pb-24 sm:px-6">
    <div class="relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-blue px-6 py-14 text-white md:grid-cols-[1.1fr_1fr] md:px-14">
      <Bars class="absolute inset-x-0 bottom-0 -z-10 h-28" />
      <div>
        <h2 class="text-6xl sm:text-7xl lg:text-[6rem]">{c.final.h2}</h2>
        <p class="mt-5 text-lg text-white/75">{c.final.p}</p>
        <WaButton text={c.wa} label={t.ui.whatsapp} where="home-final" class="mt-8 px-8 text-lg" />
      </div>
      <ChatThread lang={lang} message={c.wa} reply={t.ui.chatReply} dark />
    </div>
  </section>
</Base>
