---
// Home: Amplify for every Moroccan trade. One promise (the money a shop loses without seeing it), the trades
// to choose from, a calculator per trade, one partner from the counter to Google, how we work, proof, FAQ.
// The restaurant blocks that lived here (scale, margin simulator, tour, QR ordering) moved to /restaurants.
// No results are claimed for a trade without clients: the calculators show the visitor's own numbers.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Device from '../Device.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import LogoBand from '../LogoBand.astro';
import ZaynaProof from '../ZaynaProof.astro';
import LeakCalc from '../LeakCalc.astro';
import PartnerChain from '../PartnerChain.astro';
import { SITE, CONTACT } from '../../config';
import { copy } from '../../i18n';
import { tr } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const t = copy(lang);
const c = t.home;
const wa = tt('Bonjour, je voudrais un diagnostic gratuit pour mon commerce.');
const faq = [
  ['Pour quels commerces ?', 'Restaurants, cafés et snacks, pâtisseries, fine dining, coiffeurs et barbiers, spas et instituts, pressings, hanouts et agences immobilières. Chaque métier a son propre système, pensé pour lui.'],
  ['Je ne suis pas à Rabat.', 'Nous passons sur place à Rabat et Salé. Ailleurs au Maroc, nous installons et formons votre équipe en appel vidéo.'],
  ['Il me faut quel matériel ?', 'Souvent rien de plus que ce que vous avez : un téléphone, une tablette ou un ordinateur. Pour une caisse ou des tickets, nous vous conseillons le matériel qui convient.'],
  ['Vos systèmes sont en arabe ?', 'Oui. Nos systèmes sont en arabe et en français, et les messages à vos clients partent dans leur langue.'],
  ['Combien ça coûte ?', 'Cela dépend de votre métier et de ce que vous utilisez. Les prix sont sur la page Tarifs et sur la page de chaque métier. Le diagnostic est gratuit.'],
  ['Je dois m’engager ?', 'Non. Vous arrêtez quand vous voulez, et vous gardez vos données.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: SITE.url,
    logo: abs('/favicon.svg'), email: CONTACT.email, telephone: `+${CONTACT.whatsapp}` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: abs(ROUTES.home[lang]), inLanguage: lang },
  faqSchema(faq.map(([q, a]) => [tt(q), tt(a)])),
].filter(Boolean) as Record<string, unknown>[];
const toc = [
  { id: 'metiers', label: tt('Votre métier') },
  { id: 'calcul', label: tt('Faire le calcul') },
  { id: 'partenaire', label: tt('Un seul partenaire') },
  { id: 'methode', label: tt('Comment nous travaillons') },
  { id: 'faq', label: t.ui.faq },
];
// the trades: the restaurant card is the big one (most of today's clients)
const TRADES = [
  { k: 'restaurants', name: 'Restaurants et cafés', line: 'La caisse, le menu QR et la marge de chaque plat.', img: '/img/photos/metier-restaurant-1600.webp', pos: '50% 55%', cls: 'col-span-2 lg:row-span-2' },
  { k: 'bakery', name: 'Pâtisseries', line: 'Le plan de production et le coût de chaque pièce.', img: '/img/photos/pat-matin-800.webp', pos: '72% 50%', cls: '' },
  { k: 'maitre', name: 'Fine dining', line: 'Le service à table, sans papier.', img: '/img/nav-dining.webp', pos: '62% 55%', cls: '' },
  { k: 'salons', name: 'Coiffeurs et barbiers', line: 'L’agenda, la file d’attente et les rappels.', img: '/img/photos/salon-barbier-800.webp', pos: '62% 45%', cls: '' },
  { k: 'spas', name: 'Spas et instituts', line: 'Les cabines, les soins et les forfaits.', img: '/img/photos/spa-cabine-800.webp', pos: '55% 50%', cls: '' },
  { k: 'pressing', name: 'Pressings', line: 'Une étiquette par pièce, le client prévenu.', img: '/img/nav-pressing.webp', pos: '55% 45%', cls: '' },
  { k: 'hanout', name: 'Hanouts', line: 'Le kridi, la caisse et le stock, sur le téléphone.', img: '/img/photos/hanout-comptoir-800.webp', pos: '62% 45%', cls: '' },
  { k: 'immobilier', name: 'Immobilier', line: 'Les biens, les visites et les loyers.', img: '/img/photos/immo-agent-rue-800.webp', pos: '62% 40%', cls: 'col-span-2' },
] as const;
const trades = TRADES.map(x => ({ ...x, href: ROUTES[x.k][lang] }));
const chips = [['restaurants', 'Restaurants'], ['salons', 'Coiffeurs'], ['spas', 'Spas'], ['pressing', 'Pressings'], ['hanout', 'Hanouts'], ['immobilier', 'Immobilier']] as const;
// where the money goes: the same three leaks in every trade
const leaks = [
  ['coins', 'L’argent qui fuit', 'Une portion trop généreuse, un produit périmé, une caisse qui ne tombe pas juste. Petit chaque jour, énorme sur l’année.', ['Restaurant : 10 g de fromage en trop par pizza', 'Hanout : le yaourt périmé au fond du frigo', 'Tous : l’écart de caisse du soir']],
  ['clock', 'L’argent qui dort', 'Ce qu’on vous doit, mais que personne ne vient régler. Écrit dans un cahier, ou pas écrit du tout.', ['Hanout : le kridi qui ne revient pas', 'Pressing : les costumes jamais récupérés', 'Immobilier : le loyer en retard']],
  ['users', 'Les clients qui ne reviennent pas', 'Un client content qui oublie de revenir, un rendez-vous manqué, un nouveau client qui ne vous trouve pas sur Google.', ['Salon : le rendez-vous oublié', 'Restaurant : l’habitué qu’on ne relance jamais', 'Tous : pas de site, pas de fiche Google']],
] as const;
// one calculator per trade: three sliders, one formula, the visitor's own numbers
const calcs = [
  { k: 'resto', tab: 'Restaurant', out: 'Ce que coûtent les portions trop généreuses, chaque mois', how: 'Calcul : plats par jour × 30 jours × coût matière d’un plat × la part en trop.', with: 'Avec Amplify Profit, chaque plat a sa fiche au gramme près, et vous voyez l’écart entre ce qui est sorti du stock et ce qui a été vendu.',
    s: [['Plats vendus par jour', 20, 400, 10, 120], ['Coût matière d’un plat (DH)', 5, 100, 1, 25], ['Portion trop généreuse (%)', 0, 30, 1, 8]] },
  { k: 'hanout', tab: 'Hanout', out: 'Le kridi qui dort depuis plus d’un mois', how: 'Calcul : clients au kridi × ce que doit un client × la part qui ne paie plus.', with: 'Avec Amplify Hanout, ces clients sont en haut de la liste, avec un rappel poli prêt à partir sur WhatsApp.',
    s: [['Clients qui achètent au kridi', 5, 200, 5, 40], ['Ce que doit un client en moyenne (DH)', 20, 2000, 10, 250], ['Sur 100, combien ne paient plus depuis un mois', 0, 80, 1, 20]] },
  { k: 'pressing', tab: 'Pressing', out: 'L’argent qui attend sur vos rails, chaque mois', how: 'Calcul : dépôts par semaine × 4,3 semaines × la part récupérée en retard × prix moyen.', with: 'Avec Amplify Pressing, les dépôts qui traînent sont listés, avec un WhatsApp prêt à envoyer au client.',
    s: [['Dépôts par semaine', 10, 400, 10, 60], ['Prix moyen d’un dépôt (DH)', 30, 600, 10, 120], ['Dépôts récupérés en retard sur 100', 0, 40, 1, 8]] },
  { k: 'salon', tab: 'Salon', out: 'Ce que coûtent les rendez-vous manqués, chaque mois', how: 'Calcul : rendez-vous par semaine × 4,3 semaines × la part de rendez-vous manqués × prix moyen.', with: 'Avec Amplify Agenda, le client reçoit un rappel WhatsApp la veille, envoyé en un geste.',
    s: [['Rendez-vous par semaine', 10, 300, 5, 80], ['Prix moyen d’une prestation (DH)', 30, 800, 10, 120], ['Rendez-vous manqués sur 100', 0, 30, 1, 10]] },
] as const;
const partner = [
  ['till', 'Le système de votre métier', 'La caisse, l’agenda, le kridi ou les dépôts : l’outil de tous les jours, pensé pour votre métier.', ROUTES.systems[lang], 'Voir nos systèmes'],
  ['store', 'Votre site', 'Un vrai site à votre nom, relié à votre système : le menu, les prix, les rendez-vous ou les commandes.', ROUTES.site[lang], 'Voir Amplify Site'],
  ['megaphone', 'Plus de clients', 'Google, WhatsApp, dégustations et campagnes : du marketing qui fait venir des clients, pas des vues.', ROUTES.marketing[lang], 'Voir Amplify Clients'],
] as const;
const method = [
  ['pin', 'Nous passons vous voir', 'À Rabat et Salé, dans votre commerce. Ailleurs, en appel vidéo. Nous regardons comment vous travaillez.', '/img/equipe-client.webp', '55% 40%', 'Une consultante montre des chiffres sur une tablette à un restaurateur, autour d’un thé à la menthe'],
  ['box', 'Nous installons', 'Avec vos produits, vos prix et votre équipe. Vous n’avez rien à préparer.', '/img/equipe-installation.webp', '60% 50%', 'Une main branche une imprimante de tickets à côté d’un écran de caisse, dans un café de Rabat'],
  ['users', 'Nous formons votre équipe', 'En arabe ou en français, jusqu’à ce que chacun soit à l’aise.', '/img/equipe-formation.webp', '55% 40%', 'Une consultante montre la caisse sur une tablette à trois employés d’un restaurant'],
  ['message', 'Nous restons là', 'Une question ? WhatsApp. Et nous regardons vos chiffres avec vous.', '/img/equipe-patron.webp', '50% 30%', 'Un patron de café souriant regarde son téléphone derrière son comptoir'],
] as const;
const img = (k: string) => `/img/hanout-${k}-${lang === 'ar' ? 'ar' : 'fr'}.webp`;
---
<Base lang={lang} page="home" title={tt('Amplify : les systèmes des commerces marocains | Amplify Growth Studio')} description={tt('Caisse, marges, kridi, agenda, dépôts, site et marketing : Amplify aide les commerces marocains à retrouver l’argent qu’ils perdent sans le voir. Restaurants, salons, pressings, hanouts et agences. Une équipe à Rabat.')} wa={wa} schema={schema} toc={toc}>

  <!-- HERO: the promise left; right, one scene with four trades: the till lands, three phones drop, the day plays out in chips -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-0 px-4 pb-10 pt-6 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.05fr] lg:items-start lg:gap-12 lg:pb-16">
      <div class="max-lg:contents">
        <h1 class="max-lg:order-1 text-[clamp(2.05rem,8.4vw,3.3rem)] md:text-[clamp(2.8rem,4.3vw,3.9rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:60ms">Votre commerce perd</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:180ms">de l’argent sans le voir.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:300ms">Nous le retrouvons.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:800ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up max-lg:order-1 mt-4 max-w-xl text-base text-muted sm:mt-5 sm:text-lg md:text-xl" style="--d:350ms">Caisse, marges, kridi, rendez-vous, dépôts, site et clients : Amplify met de l’ordre dans les commerces marocains, et vous montre ce que vous gagnez vraiment. Une équipe à Rabat, en arabe et en français.</p>
        <div class="fade-up max-lg:order-1 mt-5 flex flex-wrap sm:mt-6 items-center gap-x-5 gap-y-3" style="--d:450ms">
          <WaButton id="hero-cta" text={wa} label={c.hero.diag} where="home-hero" class="px-7 text-lg" />
          <ul class="flex items-center gap-x-4 text-[0.85rem] md:text-[0.95rem]">
            <li>
              <a href={CONTACT.googleProfileUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:underline">
                <span class="flex text-[#F5B301]" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" class="size-3.5 md:size-4"><path fill="currentColor" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z"/></svg>)}</span>
                <span><strong class="font-semibold">{CONTACT.googleRating}</strong> {c.hero.rating}</span>
              </a>
            </li>
            <li class="flex items-center gap-2 text-muted"><span class="size-2 shrink-0 rounded-full bg-green" aria-hidden="true"></span>{c.hero.local}</li>
          </ul>
        </div>
        <div class="fade-up max-lg:order-3 mt-6 sm:mt-7" style="--d:550ms">
          <p class="text-sm font-semibold text-muted">Votre métier</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {chips.map(([k, l]) => <li><a href={ROUTES[k][lang]} class="inline-flex min-h-10 items-center rounded-full bg-paper px-3.5 text-[0.9rem] sm:px-4 sm:text-[0.95rem] font-semibold ring-1 ring-line transition-colors hover:bg-navy hover:text-white">{l}</a></li>)}
            <li><a href="#metiers" class="inline-flex min-h-10 items-center rounded-full px-3 text-[0.95rem] font-semibold text-green-deep underline underline-offset-4">Tous les métiers</a></li>
          </ul>
        </div>
      </div>

      <div class="relative isolate order-2 mt-7 aspect-[4/3.6] overflow-hidden rounded-[1.75rem] bg-navy sm:mt-8 lg:order-none lg:mt-3 lg:aspect-[5/4.6] lg:rounded-[2.25rem]">
        <span class="sl-scene absolute inset-0 -z-20" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
        <span class="shadow-in absolute start-[10%] top-[66%] h-6 w-[64%] rounded-[50%] bg-black/55 blur-xl" style="--d:700ms" aria-hidden="true"></span>
        <div class="land absolute start-[5%] top-[17%] w-[72%]" style="--d:250ms"><Device src="/img/caisse-ticket.webp" alt={tt('La caisse d’un restaurant : une table ouverte avec ses articles et le total')} w={1200} h={878} eager /></div>
        <div class="drop absolute bottom-[4%] start-[44%] w-[19%]" style="--d:650ms"><Device kind="phone" src="/img/pressing-suivi-phone.webp" alt={tt('Le suivi d’un dépôt de pressing sur le téléphone du client')} w={600} h={1298} eager class="-rotate-[4deg]" /></div>
        <div class="drop absolute bottom-[6%] start-[63%] w-[19%]" style="--d:850ms"><Device kind="phone" src="/img/salon-rdv-phone.webp" alt={tt('Un rendez-vous de salon pris depuis le téléphone')} w={600} h={1298} eager class="rotate-[2deg]" /></div>
        <div class="drop absolute end-[3%] top-[30%] w-[22%]" style="--d:1050ms"><Device kind="phone" src={img('today')} alt={tt('Le téléphone d’un hanout : les ventes du jour, le stock et le kridi')} w={600} h={1298} eager screenBg="#EDF1F6" class="rotate-[5deg]" /></div>
        <ul class="pointer-events-none text-[0.68rem] font-semibold sm:text-sm" aria-hidden="true">
          {[['chart', 'Restaurant : marge calculée', 'top-[4%] start-[4%]', 'bg-paper text-navy'], ['book', 'Hanout : +200 DH rentrés', 'top-[19%] end-[3%] max-sm:hidden', 'bg-green text-navy'], ['message', 'Pressing : client prévenu', 'bottom-[30%] start-[3%] max-sm:hidden', 'bg-paper text-navy'], ['calendar', 'Salon : rendez-vous confirmé', 'bottom-[3%] start-[3%]', 'bg-paper text-navy']].map(([i, l, p, col], k) => (
            <li class={`absolute z-10 ${p}`}><div class="tf-float" style={`--d:${k * 900}ms`}><p class={`chat-in flex items-center gap-2 rounded-full py-1.5 pe-3.5 ps-1.5 shadow-lg ${col}`} style={`--d:${1800 + k * 700}ms`}><span class="grid size-6 place-items-center rounded-full bg-navy text-green sm:size-7"><Icon name={i as 'chart'} class="size-3.5 sm:size-4" /></span>{l}</p></div></li>
          ))}
        </ul>
      </div>
    </div>

  </section>

  <!-- CLIENTS: the businesses already running on Amplify -->
  <LogoBand />

  <!-- TRADES: a photo card per trade, the restaurants first and biggest -->
  <section id="metiers" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Choisissez votre métier.</span><span class="block text-green-deep">Le système est fait pour lui.</span></h2>
    <p class="tf mt-4 max-w-2xl text-lg text-muted" style="--d:100ms">Un restaurant ne travaille pas comme un pressing, un salon ou un hanout. Chaque métier a son système, avec ses mots, ses habitudes et ses chiffres.</p>
    <div class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:grid-rows-[15rem_15rem_15rem]">
      {trades.map((x, k) => (
        <a href={x.href} class={`tf group/t relative isolate flex min-h-52 flex-col justify-end overflow-hidden rounded-[1.6rem] bg-navy p-5 text-white shadow-[0_18px_40px_-24px_rgba(0,30,62,0.6)] lg:min-h-0 ${x.cls}`} style={`--d:${k * 60}ms`}>
          <img src={x.img} alt="" width="800" height="597" loading="lazy" decoding="async" class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-700 ease-out group-hover/t:scale-105" style={`object-position:${x.pos}`} />
          <span class="absolute inset-0 -z-10 bg-linear-to-t from-navy/95 via-navy/40 to-navy/5" aria-hidden="true"></span>
          <span class={`display leading-[0.95] ${k === 0 ? 'text-[2.2rem] sm:text-5xl' : 'text-[1.45rem] sm:text-[1.7rem]'}`}>{tt(x.name)}</span>
          <span class={`mt-1.5 leading-snug text-white/85 ${k === 0 ? 'max-w-sm text-base' : 'text-[0.85rem]'}`}>{tt(x.line)}</span>
          <span class="absolute end-4 top-4 grid size-9 place-items-center rounded-full bg-green text-navy opacity-0 transition-opacity duration-300 group-hover/t:opacity-100" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-4 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      ))}
    </div>
  </section>

  <!-- LEAKS: the same three, in every trade. Each card plays its leak (coins dripping from the drawer, the notebook
       asleep, clients walking away); the switch, or the section after a few seconds, shows the same cards with Amplify. -->
  <section id="fuites" class="relative isolate overflow-hidden bg-navy text-white" data-tf data-leaks data-mode="off">
    <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
    <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="tf-x text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Où part votre argent ?</span><span class="block text-green">Toujours au même endroit.</span></h2>
          <p class="tf-x mt-5 max-w-2xl text-lg text-white/70" style="--d:100ms">Restaurant, salon, pressing ou hanout : le métier change, les fuites restent les mêmes. Ce sont elles que nos systèmes ferment.</p>
        </div>
        <div class="tf relative inline-grid shrink-0 grid-cols-2 self-start rounded-full bg-white/10 p-1 ring-1 ring-white/15 lg:self-auto" role="group" aria-label="Sans ou avec Amplify" style="--d:200ms">
          <span class="lv-thumb absolute inset-y-1 start-1 w-[calc(50%-0.25rem)] rounded-full bg-white transition-transform duration-500 ease-[cubic-bezier(.2,.8,.2,1)]" aria-hidden="true"></span>
          <button type="button" data-set="off" aria-pressed="true" class="lv-btn relative z-10 min-h-11 rounded-full px-5 font-semibold transition-colors">Sans Amplify</button>
          <button type="button" data-set="on" aria-pressed="false" class="lv-btn relative z-10 min-h-11 rounded-full px-5 font-semibold transition-colors">Avec Amplify</button>
        </div>
      </div>
      <ul class="mt-12 grid gap-4 lg:grid-cols-3">
        {leaks.map(([i, h, x, ex], k) => (
          <li class="tf lv-card flex flex-col overflow-hidden rounded-[2rem] bg-white/[0.06] ring-1 ring-white/10 transition-[background-color,box-shadow] duration-700" style={`--d:${k * 120}ms`}>
            <div class="lv-vis relative h-52 overflow-hidden border-b border-white/10 bg-[radial-gradient(80%_90%_at_50%_100%,rgba(255,255,255,.07),transparent)]" aria-hidden="true">
              {k === 0 && (
                <div class="absolute inset-0 flex items-center justify-center gap-7 px-6">
                  <div class="relative">
                    <div class="relative h-32 w-24 overflow-hidden rounded-[1.1rem] bg-white/[0.07] ring-2 ring-white/25">
                      <span class="lv-fill absolute inset-x-0 bottom-0 bg-linear-to-t from-green to-green/60"></span>
                      <span class="absolute inset-x-0 top-1/2 h-px bg-white/15"></span>
                      <span class="absolute inset-x-0 bottom-3 text-center text-[0.65rem] font-bold tracking-wide text-navy/80">DH</span>
                    </div>
                    <span class="lv-crack absolute -bottom-1 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full bg-[#F5B301]"></span>
                    {[0, 1, 2].map(d => <span class="lv-drop absolute left-1/2 top-full grid size-5 -translate-x-1/2 place-items-center rounded-full bg-[#F5B301] text-[0.5rem] font-black text-navy shadow" style={`--k:${d}`}>DH</span>)}
                  </div>
                  <div class="min-w-0">
                    <p class="lv-off text-xs font-semibold text-white/55">Perdu cette année</p>
                    <p class="lv-off display mt-1 whitespace-nowrap text-[1.9rem] leading-none text-[#FF8A80] tabular-nums sm:text-[2.2rem]" dir="ltr">− <span class="lv-count">0</span> DH</p>
                    <p class="lv-on display flex items-center gap-2 text-[1.7rem] leading-none text-green"><span class="grid size-7 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>Fuite fermée</p>
                  </div>
                </div>
              )}
              {k === 1 && (
                <div class="absolute inset-0 flex items-center justify-center px-6">
                  <div class="lv-book w-full max-w-[16rem] -rotate-2 rounded-xl bg-[#FBF7EC] p-3.5 text-navy shadow-[0_20px_40px_-20px_rgba(0,0,0,.6)]">
                    {[['Ahmed', '640'], ['Khadija', '480'], ['Omar', '420'], ['Nadia', '300']].map(([n, v], j) => (
                      <div class="lv-row relative flex items-center gap-2 border-b border-dashed border-navy/15 py-1 text-[0.85rem]" style={`--j:${j}`}>
                        <span class="font-semibold">{n}</span>
                        <span class="lv-zz text-[0.7rem] font-black text-navy/35">z z</span>
                        <span class="lv-amt ms-auto font-bold tabular-nums" dir="ltr">{v} DH</span>
