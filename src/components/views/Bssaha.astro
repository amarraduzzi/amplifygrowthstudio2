---
// Bssaha: commission-free ordering directory for Rabat restaurants (fr, en, ar). Design: "Le Terminal", a futuristic command-centre
// in the Amplify palette (navy, green, tall Archivo heads). Text: src/i18n/bssaha.ts. Restaurants: src/data/bssaha.ts.
// The directory itself (list, map, calculator, live order, join form) is BssahaDirectory, also shown inside the Livraison page.
import '../../styles/bssaha.css';
import Base from '../../layouts/Base.astro';
import FinalCta from '../FinalCta.astro';
import BxArrow from '../BxArrow.astro';
import BssahaFx from '../BssahaFx.astro';
import BssahaTicket from '../BssahaTicket.astro';
import BssahaDirectory from '../BssahaDirectory.astro';
import { bssahaModel } from '../../lib/bssahaModel';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = bssahaModel(lang);
const { c, wa, restos, first } = m;
const schema = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Bssaha', inLanguage: lang, url: abs(ROUTES.bssaha[lang]),
  about: restos.map(r => ({ '@type': 'Restaurant', name: r.nom, servesCuisine: r.cuisine, address: { '@type': 'PostalAddress', addressLocality: r.quartier, addressCountry: 'MA' } })) }];
const ticker = [`${c.ticketComm} 0 DH`, c.modes.direct, `100 % ${c.liveReceived}`, c.modes.whatsapp, c.badge, c.modes.livraison, c.modes.emporter];
---
<Base lang={lang} page="bssaha" title={c.title} description={c.description} wa={wa} schema={schema}>
  <div class="bx-page" data-city={first.id} data-number="212611053649" data-one={c.countOne} data-many={c.countMany} data-list-city={c.listCity} data-first={first.id}
    data-m-direct={c.modes.direct} data-m-whatsapp={c.modes.whatsapp} data-m-livraison={c.modes.livraison} data-m-emporter={c.modes.emporter} data-sending={c.sending} style={`--city:${first.glow}`}>
  <BssahaFx />

  <!-- ============ HERO ============ -->
  <section class="bx-hero">
    <canvas id="bx-net" aria-hidden="true"></canvas>
    <div class="bx-floor" aria-hidden="true"><i></i></div>
    <div class="bx-grain" aria-hidden="true"></div>
    <div class="bx-scan" aria-hidden="true"></div>
    <div class="mx-auto grid w-full max-w-6xl gap-14 px-4 py-12 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:py-14">
      <div>
        <p class="bx-badge rv"><span class="bx-dot"></span><span class="font-dot text-sm tracking-widest">{c.badge}</span></p>
        <h1 class="bx-h1 mt-6"><span class="block" data-scramble>{c.h1a}</span><span class="block bx-hot" data-scramble>{c.h1b}</span><span class="bx-under" aria-hidden="true"></span></h1>
        <p class="measure rv mt-7 text-lg bx-mute md:text-xl" style="--d:200ms">{c.lead}</p>
        <div class="rv mt-9 flex flex-col gap-3 sm:flex-row" style="--d:320ms">
          <a id="hero-cta" href="#liste" class="bx-btn bx-btn--go" data-mag>{c.ctaList}<BxArrow /></a>
          <a href="#rejoindre" class="bx-btn bx-btn--ghost" data-mag>{c.ctaJoin}</a>
        </div>
        <div class="bx-stats rv mt-12" style="--d:440ms">
          <div class="bx-stat"><b class="bx-led" dir="ltr">0 DH</b><span>{c.zeroLabel}</span></div>
          <div class="bx-stat"><b class="bx-led" dir="ltr">100 %</b><span>{c.liveReceived}</span></div>
          <div class="bx-stat"><b class="bx-led" dir="ltr">{restos.length}</b><span>{c.restos}</span></div>
        </div>
      </div>
      <div class="rv" style="--d:260ms"><BssahaTicket c={c} /></div>
    </div>
  </section>

  <!-- ============ TICKER ============ -->
  <div class="bx-marq" aria-hidden="true">
    <div class="bx-marq-track">
      {[0, 1, 2, 3].map(() => ticker.map((t, i) => <span><b class={`display ${i % 2 ? 'out' : ''}`}>{t}</b></span>))}
    </div>
  </div>

  <BssahaDirectory m={m} />

  <FinalCta lang={lang} page="bssaha" wa={wa} h2={c.ctaH2} p={c.ctaP} />
  </div>

</Base>
