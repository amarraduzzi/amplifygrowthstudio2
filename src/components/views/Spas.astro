---
// Spas page (spas, hammams, instituts): linked from the salons page, the products menu and the footer.
// Same look as the salons page. Real screenshots of the demo spa ("Spa Démo", invented names). No
// clients, reviews or results are claimed. Only prices already published on the salons page are used.
import Base from '../../layouts/Base.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import CountUp from '../CountUp.astro';
import SpaCabins from '../SpaCabins.astro';
import PhotoBand from '../PhotoBand.astro';
import { tr } from '../../i18n/t';
import { ROUTES, type Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais voir Amplify pour mon spa.');
const today = [
  'Une cabine réservée deux fois, et une cliente qui attend en peignoir.',
  'Le hammam plein à 11 h, vide à 15 h.',
  'Une cliente qui ne vient pas à son soin de 90 minutes.',
  'Les forfaits et les cartes cadeaux notés dans un cahier.',
];
const withUs = [
  'Un horaire n’est proposé que si la praticienne et une cabine sont libres.',
  'Le hammam accueille plusieurs clientes à la fois, jusqu’à sa capacité.',
  'Un acompte pour les longs soins : pas payé à temps, le créneau se libère.',
  'Forfaits de séances et cartes cadeaux, suivis par la caisse.',
];
const cabins = [
  ['door', 'Vos cabines, vos salles', 'Cabines de massage, hammam, salle de soins : chacune avec le nombre de clientes qu’elle peut recevoir en même temps.'],
  ['flask', 'Vos machines', 'Un laser, un appareil de soin du visage : une prestation qui en a besoin n’est proposée que s’il est libre.'],
  ['calendar', 'La bonne cabine, toute seule', 'À la réservation, l’agenda choisit une cabine libre. Vous pouvez aussi la choisir vous-même.'],
  ['tv', 'La vue Cabines', 'Une colonne par cabine : qui est dedans, pour quel soin, avec qui. Le hammam montre ses clientes côte à côte.'],
] as const;
const deposit = [
  ['coins', 'Par soin', 'Un montant pour les soins longs ou chers : pierres chaudes, rituel hammam, mariée.'],
  ['users', 'Après une absence', 'Une cliente qui n’est pas venue paie un acompte pour chaque nouveau rendez-vous.'],
  ['phone', 'Payé comme elle veut', 'Virement avec votre RIB à copier, CashPlus, votre lien de paiement, ou sur place.'],
  ['check', 'Déduit le jour J', 'La caisse le retire de l’addition. Annulé à temps : remboursé ou gardé en avoir.'],
] as const;
const till = [
  ['box', 'Forfaits de séances', '5 massages, 10 séances de laser : payés en une fois ou en plusieurs, chaque séance décomptée.'],
  ['gift', 'Cartes cadeaux', 'Un code à offrir, utilisable en plusieurs fois, avec son solde.'],
  ['heart', 'Fidélité', 'Un tampon par visite payée, et la récompense que vous choisissez.'],
  ['wallet', 'Commissions', 'Par praticienne : pourcentage, paliers ou montant par soin, salaire fixe, avances et primes.'],
  ['bag', 'Produits et stock', 'Les huiles et crèmes vendues, et celles utilisées en cabine, avec l’inventaire.'],
  ['star', 'Avis clientes', 'Après la visite, une note pour le spa, puis une invitation à laisser un avis Google.'],
] as const;
const faq = [
  ['Mes clientes doivent-elles installer une application ?', 'Non. Elles ouvrent un lien ou scannent un QR. Rien à installer, rien à créer.'],
  ['Le hammam reçoit plusieurs clientes. Ça marche ?', 'Oui. Vous indiquez combien de clientes il reçoit en même temps : l’agenda remplit jusqu’à ce nombre, pas plus.'],
  ['Et un massage en duo ?', 'Aujourd’hui, ce sont deux rendez-vous à la même heure, avec deux praticiennes. Une réservation duo en une fois arrive si nos spas la demandent.'],
  ['L’acompte est-il payé en ligne automatiquement ?', 'Le paiement en ligne automatique demande un contrat de votre spa avec CMI, PayZone ou YouCan Pay. En attendant, la cliente paie par virement, CashPlus ou votre lien, et vous confirmez la réception en un clic.'],
  ['Combien de cabines et de praticiennes puis-je ajouter ?', 'Autant que vous voulez.'],
  ['Mes clientes restent-elles à moi ?', 'Oui. Il n’y a pas de place de marché : votre page ne montre que votre spa, jamais un concurrent.'],
  ['Qui installe tout ?', 'Nous. Vos soins, vos cabines, votre équipe et vos horaires, et nous montrons tout à votre équipe. C’est offert.'],
  ['Et si j’arrête ?', 'Sans engagement : vous arrêtez d’un mois à l’autre. Les 14 premiers jours sont gratuits.'],
];
const demo = 'https://menu.amplifygrowthstudio.com/spa-demo?rdv';
const plans = [
  { name: 'Agenda', price: '199', for: 'Les rendez-vous, les cabines et la réservation en ligne.', items: ['Agenda par praticienne et par cabine', 'Hammam et salles à plusieurs places', 'Réservation en ligne avec votre QR', 'Rappels de la veille et confirmation de la cliente', 'Fiche cliente, allergies et historique'] },
  { name: 'Spa complet', price: '399', for: 'L’agenda, la caisse et l’acompte, ensemble.', featured: true, was: '447', items: ['Tout Agenda', 'Caisse et clôture du jour', 'Forfaits, cartes cadeaux et fidélité', 'Commissions par praticienne', 'Acompte et règles d’absence'] },
  { name: 'Agenda et caisse', price: '348', for: 'Pour les instituts qui n’ont pas besoin d’acompte.', items: ['Tout Agenda', 'Caisse et clôture du jour', 'Produits et stock', 'Forfaits, cartes cadeaux et fidélité', 'Commissions et avis clientes'] },
];
const modules = [
  ['Caisse et fidélité', '+149 DH HT / mois', 'Tickets, clôture du jour, produits et stock, commissions, forfaits, cartes cadeaux, tampons et avis clientes.', 'live'],
  ['Acompte', '+99 DH HT / mois', 'Un acompte pour les longs soins. Pas payé à temps, le créneau se libère.', 'live'],
  ['Site du spa', '+149 DH HT / mois', 'Vos soins, vos prix, vos photos et le bouton de réservation, à votre nom.', 'live'],
  ['WhatsApp automatique', '+99 DH HT / mois', 'Les rappels partent tout seuls. Les messages WhatsApp sont facturés à prix coûtant.', ''],
];
---
<Base lang={lang} page="spas" title={tt('Amplify pour les spas, hammams et instituts | Amplify Growth Studio')} description={tt('L’agenda qui connaît vos cabines, votre hammam et vos machines. Réservation en ligne, acomptes, forfaits et cartes cadeaux. Pour les spas et instituts à Rabat et Salé.')} wa={wa}>
  <!-- hero: the cabins land, the client's phone drops, the day fills -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-14">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Spas, hammams et instituts</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Chaque cabine pleine.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Jamais deux fois.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Vos clientes réservent en ligne, uniquement quand une praticienne et une cabine sont libres. L’acompte tient le créneau, le rappel de la veille fait le reste.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="spas-hero" class="px-7 text-lg" />
          <a href={demo} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-paper">Essayer la réservation</a>
        </div>
      </div>

      <div class="relative isolate aspect-[4/3.7] overflow-hidden rounded-[1.75rem] bg-navy lg:aspect-[5/4.7] lg:rounded-[2.25rem]">
        <span class="sl-scene absolute inset-0 -z-20" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
        <span class="shadow-in absolute start-[8%] top-[72%] h-6 w-[66%] rounded-[50%] bg-black/55 blur-xl" style="--d:700ms" aria-hidden="true"></span>
        <div class="land absolute start-[4%] top-[18%] w-[74%]" style="--d:300ms">
          <Device src="/img/spa-cabines.webp" alt={tt('L’agenda du spa par cabine : deux cabines de massage, le hammam et le laser')} w={1200} h={878} eager />
        </div>
        <span class="shadow-in absolute bottom-[3%] end-[6%] h-4 w-[22%] rounded-[50%] bg-black/55 blur-lg" style="--d:900ms" aria-hidden="true"></span>
        <div class="drop absolute bottom-[4%] end-[5%] w-[25%]" style="--d:650ms"><Device kind="phone" src="/img/spa-rdv-phone.webp" alt={tt('La réservation en ligne du spa : hammam, massages, soins et laser')} w={600} h={1298} eager class="rotate-[3deg]" /></div>
        <div class="absolute start-[5%] top-[4%] z-10"><div class="tf-float"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:2300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-green text-navy sm:size-7"><Icon name="door" class="size-3.5 sm:size-4" /></span>Cabine Oasis libre à 15 h</p></div></div>
        <div class="absolute end-[4%] top-[14%] z-10 sm:top-[6%]"><div class="tf-float" style="--d:1200ms"><p class="chat-in flex items-center gap-2 rounded-full bg-green py-1.5 pe-3.5 ps-3 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:3300ms" aria-hidden="true"><span class="sl-live size-2 rounded-full bg-navy"></span>Hammam : 2 places sur 4</p></div></div>
        <div class="absolute bottom-[6%] start-[5%] z-10"><div class="tf-float" style="--d:2400ms"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:4300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-green text-navy sm:size-7"><Icon name="check" class="size-3.5 sm:size-4" /></span>Acompte reçu de Sofia</p></div></div>
      </div>
    </div>

    <!-- three facts -->
    <div class="border-y border-line bg-paper">
      <ul class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:py-6">
        {[['199', 'DH HT par mois, cabines comprises'], ['14', 'jours gratuits, sans engagement'], ['3', 'langues : français, arabe et anglais']].map(([n, l]) => (
          <li class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><span class="display text-5xl text-navy md:text-6xl" data-count={n} dir="ltr">{n}</span><span class="text-[0.78rem] leading-snug text-muted md:max-w-[13rem] md:text-[0.95rem]">{l}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- today / with Amplify -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="tf rounded-[2rem] bg-paper p-7 ring-1 ring-line">
        <p class="text-sm font-semibold text-muted">Aujourd’hui</p>
        <ul class="mt-4 space-y-3">{today.map((x, i) => <li class="tf-x flex gap-3 text-lg" style={`--d:${200 + i * 90}ms`}><span class="mt-2 size-2 shrink-0 rounded-full bg-muted/50"></span>{x}</li>)}</ul>
      </div>
      <div class="tf rounded-[2rem] bg-navy p-7 text-white" style="--d:120ms">
        <p class="text-sm font-semibold text-green">Avec Amplify</p>
        <ul class="mt-4 space-y-3">{withUs.map((x, i) => <li class="tf-x flex gap-3 text-lg" style={`--d:${320 + i * 90}ms`}><span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- the cabins -->
  <section id="cabines" class="relative isolate scroll-mt-20 overflow-hidden bg-navy text-white" data-tf>
    <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
    <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="tf-x">
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Les cabines.</span><span class="block text-green">Dans l’agenda.</span></h2>
          <p class="mt-5 max-w-md text-lg text-white/70">Un spa ne manque pas seulement de bras : il manque de cabines. Amplify regarde les deux avant de proposer un horaire, en ligne comme à l’accueil.</p>
        </div>
        <div class="tf relative pb-[14%] pe-[8%]" style="--d:150ms">
          <div class="overflow-hidden rounded-[2rem] ring-1 ring-white/10">
            <img src="/img/photos/spa-hammam-1376.webp" srcset="/img/photos/spa-hammam-800.webp 800w, /img/photos/spa-hammam-1376.webp 1376w" sizes="(min-width: 1024px) 560px, 100vw" alt="" width="1376" height="768" loading="lazy" class="aspect-[4/3] w-full object-cover" />
          </div>
          <div class="absolute bottom-0 end-0 w-[56%]"><div class="tf-float"><Device src="/img/spa-cabines.webp" alt={tt('La vue Cabines : une colonne par cabine, le hammam avec ses clientes côte à côte')} w={1200} h={878} /></div></div>
        </div>
      </div>
      <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {cabins.map(([i, h, x], k) => (
          <li class="tf" style={`--d:${k * 90}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-green ring-1 ring-white/15"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-white/65">{x}</p>
          </li>
        ))}
      </ul>
      <SpaCabins />
      <div class="mt-14 grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <Device src="/img/spa-prestations.webp" alt={tt('Les soins du spa : chacun avec sa cabine ou sa machine, et son acompte')} w={1200} h={878} />
        <div>
          <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">Quand rien n’est libre, l’accueil le sait.</p>
          <p class="mt-4 text-white/70">À l’accueil, une cabine déjà prise donne un avertissement, comme un rendez-vous qui se chevauche. Vous décidez : un autre horaire, ou enregistrer quand même.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- deposits -->
  <section id="acompte" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div class="tf-x">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">L’acompte.</span><span class="block text-green-deep">Le soin de 90 minutes est tenu.</span></h2>
        <p class="mt-5 max-w-md text-lg text-muted">La cliente voit le montant, le délai et comment payer, dès qu’elle a réservé. Pas payé à temps : le créneau revient en ligne, pour une autre cliente.</p>
      </div>
      <div class="tf relative pb-[10%] pe-[6%]" style="--d:150ms">
        <div class="overflow-hidden rounded-[2rem] ring-1 ring-line">
          <img src="/img/photos/spa-cabine-1376.webp" srcset="/img/photos/spa-cabine-800.webp 800w, /img/photos/spa-cabine-1376.webp 1376w" sizes="(min-width: 1024px) 520px, 100vw" alt="" width="1376" height="768" loading="lazy" class="aspect-[4/3] w-full object-cover object-right" />
        </div>
        <div class="absolute bottom-0 end-0 w-[34%]"><div class="tf-float"><Device kind="phone" src="/img/spa-acompte-phone.webp" alt={tt('La page de la cliente : l’acompte à payer, le délai, le RIB à copier et le bouton J’ai payé')} w={600} h={1298} class="-rotate-[2deg]" /></div></div>
      </div>
    </div>
    <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {deposit.map(([i, h, x], k) => (
        <li class="tf" style={`--d:${k * 90}ms`}>
          <span class="grid size-11 place-items-center rounded-2xl bg-green/15 text-green-deep"><Icon name={i} class="size-5" /></span>
          <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
        </li>
      ))}
    </ul>
    <p class="tf mt-10 max-w-3xl rounded-2xl bg-paper p-5 text-muted ring-1 ring-line">Le paiement en ligne automatique demande un contrat de votre spa avec CMI, PayZone ou YouCan Pay. Avec ce contrat, nous branchons la confirmation automatique. Sans, la cliente paie par virement, CashPlus ou votre lien, et vous confirmez en un clic.</p>
  </section>

  <!-- the till of the spa -->
  <PhotoBand name="spa-accueil" alt="" pos="70% 50%" w={1376} h={768} big="1376" kicker="À l’accueil" title="Tout ce qui se vend, au même endroit." class="pb-4 md:pb-8" />
  <section id="caisse" class="scroll-mt-20" data-tf>
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
      <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">La caisse du spa.</span><span class="block text-green-deep">Sans double saisie.</span></h2>
      <p class="tf mt-4 max-w-2xl text-lg text-muted" style="--d:100ms">La caisse reconnaît la cliente à son numéro : ses forfaits, son solde, ses tampons. Le même système que l’agenda.</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {till.map(([i, h, x], k) => (
          <li class="tf rounded-[1.75rem] bg-paper p-6 ring-1 ring-line" style={`--d:${k * 80}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-navy text-green"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- the cost of missed treatments, with the spa's own numbers -->
  <section id="calcul" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-noshow data-tf>
    <div class="tf-x mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div>
        <h2 class="text-[2.2rem] leading-[0.95] sm:text-[2.8rem]"><span class="block">Combien vous coûtent</span><span class="block text-green-deep">les soins manqués ?</span></h2>
        <p class="mt-4 text-muted">Faites le calcul avec vos propres chiffres. Rien n’est envoyé, tout reste sur votre téléphone.</p>
        <div class="mt-8 space-y-6">
          <label class="block"><span class="flex justify-between font-semibold"><span>Rendez-vous par semaine</span><span class="ns-v tabular-nums" data-for="rdv">30</span></span>
            <input type="range" min="5" max="200" step="5" value="30" data-k="rdv" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
          <label class="block"><span class="flex justify-between font-semibold"><span>Prix moyen d’un soin (DH)</span><span class="ns-v tabular-nums" data-for="prix">450</span></span>
            <input type="range" min="100" max="2000" step="50" value="450" data-k="prix" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
          <label class="block"><span class="flex justify-between font-semibold"><span>Rendez-vous manqués sur 100</span><span class="ns-v tabular-nums" data-for="taux">5</span></span>
            <input type="range" min="0" max="30" step="1" value="5" data-k="taux" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
        </div>
      </div>
      <div class="rounded-[2rem] bg-navy p-8 text-white">
        <p class="text-white/60">Chaque mois, les cabines restées vides représentent</p>
        <p class="mt-2"><span class="ns-out display text-6xl text-green tabular-nums" dir="ltr">2 903</span> <span class="text-2xl font-semibold">DH</span></p>
        <p class="mt-6 rounded-2xl bg-white/[0.07] p-4 text-white/80">La formule Spa complet, avec l’acompte, coûte 399 DH HT par mois.</p>
        <p class="mt-4 text-sm text-white/50">Calcul : rendez-vous par semaine × 4,3 semaines × rendez-vous manqués × prix moyen. Combien de ces absences un acompte évite dépend de vos clientes : nous ne promettons pas de chiffre.</p>
      </div>
    </div>
  </section>

  <!-- prices -->
  <section id="tarifs" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Trois formules.</span><span class="block text-green-deep">Cabines comprises.</span></h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">Prix HT par mois. Praticiennes et cabines illimitées. 14 jours gratuits, sans engagement. Nous installons tout pour vous.</p>
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {[plans[0], plans[1], plans[2]].map((p, k) => (
        <div style={`--d:${k * 110}ms`} class={`tf relative flex flex-col rounded-[2rem] p-7 ${p.featured ? 'bg-navy text-white shadow-[0_30px_60px_-30px_rgba(0,30,62,.6)] lg:-my-3' : 'bg-paper ring-1 ring-line'}`}>
          {p.featured && <span class="tf-ping absolute -top-3 start-7 rounded-full bg-green px-3 py-1 text-sm font-bold text-navy">{tt('Le plus complet')}</span>}
          <p class="display text-4xl">{p.name}</p>
          <p class={`mt-1 ${p.featured ? 'text-white/70' : 'text-muted'}`}>{p.for}</p>
          <p class="mt-6"><span class={`display text-6xl ${p.featured ? 'text-green' : ''}`} dir="ltr">{p.price}</span> <span class={p.featured ? 'text-white/60' : 'text-muted'}>DH HT / mois</span></p>
          {p.was && <p class="mt-1 text-sm text-white/60"><span class="line-through" dir="ltr">{p.was} DH</span> <span>si pris séparément</span></p>}
          <ul class="mt-6 flex-1 space-y-2.5">{p.items.map(x => <li class="flex gap-2.5"><span class={`mt-0.5 grid size-5 shrink-0 place-items-center rounded-full ${p.featured ? 'bg-green text-navy' : 'bg-green/15 text-green-deep'}`}><Icon name="check" class="size-3.5" /></span>{x}</li>)}</ul>
          <WaButton text={`${tt('Bonjour, la formule qui m’intéresse :')} ${p.name} (spa).`} label={tt('Demander une démo')} where={`spas-plan-${k}`} tone={p.featured ? 'green' : 'light'} class={`mt-7 w-full justify-center ${p.featured ? '' : 'ring-1 ring-line'}`} />
        </div>
      ))}
    </div>
    <div class="tf mt-10 rounded-[2rem] border-2 border-dashed border-line p-6 md:p-8" style="--d:120ms">
      <p class="font-semibold">Les modules en option</p>
      <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {modules.map(([n, pr, x, live]) => <div><p class="mb-2">{live ? <span class="rounded-full bg-green px-2.5 py-1 text-sm font-bold text-navy">Disponible</span> : <span class="rounded-full bg-[#F5B301] px-2.5 py-1 text-sm font-bold text-navy">Bientôt</span>}</p><p class="font-semibold">{n} <span class="text-sm font-normal text-muted">{pr}</span></p><p class="mt-1 text-sm text-muted">{x}</p></div>)}
      </div>
    </div>
  </section>

  <Faq lang={lang} items={faq} wa={wa} />

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="tf relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
      <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
      <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_70%_at_85%_50%,rgba(5,185,98,.25),transparent_70%)]" aria-hidden="true"></span>
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez-le avec vos cabines.</span><span class="block text-green">En 15 minutes.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp. Nous passons au spa, nous mettons vos soins, vos cabines et votre équipe, et vous essayez 14 jours gratuitement.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <WaButton text={wa} label={tt('Demander une démo')} where="spas-final" class="px-8 text-lg" />
        <a href={ROUTES.salons[lang]} class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold text-white ring-1 ring-white/25 hover:bg-white/10">Vous êtes un salon de coiffure ?</a>
      </div>
    </div>
  </section>
  <CountUp />
</Base>

<script>
  // the calculator: the spa's own numbers, nothing is sent
  document.querySelectorAll<HTMLElement>('[data-noshow]').forEach((root) => {
    const val = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value);
    const out = root.querySelector<HTMLElement>('.ns-out')!;
    const fmt = (n: number) => Math.round(n).toLocaleString('fr-FR').replace(/\u202f|\u00a0/g, ' ');
    const run = () => {
      root.querySelectorAll<HTMLElement>('.ns-v').forEach(v => { v.textContent = String(val(v.dataset.for!)); });
      out.textContent = fmt(val('rdv') * 4.3 * (val('taux') / 100) * val('prix'));
    };
    root.querySelectorAll('.ns-r').forEach(r => r.addEventListener('input', run));
    run();
  });
  // sections reveal as they scroll in
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  if (still || !('IntersectionObserver' in window)) roots.forEach((r) => r.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.18 });
    roots.forEach((r) => io.observe(r));
  }
</script>
