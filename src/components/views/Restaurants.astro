---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Proof from '../Proof.astro';
import Faq from '../Faq.astro';
import FinalCta from '../FinalCta.astro';
import Related from '../Related.astro';
import { copy } from '../../i18n';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const c = t.restaurants;
const schema = [serviceSchema(c.hero.h1, c.meta.description, abs(ROUTES.restaurants[lang])), faqSchema(c.faq)].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="restaurants" title={c.meta.title} description={c.meta.description} wa={c.wa} schema={schema}>
  <PageHero lang={lang} page="restaurants" h1={c.hero.h1} lead={c.hero.lead} wa={c.wa} shot={{ src: '/img/tables.webp', alt: 'Le plan de salle de la caisse avec les tables occupées', w: 1600, h: 937 }} />

  <section class="border-y border-line bg-paper">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 md:grid-cols-[1fr_2fr] md:gap-12">
      <h2 class="text-5xl md:text-6xl">{c.pains.h2}</h2>
      <ul class="grid gap-x-10 sm:grid-cols-2">
        {c.pains.items.map(p => <li class="border-t border-line py-5 text-lg">{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="text-5xl md:text-6xl">{c.solutions.h2}</h2>
    <p class="mt-3 text-muted">{c.solutions.p}</p>
    <ol class="mt-10 divide-y divide-line border-y border-line">
      {c.solutions.items.map(([h, p, page], i) => (
        <li>
          <a href={ROUTES[page][lang]} class="group grid grid-cols-[2.5rem_1fr] items-baseline gap-4 py-6 md:grid-cols-[2.5rem_1fr_1.4fr_auto] md:gap-8">
            <span class="text-lg font-semibold text-green-deep">{i + 1}</span>
            <h3 class="text-xl group-hover:text-green-deep">{h}</h3>
            <p class="col-start-2 text-muted md:col-start-auto">{p}</p>
            <span class="hidden text-sm text-muted group-hover:text-navy md:block">{t.nav[page]}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <Proof h2={c.proof.h2} ph={c.proof.ph} />
  <Related links={[[t.systems.hero.h1, ROUTES.systems[lang]], [t.marketing.hero.h1, ROUTES.marketing[lang]], [t.nav.contact, ROUTES.contact[lang]]]} />
  <Faq lang={lang} items={c.faq} />
  <FinalCta lang={lang} page="restaurants" h2={c.final.h2} p={c.final.p} wa={c.wa} />
</Base>
