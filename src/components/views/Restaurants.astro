---
// Restaurants page: one partner for the whole place. X-ray hero, a 10-second diagnostic that builds the
// plan, the three tools that talk to each other, priorities per trade, FAQ, and a final card that
// carries the visitor's diagnostic into WhatsApp.
import Base from '../../layouts/Base.astro';
import RsHero from '../RsHero.astro';
import RsDiag from '../RsDiag.astro';
import Proof from '../Proof.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import { copy } from '../../i18n';
import { rsFr as c } from '../../i18n/restaurants-fr';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const old = t.restaurants;
const schema = [serviceSchema(`${c.hero.h1a} ${c.hero.h1b}`, c.meta.description, abs(ROUTES.restaurants[lang])), faqSchema(c.faq)].filter(Boolean) as Record<string, unknown>[];
const TRIO = { pos: ['till', 'bg-blue text-white', ROUTES.pos[lang]], profit: ['chart', 'bg-green text-navy', ROUTES.profit[lang]], marketing: ['megaphone', 'bg-[#F5B301] text-navy', ROUTES.marketing[lang]] } as const;
const TYPE_IMG = { resto: 'metier-restaurant', cafe: 'metier-cafe', snack: 'metier-snack', the: 'metier-salon-the' } as const;
---
<Base lang={lang} page="restaurants" title={c.meta.title} description={c.meta.description} wa={c.wa} schema={schema}>
  <RsHero />

  <RsDiag lang={lang} />

  <!-- three tools that talk -->
  <section class="relative isolate overflow-hidden bg-navy py-24 text-white" data-rstrio>
    <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_60%_at_50%_100%,rgba(5,185,98,.22),transparent_70%)]" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.trio.h2a}</span><span class="block text-green">{c.trio.h2b}</span></h2>
      <p class="mt-4 max-w-2xl text-lg text-white/75">{c.trio.p}</p>
      <div class="mt-14 grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:gap-0">
        {c.trio.items.map((it, i) => (
          <>
            {i > 0 && (
              <div class="rt-link relative mx-auto flex h-14 w-1 items-center justify-center md:h-auto md:w-24" aria-hidden="true">
                <span class="rt-wire absolute inset-0 m-auto h-full w-1 rounded-full md:h-1 md:w-full"></span>
                <span class="rt-dot absolute size-3 rounded-full bg-green shadow-[0_0_12px_3px_rgba(5,185,98,.7)]"></span>
                <span class="relative z-10 rounded-full bg-navy px-2.5 py-1 text-xs font-bold text-green ring-1 ring-green/40">{c.trio.flows[i - 1]}</span>
              </div>
            )}
            <a href={TRIO[it.k as keyof typeof TRIO][2]} class="rt-card group relative flex flex-col rounded-[1.75rem] bg-white/[0.05] p-6 ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1.5 hover:bg-white/[0.09] hover:ring-green/50" style={`--d:${i * 150}ms`}>
              <span class={`grid size-14 place-items-center rounded-2xl ${TRIO[it.k as keyof typeof TRIO][1]}`}><Icon name={TRIO[it.k as keyof typeof TRIO][0] as any} class="size-7" /></span>
              <p class="mt-5 text-sm font-semibold text-green">{it.name}</p>
              <h3 class="display mt-1 text-4xl">{it.h}</h3>
              <p class="mt-2 flex-1 text-white/70">{it.p}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-green">{it.cta}<span class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" aria-hidden="true">→</span></span>
            </a>
          </>
        ))}
      </div>
      <p class="rt-loop mx-auto mt-8 flex w-fit items-center gap-2 rounded-full bg-white/[0.06] px-4 py-2 text-sm font-semibold text-white/80 ring-1 ring-white/10"><span class="text-green">↺</span>Chaque action marketing se mesure à la caisse.</p>
    </div>
  </section>

  <!-- per trade -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-rstypes>
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.types.h2a}</span><span class="block text-green-deep">{c.types.h2b}</span></h2>
    <div class="mt-10 flex flex-wrap gap-2" role="tablist" aria-label={c.types.h2a}>
      {c.types.items.map((it, i) => <button type="button" role="tab" class="ty-tab relative overflow-hidden rounded-full bg-paper px-5 py-2.5 font-semibold ring-1 ring-line transition-colors" data-k={it.k} aria-selected={i ? 'false' : 'true'}><span class="relative z-10">{it.t}</span><span class="ty-prog absolute inset-y-0 start-0 bg-green/25" aria-hidden="true"></span></button>)}
    </div>
    <div class="relative mt-6">
      {c.types.items.map((it, i) => (
        <div class={`ty-panel grid items-center gap-8 overflow-hidden rounded-[2rem] bg-paper ring-1 ring-line md:grid-cols-[1.25fr_1fr] ${i ? 'hidden' : ''}`} data-k={it.k} role="tabpanel">
          <div class="relative aspect-[4/3] overflow-hidden md:aspect-auto md:h-full md:min-h-[26rem]" aria-hidden="true">
            <img src={`/img/photos/${TYPE_IMG[it.k as keyof typeof TYPE_IMG]}-1600.webp`} srcset={`/img/photos/${TYPE_IMG[it.k as keyof typeof TYPE_IMG]}-800.webp 800w, /img/photos/${TYPE_IMG[it.k as keyof typeof TYPE_IMG]}-1600.webp 1536w`} sizes="(min-width: 768px) 640px, 100vw" alt="" width="1536" height="1024" loading="lazy" class="ty-img absolute inset-0 size-full object-cover" />
            <span class="absolute inset-0 bg-linear-to-t from-navy/50 to-transparent md:bg-linear-to-r md:from-transparent md:via-transparent md:to-paper/10"></span>
          </div>
          <div class="px-6 pb-8 md:px-0 md:py-10 md:pe-10">
            <h3 class="display text-5xl sm:text-6xl">{it.t}</h3>
            <ul class="mt-6 space-y-3">
              {it.pts.map((p, k) => <li class="ty-pt flex items-center gap-3 text-lg font-semibold" style={`--d:${150 + k * 140}ms`}><span class="grid size-7 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>{p}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Proof h2={old.proof.h2} ph={old.proof.ph} />

  <Faq lang={lang} items={c.faq} wa={c.wa} />

  <!-- final: carries the diagnostic -->
  <section class="px-4 pb-24 sm:px-6">
    <div class="relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14 lg:grid-cols-[1.2fr_1fr]" data-rsfin>
      <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_70%_at_85%_50%,rgba(5,185,98,.25),transparent_70%)]" aria-hidden="true"></span>
      <div>
        <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{c.final.h2a}</span><span class="block text-green">{c.final.h2b}</span></h2>
        <p class="mt-5 max-w-xl text-lg text-white/75">{c.final.p}</p>
        <div class="mt-8"><WaButton text={c.wa} label={c.final.cta} where="restaurants-final" class="rf-wa px-8 text-lg" /></div>
        <p class="rf-note mt-3 hidden text-sm text-green">✓ {c.final.chosen}</p>
      </div>
      <div class="rounded-[1.5rem] bg-white/5 p-5 ring-1 ring-white/15">
        <p class="text-sm font-semibold text-white/60">Votre diagnostic</p>
        <ul class="rf-list mt-3 space-y-2"></ul>
        <a href="#diagnostic" class="rf-empty mt-1 block rounded-xl border-2 border-dashed border-white/20 p-5 text-center font-semibold text-white/70 hover:border-green hover:text-white">Pas encore fait ? Faites-le en 10 secondes ↑</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // types: tabs that rotate by themselves until the visitor picks one
  document.querySelectorAll<HTMLElement>('[data-rstypes]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.ty-tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.ty-panel')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer = 0, auto = !still;
    const set = (k: number) => {
      i = k;
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === k)); t.classList.remove('run'); });
      panels.forEach((p, j) => { p.classList.toggle('hidden', j !== k); if (j === k) { p.classList.remove('ty-in'); void p.offsetWidth; p.classList.add('ty-in'); } });
      if (auto) { void tabs[k].offsetWidth; tabs[k].classList.add('run'); }
    };
    tabs.forEach((t, j) => t.addEventListener('click', () => { auto = false; clearInterval(timer); tabs.forEach(x => x.classList.remove('run')); set(j); }));
    if (!('IntersectionObserver' in window) || still) return;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && auto && !timer) { set(i); timer = window.setInterval(() => set((i + 1) % tabs.length), 3600); }
      else if (!e.isIntersecting) { clearInterval(timer); timer = 0; }
    }, { threshold: 0.4 }).observe(root);
  });
  // final card: shows the diagnostic and puts it in the WhatsApp message
  document.querySelectorAll<HTMLElement>('[data-rsfin]').forEach((root) => {
    const a = root.querySelector<HTMLAnchorElement>('.rf-wa')!;
    const list = root.querySelector<HTMLElement>('.rf-list')!;
    document.addEventListener('rs-diag', (e) => {
      const { text, items } = (e as CustomEvent).detail as { text: string; items: string[] };
      a.href = `https://wa.me/${a.href.split('wa.me/')[1].split('?')[0]}?text=${encodeURIComponent(text)}`;
      list.innerHTML = '';
      items.forEach(x => { const li = document.createElement('li'); li.className = 'flex items-start gap-2 rounded-xl bg-white/[0.06] px-3 py-2.5 text-sm font-semibold'; li.innerHTML = '<span class="text-green">●</span>'; li.append(document.createTextNode(x)); list.append(li); });
      root.querySelector('.rf-empty')!.classList.toggle('hidden', items.length > 0);
      root.querySelector('.rf-note')!.classList.toggle('hidden', items.length === 0);
    });
  });
</script>
