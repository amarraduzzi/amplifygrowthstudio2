---
// Salons page (coiffeurs, barbiers, instituts): shown by hand to the salons we visit, not in the menu
// and not in the sitemap yet. Same look as the restaurant pages. Real screenshots of the demo salon
// ("Salon Démo", invented names). No clients, reviews or results are claimed: the no-show calculator
// only works with the salon's own numbers.
import Base from '../../layouts/Base.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import { tr } from '../../i18n/t';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais voir Amplify pour mon salon.');
const today = [
  'Des clients qui attendent une heure sur une chaise, ou qui repartent.',
  'Les rendez-vous dans un cahier et dans des dizaines de messages WhatsApp.',
  'Des rendez-vous oubliés, et une place vide que personne n’a pu prendre.',
  'La formule couleur d’une cliente, dans la tête d’une seule coiffeuse.',
];
const withUs = [
  'Le client voit l’attente de chez lui et vient au bon moment.',
  'Un agenda par personne, sur le téléphone ou la tablette du salon.',
  'Un rappel la veille, en un geste, et le client confirme ou libère sa place.',
  'Chaque formule notée sur la fiche de la cliente, pour toute l’équipe.',
];
const nouba = [
  ['clock', 'L’attente en direct', 'Sur votre Instagram, votre Google et votre lien : « environ 20 à 30 min, 3 personnes ». Le client décide de venir maintenant ou plus tard.'],
  ['phone', 'Sa place, de chez lui', 'Il prend sa place en ligne, ou avec le QR à l’entrée. Quand son tour approche, vous le prévenez sur WhatsApp en un geste.'],
  ['scissors', 'Un bouton : Suivant', 'Chaque coiffeur appuie quand son fauteuil se libère. Le client suivant est appelé, l’attente se recalcule toute seule.'],
  ['tv', 'L’écran du salon', 'Sur une télé ou une tablette au mur : qui est au fauteuil, qui passe ensuite. Plus de dispute sur qui était là avant.'],
] as const;
const agenda = [
  ['calendar', 'La réservation en ligne', 'Une page à votre nom : la prestation, la personne ou « peu importe », un horaire vraiment libre. En français, en arabe et en anglais.'],
  ['bell', 'Le rappel de la veille', 'La liste des rendez-vous de demain, un message WhatsApp prêt pour chacun. Le client confirme ou annule, et la place se libère.'],
  ['users', 'L’agenda de l’équipe', 'Une colonne par personne, ses horaires, ses congés. Glissez un rendez-vous pour le déplacer. Sur ordinateur, tablette ou téléphone.'],
  ['flask', 'La fiche cliente', 'Ses visites, ses absences, ses allergies en rouge, et ses formules couleur : la prochaine couleur sera la même, avec n’importe quelle coiffeuse.'],
] as const;
const plans = [
  { name: 'Nouba', price: '149', for: 'Pour les barbiers et les salons sans rendez-vous.', items: ['L’attente en direct sur votre lien', 'Place en ligne ou avec le QR à l’entrée', 'Bouton « Suivant » par coiffeur', 'L’écran du salon', 'Prévenir le client sur WhatsApp', 'Fichier clients'] },
  { name: 'Salon', price: '299', for: 'Rendez-vous et clients sans rendez-vous, ensemble.', featured: true, items: ['Tout Nouba', 'Tout Agenda', 'L’attente tient compte des rendez-vous', 'Une seule équipe, un seul écran'] },
  { name: 'Agenda', price: '199', for: 'Pour les salons qui travaillent sur rendez-vous.', items: ['Agenda par personne, jour et semaine', 'Réservation en ligne avec votre QR', 'Rappels de la veille et confirmation du client', 'Fiche cliente, formules couleur et allergies', 'Historique des absences', 'Fichier clients'] },
];
const soon = [
  ['Site du salon', '+149 DH HT / mois', 'Vos prestations, vos prix, vos photos avant/après (avec l’accord de vos clientes), vos avis Google et le bouton de réservation.'],
  ['WhatsApp automatique', '+99 DH HT / mois', 'Les rappels et « bientôt votre tour » partent tout seuls. Les messages WhatsApp sont facturés à prix coûtant.'],
  ['Acompte', '+99 DH HT / mois', 'Un acompte pour les longues prestations : balayage, mariée, soins.'],
];
const faq = [
  ['Mes clients doivent-ils installer une application ?', 'Non. Ils ouvrent un lien ou scannent un QR. Rien à installer, rien à créer.'],
  ['Je travaille sans rendez-vous. C’est pour moi ?', 'Oui : c’est la formule Nouba. Vos clients voient l’attente et prennent leur place. Vous appuyez sur « Suivant ».'],
  ['Les rappels partent-ils tout seuls ?', 'Aujourd’hui, le salon envoie chaque rappel depuis son WhatsApp en un geste : le message et le lien sont prêts. L’envoi automatique arrive avec le module WhatsApp automatique.'],
  ['Combien de coiffeurs puis-je ajouter ?', 'Autant que vous voulez, dans toutes les formules.'],
  ['Mes clientes restent-elles à moi ?', 'Oui. Il n’y a pas de place de marché : votre page ne montre que votre salon, jamais un concurrent.'],
  ['Qui installe tout ?', 'Nous. Vos prestations, votre équipe, vos horaires et vos QR codes, et nous montrons tout à votre équipe. C’est offert.'],
  ['Et si j’arrête ?', 'Sans engagement : vous arrêtez d’un mois à l’autre. Les 14 premiers jours sont gratuits.'],
];
---
<Base lang={lang} page="salons" noindex title={tt('Amplify pour les salons de coiffure | Amplify Growth Studio')} description={tt('L’attente en direct, la réservation en ligne, les rappels WhatsApp et la fiche cliente avec les formules couleur. Pour les coiffeurs, barbiers et instituts à Rabat et Salé.')} wa={wa}>
  <!-- hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Coiffeurs, barbiers et instituts</p>
      <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Moins d’attente.</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:200ms">Moins d’oublis.</span></span>
      </h1>
      <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Vos clients voient l’attente de chez eux, prennent leur place ou réservent en ligne, et reçoivent un rappel la veille. Vous gardez la main sur tout, depuis le téléphone du salon.</p>
      <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
        <WaButton text={wa} label={tt('Demander une démo')} where="salons-hero" class="px-7 text-lg" />
        <a href="#tarifs" class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-paper">Voir les tarifs</a>
      </div>
    </div>
    <div class="relative pb-[10%] pe-[12%]">
      <Device src="/img/salon-agenda.webp" alt={tt('L’agenda du salon : une colonne par coiffeuse, les rendez-vous de la journée')} w={1200} h={878} eager />
      <div class="absolute bottom-0 end-0 w-[30%]"><Device kind="phone" src="/img/salon-nouba-phone.webp" alt={tt('Sur le téléphone du client : l’attente en direct et le bouton pour prendre sa place')} w={600} h={1298} class="rotate-[3deg]" /></div>
    </div>
  </section>

  <!-- today / with Amplify -->
  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 md:pb-24">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-[2rem] bg-paper p-7 ring-1 ring-line">
        <p class="text-sm font-semibold text-muted">Aujourd’hui</p>
        <ul class="mt-4 space-y-3">{today.map(x => <li class="flex gap-3 text-lg"><span class="mt-2 size-2 shrink-0 rounded-full bg-muted/50"></span>{x}</li>)}</ul>
      </div>
      <div class="rounded-[2rem] bg-navy p-7 text-white">
        <p class="text-sm font-semibold text-green">Avec Amplify</p>
        <ul class="mt-4 space-y-3">{withUs.map(x => <li class="flex gap-3 text-lg"><span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- la Nouba -->
  <section id="nouba" class="scroll-mt-20 bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div>
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">La Nouba.</span><span class="block text-green">L’attente en direct.</span></h2>
          <p class="mt-5 max-w-md text-lg text-white/70">« Nouba », c’est votre tour. Pour les barbiers et tous les salons où l’on vient sans rendez-vous : plus personne n’attend une heure sur une chaise.</p>
        </div>
        <div class="relative pb-[12%] pe-[10%]">
          <Device src="/img/salon-nouba-ecran.webp" alt={tt('L’écran du salon : qui est au fauteuil, qui passe ensuite')} w={1200} h={878} />
          <div class="absolute bottom-0 end-0 w-[30%]"><Device kind="phone" src="/img/salon-nouba-phone.webp" alt="" w={600} h={1298} class="rotate-[3deg]" /></div>
        </div>
      </div>
      <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {nouba.map(([i, h, x]) => (
          <li>
            <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-green ring-1 ring-white/15"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-white/65">{x}</p>
          </li>
        ))}
      </ul>
      <div class="mt-14 grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <Device src="/img/salon-nouba-suivant.webp" alt={tt('Pour le salon : chaque coiffeur et son bouton Suivant, la file avec l’attente estimée')} w={1200} h={878} />
        <div>
          <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">Une estimation honnête, toujours en fourchette.</p>
          <p class="mt-4 text-white/70">L’attente est calculée sur les coiffeurs qui travaillent maintenant, la durée des prestations et les rendez-vous de l’agenda. C’est une estimation : nous l’affichons toujours comme une fourchette, jamais comme une promesse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- l'agenda -->
  <section id="agenda" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Les rendez-vous.</span><span class="block text-green-deep">Sans cahier, sans oubli.</span></h2>
        <p class="mt-5 max-w-md text-lg text-muted">Vos clientes réservent seules, à toute heure, uniquement sur les horaires vraiment libres. Vous voyez tout dans l’agenda de l’équipe.</p>
      </div>
      <div class="relative pb-[10%] ps-[12%]">
        <Device src="/img/salon-fiche.webp" alt={tt('La fiche cliente : visites, allergie, formule couleur et historique')} w={1200} h={878} />
        <div class="absolute bottom-0 start-0 w-[30%]"><Device kind="phone" src="/img/salon-rdv-phone.webp" alt={tt('La réservation en ligne : le jour et l’heure, uniquement les horaires libres')} w={600} h={1298} class="-rotate-[3deg]" /></div>
      </div>
    </div>
    <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {agenda.map(([i, h, x]) => (
        <li>
          <span class="grid size-11 place-items-center rounded-2xl bg-green/15 text-green-deep"><Icon name={i} class="size-5" /></span>
          <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- the cost of no-shows, with the salon's own numbers -->
  <section id="calcul" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-noshow>
    <div class="mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div>
        <h2 class="text-[2.2rem] leading-[0.95] sm:text-[2.8rem]"><span class="block">Combien vous coûtent</span><span class="block text-green-deep">les rendez-vous manqués ?</span></h2>
        <p class="mt-4 text-muted">Faites le calcul avec vos propres chiffres. Rien n’est envoyé, tout reste sur votre téléphone.</p>
        <div class="mt-8 space-y-6">
          <label class="block"><span class="flex justify-between font-semibold"><span>Rendez-vous par semaine</span><span class="ns-v tabular-nums" data-for="rdv">40</span></span>
            <input type="range" min="5" max="200" step="5" value="40" data-k="rdv" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
          <label class="block"><span class="flex justify-between font-semibold"><span>Prix moyen d’une prestation (DH)</span><span class="ns-v tabular-nums" data-for="prix">150</span></span>
            <input type="range" min="30" max="800" step="10" value="150" data-k="prix" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
          <label class="block"><span class="flex justify-between font-semibold"><span>Rendez-vous manqués sur 100</span><span class="ns-v tabular-nums" data-for="taux">5</span></span>
            <input type="range" min="0" max="30" step="1" value="5" data-k="taux" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
        </div>
      </div>
      <div class="rounded-[2rem] bg-navy p-8 text-white">
        <p class="text-white/60">Chaque mois, les places restées vides représentent</p>
        <p class="mt-2"><span class="ns-out display text-6xl text-green tabular-nums" dir="ltr">1 290</span> <span class="text-2xl font-semibold">DH</span></p>
        <p class="mt-6 rounded-2xl bg-white/[0.07] p-4 text-white/80">La formule Agenda coûte 199 DH HT par mois.</p>
        <p class="mt-4 text-sm text-white/50">Calcul : rendez-vous par semaine × 4,3 semaines × rendez-vous manqués × prix moyen. Combien de ces absences un rappel évite dépend de vos clients : nous ne promettons pas de chiffre.</p>
      </div>
    </div>
  </section>

  <!-- prices -->
  <section id="tarifs" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24">
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Trois formules.</span><span class="block text-green-deep">Selon votre façon de travailler.</span></h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">Prix HT par mois. Coiffeurs illimités. 14 jours gratuits, sans engagement. Nous installons tout pour vous.</p>
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {plans.map(p => (
        <div class={`relative flex flex-col rounded-[2rem] p-7 ${p.featured ? 'bg-navy text-white shadow-[0_30px_60px_-30px_rgba(0,30,62,.6)] lg:-my-3' : 'bg-paper ring-1 ring-line'}`}>
          {p.featured && <span class="absolute -top-3 start-7 rounded-full bg-green px-3 py-1 text-sm font-bold text-navy">{tt('Le plus complet')}</span>}
          <p class="display text-4xl">{p.name}</p>
          <p class={`mt-1 ${p.featured ? 'text-white/70' : 'text-muted'}`}>{p.for}</p>
          <p class="mt-6"><span class={`display text-6xl ${p.featured ? 'text-green' : ''}`} dir="ltr">{p.price}</span> <span class={p.featured ? 'text-white/60' : 'text-muted'}>DH HT / mois</span></p>
          <ul class="mt-6 flex-1 space-y-2.5">{p.items.map(x => <li class="flex gap-2.5"><span class={`mt-0.5 grid size-5 shrink-0 place-items-center rounded-full ${p.featured ? 'bg-green text-navy' : 'bg-green/15 text-green-deep'}`}><Icon name="check" class="size-3.5" /></span>{x}</li>)}</ul>
          <WaButton text={`${tt('Bonjour, la formule qui m’intéresse :')} ${p.name}.`} label={tt('Demander une démo')} where={`salons-plan-${p.name.toLowerCase()}`} tone={p.featured ? 'green' : 'light'} class={`mt-7 w-full justify-center ${p.featured ? '' : 'ring-1 ring-line'}`} />
        </div>
      ))}
    </div>
    <div class="mt-10 rounded-[2rem] border-2 border-dashed border-line p-6 md:p-8">
      <p class="font-semibold"><span class="me-2 rounded-full bg-[#F5B301] px-2.5 py-1 text-sm font-bold text-navy">Bientôt</span>Les modules en option</p>
      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {soon.map(([n, pr, x]) => <div><p class="font-semibold">{n} <span class="text-sm font-normal text-muted">{pr}</span></p><p class="mt-1 text-sm text-muted">{x}</p></div>)}
      </div>
    </div>
  </section>

  <Faq lang={lang} items={faq} wa={wa} />

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_70%_at_85%_50%,rgba(5,185,98,.25),transparent_70%)]" aria-hidden="true"></span>
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez-le avec votre salon.</span><span class="block text-green">En 15 minutes.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp. Nous passons au salon, nous mettons vos prestations et votre équipe, et vous essayez 14 jours gratuitement.</p>
      <div class="mt-8"><WaButton text={wa} label={tt('Demander une démo')} where="salons-final" class="px-8 text-lg" /></div>
    </div>
  </section>
</Base>

<script>
  // the no-show calculator: the salon's own numbers, nothing is sent
  document.querySelectorAll<HTMLElement>('[data-noshow]').forEach((root) => {
    const val = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value);
    const out = root.querySelector<HTMLElement>('.ns-out')!;
    const fmt = (n: number) => Math.round(n).toLocaleString('fr-FR').replace(/ | /g, ' ');
    const run = () => {
      root.querySelectorAll<HTMLElement>('.ns-v').forEach(v => { v.textContent = String(val(v.dataset.for!)); });
      out.textContent = fmt(val('rdv') * 4.3 * (val('taux') / 100) * val('prix'));
    };
    root.querySelectorAll('.ns-r').forEach(r => r.addEventListener('input', run));
    run();
  });
</script>
