---
// Salons page (coiffeurs, barbiers, instituts): linked from the trades on the home page, the products
// menu and the footer. Same look as the restaurant pages. Real screenshots of the demo salon
// ("Salon Démo", invented names). No clients, reviews or results are claimed: the no-show calculator
// only works with the salon's own numbers.
import Base from '../../layouts/Base.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import CountUp from '../CountUp.astro';
import SalonNouba from '../SalonNouba.astro';
import SalonReminder from '../SalonReminder.astro';
import SecurityTrace from '../SecurityTrace.astro';
import { tr } from '../../i18n/t';
import { ROUTES } from '../../i18n/routes';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais voir Amplify pour mon salon.');
const today = [
  'Des clients qui attendent une heure sur une chaise, ou qui repartent.',
  'Les rendez-vous dans un cahier et dans des dizaines de messages WhatsApp.',
  'Des rendez-vous oubliés, et une place vide que personne n’a pu prendre.',
  'La formule couleur d’une cliente, dans la tête d’une seule coiffeuse.',
];
const withUs = [
  'Le client voit l’attente de chez lui et vient au bon moment.',
  'Un agenda par personne, sur le téléphone ou la tablette du salon.',
  'Un rappel la veille, en un geste, et le client confirme ou libère sa place.',
  'Chaque formule notée sur la fiche de la cliente, pour toute l’équipe.',
];
const nouba = [
  ['clock', 'L’attente en direct', 'Sur votre Instagram, votre Google et votre lien : « environ 20 à 30 min, 3 personnes ». Le client décide de venir maintenant ou plus tard.'],
  ['phone', 'Sa place, de chez lui', 'Il prend sa place en ligne, ou avec le QR à l’entrée. Quand son tour approche, vous le prévenez sur WhatsApp en un geste.'],
  ['scissors', 'Un bouton : Suivant', 'Chaque coiffeur appuie quand son fauteuil se libère. Le client suivant est appelé, l’attente se recalcule toute seule.'],
  ['tv', 'L’écran du salon', 'Sur une télé ou une tablette au mur : qui est au fauteuil, qui passe ensuite. Plus de dispute sur qui était là avant.'],
] as const;
const agenda = [
  ['calendar', 'La réservation en ligne', 'Une page à votre nom : la prestation, la personne ou « peu importe », un horaire vraiment libre. En français, en arabe et en anglais.'],
  ['bell', 'Le rappel de la veille', 'La liste des rendez-vous de demain, un message WhatsApp prêt pour chacun. Le client confirme ou annule, et la place se libère.'],
  ['users', 'L’agenda de l’équipe', 'Une colonne par personne, ses horaires, ses congés. Glissez un rendez-vous pour le déplacer. Sur ordinateur, tablette ou téléphone.'],
  ['flask', 'La fiche cliente', 'Ses visites, ses absences, ses allergies en rouge, et ses formules couleur : la prochaine couleur sera la même, avec n’importe quelle coiffeuse.'],
] as const;
const site = [
  ['scissors', 'Vos prestations et vos prix', 'Toujours à jour : vous changez un prix dans Amplify, le site suit. Avec le bouton de réservation sur chaque prestation.'],
  ['clock', 'L’attente en direct', 'Le visiteur voit combien de temps il faut attendre maintenant, et prend sa place depuis le site.'],
  ['heart', 'Avant, après', 'Il fait glisser pour comparer. Une photo n’apparaît que si la cliente a donné son accord.'],
  ['search', 'Fait pour Google', 'Un site rapide sur téléphone, en français, en arabe et en anglais, avec votre adresse, vos horaires et vos avis Google.'],
] as const;
const plans = [
  { name: 'Nouba', price: '149', for: 'Pour les barbiers et les salons sans rendez-vous.', items: ['L’attente en direct sur votre lien', 'Place en ligne ou avec le QR à l’entrée', 'Bouton « Suivant » par coiffeur', 'L’écran du salon', 'Prévenir le client sur WhatsApp', 'Fichier clients'] },
  { name: 'Salon', price: '299', for: 'Rendez-vous et clients sans rendez-vous, ensemble.', featured: true, items: ['Tout Nouba', 'Tout Agenda', 'L’attente tient compte des rendez-vous', 'Une seule équipe, un seul écran'] },
  { name: 'Agenda', price: '199', for: 'Pour les salons qui travaillent sur rendez-vous.', items: ['Agenda par personne, jour et semaine', 'Réservation en ligne avec votre QR', 'Rappels de la veille et confirmation du client', 'Fiche cliente, formules couleur et allergies', 'Historique des absences', 'Fichier clients'] },
];
const soon = [
  ['Site du salon', '+149 DH HT / mois', 'Vos prestations, vos prix, vos photos avant/après (avec l’accord de vos clientes), vos avis Google et le bouton de réservation.', 'live'],
  ['WhatsApp automatique', '+99 DH HT / mois', 'Les rappels et « bientôt votre tour » partent tout seuls. Les messages WhatsApp sont facturés à prix coûtant.'],
  ['Caisse et fidélité', '+149 DH HT / mois', 'Tickets, clôture du jour, produits et stock, commissions, forfaits, cartes cadeaux, tampons et avis clientes.', 'live'],
  ['Acompte', '+99 DH HT / mois', 'Un acompte pour les longues prestations : balayage, mariée, soins. Pas payé à temps, le créneau se libère.', 'live'],
];
const faq = [
  ['Mes clients doivent-ils installer une application ?', 'Non. Ils ouvrent un lien ou scannent un QR. Rien à installer, rien à créer.'],
  ['Je travaille sans rendez-vous. C’est pour moi ?', 'Oui : c’est la formule Nouba. Vos clients voient l’attente et prennent leur place. Vous appuyez sur « Suivant ».'],
  ['Les rappels partent-ils tout seuls ?', 'Aujourd’hui, le salon envoie chaque rappel depuis son WhatsApp en un geste : le message et le lien sont prêts. L’envoi automatique arrive avec le module WhatsApp automatique.'],
  ['Combien de coiffeurs puis-je ajouter ?', 'Autant que vous voulez, dans toutes les formules.'],
  ['Mes clientes restent-elles à moi ?', 'Oui. Il n’y a pas de place de marché : votre page ne montre que votre salon, jamais un concurrent.'],
  ['Qui installe tout ?', 'Nous. Vos prestations, votre équipe, vos horaires et vos QR codes, et nous montrons tout à votre équipe. C’est offert.'],
  ['Et si j’arrête ?', 'Sans engagement : vous arrêtez d’un mois à l’autre. Les 14 premiers jours sont gratuits.'],
];
---
<Base lang={lang} page="salons" title={tt('Amplify pour les salons de coiffure | Amplify Growth Studio')} description={tt('L’attente en direct, la réservation en ligne, les rappels WhatsApp et la fiche cliente avec les formules couleur. Pour les coiffeurs, barbiers et instituts à Rabat et Salé.')} wa={wa}>
  <!-- hero: the agenda lands, the client's phone drops, and the salon's day starts to move -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-14">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Coiffeurs, barbiers et instituts</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Moins d’attente.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Moins d’oublis.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Vos clients voient l’attente de chez eux, prennent leur place ou réservent en ligne, et reçoivent un rappel la veille. Vous gardez la main sur tout, depuis le téléphone du salon.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="salons-hero" class="px-7 text-lg" />
          <a href="#tarifs" class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-paper">Voir les tarifs</a>
        </div>
      </div>

      <div class="relative isolate aspect-[4/3.7] overflow-hidden rounded-[1.75rem] bg-navy lg:aspect-[5/4.7] lg:rounded-[2.25rem]">
        <span class="sl-scene absolute inset-0 -z-20" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
        <!-- the agenda lands -->
        <span class="shadow-in absolute start-[8%] top-[72%] h-6 w-[66%] rounded-[50%] bg-black/55 blur-xl" style="--d:700ms" aria-hidden="true"></span>
        <div class="land absolute start-[4%] top-[18%] w-[74%]" style="--d:300ms">
          <Device src="/img/salon-agenda.webp" alt={tt('L’agenda du salon : une colonne par coiffeuse, les rendez-vous de la journée')} w={1200} h={878} eager>
            <span class="glow absolute left-[80%] top-[9.5%] h-[5.5%] w-[17.5%] rounded-md ring-[3px] ring-green" style="--d:1500ms" aria-hidden="true"></span>
          </Device>
        </div>
        <!-- the client's phone drops -->
        <span class="shadow-in absolute bottom-[3%] end-[6%] h-4 w-[22%] rounded-[50%] bg-black/55 blur-lg" style="--d:900ms" aria-hidden="true"></span>
        <div class="drop absolute bottom-[4%] end-[5%] w-[25%]" style="--d:650ms"><Device kind="phone" src="/img/salon-nouba-phone.webp" alt={tt('Sur le téléphone du client : l’attente en direct et le bouton pour prendre sa place')} w={600} h={1298} eager class="rotate-[3deg]" /></div>
        <!-- the day moves: reminder, wait, a client takes a place -->
        <div class="absolute start-[5%] top-[4%] z-10"><div class="tf-float"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:2300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-green text-navy sm:size-7"><Icon name="bell" class="size-3.5 sm:size-4" /></span>Rappel envoyé à Leila</p></div></div>
        <div class="absolute end-[4%] top-[14%] z-10 sm:top-[6%]"><div class="tf-float" style="--d:1200ms"><p class="chat-in flex items-center gap-2 rounded-full bg-green py-1.5 pe-3.5 ps-3 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:3300ms" aria-hidden="true"><span class="sl-live size-2 rounded-full bg-navy"></span>Attente estimée : 20 à 30 min</p></div></div>
        <div class="absolute bottom-[6%] start-[5%] z-10"><div class="tf-float" style="--d:2400ms"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:4300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-green text-navy sm:size-7"><Icon name="check" class="size-3.5 sm:size-4" /></span>Maryam a pris sa place</p></div></div>
      </div>
    </div>

    <!-- three facts -->
    <div class="border-y border-line bg-paper">
      <ul class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:py-6">
        {[['149', 'DH HT par mois, dès la formule Nouba'], ['14', 'jours gratuits, sans engagement'], ['0', 'application à installer pour vos clients']].map(([n, l]) => (
          <li class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><span class="display text-5xl text-navy md:text-6xl" data-count={n} dir="ltr">{n}</span><span class="text-[0.78rem] leading-snug text-muted md:max-w-[13rem] md:text-[0.95rem]">{l}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- today / with Amplify -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="tf rounded-[2rem] bg-paper p-7 ring-1 ring-line">
        <p class="text-sm font-semibold text-muted">Aujourd’hui</p>
        <ul class="mt-4 space-y-3">{today.map((x, i) => <li class="tf-x flex gap-3 text-lg" style={`--d:${200 + i * 90}ms`}><span class="mt-2 size-2 shrink-0 rounded-full bg-muted/50"></span>{x}</li>)}</ul>
      </div>
      <div class="tf rounded-[2rem] bg-navy p-7 text-white" style="--d:120ms">
        <p class="text-sm font-semibold text-green">Avec Amplify</p>
        <ul class="mt-4 space-y-3">{withUs.map((x, i) => <li class="tf-x flex gap-3 text-lg" style={`--d:${320 + i * 90}ms`}><span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-green text-navy"><Icon name="check" class="size-4" /></span>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- la Nouba -->
  <section id="nouba" class="relative isolate scroll-mt-20 overflow-hidden bg-navy text-white" data-tf>
    <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
    <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="tf-x">
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">La Nouba.</span><span class="block text-green">L’attente en direct.</span></h2>
          <p class="mt-5 max-w-md text-lg text-white/70">« Nouba », c’est votre tour. Pour les barbiers et tous les salons où l’on vient sans rendez-vous : plus personne n’attend une heure sur une chaise.</p>
        </div>
        <div class="tf relative pb-[8%] pe-[10%]" style="--d:150ms">
          <div class="overflow-hidden rounded-[2rem] ring-1 ring-white/10">
            <img src="/img/photos/salon-barbier-1376.webp" srcset="/img/photos/salon-barbier-800.webp 800w, /img/photos/salon-barbier-1376.webp 1376w" sizes="(min-width: 1024px) 560px, 100vw" alt="" width="1376" height="768" loading="lazy" class="aspect-[4/3] w-full object-cover" />
          </div>
          <div class="absolute bottom-0 end-0 w-[30%]"><div class="tf-float"><Device kind="phone" src="/img/salon-nouba-phone.webp" alt="" w={600} h={1298} class="rotate-[3deg]" /></div></div>
        </div>
      </div>
      <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {nouba.map(([i, h, x], k) => (
          <li class="tf" style={`--d:${k * 90}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-green ring-1 ring-white/15"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-white/65">{x}</p>
          </li>
        ))}
      </ul>
      <SalonNouba />
      <div class="mt-14 grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <Device src="/img/salon-nouba-ecran.webp" alt={tt('L’écran du salon : qui est au fauteuil, qui passe ensuite')} w={1200} h={878} />
        <div>
          <p class="display text-3xl leading-[0.95] sm:text-[2.6rem]">Une estimation honnête, toujours en fourchette.</p>
          <p class="mt-4 text-white/70">L’attente est calculée sur les coiffeurs qui travaillent maintenant, la durée des prestations et les rendez-vous de l’agenda. C’est une estimation : nous l’affichons toujours comme une fourchette, jamais comme une promesse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- l'agenda -->
  <section id="agenda" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div class="tf-x">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Les rendez-vous.</span><span class="block text-green-deep">Sans cahier, sans oubli.</span></h2>
        <p class="mt-5 max-w-md text-lg text-muted">Vos clientes réservent seules, à toute heure, uniquement sur les horaires vraiment libres. Vous voyez tout dans l’agenda de l’équipe.</p>
      </div>
      <div class="tf relative pb-[10%] ps-[12%]" style="--d:150ms">
        <Device src="/img/salon-fiche.webp" alt={tt('La fiche cliente : visites, allergie, formule couleur et historique')} w={1200} h={878} />
        <div class="absolute bottom-0 start-0 w-[30%]"><div class="tf-float" style="--d:900ms"><Device kind="phone" src="/img/salon-rdv-phone.webp" alt={tt('La réservation en ligne : le jour et l’heure, uniquement les horaires libres')} w={600} h={1298} class="-rotate-[3deg]" /></div></div>
      </div>
    </div>
    <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {agenda.map(([i, h, x], k) => (
        <li class="tf" style={`--d:${k * 90}ms`}>
          <span class="grid size-11 place-items-center rounded-2xl bg-green/15 text-green-deep"><Icon name={i} class="size-5" /></span>
          <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
        </li>
      ))}
    </ul>
    <SalonReminder />
  </section>

  <!-- the salon's website -->
  <section id="site" class="scroll-mt-20 bg-paper" data-tf>
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="tf-x">
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Votre site.</span><span class="block text-green-deep">À votre nom.</span></h2>
          <p class="mt-5 max-w-md text-lg text-muted">Un vrai site pour votre salon, sans rien construire : il se remplit tout seul avec vos prestations, votre équipe, vos horaires et l’attente en direct.</p>
          <a href="https://site.amplifygrowthstudio.com/salon-demo" target="_blank" rel="noopener" class="mt-6 inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-bg">Voir un exemple</a>
        </div>
        <div class="tf relative pb-[10%] pe-[10%]" style="--d:150ms">
          <Device src="/img/salon-site.webp" alt={tt('Le site du salon : la photo du salon, la réservation et l’attente en direct')} w={1200} h={878} />
          <div class="absolute bottom-0 end-0 w-[30%]"><div class="tf-float" style="--d:900ms"><Device kind="phone" src="/img/salon-site-phone.webp" alt={tt('Le site du salon sur téléphone')} w={600} h={1298} class="rotate-[3deg]" /></div></div>
        </div>
      </div>
      <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {site.map(([i, h, x], k) => (
          <li class="tf" style={`--d:${k * 90}ms`}>
            <span class="grid size-11 place-items-center rounded-2xl bg-green/15 text-green-deep"><Icon name={i} class="size-5" /></span>
            <p class="mt-4 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
          </li>
        ))}
      </ul>
      <p class="tf mt-10 text-muted">Module en option : <b class="text-navy">+149 DH HT / mois</b>, avec n’importe quelle formule.</p>
    </div>
  </section>

  <SecurityTrace sector="salon" />

  <!-- spas and instituts have their own page -->
  <section class="px-4 pb-14 sm:px-6 md:pb-20" data-tf>
    <a href={ROUTES.spas[lang]} class="tf group mx-auto flex max-w-6xl flex-wrap items-center gap-4 rounded-[2rem] bg-paper p-6 ring-1 ring-line transition hover:ring-green/60 md:p-8">
      <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-navy text-green"><Icon name="leaf" class="size-6" /></span>
      <span class="min-w-0 flex-1"><span class="display block text-2xl leading-tight sm:text-3xl">Un spa, un hammam ou un institut ?</span><span class="mt-1 block text-muted">Les cabines, le hammam et les machines dans l’agenda : une page rien que pour vous.</span></span>
      <span class="font-semibold text-green-deep">Voir la page spas <span class="inline-block transition-transform group-hover:translate-x-1 rtl:-scale-x-100">→</span></span>
    </a>
  </section>

  <!-- the cost of no-shows, with the salon's own numbers -->
  <section id="calcul" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-noshow data-tf>
    <div class="tf-x mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div>
        <h2 class="text-[2.2rem] leading-[0.95] sm:text-[2.8rem]"><span class="block">Combien vous coûtent</span><span class="block text-green-deep">les rendez-vous manqués ?</span></h2>
        <p class="mt-4 text-muted">Faites le calcul avec vos propres chiffres. Rien n’est envoyé, tout reste sur votre téléphone.</p>
        <div class="mt-8 space-y-6">
          <label class="block"><span class="flex justify-between font-semibold"><span>Rendez-vous par semaine</span><span class="ns-v tabular-nums" data-for="rdv">40</span></span>
            <input type="range" min="5" max="200" step="5" value="40" data-k="rdv" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
          <label class="block"><span class="flex justify-between font-semibold"><span>Prix moyen d’une prestation (DH)</span><span class="ns-v tabular-nums" data-for="prix">150</span></span>
            <input type="range" min="30" max="800" step="10" value="150" data-k="prix" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
          <label class="block"><span class="flex justify-between font-semibold"><span>Rendez-vous manqués sur 100</span><span class="ns-v tabular-nums" data-for="taux">5</span></span>
            <input type="range" min="0" max="30" step="1" value="5" data-k="taux" class="ns-r mt-2 w-full accent-[#05B962]" /></label>
        </div>
      </div>
      <div class="rounded-[2rem] bg-navy p-8 text-white">
        <p class="text-white/60">Chaque mois, les places restées vides représentent</p>
        <p class="mt-2"><span class="ns-out display text-6xl text-green tabular-nums" dir="ltr">1 290</span> <span class="text-2xl font-semibold">DH</span></p>
        <p class="mt-6 rounded-2xl bg-white/[0.07] p-4 text-white/80">La formule Agenda coûte 199 DH HT par mois.</p>
