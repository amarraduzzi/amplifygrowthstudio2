---
// Systems: the overview of the two products, each with its own page.
import Base from '../../layouts/Base.astro';
import Device from '../Device.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import FinalCta from '../FinalCta.astro';
import Related from '../Related.astro';
import { signupUrl } from '../../config';
import { copy } from '../../i18n';
import { posFr } from '../../i18n/products-fr';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const c = t.systems;
const h = c.hub;
const products = [
  { key: 'pos' as const, data: posFr.products.pos, price: '199', img: '/img/tour-caisse.webp', w: 2400, h: 1406, items: c.pos.items.slice(0, 5).map(x => x[0]), dark: true },
  { key: 'profit' as const, data: posFr.products.profit, price: '249', img: '/img/tour-marges.webp', w: 2188, h: 1116, items: c.profit.items.map(x => x[0]), dark: false },
];
const schema = [serviceSchema(`${h.h1a} ${h.h1b}`, c.meta.description, abs(ROUTES.systems[lang])), faqSchema(c.faq)].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="systems" title={c.meta.title} description={c.meta.description} wa={c.wa} schema={schema}>
  <section class="mx-auto max-w-6xl px-4 pb-10 pt-10 sm:px-6 md:pt-16">
    <h1 class="text-[clamp(3rem,7vw,6rem)]">
      <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:60ms">{h.h1a}</span></span>
      <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:180ms">{h.h1b}</span></span>
    </h1>
    <p class="fade-up mt-5 max-w-2xl text-lg text-muted md:text-xl" style="--d:300ms">{h.lead}</p>
  </section>

  <!-- the two products -->
  <section class="mx-auto grid max-w-6xl gap-5 px-4 pb-20 sm:px-6 lg:grid-cols-2">
    {products.map((pr, i) => (
      <article class={`fade-up flex flex-col overflow-hidden rounded-[2rem] ${pr.dark ? 'bg-navy text-white' : 'bg-paper ring-1 ring-line'}`} style={`--d:${350 + i * 120}ms`}>
        <div class={`px-6 pt-6 sm:px-8 sm:pt-8 ${pr.dark ? 'bg-blue' : 'bg-mint'}`}>
          <Device src={pr.img} alt={pr.data.text} w={pr.w} h={pr.h} eager class="translate-y-6" />
        </div>
        <div class="flex flex-1 flex-col p-6 pt-10 sm:p-8 sm:pt-12">
          <p class={`text-sm font-semibold ${pr.dark ? 'text-green' : 'text-green-deep'}`}>{pr.data.tag}</p>
          <h2 class="mt-1 text-5xl sm:text-6xl">{pr.data.name}</h2>
          <p class={`mt-3 ${pr.dark ? 'text-white/75' : 'text-muted'}`}>{pr.data.text}</p>
          <ul class="mt-5 flex-1 space-y-2">
            {pr.items.map(it => <li class="flex gap-2"><Icon name="check" class={`mt-0.5 size-5 shrink-0 ${pr.dark ? 'text-green' : 'text-green-deep'}`} />{it}</li>)}
          </ul>
          <p class="mt-6 flex items-baseline gap-2"><span class={`text-sm ${pr.dark ? 'text-white/60' : 'text-muted'}`}>{h.from}</span><span class="display text-5xl" dir="ltr">{pr.price}</span><span class={`text-sm ${pr.dark ? 'text-white/60' : 'text-muted'}`}>{h.per}</span></p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={ROUTES[pr.key][lang]} class={`inline-flex min-h-12 items-center rounded-full px-6 font-semibold ${pr.dark ? 'bg-green text-navy hover:bg-[#04A859]' : 'bg-navy text-white hover:bg-blue'}`}>{h.discover} {pr.data.name}</a>
            <a href={signupUrl(lang, pr.key === 'profit' ? 'profit' : undefined)} class={`inline-flex min-h-12 items-center rounded-full border px-6 ${pr.dark ? 'border-white/30 hover:border-white' : 'border-navy/25 hover:border-navy'}`}>{h.trial}</a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- together -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <p class="flex gap-4 rounded-[1.75rem] bg-mint p-6 text-lg font-medium sm:p-8"><Icon name="check" class="mt-1 size-6 shrink-0 text-green-deep" />{posFr.products.together}</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="text-5xl md:text-6xl">{c.compare.h2}</h2>
    <div class="mt-8 overflow-hidden rounded-3xl border border-line bg-paper">
      <table class="w-full text-start">
        <thead><tr class="border-b border-line text-sm text-muted"><th class="w-1/2 px-5 py-3 text-start font-medium">{c.compare.before}</th><th class="px-5 py-3 text-start font-medium text-green-deep">{c.compare.after}</th></tr></thead>
        <tbody class="divide-y divide-line">
          {c.compare.rows.map(([b, a]) => <tr><td class="px-5 py-4 text-muted line-through decoration-muted/40">{b}</td><td class="px-5 py-4 font-medium">{a}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <Related links={[[t.nav.pos, ROUTES.pos[lang]], [t.nav.profit, ROUTES.profit[lang]], [t.nav.features, ROUTES.features[lang]], [t.restaurants.hero.h1, ROUTES.restaurants[lang]]]} />
  <Faq lang={lang} items={c.faq} />
  <FinalCta lang={lang} page="systems" h2={c.final.h2} p={c.final.p} wa={c.wa} />
</Base>
