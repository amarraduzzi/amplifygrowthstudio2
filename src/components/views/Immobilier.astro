---
// Real estate page (Amplify Immobilier): agencies, rental management, syndics, developers.
// Hero: the question "vous êtes…" with four photo cards that open the right tab; then one apartment followed
// from the mandate to the commission (ImmoParcours); then the tabs per profession, the law, WhatsApp.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import ImmoMetiers from '../ImmoMetiers.astro';
import ImmoParcours from '../ImmoParcours.astro';
import { tr } from '../../i18n/t';
import { ROUTES, type Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais une démo d’Amplify Immobilier.');
const who = [
  ['agent', 'p-agent', tt('Agent indépendant'), tt('Vos biens, vos clients, vos visites signées.')],
  ['agences', 'p-agence', tt('Agence immobilière'), tt('Chaque lead suivi, chaque vente jusqu’à la commission.')],
  ['courte-duree', 'p-cles', tt('Location courte durée'), tt('Réservé sans les dix messages.')],
  ['location', 'p-syndic', tt('Gestion, syndic, promoteur'), tt('Loyers, charges, lots et chantiers.')],
] as const;
// block "droit marocain": only what the product does, stated as such (no promise of legal compliance)
const laws = [
  ['Loi 18-00', 'Copropriété', 'Lots, tantièmes, appels de fonds répartis au centime, votes de l’assemblée par tantièmes et procès-verbal en PDF.'],
  ['Loi 67-12', 'Révision du loyer', 'Pas de révision avant trois ans après le début du bail ou la dernière hausse. L’application plafonne la hausse à 8 % pour l’habitation et 10 % pour les autres usages, et propose le montant.'],
  ['Loi 107-12', 'Vente sur plan (VEFA)', '5 % au contrat préliminaire, des paiements par étape du chantier, 20 % à la remise des clés. L’application refuse plus de 5 % au départ et moins de 20 % aux clés.'],
  ['Loi 09-08', 'Données personnelles', 'Un client n’est recommandé à une autre agence qu’avec son accord. Sur vos pages publiques, jamais d’adresse exacte, de propriétaire ni de notes internes.'],
  ['Article 145 du CGI', 'Factures', 'Numéro continu et sans trou, ICE, IF, RC, taxe professionnelle, HT, TVA et TTC, montant en lettres. Une facture émise ne se modifie plus.'],
];
// block "WhatsApp partout": one click opens WhatsApp with the message written, nothing is sent automatically
const uses = [
  ['Loyers en retard', 'Une relance polie au locataire, avec le mois et le montant.', 'Mme Alami', 'Bonjour Mme Alami, le loyer d’octobre (4 500 DH) n’est pas encore arrivé. Merci de le régler dès que possible.'],
  ['Visites', 'Un rappel envoyé au client avant le rendez-vous.', 'M. Tazi', 'Bonjour M. Tazi, je vous rappelle la visite de demain à 17 h 30 : l’appartement de 3 chambres à Agdal. À demain !'],
  ['Biens pour vos clients', 'Les biens qui correspondent à sa recherche, avec les liens, dans sa langue.', 'Yasmine', 'Bonjour Yasmine, trois biens correspondent à votre recherche à Agdal. Les photos et les visites : atlas-immo.ma/P-AB12'],
  ['Propriétaires', 'Le relevé du mois ou le point sur leur bien, avec un lien privé pour suivre le reste.', 'M. Benjelloun', 'Bonjour M. Benjelloun, votre relevé d’octobre est prêt : loyer reçu 4 500 DH, honoraires 360 DH. Tout le détail sur votre lien privé.'],
  ['Copropriétaires', 'Relance des impayés, convocation à l’assemblée, annonces de la résidence.', 'Les Orangers', 'Bonjour, l’assemblée générale de la résidence Les Orangers aura lieu le 15 novembre à 18 h. Votre présence compte.'],
  ['Acheteurs', 'Un appel de fonds ou un rappel d’échéance, ou tous les acheteurs prévenus d’un coup à chaque étape du chantier.', 'M. Naciri', 'Bonjour M. Naciri, le gros œuvre de la Résidence Les Orangers est terminé. L’appel de fonds de 380 000 DH est prêt, avec le RIB.'],
];
---
<Base lang={lang} page="immobilier" title={tt('Amplify Immobilier : le logiciel de l’immobilier au Maroc | Amplify Growth Studio')} description={tt('Un seul système pour les agences, la gestion locative, les syndics et les promoteurs. En français et en arabe, sur téléphone et ordinateur, avec WhatsApp.')} wa={wa}>
  <!-- hero: the promise left, "vous êtes…" right, four photo cards that open the right tab -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-14 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-20">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Immobilier</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{tt('Vendez, louez, gérez.')}</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">{tt('Sans rien laisser filer.')}<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">{tt('Le client qui achète sans vous, le loyer oublié, les dix messages pour une nuit : c’est fini. Vos biens, vos clients, vos visites signées, vos loyers et vos réservations, sur le téléphone, avec WhatsApp.')}</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <a href="#parcours" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-navy px-7 text-lg font-semibold text-white transition-transform hover:-translate-y-0.5">{tt('Voir comment ça marche')}<span aria-hidden="true">↓</span></a>
          <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-hero" tone="light" class="px-6 ring-1 ring-line" />
        </div>
      </div>

      <div>
        <p class="fade-up text-sm font-bold text-muted" style="--d:350ms">{tt('Vous êtes…')}</p>
        <div class="mt-3 grid grid-cols-2 gap-3 sm:gap-4">
          {who.map(([k, img, h, x], i) => (
            <a href={k === 'agent' ? ROUTES.immoAgent[lang] : k === 'courte-duree' ? ROUTES.immoStay[lang] : `#${k}`} class="ih-card group relative isolate block aspect-[4/5] overflow-hidden rounded-[1.6rem] text-white shadow-[0_30px_60px_-35px_rgba(0,30,62,0.7)] sm:aspect-[4/4.4]" style={`--i:${i}`}>
              <img src={`/img/immo/${img}-700.webp`} srcset={`/img/immo/${img}-700.webp 700w, /img/immo/${img}.webp 1200w`} sizes="(min-width: 1024px) 300px, 50vw" alt="" width="1200" height="896" loading={i < 2 ? 'eager' : 'lazy'} class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-700 group-hover:scale-105" style={`object-position:${img === 'p-agent' ? '38% 50%' : '50% 50%'}`} />
              <span class="absolute inset-0 -z-10 bg-linear-to-t from-navy via-navy/45 to-transparent"></span>
              <span class="absolute inset-x-0 bottom-0 p-3.5 sm:p-5">
                <span class="display block text-[1.35rem] leading-[0.95] sm:text-[1.7rem]">{h}</span>
                <span class="mt-1.5 hidden text-sm leading-snug text-white/80 sm:block">{x}</span>
                <span class="mt-2 inline-flex size-8 items-center justify-center rounded-full bg-green text-navy transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" aria-hidden="true"><span class="rtl:-scale-x-100">→</span></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- one apartment, from the mandate to the commission: the screen follows as you scroll -->
  <section id="parcours" class="scroll-mt-20 border-y border-line bg-paper py-14 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Un appartement à Agdal.')}</span><span class="block text-green-deep">{tt('Du mandat à la commission.')}</span></h2>
        <p class="mt-5 max-w-2xl text-lg text-muted">{tt('Suivez-le pas à pas : à chaque étape, voici ce que vous voyez sur votre téléphone.')}</p>
      </div>
      <div class="mt-10 md:mt-14"><ImmoParcours /></div>
    </div>
  </section>

  <!-- the promise, word by word as you scroll -->
  <section class="px-4 py-14 sm:px-6 md:py-24">
    <p class="mx-auto max-w-5xl text-[clamp(2rem,4.6vw,3.8rem)] font-semibold leading-[1.08] tracking-tight" data-scrub="words">{tt('Un bien, un client, un loyer, une copropriété, un chantier : tout est suivi, et chaque message part sur WhatsApp en un clic.').split(' ').map(w => <span class="word">{w} </span>)}</p>
  </section>

  <!-- who it is for: one tab per profession, with a live demo -->
  <section id="pour-qui" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-6 sm:px-6 md:pb-10">
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Chaque métier,')}</span><span class="block text-green-deep">{tt('ses propres outils.')}</span></h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">{tt('Choisissez votre métier et essayez : tout ce qui bouge ici se touche.')}</p>
    <div class="mt-8"><ImmoMetiers /></div>
  </section>

  <!-- Moroccan law: what the product does, not a legal promise -->
  <section id="droit" class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
    <div class="mx-auto max-w-6xl rounded-[2.5rem] bg-navy p-6 text-white md:p-12">
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-10">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white ring-1 ring-white/15"><span class="size-2 rounded-full bg-green"></span>{tt('Droit marocain')}</p>
          <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Les règles marocaines,')}</span><span class="block text-green">{tt('déjà dans l’outil.')}</span></h3>
        </div>
        <p class="max-w-xl text-lg text-white/75 lg:pt-12">{tt('Les lois de votre métier sont prises en compte dans l’application. Elle vous aide à les suivre, elle ne remplace pas votre notaire ni votre juriste.')}</p>
      </div>
      <ol class="lw-tl relative mt-10 space-y-8 ps-12" data-scrub="steps">
        <span class="absolute start-[15px] top-2 bottom-2 w-0.5 rounded bg-white/10" aria-hidden="true"></span>
        <span class="flow-y absolute start-[15px] top-2 bottom-2 w-0.5 rounded bg-green" aria-hidden="true"></span>
        {laws.map(([law, t, x]) => (
          <li class="step relative">
            <span class="node absolute -start-12 top-0 grid size-8 place-items-center rounded-full bg-green text-navy transition-all duration-300"><Icon name="shield" class="size-4" /></span>
            <div class="lw-body grid gap-1 md:grid-cols-[13rem_1fr] md:gap-8">
              <p class="display text-2xl text-green">{tt(law)}</p>
              <div><p class="font-semibold">{tt(t)}</p><p class="mt-1 max-w-2xl text-[0.95rem] leading-relaxed text-white/65">{tt(x)}</p></div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WhatsApp everywhere: one click, message ready, nothing sent automatically -->
  <section id="whatsapp" class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
    <div class="mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-chalk px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt('WhatsApp partout')}</p>
        <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Un clic.')}</span><span class="block text-green-deep">{tt('Le message est prêt.')}</span></h3>
        <p class="mt-5 max-w-xl text-lg text-muted">{tt('Relances, convocations, rapports et annonces : WhatsApp s’ouvre avec le message déjà écrit, en français, en arabe ou en anglais. Vous relisez, vous envoyez. Rien ne part sans vous.')}</p>
        <ul class="mt-8 space-y-2" role="list" data-wa-uses>
          {uses.map(([t, x, who, m], i) => (
            <li>
              <button type="button" class="wu-b grid w-full gap-1 rounded-2xl px-4 py-3 text-start ring-1 ring-line transition-colors sm:grid-cols-[11rem_1fr] sm:gap-6" data-who={tt(who)} data-m={tt(m)} aria-pressed={i ? 'false' : 'true'}>
                <span class="font-semibold">{tt(t)}</span>
                <span class="text-[0.95rem] leading-relaxed text-muted">{tt(x)}</span>
              </button>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[0.95rem] font-semibold text-green-deep">{tt('Et vos visiteurs aussi : chaque page de bien a son bouton WhatsApp.')}</p>
      </div>
      <!-- the phone: the chosen message types itself -->
      <div class="self-start lg:sticky lg:top-28" data-wa-phone>
        <div class="mx-auto max-w-[22rem] rounded-[2.6rem] bg-linear-to-b from-[#3A3F47] to-[#1C1F24] p-2 shadow-[0_40px_70px_-30px_rgba(0,0,0,.6)]">
          <div class="overflow-hidden rounded-[2.2rem] bg-[#ECE5DD]">
            <div class="flex items-center gap-3 bg-[#075E54] px-4 pb-3 pt-6 text-white">
              <span class="grid size-9 place-items-center rounded-full bg-white/20 text-sm font-bold" data-wa-init>A</span>
              <span class="min-w-0"><span class="block truncate font-semibold" data-wa-who>Mme Alami</span><span class="block text-xs text-white/70" data-wa-state>{tt('en ligne')}</span></span>
            </div>
            <div class="flex min-h-[19rem] flex-col justify-end gap-2 px-3 py-4">
              <p class="wa-bub ms-auto max-w-[88%] rounded-2xl rounded-se-sm bg-[#DCF8C6] px-3 py-2 text-[0.9rem] leading-relaxed text-navy shadow-sm"><span data-wa-text></span><span class="wa-caret" aria-hidden="true">|</span><span class="ms-2 inline-block align-bottom text-[0.65rem] text-navy/50" dir="ltr">10:24 ✓✓</span></p>
            </div>
            <div class="flex items-center gap-2 bg-[#F0F0F0] px-3 py-2.5">
              <span class="flex-1 rounded-full bg-white px-4 py-2 text-sm text-muted">{tt('Vous relisez, vous envoyez.')}</span>
              <span class="grid size-10 place-items-center rounded-full bg-[#00A884] text-white"><Icon name="phone" class="size-4" /></span>
            </div>
          </div>
        </div>
        <p class="mt-3 text-center text-xs text-muted">{tt('Exemple : choisissez un message à gauche.')}</p>
      </div>
    </div>
  </section>

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 pt-10 sm:px-6 md:pb-24 md:pt-16">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez Amplify Immobilier</span><span class="block text-green">avec votre activité.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp et dites-nous si vous êtes une agence, un syndic ou un promoteur. Nous vous faisons la démonstration.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-final" class="px-8 text-lg" />
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .ih-card { transition: opacity .7s, transform .9s cubic-bezier(.2,.8,.2,1), box-shadow .3s; transition-delay: calc(var(--i) * .1s + .35s); }
  .js .ih-card { animation: ih-in .9s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i) * .1s + .35s); }
  @keyframes ih-in { from { opacity: 0; transform: translateY(28px) scale(.97); } }
  @media (prefers-reduced-motion: reduce) { .js .ih-card { animation: none; } }
  .wu-b[aria-pressed="true"] { background: var(--color-navy); color: #fff; box-shadow: none; }
  .wu-b[aria-pressed="true"] span:last-child { color: rgb(255 255 255 / .7); }
  .wu-b:not([aria-pressed="true"]):hover { background: var(--color-chalk); }
  .wa-caret { animation: wa-blink .8s steps(1) infinite; color: var(--color-green-deep); }
  [data-wa-phone].done .wa-caret { display: none; }
  @keyframes wa-blink { 50% { opacity: 0; } }
  .js .lw-tl .step:not(.on) .node { background: #1A3355; color: rgb(255 255 255 / .4); box-shadow: none; transform: scale(.85); }
  .lw-body { transition: opacity .5s, transform .5s; }
  .js .lw-tl .step:not(.on) .lw-body { opacity: .3; transform: translateX(8px); }
  @media (prefers-reduced-motion: reduce) { .wa-caret { animation: none; } .js .lw-tl .step .lw-body { opacity: 1; transform: none; } }
</style>

<script>
  // WhatsApp: pick a use, the message types itself in the phone (instantly with reduced motion)
  document.querySelectorAll<HTMLElement>('[data-wa-uses]').forEach((list) => {
    const phone = list.closest('section')!.querySelector<HTMLElement>('[data-wa-phone]')!;
    const out = phone.querySelector<HTMLElement>('[data-wa-text]')!;
    const who = phone.querySelector<HTMLElement>('[data-wa-who]')!, init = phone.querySelector<HTMLElement>('[data-wa-init]')!;
    const btns = [...list.querySelectorAll<HTMLButtonElement>('.wu-b')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0, i = 0, auto = 0, touched = false;
    const type = (b: HTMLButtonElement) => {
      btns.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      who.textContent = b.dataset.who ?? ''; init.textContent = (b.dataset.who ?? '?').replace(/^(M\.|Mme)\s*/, '').charAt(0);
      const m = b.dataset.m ?? ''; clearInterval(timer); phone.classList.remove('done');
      if (still) { out.textContent = m; phone.classList.add('done'); return; }
      let k = 0; out.textContent = '';
      timer = window.setInterval(() => { k += 2; out.textContent = m.slice(0, k); if (k >= m.length) { clearInterval(timer); phone.classList.add('done'); } }, 22);
    };
    btns.forEach((b, n) => b.addEventListener('click', () => { touched = true; clearInterval(auto); i = n; type(b); }));
    out.textContent = btns[0].dataset.m ?? ''; phone.classList.add('done');
    if ('IntersectionObserver' in window && !still) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return; io.disconnect(); type(btns[0]);
        // then the next use every few seconds, until the visitor picks one
        auto = window.setInterval(() => { if (touched || document.hidden) return; i = (i + 1) % btns.length; type(btns[i]); }, 5200);
      }, { threshold: 0.4 });
      io.observe(phone);
    }
  });
</script>
