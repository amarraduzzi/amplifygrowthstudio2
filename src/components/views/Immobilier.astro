---
// Real estate page (Amplify Immobilier): agencies, rental management, syndics, developers.
// Step 1: hero with a stock grid drawn in CSS (no photos of people) and the demo request.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import { tr } from '../../i18n/t';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais une démo d’Amplify Immobilier.');
// stock grid of the example building: floors from top to bottom, 6 lots per floor (f = libre, r = réservé, s = vendu)
const floors: [number, string][] = [[4, 'fsfrff'], [3, 'sssfrs'], [2, 'ssrssf'], [1, 'ssssrs']];
const look: Record<string, string> = { f: 'bg-green text-navy', r: 'bg-[#F5B301] text-navy', s: 'bg-white/10 text-white/60' };
---
<Base lang={lang} page="immobilier" title={tt('Amplify Immobilier : le logiciel de l’immobilier au Maroc | Amplify Growth Studio')} description={tt('Un seul système pour les agences, la gestion locative, les syndics et les promoteurs. En français et en arabe, sur téléphone et ordinateur, avec WhatsApp.')} wa={wa}>
  <!-- hero -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-14 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-20">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Immobilier</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Tout l’immobilier.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Un seul système.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Agences, gestion locative, syndics et promoteurs : un seul outil, en français et en arabe, sur téléphone et ordinateur. Vous écrivez à vos clients, locataires et copropriétaires par WhatsApp en un clic.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-hero" class="px-7 text-lg" />
        </div>
      </div>

      <!-- the stock grid of a building, drawn in CSS: an example, not a real project -->
      <div class="fade-up relative" style="--d:350ms" aria-hidden="true">
        <div class="rounded-[1.75rem] bg-navy p-5 text-white shadow-[0_40px_80px_-40px_rgba(0,30,62,.7)] sm:p-7 lg:rounded-[2.25rem]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-green">Grille de stock</p>
              <p class="display mt-1 text-2xl leading-tight sm:text-3xl">Résidence Les Orangers</p>
              <p class="mt-0.5 text-sm text-white/60">Immeuble A</p>
            </div>
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70 ring-1 ring-white/15">Exemple</span>
          </div>
          <div class="mt-6 space-y-2" dir="ltr">
            {floors.map(([n, row]) => (
              <div class="flex items-center gap-2">
                <span class="w-6 shrink-0 text-end text-xs font-semibold text-white/50 tabular-nums">{n}</span>
                <div class="grid flex-1 grid-cols-6 gap-1.5 sm:gap-2">
                  {[...row].map((c, i) => <span class={`grid h-10 place-items-center rounded-lg text-[0.7rem] font-semibold tabular-nums sm:h-12 sm:text-xs ${look[c]}`}>{`A${n}0${i + 1}`}</span>)}
                </div>
              </div>
            ))}
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/75">
            <li class="flex items-center gap-2"><span class="size-3 rounded bg-green"></span><span>Libre</span></li>
            <li class="flex items-center gap-2"><span class="size-3 rounded bg-[#F5B301]"></span><span>Réservé</span></li>
            <li class="flex items-center gap-2"><span class="size-3 rounded bg-white/25"></span><span>Vendu</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez Amplify Immobilier</span><span class="block text-green">avec votre activité.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp et dites-nous si vous êtes une agence, un syndic ou un promoteur. Nous vous faisons la démonstration.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-final" class="px-8 text-lg" />
      </div>
    </div>
  </section>
</Base>
