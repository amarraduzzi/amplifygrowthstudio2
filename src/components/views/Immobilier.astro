---
// Real estate page (Amplify Immobilier): agencies, rental management, syndics, developers.
// Step 1: hero with a stock grid drawn in CSS (no photos of people) and the demo request.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import { tr } from '../../i18n/t';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais une démo d’Amplify Immobilier.');
// stock grid of the example building: floors from top to bottom, 6 lots per floor (f = libre, r = réservé, s = vendu)
const floors: [number, string][] = [[4, 'fsfrff'], [3, 'sssfrs'], [2, 'ssrssf'], [1, 'ssssrs']];
const look: Record<string, string> = { f: 'bg-green text-navy', r: 'bg-[#F5B301] text-navy', s: 'bg-white/10 text-white/60' };
// who it is for: one block per profession, 6 plain-language benefits each (not the whole module list)
const blocks = [
  { id: 'agences', dark: false, kicker: 'Agences immobilières', h: ['Chaque lead suivi.', 'Chaque bien en ligne.'], lead: 'Vente et location : biens, mandats, clients, visites et ventes dans un seul outil, sur téléphone comme au bureau.',
    wa: 'Bonjour, je suis une agence immobilière et je voudrais une démo d’Amplify Immobilier.',
    items: [
      ['Biens et mandats', 'Vos biens avec leurs photos, et leurs mandats. Vous voyez ceux qui arrivent à échéance avant qu’ils expirent.'],
      ['Les bons biens aux bons clients', 'Un bien arrive : les clients qui le cherchent apparaissent, et vous leur écrivez sur WhatsApp en un clic.'],
      ['Annonces prêtes à copier', 'Un titre, un texte et des photos pour Mubawab, Avito et les autres portails. Vous copiez, vous publiez.'],
      ['Visites et rapport propriétaire', 'Vos visites dans l’agenda de la semaine, et pour chaque bien un rapport à remettre au propriétaire : visites, offres, état du mandat.'],
      ['Ventes et commissions', 'Chaque vente suivie jusqu’à la commission, avec le partage quand un confrère ou un apporteur est dans l’affaire.'],
      ['Votre propre site', 'Votre agence en ligne, à votre adresse, avec un formulaire qui crée le contact et la tâche de rappel tout seul.'],
    ] },
  { id: 'location', dark: true, kicker: 'Gestion locative', h: ['Les loyers rentrent.', 'Le propriétaire est informé.'], lead: 'Baux, loyers, quittances et relevés, avec WhatsApp pour relancer les locataires et informer les propriétaires.',
    wa: 'Bonjour, je fais de la gestion locative et je voudrais une démo d’Amplify Immobilier.',
    items: [
      ['Loyers suivis', 'Chaque mois, une ligne par locataire : payé, à payer ou en retard. La relance part sur WhatsApp en un clic.'],
      ['Quittances', 'Une quittance en français ou en arabe pour chaque mois payé, à imprimer ou à envoyer au locataire.'],
      ['Révision du loyer', 'L’application montre quand une révision est possible et de combien, selon la loi 67-12, et prépare le message au locataire.'],
      ['État des lieux', 'Entrée et sortie sur téléphone ou tablette, avec photos par pièce et signatures à l’écran, puis en PDF.'],
      ['Le propriétaire informé', 'Un relevé chaque mois : loyers reçus, honoraires, réparations. Et un lien privé pour suivre ses biens, en français, arabe, anglais ou néerlandais.'],
      ['Courte durée', 'Un calendrier par bien avec vos réservations Airbnb et Booking, et un lien iCal pour bloquer vos dates sur les deux.'],
    ] },
  { id: 'syndics', dark: false, kicker: 'Syndics de copropriété', h: ['Chaque appel de fonds juste.', 'Chaque copropriétaire informé.'], lead: 'Pour les syndics de copropriété (loi 18-00) : résidences, appels de fonds, impayés, incidents et assemblées générales au même endroit.',
    wa: 'Bonjour, je suis syndic de copropriété et je voudrais une démo d’Amplify Immobilier.',
    items: [
      ['Résidences et lots', 'Chaque lot avec son étage, ses tantièmes et son copropriétaire. La part de chacun en pourcentage est calculée pour vous.'],
      ['Appels de fonds au centime', 'Vous répartissez un appel de fonds selon les tantièmes ou à parts égales. Chaque lot reçoit son montant exact.'],
      ['Impayés et relances', 'Qui a payé, qui a payé en partie, qui est en retard : un écran par résidence, et la relance part sur WhatsApp en français ou en arabe.'],
      ['Incidents des parties communes', 'Une panne signalée avec son lieu, son urgence, son coût et son état. Vous choisissez si les résidents la voient.'],
      ['Assemblée générale', 'Convocation par WhatsApp, présences et procurations, votes par tantièmes, puis le procès-verbal en PDF.'],
      ['Annonces et espace copropriétaire', 'Vos annonces partent sur WhatsApp. Chaque lot a son lien privé : ses charges, le RIB, les travaux et le résultat de l’assemblée.'],
    ] },
  { id: 'promoteurs', dark: true, kicker: 'Promoteurs', h: ['Chaque lot suivi.', 'Du plan aux clés.'], lead: 'Projets, stock, réservations, paiements par étape et rapport de direction, pour suivre chaque lot jusqu’à la remise des clés.',
    wa: 'Bonjour, je suis promoteur et je voudrais une démo d’Amplify Immobilier.',
    items: [
      ['Projets et tranches', 'Chaque projet avec son statut et sa livraison prévue, découpé en tranches. Les lots s’ajoutent par immeuble, plusieurs centaines d’un coup.'],
      ['Grille de stock', 'Chaque immeuble et chaque étage en couleurs : disponible, option, réservé, vendu. Un prix ou un statut changé sur plusieurs lots à la fois.'],
      ['Réservation et VEFA', 'Une réservation avec son échéancier. La VEFA suit la loi 107-12 : l’application refuse plus de 5 % au départ et moins de 20 % à la remise des clés.'],
      ['Avancement du chantier', 'Une étape atteinte (fondations, gros œuvre, finitions, clés) : les échéances deviennent exigibles, et l’appel de fonds en PDF part avec le RIB.'],
      ['Page publique du projet', 'Une page par projet avec photos, prix de départ, lots libres et formulaire de rappel. Chaque demande devient un prospect et une tâche pour un vendeur.'],
      ['Rapport de direction', 'Ventes, encaissements, retards, stock restant et encaissements à venir, par projet et par vendeur, en PDF ou en Excel.'],
    ] },
  { id: 'network', dark: false, kicker: 'Amplify Network', h: ['Collaborez entre agences.', 'Chacun garde ses données.'], lead: 'Partagez des biens, recommandez des clients et partagez la commission avec d’autres agences qui utilisent Amplify Immobilier.',
    wa: 'Bonjour, je suis une agence immobilière et je voudrais voir Amplify Network dans une démo d’Amplify Immobilier.',
    items: [
      ['Vos agences partenaires', 'Vous invitez une autre agence avec votre code de bureau. Elle accepte, et vous pouvez collaborer.'],
      ['Biens partagés', 'Vous partagez un bien disponible avec un partenaire et vous lui proposez une part de votre commission. Il ne voit ni l’adresse, ni le propriétaire.'],
      ['J’ai un client', 'Sur un bien partagé, l’agence partenaire propose son client. Les deux agences suivent les mêmes étapes : visite, offre, signature, commission versée.'],
      ['Recommandation de clients', 'Vous recommandez un client à une agence partenaire, avec son accord (loi 09-08) et des frais en pourcentage de la commission de l’agence.'],
      ['Un partage clair', 'Les deux agences voient la même répartition de la commission, en pourcentage et en dirhams.'],
      ['Convention de collaboration', 'La convention entre agences est prête en PDF.'],
    ] },
];
// block "droit marocain": only what the product does, stated as such (no promise of legal compliance)
const laws = [
  ['Loi 18-00', 'Copropriété', 'Lots, tantièmes, appels de fonds répartis au centime, votes de l’assemblée par tantièmes et procès-verbal en PDF.'],
  ['Loi 67-12', 'Révision du loyer', 'Pas de révision avant trois ans après le début du bail ou la dernière hausse. L’application plafonne la hausse à 8 % pour l’habitation et 10 % pour les autres usages, et propose le montant.'],
  ['Loi 107-12', 'Vente sur plan (VEFA)', '5 % au contrat préliminaire, des paiements par étape du chantier, 20 % à la remise des clés. L’application refuse plus de 5 % au départ et moins de 20 % aux clés.'],
  ['Loi 09-08', 'Données personnelles', 'Un client n’est recommandé à une autre agence qu’avec son accord. Sur vos pages publiques, jamais d’adresse exacte, de propriétaire ni de notes internes.'],
  ['Article 145 du CGI', 'Factures', 'Numéro continu et sans trou, ICE, IF, RC, taxe professionnelle, HT, TVA et TTC, montant en lettres. Une facture émise ne se modifie plus.'],
];
// block "WhatsApp partout": one click opens WhatsApp with the message written, nothing is sent automatically
const uses = [
  ['Loyers en retard', 'Une relance polie au locataire, avec le mois et le montant.'],
  ['Visites', 'Un rappel envoyé au client avant le rendez-vous.'],
  ['Biens pour vos clients', 'Les biens qui correspondent à sa recherche, avec les liens, dans sa langue.'],
  ['Propriétaires', 'Le relevé du mois ou le point sur leur bien, avec un lien privé pour suivre le reste.'],
  ['Copropriétaires', 'Relance des impayés, convocation à l’assemblée, annonces de la résidence.'],
  ['Acheteurs', 'Un appel de fonds ou un rappel d’échéance, ou tous les acheteurs prévenus d’un coup à chaque étape du chantier.'],
];
const bubbles = [
  'Bonjour Mme Alami, le loyer d’octobre (4 500 DH) n’est pas encore arrivé. Merci de le régler dès que possible.',
  'Bonjour, l’assemblée générale de la résidence Les Orangers aura lieu le 15 novembre à 18 h. Votre présence compte.',
];
---
<Base lang={lang} page="immobilier" title={tt('Amplify Immobilier : le logiciel de l’immobilier au Maroc | Amplify Growth Studio')} description={tt('Un seul système pour les agences, la gestion locative, les syndics et les promoteurs. En français et en arabe, sur téléphone et ordinateur, avec WhatsApp.')} wa={wa}>
  <!-- hero -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-14 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-20">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Immobilier</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Tout l’immobilier.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Un seul système.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Agences, gestion locative, syndics et promoteurs : un seul outil, en français et en arabe, sur téléphone et ordinateur. Vous écrivez à vos clients, locataires et copropriétaires par WhatsApp en un clic.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-hero" class="px-7 text-lg" />
        </div>
      </div>

      <!-- the stock grid of a building, drawn in CSS: an example, not a real project -->
      <div class="fade-up relative" style="--d:350ms" aria-hidden="true">
        <div class="rounded-[1.75rem] bg-navy p-5 text-white shadow-[0_40px_80px_-40px_rgba(0,30,62,.7)] sm:p-7 lg:rounded-[2.25rem]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-green">Grille de stock</p>
              <p class="display mt-1 text-2xl leading-tight sm:text-3xl">Résidence Les Orangers</p>
              <p class="mt-0.5 text-sm text-white/60">Immeuble A</p>
            </div>
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70 ring-1 ring-white/15">Exemple</span>
          </div>
          <div class="mt-6 space-y-2" dir="ltr">
            {floors.map(([n, row]) => (
              <div class="flex items-center gap-2">
                <span class="w-6 shrink-0 text-end text-xs font-semibold text-white/50 tabular-nums">{n}</span>
                <div class="grid flex-1 grid-cols-6 gap-1.5 sm:gap-2">
                  {[...row].map((c, i) => <span class={`grid h-10 place-items-center rounded-lg text-[0.7rem] font-semibold tabular-nums sm:h-12 sm:text-xs ${look[c]}`}>{`A${n}0${i + 1}`}</span>)}
                </div>
              </div>
            ))}
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/75">
            <li class="flex items-center gap-2"><span class="size-3 rounded bg-green"></span><span>Libre</span></li>
            <li class="flex items-center gap-2"><span class="size-3 rounded bg-[#F5B301]"></span><span>Réservé</span></li>
            <li class="flex items-center gap-2"><span class="size-3 rounded bg-white/25"></span><span>Vendu</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- who it is for -->
  <section id="pour-qui" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-6 sm:px-6 md:pb-10">
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Chaque métier,</span><span class="block text-green-deep">ses propres outils.</span></h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">Un seul système, avec ce qu’il faut pour chaque activité.</p>
  </section>
  {blocks.map((b) => (
    <section id={b.id} class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
      <div class={`mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] p-6 md:p-12 lg:grid-cols-[0.85fr_1.15fr] ${b.dark ? 'bg-navy text-white' : 'bg-paper ring-1 ring-line'}`}>
        <div>
          <p class={`inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-semibold ${b.dark ? 'bg-white/10 text-white ring-1 ring-white/15' : 'bg-chalk ring-1 ring-line'}`}><span class="size-2 rounded-full bg-green"></span>{b.kicker}</p>
          <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{b.h[0]}</span><span class={`block ${b.dark ? 'text-green' : 'text-green-deep'}`}>{b.h[1]}</span></h3>
          <p class={`mt-5 max-w-md text-lg ${b.dark ? 'text-white/75' : 'text-muted'}`}>{b.lead}</p>
          <WaButton text={b.wa} label={tt('Demander une démo')} where={`immobilier-${b.id}`} class="mt-7 px-7 text-lg" />
        </div>
        <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {b.items.map(([t, x]) => (
            <li class="flex gap-3">
              <span class={`mt-0.5 grid size-6 shrink-0 place-items-center rounded-full ${b.dark ? 'bg-green text-navy' : 'bg-green/15 text-green-deep'}`}><Icon name="check" class="size-4" /></span>
              <div><p class="font-semibold">{t}</p><p class={`mt-1 text-[0.95rem] leading-relaxed ${b.dark ? 'text-white/65' : 'text-muted'}`}>{x}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <!-- Moroccan law: what the product does, not a legal promise -->
  <section id="droit" class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
    <div class="mx-auto max-w-6xl rounded-[2.5rem] bg-navy p-6 text-white md:p-12">
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-10">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white ring-1 ring-white/15"><span class="size-2 rounded-full bg-green"></span>{tt('Droit marocain')}</p>
          <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Les règles marocaines,')}</span><span class="block text-green">{tt('déjà dans l’outil.')}</span></h3>
        </div>
        <p class="max-w-xl text-lg text-white/75 lg:pt-12">{tt('Les lois de votre métier sont prises en compte dans l’application. Elle vous aide à les suivre, elle ne remplace pas votre notaire ni votre juriste.')}</p>
      </div>
      <ul class="mt-10 border-t border-white/15">
        {laws.map(([law, t, x]) => (
          <li class="grid gap-2 border-b border-white/15 py-5 md:grid-cols-[13rem_1fr] md:gap-8">
            <p class="font-semibold text-green">{tt(law)}</p>
            <div><p class="font-semibold">{tt(t)}</p><p class="mt-1 max-w-2xl text-[0.95rem] leading-relaxed text-white/65">{tt(x)}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WhatsApp everywhere: one click, message ready, nothing sent automatically -->
  <section id="whatsapp" class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
    <div class="mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-chalk px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt('WhatsApp partout')}</p>
        <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Un clic.')}</span><span class="block text-green-deep">{tt('Le message est prêt.')}</span></h3>
        <p class="mt-5 max-w-xl text-lg text-muted">{tt('Relances, convocations, rapports et annonces : WhatsApp s’ouvre avec le message déjà écrit, en français, en arabe ou en anglais. Vous relisez, vous envoyez. Rien ne part sans vous.')}</p>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {uses.map(([t, x]) => (
            <li class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <p class="font-semibold">{tt(t)}</p>
              <p class="text-[0.95rem] leading-relaxed text-muted">{tt(x)}</p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[0.95rem] font-semibold text-green-deep">{tt('Et vos visiteurs aussi : chaque page de bien a son bouton WhatsApp.')}</p>
      </div>
      <!-- two example messages drawn in CSS -->
      <div class="self-start lg:mt-12" aria-hidden="true">
        <div class="rounded-[1.75rem] bg-chalk p-5 ring-1 ring-line sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">{tt('Message prêt à envoyer')}</p>
            <span class="rounded-full bg-paper px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">{tt('Exemple')}</span>
          </div>
          <div class="mt-5 space-y-3">
            {bubbles.map((m) => (
              <p class="max-w-[92%] rounded-2xl bg-green/15 px-4 py-3 text-[0.95rem] leading-relaxed ring-1 ring-green/20">{tt(m)}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 pt-10 sm:px-6 md:pb-24 md:pt-16">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez Amplify Immobilier</span><span class="block text-green">avec votre activité.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp et dites-nous si vous êtes une agence, un syndic ou un promoteur. Nous vous faisons la démonstration.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-final" class="px-8 text-lg" />
      </div>
    </div>
  </section>
</Base>
