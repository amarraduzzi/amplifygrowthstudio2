---
// Real estate page (Amplify Immobilier): agencies, rental management, syndics, developers.
// Step 1: hero with a stock grid drawn in CSS (no photos of people) and the demo request.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import ImmoMetiers from '../ImmoMetiers.astro';
import { tr } from '../../i18n/t';
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais une démo d’Amplify Immobilier.');
// stock grid of the example building: floors from top to bottom, 6 lots per floor (f = libre, r = réservé, s = vendu)
const floors: [number, string][] = [[4, 'fsfrff'], [3, 'sssfrs'], [2, 'ssrssf'], [1, 'ssssrs']];
// block "droit marocain": only what the product does, stated as such (no promise of legal compliance)
const laws = [
  ['Loi 18-00', 'Copropriété', 'Lots, tantièmes, appels de fonds répartis au centime, votes de l’assemblée par tantièmes et procès-verbal en PDF.'],
  ['Loi 67-12', 'Révision du loyer', 'Pas de révision avant trois ans après le début du bail ou la dernière hausse. L’application plafonne la hausse à 8 % pour l’habitation et 10 % pour les autres usages, et propose le montant.'],
  ['Loi 107-12', 'Vente sur plan (VEFA)', '5 % au contrat préliminaire, des paiements par étape du chantier, 20 % à la remise des clés. L’application refuse plus de 5 % au départ et moins de 20 % aux clés.'],
  ['Loi 09-08', 'Données personnelles', 'Un client n’est recommandé à une autre agence qu’avec son accord. Sur vos pages publiques, jamais d’adresse exacte, de propriétaire ni de notes internes.'],
  ['Article 145 du CGI', 'Factures', 'Numéro continu et sans trou, ICE, IF, RC, taxe professionnelle, HT, TVA et TTC, montant en lettres. Une facture émise ne se modifie plus.'],
];
// block "WhatsApp partout": one click opens WhatsApp with the message written, nothing is sent automatically
const uses = [
  ['Loyers en retard', 'Une relance polie au locataire, avec le mois et le montant.'],
  ['Visites', 'Un rappel envoyé au client avant le rendez-vous.'],
  ['Biens pour vos clients', 'Les biens qui correspondent à sa recherche, avec les liens, dans sa langue.'],
  ['Propriétaires', 'Le relevé du mois ou le point sur leur bien, avec un lien privé pour suivre le reste.'],
  ['Copropriétaires', 'Relance des impayés, convocation à l’assemblée, annonces de la résidence.'],
  ['Acheteurs', 'Un appel de fonds ou un rappel d’échéance, ou tous les acheteurs prévenus d’un coup à chaque étape du chantier.'],
];
const bubbles = [
  'Bonjour Mme Alami, le loyer d’octobre (4 500 DH) n’est pas encore arrivé. Merci de le régler dès que possible.',
  'Bonjour, l’assemblée générale de la résidence Les Orangers aura lieu le 15 novembre à 18 h. Votre présence compte.',
];
---
<Base lang={lang} page="immobilier" title={tt('Amplify Immobilier : le logiciel de l’immobilier au Maroc | Amplify Growth Studio')} description={tt('Un seul système pour les agences, la gestion locative, les syndics et les promoteurs. En français et en arabe, sur téléphone et ordinateur, avec WhatsApp.')} wa={wa}>
  <!-- hero -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-14 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-20">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Immobilier</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Tout l’immobilier.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Un seul système.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Agences, gestion locative, syndics et promoteurs : un seul outil, en français et en arabe, sur téléphone et ordinateur. Vous écrivez à vos clients, locataires et copropriétaires par WhatsApp en un clic.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-hero" class="px-7 text-lg" />
        </div>
      </div>

      <!-- the stock grid of a building, drawn in CSS: an example, not a real project -->
      <div class="fade-up relative" style="--d:350ms" data-grid>
        <div class="rounded-[1.75rem] bg-navy p-5 text-white shadow-[0_40px_80px_-40px_rgba(0,30,62,.7)] sm:p-7 lg:rounded-[2.25rem]">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-green">Grille de stock</p>
              <p class="display mt-1 text-2xl leading-tight sm:text-3xl">Résidence Les Orangers</p>
              <p class="mt-0.5 text-sm text-white/60">Immeuble A</p>
            </div>
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/70 ring-1 ring-white/15">{tt('Touchez un lot')}</span>
          </div>
          <div class="mt-6 space-y-2" dir="ltr">
            {floors.map(([n, row]) => (
              <div class="flex items-center gap-2">
                <span class="w-6 shrink-0 text-end text-xs font-semibold text-white/50 tabular-nums">{n}</span>
                <div class="grid flex-1 grid-cols-6 gap-1.5 sm:gap-2">
                  {[...row].map((c, i) => <button type="button" class="gr-lot grid h-10 place-items-center rounded-lg text-[0.7rem] font-semibold tabular-nums transition-[background-color,color,transform] duration-300 hover:scale-105 active:scale-95 sm:h-12 sm:text-xs" data-s={c} aria-label={`A${n}0${i + 1}`}>{`A${n}0${i + 1}`}</button>)}
                </div>
              </div>
            ))}
          </div>
          <div class="mt-6 grid grid-cols-3 gap-2 text-sm">
            <p class="rounded-2xl bg-white/[0.06] px-3 py-2.5"><span class="flex items-center gap-2 text-white/70"><span class="size-3 rounded bg-green"></span>{tt('Libre')}</span><span class="display mt-1 block text-3xl tabular-nums" data-n="f">0</span></p>
            <p class="rounded-2xl bg-white/[0.06] px-3 py-2.5"><span class="flex items-center gap-2 text-white/70"><span class="size-3 rounded bg-[#F5B301]"></span>{tt('Réservé')}</span><span class="display mt-1 block text-3xl tabular-nums" data-n="r">0</span></p>
            <p class="rounded-2xl bg-white/[0.06] px-3 py-2.5"><span class="flex items-center gap-2 text-white/70"><span class="size-3 rounded bg-white/25"></span>{tt('Vendu')}</span><span class="display mt-1 block text-3xl tabular-nums" data-n="s">0</span></p>
          </div>
          <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/10"><span class="block h-full rounded-full bg-green transition-[width] duration-700" data-sold-bar style="width:0"></span></div>
          <p class="mt-2 text-xs text-white/55"><span data-pct dir="ltr">0 %</span> {tt('vendu ou réservé')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- the promise, word by word as you scroll -->
  <section class="px-4 pb-14 pt-4 sm:px-6 md:pb-20">
    <p class="mx-auto max-w-5xl text-[clamp(2rem,4.6vw,3.8rem)] font-semibold leading-[1.08] tracking-tight" data-scrub="words">{tt('Un bien, un client, un loyer, une copropriété, un chantier : tout est suivi, et chaque message part sur WhatsApp en un clic.').split(' ').map(w => <span class="word">{w} </span>)}</p>
  </section>

  <!-- who it is for: one tab per profession, with a live demo -->
  <section id="pour-qui" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-6 sm:px-6 md:pb-10">
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Chaque métier,')}</span><span class="block text-green-deep">{tt('ses propres outils.')}</span></h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">{tt('Choisissez votre métier et essayez : tout ce qui bouge ici se touche.')}</p>
    <div class="mt-8"><ImmoMetiers /></div>
  </section>

  <!-- Moroccan law: what the product does, not a legal promise -->
  <section id="droit" class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
    <div class="mx-auto max-w-6xl rounded-[2.5rem] bg-navy p-6 text-white md:p-12">
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-10">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white ring-1 ring-white/15"><span class="size-2 rounded-full bg-green"></span>{tt('Droit marocain')}</p>
          <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Les règles marocaines,')}</span><span class="block text-green">{tt('déjà dans l’outil.')}</span></h3>
        </div>
        <p class="max-w-xl text-lg text-white/75 lg:pt-12">{tt('Les lois de votre métier sont prises en compte dans l’application. Elle vous aide à les suivre, elle ne remplace pas votre notaire ni votre juriste.')}</p>
      </div>
      <ul class="mt-10 border-t border-white/15">
        {laws.map(([law, t, x]) => (
          <li class="grid gap-2 border-b border-white/15 py-5 md:grid-cols-[13rem_1fr] md:gap-8">
            <p class="font-semibold text-green">{tt(law)}</p>
            <div><p class="font-semibold">{tt(t)}</p><p class="mt-1 max-w-2xl text-[0.95rem] leading-relaxed text-white/65">{tt(x)}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WhatsApp everywhere: one click, message ready, nothing sent automatically -->
  <section id="whatsapp" class="scroll-mt-20 px-4 py-4 sm:px-6 md:py-5">
    <div class="mx-auto grid max-w-6xl gap-10 rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-chalk px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt('WhatsApp partout')}</p>
        <h3 class="display mt-5 text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Un clic.')}</span><span class="block text-green-deep">{tt('Le message est prêt.')}</span></h3>
        <p class="mt-5 max-w-xl text-lg text-muted">{tt('Relances, convocations, rapports et annonces : WhatsApp s’ouvre avec le message déjà écrit, en français, en arabe ou en anglais. Vous relisez, vous envoyez. Rien ne part sans vous.')}</p>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {uses.map(([t, x]) => (
            <li class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <p class="font-semibold">{tt(t)}</p>
              <p class="text-[0.95rem] leading-relaxed text-muted">{tt(x)}</p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[0.95rem] font-semibold text-green-deep">{tt('Et vos visiteurs aussi : chaque page de bien a son bouton WhatsApp.')}</p>
      </div>
      <!-- two example messages drawn in CSS -->
      <div class="self-start lg:mt-12" aria-hidden="true">
        <div class="rounded-[1.75rem] bg-chalk p-5 ring-1 ring-line sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold">{tt('Message prêt à envoyer')}</p>
            <span class="rounded-full bg-paper px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">{tt('Exemple')}</span>
          </div>
          <div class="mt-5 space-y-3">
            {bubbles.map((m) => (
              <p class="max-w-[92%] rounded-2xl bg-green/15 px-4 py-3 text-[0.95rem] leading-relaxed ring-1 ring-green/20">{tt(m)}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 pt-10 sm:px-6 md:pb-24 md:pt-16">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez Amplify Immobilier</span><span class="block text-green">avec votre activité.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp et dites-nous si vous êtes une agence, un syndic ou un promoteur. Nous vous faisons la démonstration.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <WaButton text={wa} label={tt('Demander une démo')} where="immobilier-final" class="px-8 text-lg" />
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .gr-lot[data-s="f"] { background: var(--color-green); color: var(--color-navy); }
  .gr-lot[data-s="r"] { background: #F5B301; color: var(--color-navy); }
  .gr-lot[data-s="s"] { background: rgb(255 255 255 / .1); color: rgb(255 255 255 / .6); }
  .gr-lot.flip { animation: gr-flip .5s ease-out; }
  @keyframes gr-flip { 40% { transform: scale(1.18); box-shadow: 0 0 0 6px rgb(5 185 98 / .35); } }
  @media (prefers-reduced-motion: reduce) { .gr-lot.flip { animation: none; } }
</style>

<script>
  // the stock grid: tap a lot to move it on (libre, réservé, vendu); on its own, a lot gets reserved then sold now and then
  document.querySelectorAll<HTMLElement>('[data-grid]').forEach((root) => {
    const lots = [...root.querySelectorAll<HTMLButtonElement>('.gr-lot')];
    const next: Record<string, string> = { f: 'r', r: 's', s: 'f' };
    const paint = () => {
      const n: Record<string, number> = { f: 0, r: 0, s: 0 };
      lots.forEach(l => n[l.dataset.s!]++);
      (['f', 'r', 's'] as const).forEach(k => (root.querySelector<HTMLElement>(`[data-n="${k}"]`)!.textContent = String(n[k])));
      const pct = Math.round(((n.r + n.s) / lots.length) * 100);
      root.querySelector<HTMLElement>('[data-sold-bar]')!.style.width = `${pct}%`;
      root.querySelector<HTMLElement>('[data-pct]')!.textContent = `${pct} %`;
    };
    const flip = (l: HTMLElement, to: string) => { l.dataset.s = to; l.classList.remove('flip'); void l.offsetWidth; l.classList.add('flip'); paint(); };
    let touched = false, moves = 0;
    lots.forEach(l => l.addEventListener('click', () => { touched = true; flip(l, next[l.dataset.s!]); }));
    paint();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let vis = false;
    new IntersectionObserver(([e]) => { vis = e.isIntersecting; }).observe(root);
    setInterval(() => {
      if (touched || !vis || document.hidden || moves >= 6) return;
      moves++;
      const r = lots.filter(l => l.dataset.s === 'r'), f = lots.filter(l => l.dataset.s === 'f');
      if (r.length && (Math.random() < 0.5 || !f.length)) flip(r[Math.floor(Math.random() * r.length)], 's');
      else if (f.length) flip(f[Math.floor(Math.random() * f.length)], 'r');
    }, 2200);
  });
</script>
