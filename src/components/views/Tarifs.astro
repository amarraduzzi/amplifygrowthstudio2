---
// One pricing page for everything: pick your situation, the plans, what is taken separately, the one-off costs.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import Pricing from '../Pricing.astro';
import PriceBuilder from '../PriceBuilder.astro';
import BillingToggle from '../BillingToggle.astro';
import Faq from '../Faq.astro';
import CountUp from '../CountUp.astro';
import LeakTicker from '../LeakTicker.astro';
import PhotoBand from '../PhotoBand.astro';
import ProductFinal from '../ProductFinal.astro';
import { OFFER, signupUrl, waLink } from '../../config';
import { copy } from '../../i18n';
import { posOf } from '../../i18n/content';
import { tr } from '../../i18n/t';
import { ROUTES, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const p = posOf(lang);
const ui = copy(lang).ui;
const title = tt('Tarifs Amplify Growth Studio : caisse, marges, site | Maroc');
const description = tt('Tous les tarifs en dirhams : Amplify POS dès 199 DH HT, Profit 249 DH, Contrôle 499 DH, site 250 DH puis 100 DH par mois. 14 jours gratuits, sans engagement.');
const wa = tt('Bonjour, j’ai une question sur vos tarifs.');
const price = (i: number) => p.pricing.plans[i].price;
const from = (n: string) => tt('Dès {n} DH HT par mois').replace('{n}', n);
const situations = [
  { h: tt('Je n’ai pas de caisse'), t: tt('Amplify POS : la caisse, le menu QR et les bons cuisine.'), plan: from(price(0)), icon: 'till', to: 0 },
  { h: tt('J’ai déjà une caisse'), t: tt('Amplify Profit : food cost, marge par plat et stock, avec votre caisse actuelle.'), plan: from(price(2)), icon: 'chart', to: 3 },
  { h: tt('Je veux tout'), t: tt('Contrôle : la caisse et les marges, ensemble.'), plan: from(price(3)), icon: 'check', to: 2 },
] as const;
const faqItems = [
  ['Les prix sont-ils avec ou sans TVA ?', 'Tous les prix sont hors taxes (HT). La TVA s’ajoute sur la facture.'],
  ['Y a-t-il un engagement ?', 'Non. 14 jours gratuits sans carte bancaire, puis vous payez chaque mois et vous pouvez arrêter quand vous voulez. En annuel, vous payez 10 mois et profitez de 12.'],
  ['Comment fonctionnent les services à la carte ?', 'Un service coûte 100 DH par mois, deux services 150 DH, trois ou plus 200 DH. Les formules avec caisse incluent déjà Site et Commandes.'],
  ['Quelle formule choisir ?', 'Sans caisse : POS. Avec une caisse que vous gardez : Profit. Les deux ensemble : Contrôle, à 499 DH au lieu de 598 DH.'],
  ['L’installation est-elle payante ?', 'À Rabat, l’installation sur place est offerte pour le moment. Partout au Maroc, l’installation guidée en vidéo est incluse.'],
  ['Le matériel est-il compris ?', 'Non, le matériel est vendu à part. Écrivez-nous sur WhatsApp et nous vous disons ce qu’il vous faut.'],
  ['Comment payer ?', 'Par virement ou CashPlus. Pas de carte bancaire demandée pour l’essai.'],
].map(([q, a]) => [tt(q), tt(a)]);
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Amplify Growth Studio',
    itemListElement: p.pricing.plans.map((x, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Offer', name: x.name, price: x.price, priceCurrency: 'MAD' } })),
  },
  faqSchema(faqItems),
].filter(Boolean) as Record<string, unknown>[];
const rows = [
  [tt('Installation sur place à Rabat'), OFFER.installFreeNow ? tt('Offerte pour le moment') : [OFFER.installRabat]],
  [tt('Mise en place de Commandes'), [500]],
  [tt('Création de votre site par nos soins'), [OFFER.siteSetup]],
  [tt('Style Premium pour votre site'), [OFFER.sitePremium]],
];
---
<Base lang={lang} page="pricing" title={title} description={description} wa={wa} schema={schema}>
  <!-- hero: the price tags land on the counter, like the till on the POS page -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 pb-10 pt-5 sm:px-6 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-12 lg:pb-14 lg:pt-12">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt('Tarifs')}</p>
        <h1 class="mt-4 text-[clamp(2.9rem,12vw,3.6rem)] lg:mt-5 lg:text-[clamp(3.4rem,5.4vw,5.4rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block whitespace-nowrap" style="--d:80ms">{tt('Des prix clairs,')}</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block whitespace-nowrap text-green-deep" style="--d:200ms">{tt('en dirhams.')}<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-4 max-w-xl text-[1.05rem] leading-snug text-muted md:mt-5 md:text-xl" style="--d:300ms">{tt('14 jours gratuits, sans carte bancaire et sans engagement. Choisissez selon votre situation, nous vous montrons le prix exact.')}</p>
        <div class="fade-up mt-6 flex items-center gap-4 md:mt-7" style="--d:400ms">
          <a href="#situation" class="inline-flex min-h-12 items-center whitespace-nowrap rounded-full bg-green px-5 text-[0.95rem] font-semibold text-navy hover:bg-[#04A859] md:px-7 md:text-lg">{tt('Quelle est votre situation ?')}</a>
          <a href={signupUrl(lang)} class="whitespace-nowrap text-sm font-medium underline underline-offset-4 md:inline-flex md:min-h-12 md:items-center md:rounded-full md:border md:border-navy/25 md:px-6 md:text-lg md:font-normal md:no-underline md:hover:border-navy">{p.hero.cta}</a>
        </div>
        <p class="fade-up mt-3 text-sm text-muted" style="--d:450ms">{tt('Prix hors taxes (HT), TVA en sus.')}</p>
      </div>

      <div class="relative isolate aspect-[4/3.3] overflow-hidden rounded-[1.75rem] bg-mint lg:aspect-[5/4.4] lg:rounded-[2.25rem]">
        <img src="/img/comptoir-1200.webp" srcset="/img/comptoir-760.webp 760w, /img/comptoir-1200.webp 1200w" sizes="(min-width: 1024px) 50vw, 100vw" alt={tt('Le comptoir d’un café à Rabat')} width="1200" height="900" class="absolute inset-0 -z-20 size-full object-cover object-[50%_75%]" />
        <div class="absolute inset-0 -z-10 bg-linear-to-b from-navy/10 via-transparent to-navy/45" aria-hidden="true"></div>
        {[
          { i: 0, cls: 'start-[5%] top-[6%] w-[42%] -rotate-3 md:top-[12%] md:w-[40%] md:start-[6%]', d: 400 },
          { i: 2, cls: 'end-[5%] top-[12%] w-[42%] rotate-2 md:top-[22%] md:w-[40%] md:end-[6%]', d: 650 },
          { i: 3, cls: 'start-[22%] bottom-[5%] w-[54%] rotate-[-1.5deg] md:bottom-[9%] md:start-[24%] md:w-[52%]', d: 900 },
        ].map(({ i, cls, d }) => {
          const pl = p.pricing.plans[i];
          const dark = i === 3;
          return (
            <div class={`absolute ${cls}`}>
              <div class="drop" style={`--d:${d}ms`}>
                <div class="tf-float" style={`--d:${d}ms`}>
                  <div class={`relative rounded-2xl p-3 shadow-[0_24px_50px_-20px_rgba(0,30,62,0.6)] md:p-5 ${dark ? 'bg-navy text-white' : 'bg-white'}`}>
                    <p class={`text-xs font-semibold md:text-sm ${dark ? 'text-green' : 'text-green-deep'}`}>{pl.tag}</p>
                    <p class="display text-xl leading-none md:text-3xl">{i === 3 ? tt('Contrôle') : i === 0 ? tt('Essentiel') : pl.name}</p>
                    <p class="mt-2 flex items-baseline gap-1.5"><span class={`display text-3xl tabular-nums md:text-6xl ${dark ? 'text-green' : ''}`} dir="ltr">{pl.price}</span><span class={`hidden text-[0.65rem] md:inline md:text-xs ${dark ? 'text-white/60' : 'text-muted'}`}>{tt('DH HT')}</span></p>
                    {dark && <span class="glow absolute inset-0 rounded-2xl ring-[3px] ring-green" style="--d:1700ms" aria-hidden="true"></span>}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- figures -->
    <div class="border-y border-line bg-paper">
      <ul class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:py-6">
        {[['199', 'DH HT / mois, tout compris'], ['14', 'jours gratuits, sans carte bancaire'], ['150', 'DH de plus que Restaurant pour avoir tout Profit']].map(([n, l]) => (
          <li class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><span class="display text-5xl text-navy md:text-6xl" data-count={n} dir="ltr">{n}</span><span class="text-[0.78rem] leading-snug text-muted md:max-w-[13rem] md:text-[0.95rem]">{tt(l)}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- pick your situation: the click scrolls to the plan and lights it up -->
  <section id="situation" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-14 sm:px-6 md:py-24" aria-labelledby="sit-h" data-tf>
    <h2 id="sit-h" class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{tt('Quelle est votre situation ?')}</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {situations.map((s, i) => (
        <a href="#formules" data-pick={s.to} class={`tf group flex flex-col rounded-[1.75rem] p-6 ${i === 2 ? 'bg-navy text-white' : 'bg-paper ring-1 ring-line'}`} style={`--d:${i * 110}ms`}>
          <span class={`tf-icon grid size-11 place-items-center rounded-xl ${i === 2 ? 'bg-green text-navy' : 'bg-mint text-green-deep ring-1 ring-green/30'}`}><Icon name={s.icon} class="size-5" /></span>
          <h3 class="display mt-4 text-3xl">{s.h}</h3>
          <p class={`mt-2 flex-1 ${i === 2 ? 'text-white/70' : 'text-muted'}`}>{s.t}</p>
          <p class={`mt-4 font-semibold ${i === 2 ? 'text-green' : 'text-green-deep'}`}>{s.plan} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1 rtl:rotate-180 rtl:group-hover:-translate-x-1">→</span></p>
        </a>
      ))}
    </div>
  </section>

  <!-- the four plans -->
  <section id="formules" class="mx-auto max-w-6xl scroll-mt-24 px-4 pb-14 sm:px-6 md:pb-24" aria-labelledby="plans">
    <h2 id="plans" class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{tt('Les formules')}</h2>
    <p class="mt-4 max-w-2xl text-muted">{p.pricing.note}</p>
    <div class="mt-8"><BillingToggle /></div>
    <div class="mt-8"><Pricing plans={[0, 1, 3, 2].map(i => p.pricing.plans[i])} per={p.pricing.per} choose={p.pricing.choose} popular={p.pricing.popular} lang={lang} /></div>
    <p class="mt-5 flex items-center gap-2 font-semibold text-green-deep"><Icon name="check" class="size-5" />{tt('Restaurant plus 150 DH, et vous avez tout Profit (249 DH seul).')} <span class="font-normal text-muted">{tt('Site inclus dans toutes les formules.')}</span></p>
  </section>

  <!-- the highlighted offer: free setup in Rabat -->
  {OFFER.installFreeNow && (
    <section class="px-4 pb-14 sm:px-6 md:pb-24" aria-labelledby="offre" data-tf>
      <div class="tf tf-shine relative isolate mx-auto grid max-w-6xl items-center gap-6 overflow-hidden rounded-[2.5rem] bg-green p-7 text-navy sm:p-10 md:grid-cols-[1.4fr_auto] md:p-14">
        <div>
          <p class="tf-ping inline-flex items-center gap-2 rounded-full bg-navy px-3 py-1 text-xs font-bold text-green"><span class="size-2 rounded-full bg-green"></span>{tt('Offre en cours')}</p>
          <h2 id="offre" class="display mt-4 text-[2.9rem] leading-[0.95] sm:text-6xl lg:text-7xl">{tt('Installation sur place à Rabat offerte')}</h2>
          <p class="mt-4 max-w-xl text-lg text-navy/80">{tt('Au lieu de {n} DH HT. Nous venons installer la caisse et former votre équipe, sans frais, pour le moment.').split('{n}')[0]}<span class="relative font-bold text-navy" dir="ltr">{OFFER.installRabat}<span class="tf-strike absolute inset-x-0 top-1/2 h-[2px] rounded-full bg-navy" aria-hidden="true"></span></span>{tt('Au lieu de {n} DH HT. Nous venons installer la caisse et former votre équipe, sans frais, pour le moment.').split('{n}')[1]}</p>
        </div>
        <a href={waLink(tt('Bonjour, je voudrais réserver l’installation offerte à Rabat.'))} target="_blank" rel="noopener" data-wa="pricing-offer" class="inline-flex min-h-14 items-center justify-center whitespace-nowrap rounded-full bg-navy px-8 text-lg font-semibold text-white transition-transform hover:scale-[1.03] hover:bg-blue">{tt('Réserver mon installation')}</a>
      </div>
    </section>
  )}

  <!-- services à la carte: 1 = 100, 2 = 150, 3+ = 200 -->
  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 md:pb-24" aria-labelledby="separe" data-tf>
    <h2 id="separe" class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{tt('Les services à la carte')}</h2>
    <p class="tf mt-4 max-w-2xl text-muted" style="--d:80ms">{tt('Prenez seulement ce dont vous avez besoin. Dans les formules avec caisse, Site et Commandes sont inclus.')}</p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-3">
      {[['1 service', '100'], ['2 services', '150'], ['3 services ou plus', '200']].map(([l, n], i) => (
        <li class={`tf rounded-[1.5rem] p-5 ${i === 1 ? 'bg-navy text-white' : 'bg-paper ring-1 ring-line'}`} style={`--d:${i * 100}ms`}>
          <p class={`text-sm font-semibold ${i === 1 ? 'text-green' : 'text-green-deep'}`}>{tt(l)}</p>
          <p class="mt-1 flex items-baseline gap-2"><span class="display text-6xl tabular-nums" dir="ltr" data-count={n}>{n}</span><span class={`text-sm ${i === 1 ? 'text-white/60' : 'text-muted'}`}>{p.pricing.per}</span></p>
        </li>
      ))}
    </ul>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {[
        { k: 'Amplify Site', text: 'Le site de votre restaurant, avec votre carte, vos photos et les commandes sur WhatsApp.', once: 'Création par nos soins : 250 DH une fois.', link: ROUTES.site[lang], cta: 'Voir Amplify Site' },
        { k: 'Amplify Commandes', text: 'Vos clients commandent depuis la table ou votre site, et les commandes arrivent sur un écran. Pas de caisse nécessaire.', once: 'Mise en place : 500 DH une fois.', link: ROUTES.pos[lang], cta: 'Voir Amplify POS' },
      ].map((c, i) => (
        <div class="tf flex flex-col rounded-[1.75rem] bg-paper p-6 ring-1 ring-line sm:p-8" style={`--d:${i * 120}ms`}>
          <p class="text-sm font-semibold text-green-deep">{tt(c.k)}</p>
          <p class="mt-3 flex-1 text-lg">{tt(c.text)}</p>
          <p class="mt-3 font-semibold">{tt(c.once)}</p>
          <a href={c.link} class="mt-4 inline-flex font-semibold text-green-deep underline underline-offset-4">{tt(c.cta)} →</a>
        </div>
      ))}
    </div>
    <p class="tf mt-6 text-sm font-semibold text-muted" style="--d:200ms">{p.pricing.soon}</p>
    <ul class="mt-2 flex flex-wrap gap-2">
      {['Réservations et file d’attente', 'Fidélité', 'Écran d’accueil', 'Péremption et traçabilité', 'Traiteur et devis'].map((x, i) => (
        <li class="tf rounded-full bg-paper px-4 py-2 text-[0.95rem] ring-1 ring-line" style={`--d:${200 + i * 70}ms`}>{tt(x)}</li>
      ))}
    </ul>
    <p class="tf mt-6 flex items-center gap-2 font-semibold text-green-deep"><Icon name="check" class="size-5" />{tt('Dès 3 services, regardez Essentiel : la caisse pour 199 DH.')}</p>
  </section>

  <PhotoBand name="pf-soir" alt={tt('Le service du soir dans un restaurant')} kicker={tt('Tarifs')} title={tt('Pas de surprise sur la facture.')} w={1600} h={686} pos="50% 55%" />

  <!-- one-off costs -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-24" aria-labelledby="uniques" data-tf>
    <h2 id="uniques" class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{tt('Les coûts uniques')}</h2>
    <p class="tf mt-4 max-w-2xl text-muted" style="--d:80ms">{tt('Tout ce qui n’est pas mensuel, au même endroit, pour que rien ne vous surprenne.')}</p>
    <ul class="mt-8 divide-y divide-line overflow-hidden rounded-[1.75rem] bg-paper px-6 ring-1 ring-line">
      {rows.map(([label, value], i) => (
        <li class="tf-x flex items-center justify-between gap-4 py-5" style={`--d:${i * 110}ms`}>
          <span class="text-lg font-medium">{label}</span>
          {i === 0 && typeof value === 'string'
            ? <span class="display shrink-0 rounded-full bg-green px-4 py-1 text-2xl text-navy">{value}</span>
            : <span class="shrink-0 text-end"><span class="display text-4xl" dir="ltr">{value}</span> <span class="text-sm text-muted">{tt('DH HT')}</span></span>}
        </li>
      ))}
    </ul>
  </section>

  <!-- everything included + calculator -->
  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 md:pb-24" aria-labelledby="inclus" data-tf>
    <h2 id="inclus" class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]">{p.pricing.included.title}</h2>
    <p class="tf mt-4 max-w-2xl text-muted" style="--d:80ms">{p.pricing.included.text}</p>
    <div class="mt-8"><PriceBuilder lang={lang} /></div>
  </section>

  <!-- what a mistake costs, running across the page -->
  <LeakTicker />
  <p class="mx-auto max-w-6xl px-4 pt-6 text-center font-semibold text-green-deep sm:px-6">{tt('Amplify Profit coûte 249 DH par mois.')}</p>

  <Faq lang={lang} items={faqItems} wa={wa} />

  <ProductFinal title={tt('Essayez 14 jours, sans carte.')} text={tt('Créez votre restaurant en quelques minutes. Une question sur le prix ? Écrivez-nous sur WhatsApp.')} cta={p.pricing.choose} href={signupUrl(lang)} wa={wa} waLabel={ui.whatsapp} where="pricing-final"
    steps={[tt('Compte créé'), tt('Menu importé depuis une photo'), tt('Tables et équipe ajoutées'), tt('Caisse prête')]} done={tt('Tout est prêt')} />
  <CountUp />
</Base>

<script>
  // sections reveal as they scroll in; a situation card scrolls to its plan and lights it up
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  if (still || !('IntersectionObserver' in window)) roots.forEach(r => r.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.18 });
    roots.forEach(r => io.observe(r));
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => a.addEventListener('click', (ev) => {
    const card = document.querySelectorAll<HTMLElement>('#formules .pr-card')[Number(a.dataset.pick)];
    if (!card) return;
    ev.preventDefault();
    card.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
    card.classList.remove('tf-pick'); void card.offsetWidth; card.classList.add('tf-pick');
    setTimeout(() => card.classList.remove('tf-pick'), 1800);
  }));
</script>
