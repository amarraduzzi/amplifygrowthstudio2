---
// Hotels page (Amplify Hotel): hotels, riads and guest houses. Linked from the home trades and the footer.
// Same look as the Pressing page: a live hero, then one live demo per part of the hotel's day, the prices, the FAQ.
// Built in steps; every demo copies the real screens of the reception app. Demo riad "Dar Lina", invented names.
// No clients, reviews or results are claimed.
import Base from '../../layouts/Base.astro';
import Faq from '../Faq.astro';
import SectorPrices from '../SectorPrices.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import Device from '../Device.astro';
import CountUp from '../CountUp.astro';
import HotelHeroBoard from '../HotelHeroBoard.astro';
import HotelDesk from '../HotelDesk.astro';
import HotelChannels from '../HotelChannels.astro';
import HotelSite from '../HotelSite.astro';
import HotelGuest from '../HotelGuest.astro';
import HotelWatch from '../HotelWatch.astro';
import HotelClean from '../HotelClean.astro';
import HotelBill from '../HotelBill.astro';
import { tr } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const title = tt('Logiciel pour hôtels et riads au Maroc : réception, Airbnb, Booking et site | Amplify');
const description = tt('Amplify Hotel : le planning des chambres, Airbnb et Booking synchronisés, votre site de réservation sans commission, l’arrivée en ligne, le ménage, la caisse de la réception et le rapport du propriétaire.');
const wa = tt('Bonjour, je voudrais voir Amplify Hotel pour mon établissement.');
const faq = [
  [tt('Je dois quitter Airbnb ou Booking ?'), tt('Non. Vous gardez vos annonces. Amplify lit leurs calendriers et leur envoie les chambres prises, pour éviter les doubles réservations. Les réservations de votre site passent sans commission.')],
  [tt('J’ai plusieurs chambres identiques sur Booking. Les calendriers suffisent ?'), tt('Pour une annonce avec plusieurs chambres, Amplify se connecte à Beds24, un gestionnaire de canaux que l’hôtel prend à son nom et paie directement à Beds24. Vous collez leur code dans Amplify et vous reliez vos types de chambres. Nous vous aidons à tout mettre en place.')],
  [tt('Ça marche pour un riad de 5 chambres ?'), tt('Oui. Tout est facultatif : la fiche de police, la taxe de séjour, les prix par saison ou l’acompte. Vous allumez ce qui vous sert, le reste ne vous gêne pas.')],
  [tt('Il me faut quel matériel ?'), tt('Une tablette ou un ordinateur à la réception, et le téléphone de chaque membre de l’équipe. Rien à installer pour vos clients.')],
  [tt('Mes clients doivent-ils installer une application ?'), tt('Non. Ils reçoivent un lien sur WhatsApp : arrivée en ligne, wifi, commandes, messages à la réception et leur note.')],
  [tt('Mon restaurant utilise déjà Amplify POS.'), tt('Les deux se parlent : le serveur met l’addition sur la chambre, et elle arrive sur la note du client à la réception.')],
  [tt('Qui installe tout ?'), tt('Nous. Vos chambres, vos prix, vos liens Airbnb et Booking, votre équipe, et nous formons la réception. C’est offert.')],
  [tt('Et si j’arrête ?'), tt('Sans engagement : vous arrêtez d’un mois à l’autre. Les 14 premiers jours sont gratuits.')],
];
const desk = [
  ['calendar', tt('Aujourd’hui en un regard'), tt('L’occupation de ce soir, les arrivées et les départs. Ce qui est en retard remonte en premier.')],
  ['users', tt('Arrivée en deux gestes'), tt('L’identité scannée, la fiche de police remplie toute seule si vous l’utilisez. La chambre passe en Occupée.')],
  ['check', tt('Le ménage suit'), tt('Au départ, la chambre passe en Ménage. Quand elle est propre, la réception le voit sans téléphoner.')],
  ['wallet', tt('La note juste'), tt('Les nuits, les extras, le restaurant et la taxe de séjour sur une note. Le client paie, la chambre se libère.')],
];
const site = [
  ['coins', tt('Sans commission'), tt('Le client réserve chez vous. Pas 15 à 18 % pour une plateforme.')],
  ['calendar', tt('Le prix de chaque nuit'), tt('Un calendrier avec vos prix du week-end et des saisons. Un seul prix toute l’année ? Ça marche aussi.')],
  ['gift', tt('Extras et code promo'), tt('Petit-déjeuner, transfert, dîner : le client les ajoute en réservant. Vos codes promo pour les habitués.')],
  ['shield', tt('Acompte ou confirmation immédiate'), tt('Vous demandez un acompte, ou la chambre est réservée tout de suite. C’est vous qui choisissez.')],
];
const guest = [
  ['clock', tt('Une chambre gardée, avec l’heure'), tt('Le client voit jusqu’à quelle heure sa chambre l’attend. Il touche « J’arrive », ou il annule et la chambre revient à la vente.')],
  ['users', tt('L’arrivée faite avant d’arriver'), tt('Heure d’arrivée et fiches remplies depuis son téléphone. À la réception, il ne reste qu’à donner la clé.')],
  ['camera', tt('Le passeport remplit la fiche'), tt('Une photo du passeport ou de la CIN, et la fiche de police se remplit toute seule. La réception vérifie et enregistre.')],
  ['gift', tt('Les commandes sur la note'), tt('Petit-déjeuner, transfert, dîner : le client commande depuis sa page, la réception accepte, c’est sur la note.')],
];
const watch = [
  ['door', tt('Une chambre utilisée sans client'), tt('Chaque matin, le ménage regarde les chambres où personne n’a dormi. Une chambre utilisée vous est signalée tout de suite.')],
  ['wallet', tt('La caisse qui ne tombe pas juste'), tt('À chaque remise de caisse, l’écart avec le nom de l’employé. Vous choisissez à partir de quel montant.')],
  ['shield', tt('Ce qui change après l’arrivée'), tt('Un séjour annulé, raccourci ou moins cher après l’arrivée, un client parti sans tout payer, une chambre marquée « payée ailleurs ».')],
  ['bell', tt('Le bilan du soir'), tt('À l’heure que vous choisissez : chambres, argent encaissé, caisse, arrivées de demain et ce qu’il faut vérifier.')],
];
const clean = [
  ['calendar', tt('Le plan du ménage, calculé'), tt('Les chambres à faire, l’heure prévue pour chacune et l’heure limite quand un client arrive. Selon le nombre de personnes ce jour-là.')],
  ['phone', tt('Sur le téléphone de l’équipe'), tt('Un lien, sans code ni application. En français, en arabe ou en anglais, et sans le nom des clients.')],
  ['bell', tt('Une panne, un technicien'), tt('Le ménage ou la réception signale une panne. Le technicien la voit sur son téléphone et la marque réparée.')],
  ['shirt', tt('Le linge suivi'), tt('Draps et serviettes en réserve, au lavage ou perdus : vous savez ce que vous avez avant de racheter.')],
];
const money = [
  ['calendar', tt('Vos prix, à votre façon'), tt('Un prix toute l’année, ou des prix par saison, week-end et durée de séjour. Et un prix convenu à la réception quand il le faut.')],
  ['shield', tt('Acompte et annulation'), tt('Un acompte à la réservation et vos règles d’annulation. Ou rien du tout : c’est vous qui choisissez.')],
  ['wallet', tt('La caisse de la réception'), tt('Espèces, carte et virement. Chaque remise de caisse est comptée, avec le nom de l’employé.')],
  ['chart', tt('Le rapport du propriétaire'), tt('Occupation, prix moyen, revenu par chambre et par canal, sur le mois ou l’année.')],
];
const schema = [serviceSchema('Amplify Hotel', description, abs(ROUTES.hotel[lang])), faqSchema(faq)].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="hotel" title={title} description={description} wa={wa} schema={schema}>
  <!-- hero: the bookings of every channel land on one planning -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.15fr] lg:gap-12 lg:pb-14">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>{tt('Hôtels, riads et maisons d’hôtes')}</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{tt('Une réception.')}</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">{tt('Pour tout l’hôtel.')}<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">{tt('Airbnb, Booking, votre site et la réception sur un seul planning. Le client arrive enregistré, la chambre est prête, la note est juste. Et vous voyez tout depuis votre téléphone.')}</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="hotel-hero" class="px-7 text-lg" />
          <a href="#tarifs" class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-paper">{tt('Voir les tarifs')}</a>
        </div>
      </div>

      <div class="relative isolate aspect-[4/3.6] overflow-hidden rounded-[1.75rem] bg-navy lg:aspect-[5/4.6] lg:rounded-[2.25rem]">
        <span class="sl-scene absolute inset-0 -z-20" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
        <span class="shadow-in absolute start-[8%] top-[80%] h-6 w-[80%] rounded-[50%] bg-black/55 blur-xl" style="--d:700ms" aria-hidden="true"></span>
        <div class="land absolute start-[5%] top-[12%] w-[90%]" style="--d:300ms">
          <Device w={1200} h={900}><HotelHeroBoard slot="screen" /></Device>
        </div>
        <div class="absolute start-[4%] top-[3.5%] z-10"><div class="tf-float"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:2600ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-[#FF5A5F] text-white sm:size-7"><Icon name="calendar" class="size-3.5 sm:size-4" /></span>{tt('Airbnb : chambre 107 bloquée partout')}</p></div></div>
        <div class="absolute bottom-[5%] end-[4%] z-10"><div class="tf-float" style="--d:1200ms"><p class="chat-in flex items-center gap-2 rounded-full bg-green py-1.5 pe-3.5 ps-3 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:4200ms" aria-hidden="true"><span class="sl-live size-2 rounded-full bg-navy"></span>{tt('Chambre 104 : propre, prête à 14:00')}</p></div></div>
        <div class="absolute bottom-[5%] start-[4%] z-10 hidden sm:block"><div class="tf-float" style="--d:2400ms"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:5800ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-[#25D366] text-white sm:size-7"><Icon name="message" class="size-3.5 sm:size-4" /></span>{tt('Sara est enregistrée')}</p></div></div>
      </div>
    </div>

    <!-- three facts -->
    <div class="border-y border-line bg-paper">
      <ul class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:py-6">
        {[['1', tt('planning pour Airbnb, Booking, votre site et la réception')], ['0', tt('commission sur les réservations de votre site')], ['14', tt('jours gratuits, sans engagement')]].map(([n, l]) => (
          <li class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><span class="display text-5xl text-navy md:text-6xl" data-count={n} dir="ltr">{n}</span><span class="text-[0.78rem] leading-snug text-muted md:max-w-[13rem] md:text-[0.95rem]">{l}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- the reception's day: the room board on the tablet, hour by hour -->
  <section id="reception" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-x-14 lg:gap-y-8">
      <div class="tf-x lg:col-start-1 lg:row-start-1">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Toute la journée.')}</span><span class="block text-green-deep">{tt('Sur un seul écran.')}</span></h2>
        <p class="mt-5 max-w-xl text-lg text-muted">{tt('La réception voit chaque chambre : libre, occupée, au ménage ou hors service. Touchez une heure pour voir la journée avancer, ou une chambre pour l’ouvrir.')}</p>
      </div>
      <div class="tf lg:col-start-2 lg:row-span-2 lg:row-start-1" style="--d:120ms"><HotelDesk /></div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:col-start-1 lg:row-start-2 lg:grid-cols-1">
        {desk.map(([ic, h, x], i) => (
          <li class="tf flex gap-4" style={`--d:${i * 90 + 100}ms`}><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-mint text-green-deep"><Icon name={ic} class="size-5" /></span><span><b class="block text-lg">{h}</b><span class="text-muted">{x}</span></span></li>))}
      </ul>
    </div>
  </section>

  <!-- the channels: three calendars become one, each one closes what the others sold -->
  <section id="canaux" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="tf relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy p-6 text-white md:p-14">
      <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
      <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Airbnb, Booking, votre site.')}</span><span class="block text-green">{tt('Une nuit vendue une fois.')}</span></h2>
      <p class="mt-5 max-w-2xl text-lg text-white/75">{tt('Amplify lit les calendriers d’Airbnb et de Booking, et leur renvoie les nuits déjà prises. Vous gardez vos annonces. Si deux réservations tombent quand même sur le même soir, la réception le voit tout de suite et déplace le client.')}</p>
      <div class="mt-10"><HotelChannels /></div>
      <div class="mt-10 grid gap-px overflow-hidden rounded-[1.6rem] bg-white/10 md:grid-cols-2">
        <div class="tf bg-navy p-6 md:p-8" style="--d:100ms">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-white/55">{tt('Calendriers iCal')} · <span class="text-green">{tt('inclus')}</span></p>
          <p class="mt-3 text-xl font-semibold md:text-2xl">{tt('Pour une annonce, une chambre.')}</p>
          <p class="mt-2 text-white/70">{tt('Le lien de chaque chambre va dans Airbnb et Booking, le leur vient dans Amplify. La mise à jour prend quelques minutes, parfois plus selon la plateforme.')}</p>
        </div>
        <div class="tf bg-navy p-6 md:p-8" style="--d:200ms">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-white/55">Beds24 · {tt('gestionnaire de canaux')}</p>
          <p class="mt-3 text-xl font-semibold md:text-2xl">{tt('Plusieurs chambres. Prix et disponibilités.')}</p>
          <p class="mt-2 text-white/70">{tt('Pour une annonce Booking avec plusieurs chambres identiques. L’hôtel prend son compte Beds24 et le paie directement à Beds24. Il colle leur code dans Amplify, relie ses types de chambres, et c’est connecté.')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- the hotel's own booking site: three styles, the hotel's colour, a guest books by itself -->
  <section id="site" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1fr] lg:gap-14">
      <div class="tf-x">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Votre site de réservation.')}</span><span class="block text-green-deep">{tt('Trois styles. Votre couleur.')}</span></h2>
        <p class="mt-5 max-w-xl text-lg text-muted">{tt('Vos photos, vos chambres et vos prix sur votre propre site. Vous choisissez le style dans votre espace : Atelier, Nuit ou Carnet. Essayez-les, et regardez un client réserver.')}</p>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2">
          {site.map(([ic, h, x], i) => (
            <li class="tf flex gap-4" style={`--d:${i * 90 + 100}ms`}><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-mint text-green-deep"><Icon name={ic} class="size-5" /></span><span><b class="block text-lg">{h}</b><span class="text-muted">{x}</span></span></li>))}
        </ul>
      </div>
      <div class="tf" style="--d:120ms"><HotelSite /></div>
    </div>
  </section>

  <!-- the guest's stay: kept room, arrival online, the passport fills the fiche, orders on the bill -->
  <section id="sejour" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1fr] lg:gap-14">
      <div class="tf order-2 lg:order-1" style="--d:120ms"><HotelGuest /></div>
      <div class="tf-x order-1 lg:order-2">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Le client a son lien.')}</span><span class="block text-green-deep">{tt('Pas d’application.')}</span></h2>
        <p class="mt-5 max-w-xl text-lg text-muted">{tt('Sur WhatsApp, le client reçoit la page de son séjour, dans le style de votre site. De la réservation au départ, tout se passe là.')}</p>
      </div>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {guest.map(([ic, h, x], i) => (
        <li class="tf" style={`--d:${i * 90 + 100}ms`}><span class="grid size-11 place-items-center rounded-2xl bg-mint text-green-deep"><Icon name={ic} class="size-5" /></span><b class="mt-3 block text-lg">{h}</b><span class="text-muted">{x}</span></li>))}
    </ul>
  </section>

  <!-- the owner's control: what can hide a room sold for cash, on his phone -->
  <section id="controle" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="tf relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy p-6 text-white md:p-14">
      <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
      <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
        <div>
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Vous n’êtes pas à l’hôtel.')}</span><span class="block text-green">{tt('Vous savez tout.')}</span></h2>
          <p class="mt-5 max-w-xl text-lg text-white/75">{tt('Une chambre vendue en espèces sans être enregistrée ne laisse pas de trace. Sauf ici : Amplify croise le ménage, les séjours et la caisse, et vous prévient sur votre téléphone.')}</p>
        </div>
        <div class="tf" style="--d:120ms"><HotelWatch /></div>
      </div>
      <ul class="mt-10 grid gap-6 border-t border-white/10 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        {watch.map(([ic, h, x], i) => (
          <li class="tf" style={`--d:${i * 90 + 100}ms`}><span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-green"><Icon name={ic} class="size-5" /></span><b class="mt-3 block text-lg">{h}</b><span class="text-white/70">{x}</span></li>))}
      </ul>
    </div>
  </section>

  <!-- housekeeping and repairs: the team's phone and the reception's tiles -->
  <section id="menage" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="tf-x max-w-3xl">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Le ménage sait quoi faire.')}</span><span class="block text-green-deep">{tt('La réception le voit.')}</span></h2>
      <p class="mt-5 max-w-xl text-lg text-muted">{tt('Plus de coups de téléphone pour savoir si une chambre est prête. L’équipe a sa liste sur son téléphone, et chaque chambre propre apparaît libre à la réception.')}</p>
    </div>
    <div class="tf mt-10" style="--d:120ms"><HotelClean /></div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {clean.map(([ic, h, x], i) => (
        <li class="tf" style={`--d:${i * 90 + 100}ms`}><span class="grid size-11 place-items-center rounded-2xl bg-mint text-green-deep"><Icon name={ic} class="size-5" /></span><b class="mt-3 block text-lg">{h}</b><span class="text-muted">{x}</span></li>))}
    </ul>
  </section>

  <!-- the money: the bill of the stay, the payment, the invoice -->
  <section id="argent" class="scroll-mt-20 border-y border-line bg-paper px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="mx-auto max-w-6xl">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
        <div class="tf-x">
          <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Une note juste.')}</span><span class="block text-green-deep">{tt('Rien d’oublié.')}</span></h2>
          <p class="mt-5 max-w-xl text-lg text-muted">{tt('Les nuits, les commandes, l’addition du restaurant, la taxe de séjour et l’acompte arrivent tout seuls sur la note. Le client paie, part, et reçoit sa facture sur WhatsApp.')}</p>
        </div>
        <div class="tf" style="--d:120ms"><HotelBill /></div>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {money.map(([ic, h, x], i) => (
          <li class="tf" style={`--d:${i * 90 + 100}ms`}><span class="grid size-11 place-items-center rounded-2xl bg-mint text-green-deep"><Icon name={ic} class="size-5" /></span><b class="mt-3 block text-lg">{h}</b><span class="text-muted">{x}</span></li>))}
      </ul>
    </div>
  </section>


  <SectorPrices lang={lang} k="hotel" />

  <Faq lang={lang} items={faq} wa={wa} />

  <!-- final -->
