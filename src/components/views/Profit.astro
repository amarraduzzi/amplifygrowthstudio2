---
// Amplify Profit product page (was posamplify.pages.dev/profit), in the Amplify Growth Studio style.
import Base from '../../layouts/Base.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import Pricing from '../Pricing.astro';
import Faq from '../Faq.astro';
import ProductFinal from '../ProductFinal.astro';
import ProfitCard from '../ProfitCard.astro';
import ProfitPains from '../ProfitPains.astro';
import ProfitFeatures from '../ProfitFeatures.astro';
import ProfitHow from '../ProfitHow.astro';
import ProfitLoss from '../ProfitLoss.astro';
import BillingToggle from '../BillingToggle.astro';
import PhotoBand from '../PhotoBand.astro';
import { SITE, signupUrl } from '../../config';
import { copy } from '../../i18n';
import { posOf, profitOf } from '../../i18n/content';
import type { Plan } from '../../i18n/products-fr';
import { tr, langOf } from '../../i18n/t';
const LG = langOf(Astro.url);
const tt = tr(LG);
const p = profitOf(LG);
const posFr = posOf(LG);
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy(lang);
const title = tt('Marge et food cost restaurant au Maroc | Amplify Profit');
const description = tt('Amplify Profit calcule le coût et la marge de chaque plat, et le bon prix de vente. Avec votre caisse actuelle. 14 jours gratuits, sans engagement.');
const wa = tt('Bonjour, j’ai une question sur Amplify Profit.');
// illustration: tajine poulet citron, 95 DH TTC (VAT 10 %)
const COST = 28.2, PRICE = 95, HT = PRICE / 1.1;
const money = (n: number) => `${n.toFixed(2).replace('.', ',')} DH`;
const fc = ((COST / HT) * 100).toFixed(1).replace('.', ',');
const plans: Plan[] = [
  { name: p.pricing.alone.name, tag: 'Amplify Profit', price: '249', text: p.pricing.alone.text, items: p.pricing.alone.items, product: 'profit' },
  { name: p.pricing.both.name, tag: p.pricing.both.tag, price: '499', text: p.pricing.both.text, items: p.pricing.both.items, featured: true },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Amplify Profit', applicationCategory: 'BusinessApplication', operatingSystem: 'Web',
    url: abs(ROUTES.profit[lang]), description, offers: plans.map(x => ({ '@type': 'Offer', name: x.name, price: x.price, priceCurrency: 'MAD' })), publisher: { '@id': `${SITE.url}/#business` } },
  faqSchema(p.faq.items),
].filter(Boolean) as Record<string, unknown>[];
---
<Base lang={lang} page="profit" title={title} description={description} wa={wa} schema={schema}>
  <!-- hero -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-14 pt-8 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:pt-14">
    <div>
      <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Amplify Profit</p>
      <h1 class="mt-5 text-[clamp(2.7rem,4.8vw,4.6rem)]">
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{p.hero.title1}</span></span>
        <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-green-deep" style="--d:200ms">{p.hero.title2}</span></span>
      </h1>
      <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">{p.hero.text}</p>
      <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
        <a href={signupUrl(lang, 'profit')} class="inline-flex min-h-12 items-center rounded-full bg-green px-7 text-lg font-semibold text-navy hover:bg-[#04A859]">{p.hero.cta}</a>
        <a href="#comment" class="inline-flex min-h-12 items-center rounded-full border border-navy/25 px-6 text-lg hover:border-navy">{p.hero.cta2}</a>
      </div>
      <p class="fade-up mt-3 text-sm text-muted" style="--d:450ms">{p.hero.note}</p>
    </div>

    <ProfitCard />
  </section>

  <!-- the problem -->
  <ProfitPains />

  <PhotoBand name="pf-soir" alt={tt('Un patron de restaurant fait ses comptes seul au comptoir, tard le soir')} kicker={tt('23:40, après le service')} title={tt('Le service est fini. La vraie question commence.')} w={1376} h={768} class="py-16 md:py-20" pos="70% 50%" />

  <!-- what you get -->
  <ProfitFeatures />

  <!-- how it works -->
  <!-- costs to the gram -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 md:grid-cols-[0.9fr_1.1fr]">
    <figure class="pfc relative overflow-hidden rounded-[2rem]">
      <img src="/img/pf-chef.webp" alt={tt('Un chef pèse le poulet et les citrons confits d’un tajine sur une balance de cuisine')} width="896" height="1200" loading="lazy" decoding="async" class="pfc-img aspect-[4/5] h-auto w-full object-cover" />
      <figcaption class="pfc-tag absolute bottom-5 start-5 end-5 rounded-2xl bg-white/95 p-4 text-navy shadow-xl backdrop-blur" aria-hidden="true">
        <p class="text-xs font-semibold text-muted">{tt('Fiche technique')} · <x-notr>Tajine poulet citron</x-notr></p>
        <div class="mt-2 space-y-1 text-sm">
          {[['Poulet', '350 g', '9,80'], ['Citron confit', '40 g', '0,90'], ['Olives', '30 g', '1,20']].map(([n, q, c], i) => <p class="pfc-row flex justify-between gap-3" style={`--i:${i}`}><span>{tt(n)} <span class="text-muted">{q}</span></span><b class="tabular-nums">{c} DH</b></p>)}
        </div>
      </figcaption>
    </figure>
    <div>
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Chaque gramme')}</span><span class="block text-green-deep">{tt('a un prix.')}</span></h2>
      <p class="mt-5 max-w-lg text-lg text-muted">{tt('Vos fiches techniques au gramme près, remplies par l’IA à partir de votre carte. Vous corrigez ce qui ne va pas, et le coût de chaque plat se calcule tout seul.')}</p>
      <p class="mt-3 max-w-lg text-lg text-muted">{tt('Un fournisseur augmente le poulet ? Vous le voyez sur la facture, et vous savez quels plats en souffrent.')}</p>
    </div>
  </section>

  <ProfitHow lang={lang} />

  <!-- pricing -->
  <section id="tarifs" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
    <h2 class="max-w-3xl text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Un seul plat mal calculé</span><span class="block text-[#C4282D]">vous coûte plus cher.</span></h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">{tt('Plus cher que l’abonnement. Faites le calcul vous-même.')} {p.pricing.note}</p>
    <div class="mt-12"><ProfitLoss /></div>
    <div class="mt-14 flex justify-center"><BillingToggle /></div>
    <div class="mt-6"><Pricing plans={plans} per={p.pricing.per} choose={p.pricing.choose} popular={p.pricing.best} lang={lang} /></div>
  </section>

  <Faq lang={lang} items={p.faq.items} wa={wa} />

  <ProductFinal title={p.final.title} text={p.final.text} cta={p.final.cta} href={signupUrl(lang, 'profit')} wa={wa} waLabel={t.ui.whatsapp} where="profit-final"
    steps={['Compte créé', 'Carte importée en photo', 'Coûts estimés par l’IA', 'Premières marges visibles']} done="Vos marges sont prêtes" />
</Base>

<style is:global>
  .pfc-img { transform: scale(1.1); transition: transform 2.6s cubic-bezier(.2,.8,.2,1); }
  .pfc.seen .pfc-img { transform: scale(1); }
  .js .pfc-tag { opacity: 0; transform: translateY(16px); }
  .pfc.seen .pfc-tag { animation: pfc-in .6s cubic-bezier(.2,.8,.2,1) .6s both; }
  .js .pfc-row { opacity: 0; }
  .pfc.seen .pfc-row { animation: pfc-in .4s ease both; animation-delay: calc(1s + var(--i) * .2s); }
  @keyframes pfc-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pfc-img { transform: none; transition: none; } .js .pfc-tag, .js .pfc-row { opacity: 1; transform: none; } .pfc.seen .pfc-tag, .pfc.seen .pfc-row { animation: none; } }
</style>
<script>
  const pfc = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('seen'); pfc.unobserve(e.target); } }), { threshold: 0.3 });
  document.querySelectorAll('.pfc').forEach(n => pfc.observe(n));
</script>
