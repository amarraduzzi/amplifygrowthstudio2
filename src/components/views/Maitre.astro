---
// Amplify Maître: the fine dining page. The option (+249 DH HT / month) on top of Restaurant or Contrôle,
// for the places where the service makes the difference. A dark, quiet page: the room at night, a guest
// who calls the bill from his table and the table that lights up, the rhythm of the evening that moves by
// itself, the kitchen ticket with the allergy, the deposit for the big tables and the formules, a no-show
// calculator, the price and the FAQ. Real screenshots of the demo café Dar Nour; everything else is labelled
// as an example. No clients, reviews or results are claimed.
import Base from '../../layouts/Base.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import { tr } from '../../i18n/t';
import { ROUTES, abs, type Lang } from '../../i18n/routes';
import { faqSchema, serviceSchema } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const title = tt('Amplify Maître : le logiciel du restaurant gastronomique au Maroc | Amplify');
const description = tt('Pour le fine dining : le client appelle discrètement depuis sa table, le rythme de la soirée table par table, la fiche client et les allergies sur le bon cuisine, l’avant-service, l’acompte des grandes tables et les formules. Une option de la caisse Amplify POS.');
const wa = tt('Bonjour, je voudrais voir Amplify Maître en démo.');
const loc = lang === 'en' ? 'en-US' : lang === 'ar' ? 'ar-MA' : 'fr-FR';
const faq = [
  [tt('Mes clients doivent-ils installer une application ?'), tt('Non. Ils scannent le QR de leur table : la page s’ouvre dans le téléphone, avec trois boutons. Rien à installer, rien à créer.')],
  [tt('Le client peut-il appeler dix fois de suite ?'), tt('Non. Une seule demande ouverte par type et par table. Tant que le serveur n’a pas répondu, un nouvel appui ne fait pas sonner une deuxième fois.')],
  [tt('Les allergies arrivent-elles vraiment en cuisine ?'), tt('Oui. L’allergie notée sur la fiche du client s’imprime sur chaque bon cuisine de sa table, en haut, bien visible. Elle apparaît aussi dans l’avant-service.')],
  [tt('L’acompte est-il payé en ligne ?'), tt('Il est reçu à la caisse (espèces, carte ou virement), ce qui confirme la réservation. Le jour J, il se déduit de l’addition. Si personne ne vient, il est remboursé ou gardé, avec le code d’un responsable.')],
  [tt('Faut-il un écran en cuisine pour le rythme de la soirée ?'), tt('Non. Avec un écran cuisine, chaque table sait si son plat est en préparation ou prêt. Sans écran, la caisse montre ce qu’elle sait : les plats envoyés, les plats servis et depuis quand.')],
  [tt('Puis-je arrêter Maître ?'), tt('Oui, d’un mois à l’autre. Les acomptes déjà reçus restent valables, et le plan de salle et les allergies sur le bon cuisine restent pour tout le monde.')],
];
const schema = [serviceSchema('Amplify Maître', description, abs(ROUTES.maitre[lang])), faqSchema(faq)].filter(Boolean) as Record<string, unknown>[];
const calls = [['waiter', tt('Un serveur'), 'users'], ['water', tt('De l’eau'), 'cup'], ['bill', tt('L’addition'), 'wallet']] as const;
// the room: table, guests, state (cook = in the kitchen, ready = to serve, wait = waiting for the next course, eat = eating), minutes
const room: [string, number, string, number][] = [['1', 2, 'eat', 12], ['2', 4, 'cook', 6], ['3', 2, 'wait', 9], ['4', 6, 'ready', 1], ['5', 2, 'eat', 22], ['6', 8, 'cook', 14], ['7', 4, 'eat', 31], ['8', 2, 'wait', 3]];
const brief = [
  ['users', tt('Couverts par demi-heure'), tt('Pour régler la cuisine et la salle avant d’ouvrir.')],
  ['shield', tt('Allergies et régimes'), tt('Table par table, avant le premier plat.')],
  ['star', tt('VIP et habitués'), tt('Avec ce qu’ils prennent d’habitude.')],
  ['cake', tt('Anniversaires et occasions'), tt('La bougie est prête avant le dessert.')],
  ['bell', tt('Absents la dernière fois'), tt('Un appel de confirmation avant de garder la table.')],
] as const;
const formules = [
  ['calendar', tt('Ftour du Ramadan'), tt('Heure fixe, couverts par soir, menu par personne.')],
  ['users', tt('Menus de groupe'), tt('Séminaires, familles, anniversaires : un choix par invité.')],
  ['star', tt('Soirées spéciales'), tt('Saint-Valentin, Nouvel An, soirée chef : réservées en ligne.')],
] as const;
---
<Base lang={lang} page="maitre" title={title} description={description} wa={wa} schema={schema}>
  <!-- HERO: the room at night; one table asks for the bill -->
  <section class="relative isolate overflow-hidden bg-navy text-white" data-scrub>
    <img src="/img/photos/mk-salle-pleine-1600.webp" srcset="/img/photos/mk-salle-pleine-800.webp 800w, /img/photos/mk-salle-pleine-1600.webp 1536w" sizes="100vw" alt="" width="1536" height="1024" class="mt-kb absolute inset-0 -z-20 size-full object-cover opacity-30" />
    <span class="absolute inset-0 -z-10 bg-[radial-gradient(70%_80%_at_80%_20%,rgba(124,92,255,.22),transparent_60%),linear-gradient(180deg,rgba(0,30,62,.55),#001E3E_85%)]" aria-hidden="true"></span>
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-12 sm:px-6 md:pt-20 lg:grid-cols-[1fr_1.05fr]">
      <div>
        <p class="fade-up inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold ring-1 ring-white/15 backdrop-blur"><Icon name="star" class="size-4 text-[#C9B8FF]" />{tt('Fine dining')}<span class="text-white/40" aria-hidden="true">/</span><span class="text-white/75">{tt('une option de la caisse')}</span></p>
        <h1 class="mt-5 text-[clamp(3rem,6vw,5.4rem)] leading-[0.92]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">{tt('La grande table.')}</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block text-[#C9B8FF]" style="--d:220ms">{tt('Sans un oubli.')}</span></span>
        </h1>
        <p class="fade-up mt-6 max-w-xl text-lg text-white/75 md:text-xl" style="--d:300ms">{tt('Amplify Maître, c’est la salle qui sait tout : qui arrive ce soir, ce qu’il aime, ce qu’il ne peut pas manger, quelle table attend son plat et laquelle vous appelle. Discrètement.')}</p>
        <div class="fade-up mt-8 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="maitre-hero" class="px-7 text-lg" />
          <a href="#prix" class="inline-flex min-h-12 items-center rounded-full border border-white/30 px-6 text-lg font-semibold hover:border-white">{tt('+249 DH HT / mois')}</a>
        </div>
      </div>
      <div class="fade-up relative pb-[14%] pe-[12%]" style="--d:250ms">
        <div class="mt-float"><Device src="/img/maitre-salle.webp" alt={tt('La salle sur la caisse : chaque table avec son plat en cours, une table qui demande l’addition')} w={1200} h={878} eager /></div>
        <div class="mt-float2 absolute bottom-0 end-0 w-[32%]"><Device kind="phone" src="/img/maitre-service-phone.webp" alt={tt('Sur le téléphone du client : un serveur, de l’eau, l’addition')} w={600} h={1298} class="rotate-[3deg]" /></div>
        <span class="mt-ring pointer-events-none absolute start-[38%] top-[30%] grid size-14 place-items-center rounded-full" aria-hidden="true"></span>
      </div>
    </div>
    <dl class="relative border-t border-white/10 bg-white/[0.03]" data-rv>
      <div class="mx-auto grid max-w-6xl gap-4 px-4 py-6 sm:grid-cols-3 sm:px-6">
        {[['6', tt('outils pour le service')], ['1', tt('option, sans engagement')], ['0', tt('application à installer pour vos clients')]].map(([n, l]) => (
          <div class="mt-fact flex items-center gap-4"><dt class="display text-5xl tabular-nums text-[#C9B8FF]" data-cnt={n}>{n}</dt><dd class="text-sm leading-snug text-white/70">{l}</dd></div>
        ))}
      </div>
    </dl>
  </section>

  <!-- INTERLUDE: the promise, word by word as you scroll -->
  <section class="bg-[#0B1530] px-4 pt-16 text-white sm:px-6 md:pt-28">
    <p class="mx-auto max-w-5xl text-[clamp(2rem,4.6vw,3.8rem)] font-semibold leading-[1.08] tracking-tight" data-scrub="words">{tt('Le meilleur service, c’est celui qu’on ne voit pas. Pas de main levée, pas d’allergie répétée, pas de table oubliée.').split(' ').map(w => <span class="word">{w} </span>)}</p>
  </section>

  <!-- THE DISCREET CALL: tap on the guest's phone, the table lights up -->
  <section id="service" class="scroll-mt-24 bg-[#0B1530] py-16 text-white md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Le service discret.')}</span><span class="block text-[#C9B8FF]">{tt('Personne ne lève la main.')}</span></h2>
        <p class="mt-5 max-w-2xl text-lg text-white/70">{tt('Depuis le QR de sa table, le client demande un serveur, de l’eau ou l’addition. La table s’allume en violet sur la caisse et sur les téléphones des serveurs, avec un petit son. Un « C’est fait », et le client voit que c’est en route.')}</p>
      </div>
      <div class="mt-12 grid items-center gap-10 lg:grid-cols-[0.75fr_1.25fr]" data-call>
        <!-- the guest -->
        <div class="mx-auto w-full max-w-[17rem]">
          <div class="rounded-[2.6rem] bg-linear-to-b from-[#3A3F47] to-[#1C1F24] p-2 shadow-[0_40px_70px_-30px_rgba(0,0,0,.8)]">
            <div class="rounded-[2.2rem] bg-[#FAF8F3] px-4 pb-6 pt-8 text-navy">
              <p class="text-center text-xs font-semibold text-muted">{tt('Dar Nour · Table 7')}</p>
              <p class="display mt-2 text-center text-2xl">{tt('Besoin de quelque chose ?')}</p>
              <div class="mt-5 space-y-2.5">
                {calls.map(([k, l, ic]) => (
                  <button type="button" class="mt-call flex min-h-14 w-full items-center gap-3 rounded-2xl bg-white px-4 font-bold shadow-sm ring-1 ring-line transition-all active:scale-[.98]" data-k={k}>
                    <span class="grid size-9 place-items-center rounded-xl bg-[#7C5CFF]/10 text-[#5B3FE0]"><Icon name={ic} class="size-5" /></span>{l}
                    <span class="mt-sent ms-auto hidden text-xs font-semibold text-[#5B3FE0]">{tt('Envoyé')}</span>
                  </button>
                ))}
              </div>
              <p class="mt-4 min-h-10 text-center text-sm text-muted" data-guest>{tt('Touchez une demande.')}</p>
            </div>
          </div>
        </div>
        <!-- the room on the till -->
        <div class="rounded-[2rem] bg-white/[0.04] p-5 ring-1 ring-white/10 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="font-semibold">{tt('La salle')}</p>
            <p class="min-h-8 rounded-full bg-[#7C5CFF] px-3 py-1 text-sm font-bold opacity-0 transition-opacity" data-bar></p>
          </div>
          <div class="mt-5 grid grid-cols-4 gap-3">
            {['1', '2', '3', '4', '5', '6', '7', '8'].map(n => (
              <div class={`mt-table relative grid aspect-square place-items-center rounded-2xl bg-white/[0.06] ring-1 ring-white/10 transition-all duration-300 ${n === '7' ? 'is-7' : ''}`}>
                <span class="display text-3xl">{n}</span>
                {n === '7' && <span class="mt-badge absolute -top-2 end-[-6px] hidden rounded-full bg-[#7C5CFF] px-2 py-0.5 text-[0.65rem] font-bold" data-badge></span>}
              </div>
            ))}
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="button" class="hidden min-h-11 items-center gap-2 rounded-full bg-green px-5 font-bold text-navy transition-transform active:scale-95" data-done><Icon name="check" class="size-4" />{tt('C’est fait')}</button>
            <p class="text-sm text-white/60" data-room>{tt('Aussi sur le téléphone de chaque serveur.')}</p>
          </div>
        </div>
      </div>
      <span hidden data-t-waiter>{tt('Table 7 · un serveur')}</span>
      <span hidden data-t-water>{tt('Table 7 · de l’eau')}</span>
      <span hidden data-t-bill>{tt('Table 7 · l’addition')}</span>
      <span hidden data-t-sent>{tt('C’est reçu. Un serveur arrive.')}</span>
      <span hidden data-t-ok>{tt('Votre serveur arrive.')}</span>
    </div>
  </section>

  <!-- THE RHYTHM OF THE EVENING: the room moves by itself -->
  <section id="rythme" class="scroll-mt-24 bg-navy py-16 text-white md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Le rythme')}</span><span class="block text-[#C9B8FF]">{tt('de la soirée.')}</span></h2>
        <p class="mt-5 max-w-md text-lg text-white/70">{tt('Chaque table montre où elle en est et depuis quand : en cuisine, prête à servir, en attente du plat suivant, en train de manger. Celle qui attend trop change de couleur. Au-dessus de la salle, le résumé de la soirée.')}</p>
        <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold" data-rv>
          <li class="rv flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5"><span class="size-2.5 rounded-full bg-[#F5B301]"></span>{tt('En cuisine')}</li>
          <li class="rv flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5"><span class="size-2.5 rounded-full bg-green"></span>{tt('Prêt à servir')}</li>
          <li class="rv flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5"><span class="size-2.5 rounded-full bg-[#7FB3FF]"></span>{tt('Attend la suite')}</li>
          <li class="rv flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5"><span class="size-2.5 rounded-full bg-white/50"></span>{tt('Mange')}</li>
        </ul>
      </div>
      <div class="rounded-[2rem] bg-white/[0.04] p-5 ring-1 ring-white/10 sm:p-6" data-rhythm>
        <div class="grid grid-cols-3 gap-2 text-center text-xs font-semibold text-white/70 sm:text-sm">
          <p class="rounded-xl bg-white/[0.06] px-2 py-2"><span class="display block text-2xl text-white" data-sum="cook">2</span>{tt('en cuisine')}</p>
          <p class="rounded-xl bg-white/[0.06] px-2 py-2"><span class="display block text-2xl text-white" data-sum="ready">1</span>{tt('à servir')}</p>
          <p class="rounded-xl bg-white/[0.06] px-2 py-2"><span class="display block text-2xl text-white" data-sum="wait">2</span>{tt('attendent')}</p>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {room.map(([n, g, st, m]) => (
            <div class="rh-t rounded-2xl p-3 ring-1 ring-white/10 transition-colors duration-500" data-st={st} data-m={m}>
              <div class="flex items-baseline justify-between"><span class="display text-2xl">{n}</span><span class="text-xs text-white/60" dir="ltr">{g} <Icon name="users" class="inline size-3" /></span></div>
              <p class="rh-l mt-2 text-xs font-bold"></p>
              <p class="mt-0.5 text-xs text-white/60" dir="ltr"><span data-min>{m}</span> min</p>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-white/45">{tt('Exemple animé. Sur la caisse, avec vos vraies tables.')}</p>
        <span hidden data-l-cook>{tt('En cuisine')}</span><span hidden data-l-ready>{tt('Prêt à servir')}</span><span hidden data-l-wait>{tt('Attend la suite')}</span><span hidden data-l-eat>{tt('Mange')}</span>
      </div>
    </div>
  </section>

  <!-- THE GUEST AND THE KITCHEN TICKET -->
  <section class="bg-chalk py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Une allergie notée une fois.')}</span><span class="block text-green-deep">{tt('Imprimée à chaque bon.')}</span></h2>
        <p class="mt-5 max-w-lg text-lg text-muted">{tt('La fiche client garde ce qui compte : VIP, préférences, plats préférés, dernières visites, et les allergies. Quand sa table commande, l’allergie sort en haut du bon cuisine. Plus de « on ne savait pas ».')}</p>
        <ul class="mt-6 space-y-3">
          {[tt('Reconnu par son numéro, à la réservation ou à la caisse'), tt('Ses habitudes visibles par le serveur, pas ses dépenses'), tt('L’occasion de la soirée sur la réservation, l’avant-service et le bon')].map(x => <li class="flex items-start gap-3"><span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-green/15 text-green-deep"><Icon name="check" class="size-3.5" /></span><span class="font-semibold">{x}</span></li>)}
        </ul>
      </div>
      <div class="mx-auto w-full max-w-sm" data-ticket>
        <div class="kt rounded-b-2xl bg-white px-5 pb-6 pt-5 font-mono text-[0.85rem] leading-relaxed text-navy shadow-[0_40px_70px_-35px_rgba(0,30,62,.6)] ring-1 ring-line">
          <p class="kt-l text-center font-bold" style="--i:0">{tt('CUISINE · Table 7')}</p>
          <p class="kt-l text-center text-xs text-muted" style="--i:1" dir="ltr">21:14 · 4 {tt('couverts')}</p>
          <p class="kt-l kt-alert mt-3 rounded-lg bg-[#E5484D] px-3 py-2 text-center font-bold text-white" style="--i:2">⚠ {tt('ALLERGIE : fruits à coque')}</p>
          <p class="kt-l mt-1 text-center text-xs font-bold" style="--i:3">★ {tt('Anniversaire · Mme Bennani')}</p>
          <div class="kt-l mt-3 border-t border-dashed border-navy/30 pt-3" style="--i:4">
            <p class="flex justify-between"><span>2 × {tt('Pastilla de pigeon')}</span></p>
            <p class="flex justify-between"><span>1 × {tt('Tajine d’agneau')}</span></p>
            <p class="flex justify-between"><span>1 × {tt('Bar, beurre blanc')}</span></p>
          </div>
          <p class="kt-l mt-3 border-t border-dashed border-navy/30 pt-2 text-xs text-muted" style="--i:5">{tt('Suite : desserts')}</p>
        </div>
        <p class="mt-3 text-center text-xs text-muted">{tt('Exemple de bon cuisine.')}</p>
      </div>
    </div>
  </section>

  <!-- BEFORE SERVICE: the real screen -->
  <section class="bg-paper py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="mt-slide" data-rv><Device src="/img/maitre-avant-service.webp" alt={tt('L’avant-service : couverts par demi-heure, ftour du soir, allergies et VIP')} w={1200} h={878} /></div>
      <div>
        <h2 class="text-[2.4rem] leading-[0.95] sm:text-[2.8rem] sm:leading-[0.92]"><span class="block">{tt('L’avant-service.')}</span><span class="block text-green-deep">{tt('Dix minutes qui changent la soirée.')}</span></h2>
        <p class="mt-5 text-lg text-muted">{tt('Avant d’ouvrir, l’équipe voit qui vient ce soir. Sur l’écran, ou imprimé sur l’imprimante à tickets.')}</p>
        <ul class="mt-6 space-y-4" data-rv>
          {brief.map(([i, h, x], k) => <li class="rv flex gap-3" style={`--d:${k * 120}ms`}><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-mint text-green-deep"><Icon name={i} class="size-5" /></span><span><span class="block font-semibold">{h}</span><span class="block text-sm text-muted">{x}</span></span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- DEPOSIT AND FORMULES -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="rounded-[2rem] bg-navy p-6 text-white sm:p-8">
        <p class="flex items-center gap-2 font-bold text-green"><Icon name="shield" class="size-5" />{tt('L’acompte des grandes tables')}</p>
        <p class="display mt-4 text-4xl leading-[0.95] sm:text-[2.6rem]">{tt('Dès 8 personnes : 100 DH par personne.')}</p>
        <p class="mt-2 text-sm text-white/60">{tt('Exemple de règle : vous choisissez le nombre et le montant.')}</p>
        <ol class="mt-dep relative mt-6 space-y-3" data-scrub="steps"><span class="flow-y absolute start-[13px] top-2 bottom-2 w-0.5 rounded bg-green/60" aria-hidden="true"></span>
          {[tt('Reçu à la caisse : la réservation est confirmée'), tt('Le soir même : déduit de l’addition, ligne « Acompte »'), tt('Personne ne vient : remboursé ou gardé, avec le code d’un responsable'), tt('Compté dans la caisse et dans le Z du jour')].map((x, i) => (
            <li class="step relative flex items-start gap-3"><span class="node grid size-7 shrink-0 place-items-center rounded-full bg-green text-sm font-bold text-navy transition-all duration-300">{i + 1}</span><span class="pt-0.5">{x}</span></li>
          ))}
        </ol>
      </div>
      <div class="rounded-[2rem] bg-white p-6 ring-1 ring-line sm:p-8">
        <p class="flex items-center gap-2 font-bold text-green-deep"><Icon name="book" class="size-5" />{tt('Les formules')}</p>
        <p class="display mt-4 text-4xl leading-[0.95] sm:text-[2.6rem]">{tt('Un menu fixe, réservé en ligne.')}</p>
        <ul class="mt-6 space-y-4" data-rv>
          {formules.map(([i, h, x], k) => <li class="rv flex gap-3" style={`--d:${k * 140}ms`}><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-chalk text-navy"><Icon name={i} class="size-5" /></span><span><span class="block font-semibold">{h}</span><span class="block text-sm text-muted">{x}</span></span></li>)}
        </ul>
        <p class="mt-5 text-sm text-muted">{tt('Chaque soir, la cuisine reçoit sa liste. À l’ouverture de la table, l’addition commence avec la formule, un choix par ligne.')}</p>
      </div>
    </div>
  </section>

  <!-- NO-SHOW CALCULATOR -->
  <section class="px-4 sm:px-6" data-noshow-maitre data-loc={loc} data-rv>
    <div class="relative isolate mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[2.5rem] bg-[#0B1530] px-6 py-12 text-white md:grid-cols-[1fr_1fr] md:px-12 md:py-16">
      <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_70%_at_90%_40%,rgba(124,92,255,.3),transparent_70%)]" aria-hidden="true"></span>
      <div>
        <h2 class="text-[2.4rem] leading-[0.95] sm:text-5xl"><span class="block">{tt('Une table qui ne vient pas')}</span><span class="block text-[#C9B8FF]">{tt('coûte plus qu’un mois de Maître.')}</span></h2>
        <div class="mt-8 space-y-5">
          <label class="block"><span class="flex justify-between text-sm font-semibold"><span>{tt('Couverts de la table')}</span><span class="tabular-nums text-[#C9B8FF]" data-o="c">8</span></span><input type="range" min="2" max="20" value="8" class="mt-2 w-full accent-[#7C5CFF]" data-i="c" aria-label={tt('Couverts de la table')} /></label>
          <label class="block"><span class="flex justify-between text-sm font-semibold"><span>{tt('Ticket moyen par personne')}</span><span class="tabular-nums text-[#C9B8FF]" dir="ltr"><span data-o="t">350</span> DH</span></span><input type="range" min="100" max="1000" step="25" value="350" class="mt-2 w-full accent-[#7C5CFF]" data-i="t" aria-label={tt('Ticket moyen par personne')} /></label>
        </div>
      </div>
      <div class="rounded-[1.75rem] bg-white p-6 text-navy">
        <p class="text-sm font-semibold text-muted">{tt('Une seule absence')}</p>
        <p class="display mt-1 text-6xl tabular-nums text-[#C4282D]" dir="ltr"><span data-o="loss">2 800</span> DH</p>
        <p class="mt-1 text-sm text-muted">{tt('de chiffre d’affaires perdu, ce soir-là')}</p>
        <div class="mt-5 flex items-center justify-between rounded-2xl bg-chalk px-4 py-3"><span class="font-semibold">{tt('Amplify Maître')}</span><span class="font-bold tabular-nums" dir="ltr">249 DH / {tt('mois')}</span></div>
        <p class="mt-4 font-semibold" data-o="x"></p>
        <span hidden data-t-x>{tt('Soit {n} mois de Maître.')}</span>
        <p class="mt-3 text-xs text-muted">{tt('Calcul indicatif, avec vos chiffres.')}</p>
      </div>
    </div>
  </section>

  <!-- PRICE -->
  <section id="prix" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6 md:py-24">
    <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Une option.')}</span><span class="block text-green-deep">{tt('Pas un autre système.')}</span></h2>
    <p class="mt-5 max-w-2xl text-lg text-muted">{tt('Maître s’ajoute à votre caisse Amplify POS, sur la formule Restaurant ou Contrôle. Vous l’activez quand la saison le demande, vous l’arrêtez d’un mois à l’autre.')}</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2" data-rv data-price>
      {[[tt('Restaurant + Maître'), '349', '598', tt('La caisse complète du service à table, et Maître.')], [tt('Contrôle + Maître'), '499', '748', tt('La caisse, les marges réelles, le stock, et Maître.')]].map(([n, base, tot, x], i) => (
        <div class={`rv rounded-[2rem] p-6 ring-1 sm:p-8 ${i ? 'bg-navy text-white ring-navy' : 'bg-white ring-line'}`} style={`--d:${i * 180}ms`}>
          <p class="font-bold">{n}</p>
          <p class="mt-3 flex items-baseline gap-2"><span class="display text-6xl tabular-nums" dir="ltr" data-from={base} data-to={tot}>{tot}</span><span class={`text-sm ${i ? 'text-white/60' : 'text-muted'}`}>{tt('DH HT / mois')}</span></p>
          <p class={`mt-1 text-sm ${i ? 'text-white/60' : 'text-muted'}`} dir="auto">{base} <span class="mt-plus inline-block rounded-full bg-[#7C5CFF] px-2 py-0.5 font-bold text-white">+ 249</span></p>
          <p class={`mt-4 ${i ? 'text-white/75' : 'text-muted'}`}>{x}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <WaButton text={wa} label={tt('Demander une démo')} where="maitre-price" class="px-7 text-lg" />
      <a href={ROUTES.pos[lang]} class="font-semibold text-navy underline underline-offset-4 hover:text-green-deep">{tt('Voir Amplify POS')} →</a>
    </div>
  </section>

  <Faq lang={lang} items={faq} wa={wa} />
</Base>

<style is:global>
  .mt-kb { transform: translateY(calc(var(--p) * 50px)); scale: 1.1; animation: mt-kb 24s ease-in-out infinite alternate; }
  @keyframes mt-kb { from { scale: 1.1; } to { scale: 1.2; } }
  .mt-float { animation: mt-float 7s ease-in-out infinite; }
  .mt-float2 { animation: mt-float 6s ease-in-out infinite reverse; }
  @keyframes mt-float { 50% { transform: translateY(-10px); } }
  .rv { transition: opacity .6s cubic-bezier(.2,.8,.2,1), transform .7s cubic-bezier(.2,.8,.2,1); transition-delay: var(--d, 0ms); }
  .js [data-rv]:not(.in) .rv { opacity: 0; transform: translateY(18px); }
  .mt-slide { transition: opacity .8s, transform 1s cubic-bezier(.2,.8,.2,1); }
  .js .mt-slide[data-rv]:not(.in) { opacity: 0; transform: translateX(-40px) rotate(-1.5deg); }
  [dir="rtl"] .js .mt-slide[data-rv]:not(.in), .js [dir="rtl"] .mt-slide[data-rv]:not(.in) { transform: translateX(40px) rotate(1.5deg); }
  [data-price].in .mt-plus { animation: mt-plus .7s cubic-bezier(.3,1.6,.5,1) .5s both; }
  @keyframes mt-plus { from { transform: scale(.2) translateY(-14px); opacity: 0; } }
  .js .mt-dep .step:not(.on) .node { background: #1A3355; color: rgb(255 255 255 / .55); box-shadow: none; }
  .js .mt-dep .step:not(.on) > span:last-child { opacity: .5; }
  .mt-dep .step > span:last-child { transition: opacity .4s; }
  @media (prefers-reduced-motion: reduce) { .mt-kb, .mt-float, .mt-float2, [data-price].in .mt-plus { animation: none; } .js [data-rv] .rv, .js .mt-slide[data-rv] { opacity: 1 !important; transform: none !important; } }
  .mt-ring { box-shadow: 0 0 0 0 rgb(124 92 255 / .7); animation: mt-ring 2.4s ease-out infinite 1.2s; }
  @keyframes mt-ring { 0% { box-shadow: 0 0 0 0 rgb(124 92 255 / .7); } 80%, 100% { box-shadow: 0 0 0 26px rgb(124 92 255 / 0); } }
  .mt-call.is-on { background: #7C5CFF; color: #fff; box-shadow: none; }
  .mt-call.is-on span:first-child { background: rgb(255 255 255 / .2); color: #fff; }
  .mt-call.is-on .mt-sent { display: inline; color: #fff; }
  .mt-table.is-call { background: #7C5CFF; box-shadow: 0 0 0 0 rgb(124 92 255 / .8); animation: mt-ring 1.4s ease-out infinite; }
  .mt-table.is-call .mt-badge { display: block; }
  .rh-t[data-st="cook"] { background: rgb(245 179 1 / .14); } .rh-t[data-st="cook"] .rh-l { color: #F5B301; }
  .rh-t[data-st="ready"] { background: rgb(5 185 98 / .18); } .rh-t[data-st="ready"] .rh-l { color: #05B962; }
  .rh-t[data-st="wait"] { background: rgb(127 179 255 / .14); } .rh-t[data-st="wait"] .rh-l { color: #7FB3FF; }
  .rh-t[data-st="eat"] { background: rgb(255 255 255 / .05); } .rh-t[data-st="eat"] .rh-l { color: rgb(255 255 255 / .7); }
  .rh-t.is-late { box-shadow: inset 0 0 0 2px #E5484D; }
  .kt-l { transition: opacity .3s, transform .35s; transition-delay: calc(var(--i) * .18s); }
  .js [data-ticket]:not(.in) .kt-l { opacity: 0; transform: translateY(-6px); }
  .kt-alert { animation: none; }
  [data-ticket].in .kt-alert { animation: kt-blink .9s ease-in-out 1.4s 2; }
  @keyframes kt-blink { 50% { transform: scale(1.04); } }
  @media (prefers-reduced-motion: reduce) { .mt-ring, .mt-table.is-call, [data-ticket].in .kt-alert { animation: none; } .js [data-ticket] .kt-l { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1. the discreet call
  document.querySelectorAll<HTMLElement>('[data-call]').forEach((root) => {
    const sec = root.closest('section')!;
    const txt = (k: string) => sec.querySelector<HTMLElement>(`[data-t-${k}]`)!.textContent ?? '';
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.mt-call')];
    const t7 = root.querySelector<HTMLElement>('.mt-table.is-7')!;
    const badge = root.querySelector<HTMLElement>('[data-badge]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const done = root.querySelector<HTMLButtonElement>('[data-done]')!;
    const guest = root.querySelector<HTMLElement>('[data-guest]')!;
    const first = guest.textContent;
    let touched = false;
    const call = (b: HTMLButtonElement) => {
      btns.forEach(x => x.classList.toggle('is-on', x === b));
      const label = txt(b.dataset.k!);
      t7.classList.add('is-call'); badge.textContent = label.split('·')[1]?.trim() ?? ''; bar.textContent = label; bar.style.opacity = '1';
      done.classList.remove('hidden'); done.classList.add('inline-flex'); guest.textContent = txt('sent');
    };
    btns.forEach(b => b.addEventListener('click', () => { touched = true; call(b); }));
    done.addEventListener('click', () => {
      touched = true; t7.classList.remove('is-call'); bar.style.opacity = '0'; done.classList.add('hidden'); done.classList.remove('inline-flex');
      guest.textContent = txt('ok'); setTimeout(() => { btns.forEach(x => x.classList.remove('is-on')); guest.textContent = first; }, 2500);
    });
    if (!still && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); setTimeout(() => { if (!touched) call(btns[2]); }, 1300); } }, { threshold: 0.5 });
      io.observe(root);
    }
  });

  // 2. the rhythm of the evening: every 2 s a table moves on, minutes tick, a table waiting too long turns red
  document.querySelectorAll<HTMLElement>('[data-rhythm]').forEach((root) => {
    const lab = (k: string) => root.querySelector<HTMLElement>(`[data-l-${k}]`)!.textContent ?? '';
    const tables = [...root.querySelectorAll<HTMLElement>('.rh-t')];
    const next: Record<string, string> = { cook: 'ready', ready: 'eat', eat: 'wait', wait: 'cook' };
    const paint = () => {
      const n: Record<string, number> = { cook: 0, ready: 0, wait: 0, eat: 0 };
      tables.forEach((t) => {
        const st = t.dataset.st!, m = Number(t.dataset.m);
        n[st]++; t.querySelector<HTMLElement>('.rh-l')!.textContent = lab(st);
        t.querySelector<HTMLElement>('[data-min]')!.textContent = String(m);
        t.classList.toggle('is-late', (st === 'wait' && m >= 15) || (st === 'cook' && m >= 25));
      });
      Object.entries(n).forEach(([k, v]) => { const el = root.querySelector<HTMLElement>(`[data-sum="${k}"]`); if (el) el.textContent = String(v); });
    };
    paint();
    if (still) return;
    let i = 0, vis = false;
    new IntersectionObserver(([e]) => { vis = e.isIntersecting; }).observe(root);
    setInterval(() => {
      if (!vis || document.hidden) return;
      tables.forEach(t => (t.dataset.m = String(Number(t.dataset.m) + 1)));
      const t = tables[(i * 3) % tables.length]; i++;
      t.dataset.st = next[t.dataset.st!]; t.dataset.m = '0';
      paint();
    }, 2000);
  });

  // 3. the kitchen ticket prints when it comes into view
  document.querySelectorAll<HTMLElement>('[data-ticket]').forEach((root) => {
    if (!('IntersectionObserver' in window)) { root.classList.add('in'); return; }
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); root.classList.add('in'); } }, { threshold: 0.4 });
    io.observe(root);
  });

  // 0. reveals: a block gets "in" once it is on screen; numbers count, prices add the 249
  const countUp = (el: HTMLElement, from: number, to: number, ms = 900) => {
    if (still) { el.textContent = String(to); return; }
    const t0 = performance.now();
    const tick = (t: number) => { const k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 3); el.textContent = String(Math.round(from + (to - from) * e)); if (k < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  };
  document.querySelectorAll<HTMLElement>('[data-rv]').forEach((root) => {
    const go = () => {
      root.classList.add('in');
      root.querySelectorAll<HTMLElement>('[data-cnt]').forEach(el => countUp(el, 0, Number(el.dataset.cnt), 1100));
      root.querySelectorAll<HTMLElement>('[data-to]').forEach(el => setTimeout(() => countUp(el, Number(el.dataset.from), Number(el.dataset.to), 1000), 650));
      if (root.hasAttribute('data-noshow-maitre') && !still) root.dispatchEvent(new CustomEvent('mt-play'));
    };
    if (!('IntersectionObserver' in window)) { go(); return; }
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); go(); } }, { threshold: 0.3 });
    io.observe(root);
  });

  // 4. no-show calculator
  document.querySelectorAll<HTMLElement>('[data-noshow-maitre]').forEach((root) => {
    const loc = root.dataset.loc || 'fr-FR';
    const i = (k: string) => root.querySelector<HTMLInputElement>(`[data-i="${k}"]`)!;
    const o = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const tx = root.querySelector<HTMLElement>('[data-t-x]')!.textContent ?? '';
    const run = () => {
      const c = Number(i('c').value), t = Number(i('t').value), loss = c * t;
      o('c').textContent = String(c); o('t').textContent = String(t);
      o('loss').textContent = loss.toLocaleString(loc).replace(/[  ,]/g, ' ');
      o('x').textContent = tx.replace('{n}', (loss / 249).toLocaleString(loc, { maximumFractionDigits: 1 }));
    };
    let touched = false;
    i('c').addEventListener('input', () => { touched = true; run(); }); i('t').addEventListener('input', () => { touched = true; run(); }); run();
    // on view: the table grows from 2 to 8 guests, the loss climbs with it
    root.addEventListener('mt-play', () => {
      let c = 2; i('c').value = '2'; run();
      const id = setInterval(() => { if (touched || c >= 8) { clearInterval(id); return; } c++; i('c').value = String(c); run(); }, 160);
    });
  });
</script>
