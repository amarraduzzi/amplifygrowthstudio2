---
// Pressing page (dry cleaners, laundries): linked from the products menu and the footer.
// Same look as the salons and spas pages. Real screenshots of the demo shop ("Pressing Démo", invented
// names). No clients, reviews, results or prices are claimed: the price is given on request.
import Base from '../../layouts/Base.astro';
import Device from '../Device.astro';
import Faq from '../Faq.astro';
import SectorPrices from '../SectorPrices.astro';
import WaButton from '../WaButton.astro';
import Icon from '../Icon.astro';
import CountUp from '../CountUp.astro';
import PressingCredit from '../PressingCredit.astro';
import PressingJourney from '../PressingJourney.astro';
import PressingCaisse from '../PressingCaisse.astro';
import PressingRail from '../PressingRail.astro';
import PressingTrack from '../PressingTrack.astro';
import PressingRounds from '../PressingRounds.astro';
import PressingInvoice from '../PressingInvoice.astro';
import PressingEvening from '../PressingEvening.astro';
import PressingBilan from '../PressingBilan.astro';
import PressingClients from '../PressingClients.astro';
import PressingSleep from '../PressingSleep.astro';
import PressingHeroPhone from '../PressingHeroPhone.astro';
import { tr } from '../../i18n/t';
import { ROUTES, type Lang } from '../../i18n/routes';
import CardQr from '../CardQr.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = tr(lang);
const wa = tt('Bonjour, je voudrais voir Amplify pour mon pressing.');
const rounds = [
  ['pin', 'Ramassage à domicile', 'L’adresse, le jour, l’heure et les frais. Au retour du chauffeur, le ramassage devient un dépôt en un geste.'],
  ['truck', 'Livraison', 'Un dépôt prêt livré chez le client. Les frais s’ajoutent, le chauffeur encaisse le reste.'],
  ['message', 'Le client prévenu', 'Un WhatsApp prêt à envoyer : « nous passons entre 18 h et 19 h ».'],
  ['calendar', 'La tournée du jour', 'Ramassages et livraisons de la journée, avec Google Maps pour chaque adresse.'],
] as const;
const evening = [
  ['wallet', 'La caisse du jour', 'Dépôts, retraits, espèces et carte, encaissement par encaissement.'],
  ['shield', 'Clôture à l’aveugle', 'Les espèces sont comptées avant d’afficher le montant attendu. L’écart est noté.'],
  ['printer', 'Rapport Z', 'Imprimé à la clôture : le résumé de la journée, pour le gérant.'],
  ['chart', 'Espace gérant', 'Depuis votre téléphone : ce qui est au pressing, prêt, non récupéré, et ce qu’il reste à encaisser.'],
] as const;
const credit = [
  ['coins', 'Un bonus par tranche', 'Par exemple +5 % dès 200 DH, +10 % dès 500 DH, +15 % dès 1 000 DH. Vous fixez les tranches. Le bonus n’est jamais versé en argent.'],
  ['shield', 'Code à 4 chiffres', 'Le client paie avec son code : personne d’autre ne dépense son crédit. Vous pouvez désactiver le code.'],
  ['gift', 'Cartes cadeaux à la caisse', 'Vendues avec un code, puis ajoutées plus tard au crédit d’un client.'],
  ['book', 'Chaque mouvement est écrit', 'Recharge, bonus, dépense, remboursement : un registre qui ne se modifie pas. Le rapport montre ce que vous devez encore à vos clients.'],
] as const;
const pro = [
  ['briefcase', 'Compte professionnel', 'Rien n’est encaissé au dépôt ni au retrait. Les dépôts du mois s’accumulent sur le compte du client.'],
  ['book', 'Facture mensuelle', 'Une facture numérotée avec les deux ICE, marquée payée au virement ou au chèque. Une facture ne se modifie jamais.'],
  ['tag', 'Tarifs de groupe', 'Un groupe (« Hôtels », « Famille ») a ses propres prix pour certains articles. Les autres gardent le prix normal, et la caisse applique le bon prix toute seule.'],
  ['heart', 'Remise fixe par client', 'Un pourcentage pour un habitué ou un compte pro. Seul le gérant le fixe, avec son code, et chaque changement est noté.'],
] as const;
const bilan = [
  ['phone', 'Il arrive tout seul', 'Dès que la journée est clôturée, ou à l’heure que vous choisissez si personne ne l’a fait. Chaque ramassage demandé en ligne aussi, tout de suite.'],
  ['chart', 'La journée en chiffres', 'Espèces et carte, comparées au même jour de la semaine dernière, dépôts entrés et sortis, remises, clôture.'],
  ['bell', 'Ce qui mérite un regard', 'Journée non clôturée, écart de caisse, dépôt payé puis annulé, pièces parties sans être payées, remises trop fortes, dépôts jamais récupérés.'],
  ['calendar', 'Les jours passés', 'Rouvrez n’importe laquelle des 400 dernières journées depuis l’espace gérant.'],
] as const;
const clients = [
  ['users', 'Une fiche utile', 'Dépôts, total dépensé, dernière visite, ce qui est au pressing et ce qu’il reste à payer. Elle s’ouvre sur ce qui compte.'],
  ['search', 'Doublons fusionnés', 'Deux fiches pour le même client ? Fusionnez : rien n’est supprimé et vous pouvez annuler. « Tout fusionner » règle les cas sûrs d’un coup.'],
  ['message', 'Les clients qui ne viennent plus', 'Les habitués qui ont arrêté de venir, et ce qu’ils dépensaient en un an. Un WhatsApp pour les rappeler, 25 par jour au plus pour que votre numéro ne soit pas bloqué. Vous voyez ceux qui reviennent.'],
  ['box', 'Reprise de vos données', 'Votre liste de clients et l’historique de vos dépôts, depuis un fichier CSV ou Excel de votre ancien système. Rien d’existant n’est modifié, et chaque import s’annule.'],
] as const;
const faq = [
  ['Mes clients doivent-ils installer une application ?', 'Non. Ils scannent le QR du ticket ou ouvrent le lien reçu sur WhatsApp. Rien à installer, rien à créer.'],
  [tt('Mes clients peuvent-ils payer par carte sans terminal ?'), tt('Oui. La caisse affiche un QR code et le client paie par carte sur son téléphone, par votre propre compte CMI. L’argent arrive sur votre compte bancaire. Amplify ne prend aucune commission : seuls les frais de votre banque s’appliquent.')],
  ['Il me faut quel matériel ?', 'Une tablette ou un ordinateur, et une imprimante de tickets. Les étiquettes sortent de la même imprimante. Nous vous conseillons si vous n’avez rien.'],
  ['Et le linge au kilo ?', 'Oui. Un article au kilo : la caisse demande le poids et calcule le prix. Le sac compte comme une pièce.'],
  ['Les photos sont-elles visibles par le client ?', 'Non. Elles restent au pressing : à la caisse et dans votre espace gérant. Le client voit seulement l’état de son dépôt.'],
  ['Je travaille avec des hôtels ou des restaurants.', 'Oui, avec un compte professionnel : leurs dépôts partent sur compte, avec leurs propres tarifs si vous le voulez, et vous leur faites une facture numérotée à la fin du mois.'],
  ['Mes clients restent-ils à moi ?', 'Oui. Il n’y a pas de place de marché : la page de suivi ne montre que votre pressing, jamais un concurrent.'],
  ['Qui installe tout ?', 'Nous. Votre liste de prix, votre équipe et votre imprimante, et nous montrons tout à votre équipe. C’est offert.'],
  ['Puis-je proposer un crédit prépayé ?', 'Oui, c’est une option. Le client recharge son compte à la caisse et reçoit un bonus par tranche que vous fixez. Rien ne change tant que vous ne l’activez pas.'],
  ['Je change de système : je perds mes clients ?', 'Non. Vous importez votre liste de clients et l’historique de vos dépôts depuis un fichier CSV ou Excel. Rien d’existant n’est modifié, et chaque import s’annule.'],
  ['Le WhatsApp « prêt » part-il tout seul ?', 'Par défaut, vous l’envoyez en un geste depuis la caisse. En option, avec votre propre numéro WhatsApp Business, il part tout seul. Meta facture directement votre pressing.'],
  ['Et si j’arrête ?', 'Sans engagement : vous arrêtez d’un mois à l’autre. Les 14 premiers jours sont gratuits.'],
];
---
<Base lang={lang} page="pressing" title={tt('Amplify pour les pressings et blanchisseries | Amplify Growth Studio')} description={tt('La caisse des pressings : un numéro et une étiquette par pièce, les taches en photo, le client prévenu sur WhatsApp, le suivi par QR, le ramassage et la livraison. À Rabat et Salé.')} wa={wa}>
  <!-- hero: the till lands, the client's phone drops, the shop's day plays out in chips -->
  <section class="relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-8 sm:px-6 md:pt-14 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:pb-14">
      <div>
        <p class="fade-up inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-sm font-semibold ring-1 ring-line"><span class="size-2 rounded-full bg-green"></span>Pressings et blanchisseries</p>
        <h1 class="mt-5 text-[clamp(2.8rem,5.8vw,5rem)]">
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise inline-block" style="--d:80ms">Chaque pièce retrouvée.</span></span>
          <span class="block overflow-hidden pb-[0.04em]"><span class="rise relative inline-block text-green-deep" style="--d:200ms">Chaque client prévenu.<span class="draw absolute inset-x-0 -bottom-[0.01em] h-[0.06em] origin-left rounded-full bg-green rtl:origin-right" style="--d:700ms" aria-hidden="true"></span></span></span>
        </h1>
        <p class="fade-up mt-5 max-w-xl text-lg text-muted md:text-xl" style="--d:300ms">Un numéro et une étiquette par pièce, les taches en photo au dépôt, un WhatsApp quand c’est prêt. Le client suit son linge avec le QR de son ticket, et ne vous appelle plus pour demander.</p>
        <div class="fade-up mt-7 flex flex-wrap items-center gap-3" style="--d:400ms">
          <WaButton text={wa} label={tt('Demander une démo')} where="pressing-hero" class="px-7 text-lg" />
          <a href="#suivi" class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold ring-1 ring-line hover:bg-paper">Voir le suivi client</a>
        </div>
      </div>

      <div class="relative isolate aspect-[4/3.7] overflow-hidden rounded-[1.75rem] bg-navy lg:aspect-[5/4.7] lg:rounded-[2.25rem]">
        <span class="sl-scene absolute inset-0 -z-20" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
        <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
        <span class="shadow-in absolute start-[8%] top-[72%] h-6 w-[66%] rounded-[50%] bg-black/55 blur-xl" style="--d:700ms" aria-hidden="true"></span>
        <div class="land absolute start-[3%] top-[18%] w-[70%]" style="--d:300ms">
          <Device src="/img/pressing-depot.webp" alt={tt('La caisse du pressing : la liste de prix à gauche, le dépôt du client à droite')} w={1200} h={750} eager />
        </div>
        <span class="shadow-in absolute bottom-[3%] end-[6%] h-4 w-[22%] rounded-[50%] bg-black/55 blur-lg" style="--d:900ms" aria-hidden="true"></span>
        <div class="drop absolute bottom-[3%] end-[4%] w-[32%]" style="--d:650ms"><Device kind="phone" w={600} h={1298} class="rotate-[3deg]"><PressingHeroPhone slot="screen" /></Device></div>
        <div class="absolute start-[5%] top-[4%] z-10"><div class="tf-float"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:2300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-green text-navy sm:size-7"><Icon name="tag" class="size-3.5 sm:size-4" /></span>Dépôt n° 1042 : 4 étiquettes</p></div></div>
        <div class="absolute end-[4%] top-[14%] z-10 sm:top-[6%]"><div class="tf-float" style="--d:1200ms"><p class="chat-in flex items-center gap-2 rounded-full bg-green py-1.5 pe-3.5 ps-3 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:3300ms" aria-hidden="true"><span class="sl-live size-2 rounded-full bg-navy"></span>Prêt : Rail 12</p></div></div>
        <div class="absolute bottom-[6%] start-[5%] z-10"><div class="tf-float" style="--d:2400ms"><p class="chat-in flex items-center gap-2 rounded-full bg-paper py-1.5 pe-3.5 ps-1.5 text-[0.7rem] font-semibold text-navy shadow-lg sm:text-sm" style="--d:4300ms" aria-hidden="true"><span class="grid size-6 place-items-center rounded-full bg-[#25D366] text-white sm:size-7"><Icon name="message" class="size-3.5 sm:size-4" /></span>WhatsApp envoyé à Nadia</p></div></div>
      </div>
    </div>

    <!-- three facts -->
    <div class="border-y border-line bg-paper">
      <ul class="mx-auto grid max-w-6xl grid-cols-3 gap-3 px-4 py-5 sm:px-6 md:py-6">
        {[['1', 'étiquette par pièce, avec le numéro du dépôt'], ['14', 'jours gratuits, sans engagement'], ['3', 'langues : français, arabe et anglais']].map(([n, l]) => (
          <li class="flex flex-col gap-1 md:flex-row md:items-center md:gap-4"><span class="display text-5xl text-navy md:text-6xl" data-count={n} dir="ltr">{n}</span><span class="text-[0.78rem] leading-snug text-muted md:max-w-[13rem] md:text-[0.95rem]">{l}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- the journey of one shirt: pinned on desktop, a loop on phones -->
  <PressingJourney />

  <!-- the drop-off: a till you can play -->
  <PressingCaisse />

  <!-- the counter: in the works, ready, late, not collected -->
  <section id="comptoir" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6 md:py-24" data-tf>
    <div class="tf-x">
      <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Prêt. Prévenu.</span><span class="block text-green-deep">Remis.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-muted">Le dépôt est propre : vous dites sur quel rail il attend, et le client reçoit un WhatsApp avec le reste à payer. Au retrait, la caisse encaisse et rend la monnaie.</p>
    </div>
    <div class="mt-10"><PressingRail /></div>
  </section>

  <!-- the client's tracking page -->
  <section id="suivi" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="tf-x relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-paper p-6 ring-1 ring-line md:p-14">
      <PressingTrack>
        <h2 class="text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">« C’est prêt ? »</span><span class="block text-green-deep">Le client le voit tout seul.</span></h2>
        <p class="mt-5 max-w-md text-lg text-muted">Le QR du ticket ouvre une page à votre nom : le numéro du dépôt, où il en est, le jour prévu et ce qu’il reste à payer. Un bouton pour vous appeler, un autre pour WhatsApp.</p>
      </PressingTrack>
      <p class="mt-8 text-sm text-muted">Sans application, sans compte. Le numéro du client n’apparaît jamais sur la page.</p>
    </div>
  </section>

  <!-- prepaid credit: right after the client's tracking page; played live (top-up, bonus, code payment, ledger) -->
  <section id="credit" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Le crédit prépayé.</span><span class="block text-green-deep">Le client paie d’avance.</span></h2>
    <p class="tf mt-4 max-w-2xl text-lg text-muted" style="--d:100ms">Le client met de l’argent sur son compte au comptoir et reçoit un bonus selon le montant. Il paie ses dépôts avec, quand il revient. C’est une option : rien ne change tant que vous ne l’activez pas.</p>
    <div class="mt-10 md:mt-12"><PressingCredit cards={credit} /></div>
  </section>

  <!-- pick-ups and deliveries: the driver's round on a map -->
  <PressingRounds items={rounds} />

  <!-- business clients: a month becomes one invoice -->
  <PressingInvoice items={pro} />

  <!-- the evening: the till, the blind count, the Z report, the owner's phone -->
  <PressingEvening items={evening} />

  <!-- the evening report: the owner's phone -->
  <PressingBilan items={bilan} />

  <!-- the client file, duplicates merged, win-back, moving in: one dark window, four scenes -->
  <PressingClients items={clients} />

  <!-- what sleeps on the rails: a living rail of 100 drop-offs, the shop's own numbers -->
  <PressingSleep />

  <CardQr lang={lang} k="pressing" />

  <SectorPrices lang={lang} k="pressing" />

  <Faq lang={lang} items={faq} wa={wa} />

  <!-- final -->
  <section id="demo" class="scroll-mt-20 px-4 pb-14 sm:px-6 md:pb-24" data-tf>
    <div class="tf relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-navy px-6 py-14 text-white md:px-14">
      <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
      <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
      <span class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_70%_at_85%_50%,rgba(5,185,98,.25),transparent_70%)]" aria-hidden="true"></span>
      <h2 class="text-[2.8rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">Voyez-le avec vos articles.</span><span class="block text-green">En 15 minutes.</span></h2>
      <p class="mt-5 max-w-xl text-lg text-white/75">Écrivez-nous sur WhatsApp. Nous passons au pressing, nous mettons votre liste de prix et votre équipe, et vous essayez 14 jours gratuitement.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <WaButton text={wa} label={tt('Demander une démo')} where="pressing-final" class="px-8 text-lg" />
        <a href={ROUTES.systems[lang]} class="inline-flex min-h-12 items-center rounded-full px-5 text-lg font-semibold text-white ring-1 ring-white/25 hover:bg-white/10">Voir tous nos systèmes</a>
      </div>
    </div>
  </section>
  <CountUp />
</Base>

<script>
  // sections reveal as they scroll in
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-tf]')];
  if (still || !('IntersectionObserver' in window)) roots.forEach((r) => r.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.18 });
    roots.forEach((r) => io.observe(r));
  }
</script>
