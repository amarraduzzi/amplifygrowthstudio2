---
import Icon from './Icon.astro';
// "La caméra pour vos chiffres": a camera shows that something went missing, the till keeps the trace of
// who sold what and when. A looping illustration: the day's log fills up, two lines get flagged and the
// evening report lands on the owner's WhatsApp. Invented names, no real venue. We promise visibility, not
// that theft is prevented. With reduced motion everything stays visible and still.
interface Props { sector?: 'salon' | 'horeca'; class?: string }
const { sector = 'salon', class: cls = '' } = Astro.props;
type Row = readonly [string, string, string, string, boolean];
const salon: Row[] = [
  ['10:12', 'Vente', 'Coupe et brushing · 150 DH', 'Salma', false],
  ['13:05', 'Produit vendu', 'Masque réparateur · 90 DH', 'Imane', false],
  ['15:42', 'Remise de 100 %', 'Coupe et brushing', 'Hamza', true],
  ['18:20', 'Écart de caisse', '− 40 DH', '', true],
];
const horeca: Row[] = [
  ['13:10', 'Vente', 'Table 4 · 185 DH', 'Anas', false],
  ['15:42', 'Plat retiré après la cuisine', 'Pizza · 75 DH', 'Hamza', true],
  ['17:30', 'Remise de 100 %', 'Table 2', 'Hamza', true],
  ['23:40', 'Écart de caisse', '− 40 DH', '', true],
];
const rows = sector === 'salon' ? salon : horeca;
const venue = sector === 'salon' ? 'Salon Démo · Rapport du soir' : 'Café Démo · Rapport du soir';
const ca = sector === 'salon' ? 'Chiffre d’affaires : 2 340 DH' : 'Chiffre d’affaires : 8 450 DH';
const check = sector === 'salon' ? 'À vérifier : 1 remise de 100 %' : 'À vérifier : 1 plat retiré, 1 remise de 100 %';
const points = [
  ['search', 'Qui, quoi, quand', 'Chaque vente, remise et annulation est enregistrée avec l’heure et le nom de la personne.'],
  ['bell', 'Ce qui sort de l’ordinaire', 'Remises élevées, annulations, sorties de caisse : signalées le jour même, pas trois semaines plus tard.'],
  ['phone', 'Le rapport du soir sur WhatsApp', 'Un message au patron après la clôture : le chiffre, ce qu’il faut vérifier, l’écart de caisse.'],
  ['shield', 'Protège aussi l’employé honnête', 'Un journal clair met fin au « ce n’est pas moi » : on sait qui a fait quoi.'],
] as const;
---
<section class={`sc relative mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-24 ${cls}`} data-sc>
  <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-center">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-green/15 px-3 py-1 text-sm font-semibold text-green-deep"><Icon name="shield" class="size-4" />Sécurité des chiffres</p>
      <h2 class="mt-4 text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">La caméra</span><span class="block text-green-deep">pour vos chiffres.</span></h2>
      <p class="mt-5 max-w-md text-lg text-muted">Une caméra filme. Votre caisse garde la trace : qui a vendu quoi, à quelle heure, et ce qui ne colle pas.</p>
      <ul class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {points.map(([i, h, x]) => (
          <li>
            <span class="grid size-10 place-items-center rounded-2xl bg-green/15 text-green-deep"><Icon name={i} class="size-5" /></span>
            <p class="mt-3 font-semibold">{h}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{x}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative rounded-[2rem] bg-paper p-5 ring-1 ring-line md:p-7" data-scd>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="font-semibold">Journal de la journée</p>
        <span class="rounded-full bg-chalk px-3 py-1 text-xs font-semibold text-muted ring-1 ring-line">Exemple d’illustration</span>
      </div>
      <p class="sr-only">Illustration : le journal de la journée liste chaque vente et signale une remise et un écart de caisse, puis le rapport du soir arrive sur WhatsApp.</p>
      <div aria-hidden="true">
        <ul class="mt-4 space-y-2.5">
          {rows.map(([time, kind, detail, who, flag]) => (
            <li class={`sc-i flex flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl p-3 ring-1 ${flag ? 'sc-flag bg-[#FDEEEC] ring-[#E9B4AE]' : 'bg-chalk ring-line'}`} data-row>
              <span class="rounded-xl bg-paper px-2.5 py-1.5 text-sm font-bold tabular-nums ring-1 ring-line" dir="ltr">{time}</span>
              <div class="min-w-[9rem] flex-1"><p class="text-sm font-semibold">{kind}</p><p class="text-xs text-muted">{detail}</p></div>
              {who && <span class="shrink-0 rounded-full bg-paper px-2.5 py-1 text-xs font-semibold ring-1 ring-line">{who}</span>}
              {flag && <span class="shrink-0 rounded-full bg-[#C0392B] px-2.5 py-1 text-xs font-bold text-white">À vérifier</span>}
            </li>
          ))}
        </ul>
        <div class="sc-i mt-4 ms-auto w-[92%] max-w-[22rem] rounded-2xl rounded-se-sm bg-[#DCF8C6] p-3 font-sans text-[0.78rem] leading-snug text-[#111B21] shadow-md" data-msg>
          <p class="font-bold">{venue}</p>
          <p>{ca}</p>
          <p>{check}</p>
          <p>Écart de caisse : − 40 DH</p>
          <p class="mt-1 text-end text-[0.65rem] text-[#667781]" dir="ltr">23:42 ✓✓</p>
        </div>
      </div>
    </div>
  </div>
  <p class="mx-auto mt-10 max-w-3xl rounded-2xl bg-paper p-4 text-center text-[0.95rem] text-muted ring-1 ring-line">Nous ne filmons rien et nous n’empêchons pas le vol : nous le rendons visible, le jour même. Une caméra et une caisse qui garde la trace se complètent.</p>
</section>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-scd]').forEach((root) => {
    if (still || !('IntersectionObserver' in window)) return;
    const items = [...root.querySelectorAll<HTMLElement>('.sc-i')];
    root.classList.add('sc-run');
    const times = [500, 1500, 2700, 3900, 5400];
    let clock = 0, visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.35 }).observe(root);
    setInterval(() => {
      if (!visible || document.hidden) return;
      clock += 100;
      items.forEach((el, i) => { if (clock >= times[i]) el.classList.add('on'); });
      if (clock >= 11000) { items.forEach((el) => el.classList.remove('on')); clock = 0; }
    }, 100);
  });
</script>
