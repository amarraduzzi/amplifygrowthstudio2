---
// The client's tracking page, played live. It copies the real page of the till app (?suivi=): the yellow tag,
// where it is in one sentence, the timeline with times, the rail with one hanger per piece, the receipt,
// the hours and the Call / Directions / WhatsApp bar. Nothing is invented about the layout.
// The scene: the printed ticket (same N° 1042 and QR as the "Le dépôt" till), a phone that scans it, then the page
// opens. The counter on the left is a small till: touch a status and a light pulse runs to the phone, which
// changes for real (timeline, hangers, WhatsApp). The buttons on the phone work too (call, WhatsApp, directions).
// It plays by itself once in view and stops as soon as the visitor touches something. Demo shop, invented names.
import Icon from './Icon.astro';
import Device from './Device.astro';
import { tr, langOf } from '../i18n/t';
const lang = langOf(Astro.url);
const tt = tr(lang);
const LOC = { fr: 'fr-FR', en: 'en-GB', ar: 'ar-MA-u-nu-latn' };

// the real page's own words (apps/menu/src/pressing/TrackApp.tsx), with {x} for what changes
const S = {
  fr: {
    steps: ['Déposé', 'Nettoyage', 'Prêt', 'Récupéré'], hReady: 'Votre linge est prêt.', sReady: 'Il vous attend au comptoir, vous pouvez passer.', hWait: 'Au nettoyage.', sWait: 'Prêt {d}.',
    hDone: 'Récupéré.', sDone: 'Merci et à bientôt !', pieces: '{n} PIÈCES', rail: 'Sur le portant', railSub: '{r} sur {n} prêtes', st: ['Au nettoyage', 'Prêt', 'Récupéré'],
    total: 'Total', rest: 'Reste à payer', allPaid: 'Tout est payé', open: 'Ouvert', route: 'Itinéraire', wa: 'WhatsApp', ticket: 'Montrez ce numéro ou votre ticket au comptoir.',
    review: 'Satisfait ?', reviewSub: 'Un avis Google aide beaucoup votre pressing.', reviewBtn: 'Laisser un avis', pickup: 'La prochaine fois, on vient chercher votre linge.', pickupBtn: 'Demander un ramassage',
    names: ['Chemise', 'Pantalon', 'Costume 2 pièces', 'Djellaba'],
  },
  en: {
    steps: ['Dropped off', 'Cleaning', 'Ready', 'Collected'], hReady: 'Your clothes are ready.', sReady: 'They are waiting at the counter, you can come by.', hWait: 'Being cleaned.', sWait: 'Ready {d}.',
    hDone: 'Collected.', sDone: 'Thank you, see you soon!', pieces: '{n} ITEMS', rail: 'On the rail', railSub: '{r} of {n} ready', st: ['Being cleaned', 'Ready', 'Collected'],
    total: 'Total', rest: 'Left to pay', allPaid: 'All paid', open: 'Open', route: 'Directions', wa: 'WhatsApp', ticket: 'Show this number or your ticket at the counter.',
    review: 'Happy?', reviewSub: 'A Google review helps your dry cleaner a lot.', reviewBtn: 'Leave a review', pickup: 'Next time, we come for your laundry.', pickupBtn: 'Ask for a pick-up',
    names: ['Shirt', 'Trousers', '2-piece suit', 'Djellaba'],
  },
  ar: {
    steps: ['تودع', 'التنقية', 'واجد', 'تسلم'], hReady: 'الحوايج ديالك واجدين.', sReady: 'كيتسناوك فالكونطوار، تقدر تجي.', hWait: 'كيتنقاو.', sWait: 'واجدين {d}.',
    hDone: 'تسلمو.', sDone: 'شكرا ومرحبا بيك ديما!', pieces: '{n} قطعة', rail: 'فالكروشي', railSub: '{r} من {n} واجدين', st: ['كيتنقى', 'واجد', 'تسلم'],
    total: 'المجموع', rest: 'الباقي للخلاص', allPaid: 'كلشي مخلص', open: 'محلول', route: 'الطريق', wa: 'واتساب', ticket: 'وري هاد الرقم ولا التيكي فالكونطوار.',
    review: 'عجبك؟', reviewSub: 'رأي فـ Google كيعاون بزاف البريسينغ ديالك.', reviewBtn: 'خلي رأي', pickup: 'المرة الجاية، نجيو ناخدو الحوايج من دارك.', pickupBtn: 'طلب الجمع',
    names: ['قميص', 'سروال', 'بدلة من قطعتين', 'جلابة'],
  },
};
const P = S[lang];
const TILL = ['Déposé', 'En nettoyage', 'Prêt', 'Récupéré'];
const MSG = ['Votre linge est bien arrivé. Nous vous prévenons dès qu’il est prêt.', 'Votre linge est en cours de nettoyage.', 'Votre linge est prêt, vous pouvez passer le récupérer.', 'Merci, votre dépôt est remis. À bientôt !'];
const L = Object.fromEntries(['Ouvrir', 'Appel…', 'Scanner le QR'].map((k) => [k, tt(k)]));
const data = { S, lang, loc: LOC, msg: MSG.map((m) => tt(m)), L, wa: tt('WhatsApp envoyé à') };

const qr = Array.from({ length: 49 }, (_, i) => { const r = Math.floor(i / 7), c = i % 7; const corner = (r < 3 && c < 3) || (r < 3 && c > 3) || (r > 3 && c < 3); return corner ? (r % 2 === 1 && c % 2 === 1 ? 0 : 1) : ((i * 7 + r * 3) % 5 < 2 ? 1 : 0); });
// the four article photos for the hangers (public/img/pressing)
const G = ['chemise', 'pantalon', 'costume', 'djellaba'];
---
<div class="pt relative grid gap-x-10 gap-y-8 lg:grid-cols-[0.9fr_1.1fr] lg:grid-rows-[auto_1fr] lg:items-center" data-pt data-s="0" data-ph="cam" data-d={JSON.stringify(data)}>
  <div class="order-1 lg:col-start-1 lg:row-start-1"><slot /></div>

  <!-- the counter: a small till, four statuses -->
  <div class="pt-till order-3 lg:col-start-1 lg:row-start-2 lg:self-start" dir={lang === 'ar' ? 'rtl' : 'ltr'} lang={lang}>
    <p class="text-sm font-semibold text-muted">{tt('À la caisse : touchez une étape')}</p>
    <div class="mt-3 overflow-hidden rounded-[1.1rem] bg-[#06162b] p-3 text-white shadow-[0_30px_60px_-30px_rgba(0,30,62,.6)] ring-1 ring-white/10 sm:p-4">
      <div class="flex items-center justify-between gap-2 text-sm">
        <p class="font-semibold">Pressing Démo</p>
        <p class="flex items-center gap-2 text-white/55"><span dir="ltr" class="rounded-md bg-white/10 px-2 py-0.5 font-bold text-white">N° 1042</span><span>Nadia</span></p>
      </div>
      <ul class="mt-3 grid grid-cols-2 gap-2">
        {TILL.map((x, k) => (
          <li><button type="button" class="pt-btn flex w-full items-center gap-2.5 rounded-xl bg-white/[0.07] py-2 pe-3 ps-2 text-start font-semibold ring-1 ring-white/10" data-go={k}>
            <span class="pt-n grid size-7 shrink-0 place-items-center rounded-full bg-white/10 text-sm font-bold text-white/60" dir="ltr">{k + 1}</span><span class="leading-tight">{tt(x)}</span>
          </button></li>
        ))}
      </ul>
      <p class="pt-note mt-3 flex min-h-8 items-center gap-2 rounded-lg px-1 text-sm text-white/60" aria-live="polite">
        <span class="pt-note-i hidden items-center gap-2 font-semibold text-green"><span class="grid size-6 place-items-center rounded-full bg-[#25D366] text-white"><Icon name="message" class="size-3.5" /></span>{tt('WhatsApp envoyé à')} Nadia</span>
        <span class="pt-note-h">{tt('Le client touche aussi son téléphone.')}</span>
      </p>
    </div>
  </div>

  <!-- the scene: the ticket on the counter, the phone that scans it -->
  <div class="order-2 lg:col-start-2 lg:row-span-2 lg:row-start-1">
    <div class="pt-stage relative mx-auto flex max-w-[36rem] flex-col items-center gap-6 sm:flex-row sm:items-end sm:gap-0">
      <div class="relative z-0 w-[68%] max-w-[15rem] shrink-0 sm:w-[45%] sm:max-w-none">
        <div class="pt-tkw" style="filter:drop-shadow(0 18px 24px rgba(0,30,62,.25))">
          <div class="pt-tk bg-[#FAF8F3] px-[7%] pb-[11%] pt-[7%] text-[#001E3E]" style="font-size:clamp(11px,1.25vw,14px)" dir="ltr">
            <p class="flex items-center justify-between text-[0.8em] font-semibold text-black/55"><span>Pressing Démo</span><span>{tt('Prêt le')} <span data-k="due">—</span></span></p>
            <p class="display mt-[0.3em] text-[2.8em] leading-none">N° 1042</p>
            <div class="mt-[0.9em] flex items-center gap-[0.9em]">
              <div class="pt-qrw relative shrink-0">
                <div class="pt-qr grid size-[6.4em] grid-cols-7 gap-px rounded-[0.35em] bg-white p-[0.35em] ring-1 ring-black/10">{qr.map((v) => <i class={v ? 'd bg-[#001E3E]' : 'bg-white'}></i>)}</div>
                <span class="pt-vf pointer-events-none absolute -inset-[0.7em]" aria-hidden="true"><b></b><b></b><b></b><b></b></span>
                <span class="pt-sl pointer-events-none absolute inset-x-[0.35em] top-[0.35em] h-[2px]" aria-hidden="true"></span>
              </div>
              <p class="text-[0.85em] leading-snug text-black/60">{tt('4 pièces')}<br />{tt('Reste à payer')}<br /><b dir="ltr" class="display text-[1.5em] text-[#001E3E]">265 MAD</b></p>
            </div>
            <p class="mt-[0.9em] text-[0.75em] font-semibold text-black/45">{tt('Scannez pour suivre votre dépôt')}</p>
          </div>
        </div>
        <button type="button" class="pt-scan mx-auto mt-4 flex items-center gap-2 rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white ring-1 ring-black/10 transition hover:bg-blue" data-scan><Icon name="qr" class="size-4 text-green" />{tt('Scanner le QR')}</button>
      </div>

      <div class="pt-phone relative z-10 mx-auto w-[74%] max-w-[17.5rem] sm:-ms-[3%] sm:w-[58%] sm:max-w-none">
        <div class="tf-float">
          <div class="pt-buzz">
            <Device kind="phone" w={600} h={1298} class="-rotate-[2deg]">
              <div slot="screen" class="pt-ph relative aspect-[600/1180] overflow-hidden bg-[#0b0f14]" aria-hidden="true" lang={lang}>

                <!-- the camera, before the page opens -->
                <div class="pt-cam absolute inset-0 text-white">
                  <div class="pt-pill absolute inset-x-[10%] top-[7%] flex items-center justify-between gap-2 rounded-full bg-[#F5C518] px-[4%] py-[2.6%] text-[0.62em] font-bold text-[#2A2A26] shadow-lg" style="font-size:clamp(9px,3.4cqw,13px)"><span class="flex items-center gap-1.5"><Icon name="qr" class="size-[1.3em]" />Pressing Démo</span><span data-k="open">{tt('Ouvrir')}</span></div>
                  <div class="pt-cf absolute left-1/2 top-1/2 aspect-square w-[58%] -translate-x-1/2 -translate-y-1/2"><b></b><b></b><b></b><b></b>
                    <div class="absolute inset-[16%] grid grid-cols-7 gap-px opacity-80" style="transform:perspective(300px) rotateX(14deg) rotate(-4deg)">{qr.map((v) => <i class={v ? 'bg-white' : 'bg-white/10'}></i>)}</div>
                  </div>
                  <p class="absolute inset-x-0 bottom-[10%] text-center text-white/60" style="font-size:clamp(9px,3.4cqw,13px)">{tt('Scannez pour suivre votre dépôt')}</p>
                </div>

                <!-- the page of the client: a copy of the real one -->
                <div class="pt-pgw absolute inset-0 z-10">
                  <div class="pt-pg" data-pg dir={lang === 'ar' ? 'rtl' : 'ltr'}>
                    <div class="pt-in">
                      <header class="pt-name flex items-center gap-[0.75em]">
                        <p class="pt-sn min-w-0 flex-1 truncate">Pressing Démo</p>
                        <div class="pt-lg flex shrink-0 gap-[0.125em]" dir="ltr">
                          {(['fr', 'ar', 'en'] as const).map((l) => <button type="button" data-lg={l} class={lang === l ? 'on' : ''}>{l === 'ar' ? 'ع' : l.toUpperCase()}</button>)}
                        </div>
                      </header>

                      <div class="pt-tag mx-auto mt-[1.5em] w-[88%]" dir="ltr">
                        <div class="pt-tagi relative">
                          <span class="pt-stp"></span>
                          <p class="pt-mono pt-t1">PRESSING DÉMO</p>
                          <p class="pt-mono pt-t2">1042</p>
                          <p class="pt-mono pt-t3"><span data-k="tagday">—</span> · <span data-k="tagpc">{P.pieces.replace('{n}', '4')}</span></p>
                        </div>
                      </div>
                      <p class="pt-hint pt-r1" data-k="ticket">{P.ticket}</p>

                      <section class="pt-r2 mt-[2.25em]">
                        <h1 class="pt-h1" data-k="h1">{P.hWait}</h1>
                        <p class="pt-sub" data-k="sub">—</p>
                        <ol class="pt-tl">
                          <span class="pt-tl-b"></span><span class="pt-tl-f" data-k="bar"></span>
                          {P.steps.map((x, k) => (
                            <li data-st={k}><span class="pt-dt"></span><span class="pt-tx" data-k={`step${k}`}>{x}</span><span class="pt-tm" dir="ltr" data-k={`time${k}`}></span></li>
                          ))}
                        </ol>
                      </section>

                      <section class="pt-r3 mt-[2.5em]" data-rail>
                        <div class="flex items-baseline justify-between"><h2 class="pt-h2" data-k="rail">{P.rail}</h2><span class="pt-rs" data-k="railsub">—</span></div>
                        <div class="pt-rl">
                          <div class="pt-bar"></div>
                          <ul class="pt-ul">
                            {G.map((f, k) => (
                              <li class="pt-pc p0" data-pc style={`--dl:${k * 0.16}s`}>
                                <svg viewBox="0 0 96 34" class="pt-hg" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M48 12V8a5 5 0 1 0-5-5" /><path d="M48 12L8 30Q4 32 9 32H87Q92 32 88 30Z" /></svg>
                                <div class="pt-card">
                                  <img src={`/img/pressing/${f}.webp`} alt="" width="640" height="800" loading="eager" decoding="async" draggable="false" class="pt-gm" />
                                  <span class="pt-cv"></span><span class="pt-sh"></span>
                                  <span class="pt-mt pt-mono" dir="ltr">1042 {k + 1}/4</span>
                                </div>
                                <p class="pt-nm" data-k={`name${k}`}>{P.names[k]}</p>
                                <p class="pt-ss" data-k={`ss${k}`}>{P.st[0]}</p>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </section>

                      <section class="pt-rc pt-r4 pt-mono" data-rc>
                        <p class="flex justify-between"><span data-k="total">{P.total}</span><span dir="ltr">265 MAD</span></p>
                        <p class="mt-[0.75em] flex items-end justify-between"><span class="pt-rest" data-k="rest">{P.rest}</span><span class="pt-big" dir="ltr">265 MAD</span></p>
                      </section>

                      <section class="pt-done" data-done>
                        <div class="flex justify-center gap-[0.25em] text-[#F5B301]">{[0, 1, 2, 3, 4].map(() => <Icon name="star" class="size-[1.75em] fill-current" />)}</div>
                        <p class="pt-h2 mt-[0.75em]" data-k="review">{P.review}</p>
                        <p class="pt-sub" data-k="reviewsub">{P.reviewSub}</p>
                        <span class="pt-rv" data-k="reviewbtn">{P.reviewBtn}</span>
                        <p class="pt-pk"><Icon name="truck" class="size-[1.25em] shrink-0 text-[var(--pt-b)]" /><span class="flex-1 text-[#736B60]" data-k="pickup">{P.pickup}</span><b class="shrink-0 text-[var(--pt-b)]" data-k="pickupbtn">{P.pickupBtn}</b></p>
                      </section>

                      <section class="pt-shop">
                        <p><Icon name="clock" class="size-[1.1em] text-[#736B60]" /><i class="pt-od"></i><b data-k="open">{P.open}</b><span class="truncate text-[#736B60]" dir="ltr">08:30–19:30</span></p>
                        <p class="mt-[0.75em]"><Icon name="pin" class="size-[1.1em] text-[#736B60]" /><span>Agdal, Rabat</span></p>
                      </section>
                    </div>
                  </div>

                  <!-- always at hand -->
                  <nav class="pt-nav" dir="ltr">
                    <button type="button" class="pt-nb pt-nb-i" data-nav="call" aria-label="Call"><svg viewBox="0 0 24 24" class="size-[1.3em]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg></button>
                    <button type="button" class="pt-nb flex-1" data-nav="map"><svg viewBox="0 0 24 24" class="size-[1.1em]" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 11l18-8-8 18-2-8z" /></svg><span data-k="route">{P.route}</span></button>
                    <button type="button" class="pt-nb pt-nb-w flex-1" data-nav="wa"><Icon name="message" class="size-[1.1em]" /><span>{P.wa}</span></button>
                  </nav>
                </div>

                <!-- the WhatsApp that reached the client -->
                <p class="pt-toast absolute inset-x-[5%] top-[2%] z-30 flex items-center gap-[0.6em] rounded-[1em] bg-white p-[0.7em] text-[#001E3E] shadow-lg ring-1 ring-black/5" style="font-size:clamp(9px,3.5cqw,13px)"><span class="grid size-[2.2em] shrink-0 place-items-center rounded-full bg-[#25D366] text-white"><Icon name="message" class="size-[1.2em]" /></span><span class="leading-tight"><b class="block">Pressing Démo</b><span class="text-black/60" data-k="toast">{tt(MSG[2])}</span></span></p>

                <!-- what the buttons of the phone do -->
                <div class="pt-ov pt-ov-call z-40 flex-col items-center justify-center gap-[1.2em] bg-gradient-to-b from-[#26354d] to-[#0b0f14] text-white" style="font-size:clamp(10px,4cqw,15px)">
                  <span class="pt-ring grid size-[5em] place-items-center rounded-full bg-white/15 text-[1.6em] font-bold">P</span>
                  <p class="text-center"><b class="block text-[1.3em]">Pressing Démo</b><span class="text-white/60" data-k="calling">{tt('Appel…')}</span></p>
                  <button type="button" class="grid size-[3.4em] place-items-center rounded-full bg-[#E5484D]" data-close aria-label="End"><svg viewBox="0 0 24 24" class="size-[1.5em] rotate-[135deg]" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg></button>
                </div>
                <div class="pt-ov pt-ov-wa z-40 flex-col bg-[#ECE5DD]" style="font-size:clamp(10px,3.7cqw,14px)">
                  <div class="flex items-center gap-[0.7em] bg-[#075E54] px-[1em] py-[0.8em] text-white"><button type="button" data-close aria-label="Back" class="text-[1.4em] leading-none">‹</button><span class="grid size-[2.2em] place-items-center rounded-full bg-white/20 font-bold">P</span><b>Pressing Démo</b></div>
                  <div class="flex flex-1 flex-col gap-[0.6em] p-[1em]" dir="ltr">
                    <p class="pt-b1 ms-auto max-w-[70%] rounded-[0.8em] rounded-te-[0.2em] bg-[#DCF8C6] px-[0.8em] py-[0.5em] text-[#1b1b1b] shadow-sm">N° 1042</p>
                    <p class="pt-b2 max-w-[82%] rounded-[0.8em] rounded-ts-[0.2em] bg-white px-[0.8em] py-[0.5em] text-[#1b1b1b] shadow-sm" data-k="chat">—</p>
                  </div>
                </div>
                <div class="pt-ov pt-ov-map z-40 flex-col bg-[#E9EFE6]">
                  <button type="button" data-close aria-label="Back" class="absolute start-[4%] top-[3%] z-10 grid size-[2.2rem] place-items-center rounded-full bg-white text-lg shadow">‹</button>
                  <svg viewBox="0 0 100 130" class="absolute inset-0 size-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    <rect width="100" height="130" fill="#E9EFE6" /><path d="M0 35h100M0 80h100M30 0v130M72 0v130" stroke="#fff" stroke-width="7" /><path d="M0 108L100 18" stroke="#fff" stroke-width="4" /><rect x="34" y="40" width="34" height="35" rx="3" fill="#CFE3CB" />
                    <path class="pt-rt" d="M12 112V80H30V35H72" fill="none" stroke="#1A73E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="112" r="3.5" fill="#fff" stroke="#1A73E8" stroke-width="1.6" /><path d="M72 35m0-9a5 5 0 0 1 5 5c0 4-5 9-5 9s-5-5-5-9a5 5 0 0 1 5-5z" fill="#E5484D" /><circle cx="72" cy="31" r="1.8" fill="#fff" />
                  </svg>
                  <p class="absolute inset-x-[5%] bottom-[5%] rounded-[0.8rem] bg-white px-[4%] py-[3%] text-[0.7rem] font-semibold text-[#001E3E] shadow-lg">Pressing Démo · Agdal, Rabat</p>
                </div>
              </div>
            </Device>
          </div>
        </div>
      </div>
    </div>
    <p class="mt-5 text-center text-xs text-muted">{tt('Exemple d’illustration')}</p>
  </div>
</div>

<style is:global>
  .pt { --pt-b: #00804A; }
  /* the counter */
  .pt-btn { transition: background-color .4s, color .4s, box-shadow .4s; }
  .pt-btn:hover { background: rgba(255, 255, 255, .14); }
  .pt[data-s="0"] [data-go="0"], .pt[data-s="1"] [data-go="1"], .pt[data-s="2"] [data-go="2"], .pt[data-s="3"] [data-go="3"] { background: #05B962; color: #001E3E; box-shadow: none; }
  .pt[data-s="0"] [data-go="0"] .pt-n, .pt[data-s="1"] [data-go="1"] .pt-n, .pt[data-s="2"] [data-go="2"] .pt-n, .pt[data-s="3"] [data-go="3"] .pt-n { background: #001E3E; color: #05B962; }
  .pt-note-i { display: none; } .pt.sent .pt-note-i { display: flex; animation: pt-in .5s both; } .pt.sent .pt-note-h { display: none; }
  /* the ticket */
  .pt-tk { clip-path: polygon(0 0, 100% 0, 100% calc(100% - 7px), 95% 100%, 90% calc(100% - 7px), 85% 100%, 80% calc(100% - 7px), 75% 100%, 70% calc(100% - 7px), 65% 100%, 60% calc(100% - 7px), 55% 100%, 50% calc(100% - 7px), 45% 100%, 40% calc(100% - 7px), 35% 100%, 30% calc(100% - 7px), 25% 100%, 20% calc(100% - 7px), 15% 100%, 10% calc(100% - 7px), 5% 100%, 0 calc(100% - 7px)); transform: rotate(-3deg); transform-origin: 50% 100%; }
  .pt-qr i { transition: background-color .3s; }
  .pt.hit .pt-qr i.d { background: #05B962; }
  .pt-vf { opacity: 0; transform: scale(1.35); transition: opacity .3s, transform .5s cubic-bezier(.2,1.2,.4,1); }
  .pt-vf b, .pt-cf b { position: absolute; width: 1.1em; height: 1.1em; border: 0 solid #fff; }
