<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Dict = Record<string, any>;
  document.querySelectorAll<HTMLElement>('[data-pt]').forEach((root) => {
    const D = JSON.parse(root.dataset.d || '{}') as Dict;
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const qa = <T extends HTMLElement = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const pg = q('[data-pg]'), phone = q('.pt-phone'), buzz = q('.pt-buzz'), qrw = q('.pt-qrw');
    const text = (k: string, v: string) => qa(`[data-k="${k}"]`).forEach((e) => { e.textContent = v; });
    let s = 0, pl: string = D.lang, timers: number[] = [], auto = false;
    const later = (ms: number, f: () => void) => { timers.push(window.setTimeout(f, ms)); };
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const stop = () => { auto = false; clear(); root.classList.remove('scan'); };
    const loc = () => D.loc[pl] as string;
    const due = new Date(); due.setDate(due.getDate() + 2);
    const day = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString(loc(), o);
    const hm = (d: Date, h: number, m: number) => { const x = new Date(d); x.setHours(h, m); return `${day(x, { weekday: 'short' })} ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`; };
    const now = new Date();
    const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));

    const render = () => {
      const P = D.S[pl], step = s, ready = s >= 2 ? 4 : 0, state = s >= 3 ? 2 : s === 2 ? 1 : 0;
      root.dataset.s = String(s);
      pg.dir = pl === 'ar' ? 'rtl' : 'ltr'; pg.lang = pl;
      const head = s === 3 ? [P.hDone, P.sDone] : s === 2 ? [P.hReady, P.sReady] : [P.hWait, fill(P.sWait, { d: day(due, { weekday: 'long', day: 'numeric', month: 'long' }) })];
      text('h1', head[0]); text('sub', head[1]);
      text('tagday', `${day(due, { weekday: 'short' }).replace('.', '').toUpperCase()} ${String(due.getDate()).padStart(2, '0')}/${String(due.getMonth() + 1).padStart(2, '0')}`);
      text('due', `${String(due.getDate()).padStart(2, '0')}/${String(due.getMonth() + 1).padStart(2, '0')}`);
      text('tagpc', fill(P.pieces, { n: 4 }));
      P.steps.forEach((x: string, k: number) => text(`step${k}`, x));
      const times = [hm(now, 9, 12), '', hm(due, 17, 40), hm(due, 18, 5)];
      qa('[data-st]').forEach((li, k) => { li.classList.toggle('on', k <= step); li.classList.toggle('cur', k === step && s !== 3); text(`time${k}`, k <= step ? times[k] : ''); });
      q('[data-k="bar"]').style.width = `${(Math.min(step, 3) / 3) * 75}%`;
      text('rail', P.rail); text('railsub', fill(P.railSub, { r: ready, n: 4 }));
      qa('[data-pc]').forEach((li, k) => { li.className = `pt-pc p${state}`; text(`name${k}`, P.names[k]); text(`ss${k}`, P.st[state]); });
      text('total', P.total); text('rest', s >= 3 ? P.allPaid : P.rest); text('ticket', P.ticket);
      text('review', P.review); text('reviewsub', P.reviewSub); text('reviewbtn', P.reviewBtn); text('pickup', P.pickup); text('pickupbtn', P.pickupBtn);
      text('open', P.open); text('route', P.route);
      qa('[data-lg]').forEach((b) => b.classList.toggle('on', b.dataset.lg === pl));
    };

    // a light from one device to the other (also works when they are stacked on a phone)
    const fly = (a: HTMLElement, b: HTMLElement) => {
      if (still) return;
      const r = root.getBoundingClientRect(), A = a.getBoundingClientRect(), B = b.getBoundingClientRect();
      const x1 = A.left + A.width / 2 - r.left, y1 = A.top + A.height / 2 - r.top, x2 = B.left + B.width / 2 - r.left, y2 = B.top + B.height * 0.35 - r.top;
      const len = Math.hypot(x2 - x1, y2 - y1), ang = Math.atan2(y2 - y1, x2 - x1);
      const line = document.createElement('i'); line.className = 'pt-wl'; line.style.left = `${x1}px`; line.style.top = `${y1}px`; line.style.width = `${len}px`;
      const dot = document.createElement('i'); dot.className = 'pt-wd';
      root.append(line, dot);
      const rot = `rotate(${ang}rad)`;
      line.animate([{ transform: `${rot} scaleX(0)`, opacity: 1 }, { transform: `${rot} scaleX(1)`, opacity: 1, offset: 0.7 }, { transform: `${rot} scaleX(1)`, opacity: 0 }], { duration: 900, easing: 'ease-out' }).onfinish = () => line.remove();
      dot.animate([{ transform: `translate(${x1}px,${y1}px) scale(.6)`, opacity: 1 }, { transform: `translate(${x2}px,${y2}px) scale(1.4)`, opacity: 1, offset: 0.85 }, { transform: `translate(${x2}px,${y2}px) scale(2.2)`, opacity: 0 }], { duration: 900, easing: 'cubic-bezier(.5,0,.2,1)' }).onfinish = () => dot.remove();
    };
    const shake = () => { buzz.classList.remove('go'); void buzz.offsetWidth; buzz.classList.add('go'); };
    const toast = (msg: string) => { text('toast', msg); root.classList.add('toast'); later(3400, () => root.classList.remove('toast')); };
    const scrollTo = (el: HTMLElement | null, extra = 0) => { if (el) pg.scrollTo({ top: Math.max(0, el.offsetTop - extra), behavior: still ? 'auto' : 'smooth' }); };
    const ov = (name: string) => { if (name) root.dataset.ov = name; else delete root.dataset.ov; };

    const open = () => { root.dataset.ph = 'open'; };
    const setS = (n: number, from?: HTMLElement) => {
      const changed = n !== s; s = n; render();
      if (root.dataset.ph !== 'open') { open(); return; }
      if (!changed) return;
      if (from) fly(from, phone);
      const keep = pg.scrollTop;
      if (n === 2) { root.classList.add('sent'); later(300, () => { shake(); toast(D.msg[2]); }); later(1100, () => scrollTo(q('[data-rail]'), 14)); }
      else if (n === 3) { root.classList.remove('sent'); later(800, () => scrollTo(q('[data-done]'), 10)); }
      else { root.classList.remove('sent'); if (keep > 0) pg.scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }); }
    };

    // the scan: viewfinder, scan line, buzz, the page opens
    const scan = (then?: () => void) => {
      clear(); ov(''); root.classList.remove('toast', 'hit'); root.dataset.ph = 'cam'; pg.scrollTop = 0; root.classList.add('scan');
      later(1500, () => { root.classList.add('hit'); fly(qrw, phone); later(350, shake); });
      later(2300, () => { root.classList.remove('scan'); open(); then?.(); });
    };

    // touch = your turn
    qa('[data-go]').forEach((b) => b.addEventListener('click', () => { stop(); setS(Number(b.dataset.go), b); }));
    q('[data-scan]').addEventListener('click', () => { stop(); root.classList.remove('hit'); scan(); });
    qa('[data-lg]').forEach((b) => b.addEventListener('click', () => { stop(); pl = b.dataset.lg!; render(); }));
    qa('[data-close]').forEach((b) => b.addEventListener('click', () => { stop(); ov(''); }));
    qa('[data-nav]').forEach((b) => b.addEventListener('click', () => {
      stop(); const k = b.dataset.nav!; ov(k);
      if (k === 'call') later(3200, () => ov(''));
      if (k === 'wa') text('chat', D.msg[Math.min(s, 3)]);
    }));
    ['wheel', 'touchstart', 'pointerdown'].forEach((e) => phone.addEventListener(e, () => { if (auto) stop(); }, { passive: true }));

    render();
    if (still) { s = 2; render(); root.dataset.ph = 'open'; root.classList.add('sent'); return; }

    // it plays by itself once: scan, then the four statuses, until the visitor touches something
    const go = (n: number) => setS(n, q(`[data-go="${n}"]`));
    new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect(); auto = true;
      scan(() => {
        if (!auto) return;
        later(2600, () => go(1)); later(5400, () => go(2)); later(10600, () => go(3));
      });
    }, { threshold: 0.45 }).observe(phone);
  });
</script>
