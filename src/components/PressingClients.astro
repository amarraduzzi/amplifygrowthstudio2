---
// "Vos clients": the client file as one dark window. Dark section, the window on the end side.
// Four scenes play in turn and the four points on the other side light up with them:
// 1 the client file opens on what matters (spent counts up, at the dry cleaner, left to pay),
// 2 two files of the same client slide into one (nothing deleted, undo shown, "merge all"),
// 3 the clients who stopped coming (a WhatsApp goes out, the daily meter moves, one comes back),
// 4 an Excel file drops in and the clients and drop-offs come in (nothing existing changed, undo).
// Loops while in view; a tap on a point or on the window jumps there. Demo shop, invented names and numbers.
import Icon from './Icon.astro';
import { tr, langOf } from '../i18n/t';
const tt = tr(langOf(Astro.url));
interface Props { items: readonly (readonly [string, string, string])[] }
const { items } = Astro.props;
const lapsed = [
  ['S', 'Samira E.', '94', '1 420'],
  ['Y', 'Youssef A.', '71', '980'],
  ['M', 'Meryem T.', '63', '760'],
] as const;
const bars = [28, 40, 34, 52, 46, 64, 58, 44, 70, 62, 82, 74, 92, 100];
---
<section id="clients" class="pcl relative isolate scroll-mt-20 overflow-hidden bg-navy text-white" data-tf data-pcl>
  <span class="sl-blob sl-blob-a" aria-hidden="true"></span>
  <span class="sl-blob sl-blob-b" aria-hidden="true"></span>
  <span class="pcl-dots" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <h2 class="tf text-[2.6rem] leading-[0.95] sm:text-6xl sm:leading-[0.9]"><span class="block">{tt('Vos clients.')}</span><span class="block text-green">{tt('Ceux d’hier et ceux qui reviennent.')}</span></h2>
    <p class="tf mt-4 max-w-2xl text-lg text-white/70" style="--d:100ms">{tt('Une fiche utile au comptoir, des doublons nettoyés, et la liste de ceux qui ne viennent plus. Si vous changez de système, vos clients viennent avec vous.')}</p>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-14 md:mt-16">
      <ul class="order-2 grid gap-3 lg:order-1">
        {items.map(([i, h, x], k) => (
          <li class="pcl-it tf" data-it={k} tabindex="0" role="button" style={`--d:${k * 90}ms`}>
            <span class="pcl-ico"><Icon name={i} class="size-5" /></span>
            <div><p class="font-semibold">{tt(h)}</p><p class="mt-1 text-[0.95rem] leading-relaxed text-white/65">{tt(x)}</p></div>
            <i class="pcl-prog" aria-hidden="true"></i>
          </li>
        ))}
      </ul>

      <div class="tf order-1 lg:order-2" style="--d:150ms">
        <div class="pcl-panel" data-panel>
          <span class="pcl-glow" aria-hidden="true"></span>
          <div class="pcl-win" data-stage role="img" aria-label={tt('Le fichier client : la fiche, les doublons fusionnés, les clients rappelés, la reprise des données')}>
            <div class="pcl-bar" aria-hidden="true"><i></i><i></i><i></i><span>{tt('Clients')} · Pressing Démo</span><u class="pcl-live"></u></div>
            <div class="pcl-body">

              <!-- 1 the client file -->
              <div class="pcl-sc s1">
                <div class="pcl-id"><span class="pcl-av">NB</span><p><b><bdi>Nadia Benkirane</bdi></b><span dir="ltr">06 61 •• 18 42</span></p><span class="pcl-tag">{tt('Habituée')}</span></div>
                <div class="pcl-tiles">
                  <p><span>{tt('Dépôts')}</span><b dir="ltr" data-c1>0</b></p>
                  <p><span>{tt('Total dépensé')}</span><b dir="ltr"><i data-spent>0</i> <small>MAD</small></b></p>
                  <p><span>{tt('Dernière visite')}</span><b class="sm">{tt('il y a 3 j')}</b></p>
                </div>
                <div class="pcl-spark" aria-hidden="true">{bars.map((h, i) => <i style={`--h:${h}%;--i:${i}`}></i>)}</div>
                <p class="pcl-hl a"><span class="ic"><Icon name="shirt" class="size-[1.2em]" /></span><span class="tx"><b>{tt('Au pressing')}</b><i>{tt('Dépôt n°')} <bdi dir="ltr">1042</bdi></i></span><em><b dir="ltr">2</b> {tt('pièces')}</em></p>
                <p class="pcl-hl b"><span class="ic"><Icon name="wallet" class="size-[1.2em]" /></span><span class="tx"><b>{tt('Reste à payer')}</b><i>{tt('Dépôt n°')} <bdi dir="ltr">1042</bdi></i></span><em dir="ltr">85 MAD</em></p>
              </div>

              <!-- 2 duplicates merged -->
              <div class="pcl-sc s2">
                <p class="pcl-eq"><Icon name="search" class="size-[1.1em]" />{tt('Même numéro de téléphone')}</p>
                <div class="pcl-dups">
                  <div class="pcl-d a"><span class="pcl-av">NB</span><p><b><bdi>Nadia Benkirane</bdi></b><span dir="ltr">06 61 •• 18 42</span></p><em><span class="cnt"><b class="x1" dir="ltr">18</b><b class="x2" dir="ltr">21</b></span> {tt('dépôts')}</em><u class="pcl-badge">{tt('2 fiches, 1 client')}</u></div>
                  <div class="pcl-d b"><span class="pcl-av alt">N</span><p><b><bdi>Nadia B.</bdi></b><span dir="ltr">06 61 •• 18 42</span></p><em><b dir="ltr">3</b> {tt('dépôts')}</em></div>
                </div>
                <div class="pcl-undo"><span><Icon name="check" class="size-[1.1em]" />{tt('Fusionné')} · {tt('Rien n’est supprimé')}</span><u>{tt('Annuler')}</u></div>
                <p class="pcl-all"><span>{tt('Tout fusionner')}</span><b><bdi dir="ltr">3</bdi> {tt('cas sûrs')}</b></p>
              </div>

              <!-- 3 clients who stopped coming -->
              <div class="pcl-sc s3">
                <p class="pcl-h3"><b>{tt('Ceux qui ne viennent plus')}</b><span dir="ltr">12</span></p>
                <div class="pcl-lp">
                  {lapsed.map(([a, n, d, v], i) => (
                    <div class={`pcl-r r${i + 1}`} style={`--i:${i}`}>
                      <span class="pcl-av alt">{a}</span>
                      <p><b><bdi>{n}</bdi></b><span><bdi dir="ltr">{d}</bdi> {tt('jours sans visite')}</span></p>
                      <em><b dir="ltr">{v} MAD</b><span>{tt('par an')}</span></em>
                      <span class="pcl-wa"><span class="m"><Icon name="message" class="size-[1.15em]" /></span><span class="c"><Icon name="check" class="size-[1.15em]" /></span></span>
                      {i === 2 && <span class="pcl-back"><span class="pcl-av alt">{a}</span><span class="pb2"><b><bdi>{n}</bdi></b><span>{tt('Elle est revenue')}</span></span><b class="amt" dir="ltr">+120 MAD</b></span>}
                    </div>
                  ))}
                </div>
                <div class="pcl-meter"><p><span>{tt('Envois du jour · 25 au plus')}</span><b dir="ltr"><i data-sent>7</i> / 25</b></p><i class="pcl-mb"><u></u></i></div>
              </div>

              <!-- 4 moving in -->
              <div class="pcl-sc s4">
                <div class="pcl-drop">
                  <p class="pcl-file"><span class="ic"><Icon name="box" class="size-[1.2em]" /></span><span class="tx"><b dir="ltr">ancien-systeme.xlsx</b><i>CSV · Excel</i></span></p>
                  <p class="pcl-dz">{tt('Déposez votre fichier CSV ou Excel')}</p>
                </div>
                <div class="pcl-imp"><p class="pcl-il"><span class="a">{tt('Import en cours')}</span><span class="b"><Icon name="check" class="size-[1.1em]" />{tt('Import terminé')}</span></p><i class="pcl-pb"><u></u></i></div>
                <div class="pcl-cnt">
                  <p><span>{tt('Clients')}</span><b dir="ltr" data-cl>0</b></p>
                  <p><span>{tt('Historique des dépôts')}</span><b dir="ltr" data-dp>0</b></p>
                </div>
                <ul class="pcl-ck">
                  <li><Icon name="shield" class="size-[1.15em]" />{tt('Rien d’existant n’est modifié')}</li>
                  <li><Icon name="check" class="size-[1.15em]" />{tt('Chaque import s’annule')}<u>{tt('Annuler l’import')}</u></li>
                </ul>
              </div>

            </div>
          </div>
        </div>
        <button type="button" class="pcl-redo" data-redo><svg viewBox="0 0 24 24" class="size-[1.1em]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4" /></svg>{tt('Recommencer')}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .pcl { --pg: #05B962; --amber: #F5B13D; --dir: 1; }
  [dir="rtl"] .pcl { --dir: -1; }
  .pcl-dots { position: absolute; inset: 0; z-index: -10; pointer-events: none; background-image: radial-gradient(rgb(255 255 255 / .09) 1px, transparent 1.5px); background-size: 24px 24px; -webkit-mask-image: radial-gradient(70% 70% at 80% 40%, #000, transparent 80%); mask-image: radial-gradient(70% 70% at 80% 40%, #000, transparent 80%); }

  .pcl-panel { container-type: inline-size; position: relative; padding: 1.6rem 1.1rem; border-radius: 2.2rem; background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .02)); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .1); perspective: 1400px; }
  .pcl-glow { position: absolute; inset: 8% 6%; z-index: -1; border-radius: 999px; background: radial-gradient(closest-side, rgba(5, 185, 98, .5), transparent); filter: blur(30px); opacity: .55; animation: pcl-breathe 7s ease-in-out infinite alternate; pointer-events: none; }
  @keyframes pcl-breathe { to { opacity: .9; transform: scale(1.06); } }

  .pcl-win { --rx: 0deg; --ry: 0deg; position: relative; overflow: hidden; font-size: clamp(11px, 2.55cqw, 15px); border-radius: 1.5em; background: linear-gradient(180deg, #0d2c4e, #081f3a); color: #fff; box-shadow: 0 0 0 1px rgba(255, 255, 255, .14), 0 3.5em 5em -2em rgba(0, 0, 0, .7); transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform .35s ease-out; will-change: transform; }
  .pcl-bar { display: flex; align-items: center; gap: .45em; padding: .85em 1.1em; background: rgba(255, 255, 255, .05); box-shadow: inset 0 -1px 0 rgba(255, 255, 255, .08); }
  .pcl-bar i { width: .7em; height: .7em; border-radius: 99px; background: rgba(255, 255, 255, .22); }
  .pcl-bar span { margin-inline-start: .6em; font-size: .8em; font-weight: 600; color: rgba(255, 255, 255, .6); }
  .pcl-live { margin-inline-start: auto; width: .6em; height: .6em; border-radius: 99px; background: var(--pg); box-shadow: 0 0 0 0 rgba(5, 185, 98, .6); animation: pcl-ping 2s infinite; }
  @keyframes pcl-ping { 70% { box-shadow: 0 0 0 .7em rgba(5, 185, 98, 0); } 100% { box-shadow: 0 0 0 0 rgba(5, 185, 98, 0); } }

  .pcl-body { display: grid; height: 23.5em; padding: 1.4em; overflow: hidden; }
  .pcl-sc { grid-area: 1 / 1; display: grid; align-content: start; gap: .85em; min-width: 0; opacity: 0; transform: translateY(1.2em) scale(.985); pointer-events: none; transition: opacity .4s, transform .5s cubic-bezier(.2, .8, .2, 1); }
  .pcl[data-s="1"] .s1, .pcl[data-s="2"] .s2, .pcl[data-s="3"] .s3, .pcl[data-s="4"] .s4 { opacity: 1; transform: none; transition-delay: .15s; }

  .pcl-av { display: grid; place-items: center; flex: none; width: 2.9em; height: 2.9em; border-radius: 99px; background: linear-gradient(135deg, #05B962, #0A8F5A); color: #001E3E; font-weight: 800; font-size: 1em; }
  .pcl-av.alt { background: rgba(255, 255, 255, .14); color: #fff; }
  .pcl-id { display: flex; align-items: center; gap: .8em; }
  .pcl-id p, .pcl-d p { display: grid; line-height: 1.3; min-width: 0; } .pcl-id b, .pcl-d b { font-size: 1.15em; } .pcl-id p span, .pcl-d p span { font-size: .78em; color: rgba(255, 255, 255, .55); font-weight: 600; }
  .pcl-tag { margin-inline-start: auto; padding: .25em .8em; border-radius: 99px; background: rgba(5, 185, 98, .18); color: #5be3a4; font-size: .78em; font-weight: 800; white-space: nowrap; }

  .pcl-tiles { display: grid; grid-template-columns: .8fr 1.35fr 1.1fr; gap: .55em; }
  .pcl-tiles p { padding: .65em .85em; border-radius: .9em; background: rgba(255, 255, 255, .07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08); min-width: 0; }
  .pcl-tiles span { display: block; font-size: .66em; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: rgba(255, 255, 255, .5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pcl-tiles b { display: block; margin-top: .15em; font-size: 1.4em; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.15; white-space: nowrap; }
  .pcl-tiles b small { font-size: .5em; color: rgba(255, 255, 255, .55); } .pcl-tiles b i { font-style: normal; } .pcl-tiles b.sm { font-size: 1em; line-height: 1.6; }
  .pcl-spark { display: flex; align-items: flex-end; gap: .35em; height: 3.2em; padding: 0 .2em; }
  .pcl-spark i { flex: 1; height: var(--h); border-radius: .3em .3em .1em .1em; background: linear-gradient(180deg, var(--pg), rgba(5, 185, 98, .25)); transform: scaleY(0); transform-origin: bottom; transition: transform .7s calc(var(--i) * 45ms + .2s) cubic-bezier(.3, 1.4, .5, 1); }
  .pcl.t1 .s1 .pcl-spark i { transform: none; }
  .pcl-hl { display: flex; align-items: center; gap: .8em; padding: .75em .9em; border-radius: 1em; opacity: 0; transform: translateX(calc(1.4em * var(--dir))); }
  .pcl-hl .ic { display: grid; place-items: center; flex: none; width: 2.3em; height: 2.3em; border-radius: .7em; }
  .pcl-hl .tx { display: grid; line-height: 1.3; min-width: 0; } .pcl-hl .tx b { font-size: .95em; } .pcl-hl .tx i { font-style: normal; font-size: .75em; color: rgba(255, 255, 255, .55); font-weight: 600; }
  .pcl-hl em { margin-inline-start: auto; font-style: normal; font-weight: 800; white-space: nowrap; }
  .pcl-hl.a { background: rgba(5, 185, 98, .14); box-shadow: inset 0 0 0 1px rgba(5, 185, 98, .45); } .pcl-hl.a .ic { background: var(--pg); color: #001E3E; } .pcl-hl.a em { color: #5be3a4; }
  .pcl-hl.b { background: rgba(245, 177, 61, .13); box-shadow: inset 0 0 0 1px rgba(245, 177, 61, .5); } .pcl-hl.b .ic { background: var(--amber); color: #001E3E; } .pcl-hl.b em { color: var(--amber); font-size: 1.1em; }
  .pcl.t2 .s1 .pcl-hl.a, .pcl.t3 .s1 .pcl-hl.a { opacity: 1; transform: none; transition: opacity .4s, transform .6s cubic-bezier(.3, 1.4, .5, 1); }
  .pcl.t3 .s1 .pcl-hl.b { opacity: 1; transform: none; transition: opacity .4s, transform .6s cubic-bezier(.3, 1.4, .5, 1); }

  .pcl-eq { display: inline-flex; align-items: center; gap: .5em; justify-self: start; padding: .3em .85em; border-radius: 99px; background: rgba(255, 255, 255, .08); font-size: .8em; font-weight: 700; color: rgba(255, 255, 255, .8); }
  .pcl-dups { display: grid; gap: 1.2em; margin-top: .3em; }
  .pcl-d { position: relative; display: flex; align-items: center; gap: .8em; height: 4.6em; padding: 0 1em; border-radius: 1.1em; background: rgba(255, 255, 255, .08); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .12); transition: transform .9s cubic-bezier(.6, 0, .2, 1), opacity .5s .5s, box-shadow .5s; }
  .pcl-d em { margin-inline-start: auto; font-style: normal; font-size: .85em; color: rgba(255, 255, 255, .65); white-space: nowrap; } .pcl-d em b { font-size: 1.4em; color: #fff; }
  .pcl-d .cnt { display: inline-grid; } .pcl-d .cnt b { grid-area: 1 / 1; text-align: end; transition: opacity .4s, transform .5s; } .pcl-d .x2 { opacity: 0; transform: translateY(.6em); color: #5be3a4 !important; }
  .pcl-d.a { z-index: 2; }
  .pcl-d.b { z-index: 1; }
  .pcl.t1 .s2 .pcl-d.b { transform: translateY(-5.8em) scale(.96); opacity: 0; }
  .pcl.t1 .s2 .pcl-d.a { box-shadow: inset 0 0 0 2px var(--pg), 0 0 2.5em rgba(5, 185, 98, .35); transition-delay: .7s; }
  .pcl.t1 .s2 .x1 { opacity: 0; transform: translateY(-.6em); transition-delay: .8s; } .pcl.t1 .s2 .x2 { opacity: 1; transform: none; transition-delay: .8s; }
  .pcl-badge { position: absolute; inset-block-start: -.95em; inset-inline-end: 1em; text-decoration: none; padding: .15em .7em; border-radius: 99px; background: var(--pg); color: #001E3E; font-size: .7em; font-weight: 800; opacity: 0; transform: scale(.7); transition: opacity .3s, transform .5s cubic-bezier(.3, 1.6, .5, 1); }
  .pcl.t1 .s2 .pcl-badge { opacity: 1; transform: none; transition-delay: 1.1s; }
  .pcl-undo { display: flex; align-items: center; justify-content: space-between; gap: .8em; padding: .7em .9em; border-radius: 1em; background: rgba(5, 185, 98, .14); box-shadow: inset 0 0 0 1px rgba(5, 185, 98, .4); font-size: .85em; font-weight: 700; color: #7bebb6; opacity: 0; transform: translateY(1em); transition: opacity .4s, transform .6s cubic-bezier(.3, 1.4, .5, 1); }
  .pcl-undo span { display: flex; align-items: center; gap: .5em; min-width: 0; } .pcl-undo u { text-decoration: none; padding: .3em .9em; border-radius: 99px; background: rgba(255, 255, 255, .14); color: #fff; white-space: nowrap; }
  .pcl.t2 .s2 .pcl-undo { opacity: 1; transform: none; }
  .pcl-all { display: flex; align-items: center; justify-content: space-between; padding: .8em 1em; border-radius: 1em; background: var(--pg); color: #001E3E; font-weight: 800; opacity: 0; transition: opacity .4s; }
  .pcl-all b { padding: .1em .7em; border-radius: 99px; background: #001E3E; color: #fff; font-size: .8em; }
  .pcl.t3 .s2 .pcl-all { opacity: 1; animation: pcl-nudge 1.6s .3s ease-in-out 2; }
  @keyframes pcl-nudge { 50% { transform: scale(1.025); box-shadow: 0 0 2em rgba(5, 185, 98, .55); } }

  .pcl-h3 { display: flex; align-items: center; justify-content: space-between; } .pcl-h3 b { font-size: 1.1em; } .pcl-h3 span { padding: .1em .8em; border-radius: 99px; background: rgba(245, 177, 61, .2); color: var(--amber); font-weight: 800; font-size: .85em; }
  .pcl-lp { display: grid; gap: .6em; }
  .pcl-r { position: relative; display: flex; align-items: center; gap: .8em; padding: .65em .9em; border-radius: 1em; background: rgba(255, 255, 255, .07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .09); opacity: 0; transform: translateX(calc(1.6em * var(--dir))); transition: background .5s, box-shadow .5s; }
  .pcl.t1 .s3 .pcl-r { opacity: 1; transform: none; transition: opacity .4s calc(var(--i) * .22s), transform .6s calc(var(--i) * .22s) cubic-bezier(.3, 1.4, .5, 1), background .5s, box-shadow .5s; }
  .pcl-r p { display: grid; line-height: 1.3; min-width: 0; } .pcl-r p b { font-size: .98em; } .pcl-r p span { font-size: .75em; color: rgba(255, 255, 255, .55); font-weight: 600; }
  .pcl-r em { margin-inline-start: auto; display: grid; justify-items: end; font-style: normal; line-height: 1.3; } .pcl-r em b { font-size: .95em; white-space: nowrap; } .pcl-r em span { font-size: .68em; color: rgba(255, 255, 255, .5); font-weight: 600; }
  .pcl-wa { position: relative; display: grid; place-items: center; flex: none; width: 2.4em; height: 2.4em; border-radius: 99px; background: #25D366; color: #fff; transition: background .4s, transform .3s; }
  .pcl-wa .c { position: absolute; opacity: 0; transform: scale(.4); transition: opacity .25s, transform .4s cubic-bezier(.3, 1.8, .5, 1); } .pcl-wa .m { transition: opacity .2s; }
  .pcl.t2 .s3 .r1 .pcl-wa { background: rgba(255, 255, 255, .2); animation: pcl-press .5s .2s; } .pcl.t2 .s3 .r1 .pcl-wa .c { opacity: 1; transform: none; } .pcl.t2 .s3 .r1 .pcl-wa .m { opacity: 0; }
  @keyframes pcl-press { 40% { transform: scale(.82); } }
  .pcl-back { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; gap: .8em; padding: 0 .9em; border-radius: 1em; background: linear-gradient(90deg, #05B962, #0BCB77); color: #001E3E; opacity: 0; transform: scale(.96); transition: opacity .3s, transform .5s cubic-bezier(.3, 1.6, .5, 1); }
  .pcl-back .pcl-av { background: #001E3E; color: #5be3a4; }
  .pcl-back .pb2 { display: grid; line-height: 1.3; min-width: 0; } .pcl-back .pb2 b { font-size: .98em; } .pcl-back .pb2 span { font-size: .75em; font-weight: 700; color: rgba(0, 30, 62, .75); }
  .pcl-back .amt { margin-inline-start: auto; padding: .2em .75em; border-radius: 99px; background: #001E3E; color: #5be3a4; font-size: .9em; white-space: nowrap; }
  .pcl.t3 .s3 .pcl-back { opacity: 1; transform: none; box-shadow: 0 0 0 0 rgba(5, 185, 98, .7); animation: pcl-ring 1.4s .2s ease-out 2; }
  @keyframes pcl-ring { to { box-shadow: 0 0 0 1.2em rgba(5, 185, 98, 0); } }
  .pcl-meter p { display: flex; justify-content: space-between; font-size: .78em; font-weight: 700; color: rgba(255, 255, 255, .65); } .pcl-meter b { color: #fff; font-variant-numeric: tabular-nums; } .pcl-meter i { font-style: normal; }
  .pcl-mb { display: block; height: .55em; margin-top: .45em; border-radius: 99px; background: rgba(255, 255, 255, .1); overflow: hidden; } .pcl-mb u { display: block; height: 100%; width: 28%; border-radius: inherit; background: var(--pg); transition: width .8s cubic-bezier(.2, .8, .2, 1); }
  .pcl.t2 .s3 .pcl-mb u, .pcl.t3 .s3 .pcl-mb u { width: 32%; }

  .pcl-drop { position: relative; display: grid; place-items: center; height: 7.6em; border-radius: 1.2em; border: .14em dashed rgba(255, 255, 255, .25); background: rgba(255, 255, 255, .04); overflow: hidden; }
  .pcl-dz { position: absolute; inset-inline: 0; bottom: 1em; text-align: center; font-size: .78em; font-weight: 600; color: rgba(255, 255, 255, .5); transition: opacity .3s; }
  .pcl-file { display: flex; align-items: center; gap: .8em; padding: .7em 1.1em; border-radius: 1em; background: #fff; color: #001E3E; box-shadow: 0 1.4em 2em -.8em rgba(0, 0, 0, .6); opacity: 0; transform: translateY(-5em) rotate(-4deg); }
  .pcl-file .ic { display: grid; place-items: center; width: 2.3em; height: 2.3em; border-radius: .7em; background: #0B7A44; color: #fff; } .pcl-file .tx { display: grid; line-height: 1.3; } .pcl-file i { font-style: normal; font-size: .72em; font-weight: 600; color: #6B7A8C; }
  .pcl.t1 .s4 .pcl-file { opacity: 1; transform: none; transition: opacity .3s, transform .8s cubic-bezier(.3, 1.4, .5, 1); }
  .pcl.t1 .s4 .pcl-dz { opacity: 0; }
  .pcl-il { position: relative; display: flex; align-items: center; height: 1.4em; font-size: .85em; font-weight: 700; } .pcl-il span { position: absolute; display: flex; align-items: center; gap: .4em; transition: opacity .3s; }
  .pcl-il .a { color: rgba(255, 255, 255, .75); opacity: 0; } .pcl-il .b { color: #5be3a4; opacity: 0; }
  .pcl.t2 .s4 .pcl-il .a { opacity: 1; } .pcl.t3 .s4 .pcl-il .a { opacity: 0; } .pcl.t3 .s4 .pcl-il .b { opacity: 1; }
  .pcl-pb { display: block; height: .6em; margin-top: .4em; border-radius: 99px; background: rgba(255, 255, 255, .1); overflow: hidden; } .pcl-pb u { display: block; height: 100%; width: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--pg), #5be3a4); transform: scaleX(0); transform-origin: left; transition: transform 1.8s cubic-bezier(.4, 0, .2, 1); }
  [dir="rtl"] .pcl-pb u { transform-origin: right; }
  .pcl.t2 .s4 .pcl-pb u, .pcl.t3 .s4 .pcl-pb u { transform: none; }
  .pcl-cnt { display: grid; grid-template-columns: 1fr 1fr; gap: .55em; }
  .pcl-cnt p { padding: .65em .9em; border-radius: .9em; background: rgba(255, 255, 255, .07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08); } .pcl-cnt span { display: block; font-size: .68em; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: rgba(255, 255, 255, .5); } .pcl-cnt b { font-size: 1.6em; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.2; }
  .pcl-ck { display: grid; gap: .5em; font-size: .85em; font-weight: 600; color: rgba(255, 255, 255, .8); }
  .pcl-ck li { display: flex; align-items: center; gap: .6em; opacity: 0; transform: translateY(.8em); } .pcl-ck li :global(svg) { color: var(--pg); flex: none; }
  .pcl-ck u { margin-inline-start: auto; text-decoration: none; padding: .25em .8em; border-radius: 99px; background: rgba(255, 255, 255, .12); color: #fff; font-size: .9em; white-space: nowrap; }
  .pcl.t3 .s4 .pcl-ck li { opacity: 1; transform: none; transition: opacity .4s, transform .5s cubic-bezier(.3, 1.4, .5, 1); } .pcl.t3 .s4 .pcl-ck li:nth-child(2) { transition-delay: .35s; }

  .pcl-redo { display: flex; align-items: center; gap: .5em; margin: 1.2rem auto 0; padding: .5rem 1rem; border-radius: 999px; color: rgba(255, 255, 255, .7); font-size: .9rem; font-weight: 600; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .25); transition: background .2s; }
  .pcl-redo:hover { background: rgba(255, 255, 255, .1); }

  .pcl-it { position: relative; display: flex; gap: 1rem; padding: 1.1rem 1.2rem; border-radius: 1.4rem; background: rgba(255, 255, 255, .05); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .1); cursor: pointer; overflow: hidden; transition: box-shadow .4s, background .4s; }
  .pcl-it:focus-visible { outline: 2px solid var(--pg); outline-offset: 2px; }
  .pcl-ico { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 1rem; background: rgba(255, 255, 255, .1); color: var(--pg); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .15); transition: background .4s, color .4s; }
  .pcl-it.on { background: rgba(5, 185, 98, .1); box-shadow: inset 0 0 0 2px var(--pg), 0 1.4rem 2.4rem -1.6rem rgba(5, 185, 98, .8); }
  .pcl-it.on .pcl-ico { background: var(--pg); color: #001E3E; }
  .pcl-prog { position: absolute; inset-inline: 0; bottom: 0; height: 3px; background: var(--pg); transform: scaleX(0); transform-origin: left; } [dir="rtl"] .pcl-prog { transform-origin: right; }
  .pcl.run .pcl-it.on .pcl-prog { animation: pcl-fill var(--dur, 8s) linear forwards; }
  @keyframes pcl-fill { to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .pcl-sc, .pcl-hl, .pcl-spark i, .pcl-d, .pcl-undo, .pcl-all, .pcl-r, .pcl-back, .pcl-file, .pcl-pb u, .pcl-ck li, .pcl-win, .pcl-mb u, .pcl-badge { transition: none !important; animation: none !important; }
    .pcl-glow, .pcl-live { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pcl]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const panel = root.querySelector<HTMLElement>('[data-panel]');
    const redo = root.querySelector<HTMLElement>('[data-redo]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-it]')];
    const el = (s: string) => root.querySelector<HTMLElement>(s);
    const c1 = el('[data-c1]'), spent = el('[data-spent]'), sent = el('[data-sent]'), cl = el('[data-cl]'), dp = el('[data-dp]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (n: number) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '\u00A0');
    // how long each scene stays, in ms
    const DUR = [6800, 7200, 7600, 7800];
    let timers: number[] = [], raf: number[] = [], scene = 0, visible = false, auto = false;
    const sub = (n: number) => { for (let k = 1; k <= 3; k++) root.classList.toggle('t' + k, k <= n); };
    const anim = (ms: number, fn: (p: number) => void) => {
      const t0 = performance.now();
      const tick = (now: number) => { const p = Math.min(1, (now - t0) / ms); fn(1 - Math.pow(1 - p, 3)); if (p < 1) raf.push(requestAnimationFrame(tick)); };
      raf.push(requestAnimationFrame(tick));
    };
    const clear = () => { timers.forEach(clearTimeout); raf.forEach(cancelAnimationFrame); timers = []; raf = []; };
    const setNums = (n: number, final: boolean) => {
      if (c1) c1.textContent = final && n === 1 ? '18' : '0';
      if (spent) spent.textContent = final && n === 1 ? fmt(2340) : '0';
      if (sent) sent.textContent = final && n === 3 ? '8' : '7';
      if (cl) cl.textContent = final && n === 4 ? fmt(1284) : '0';
      if (dp) dp.textContent = final && n === 4 ? fmt(3920) : '0';
    };
    const mark = (n: number) => {
      root.dataset.s = String(n);
      items.forEach((it, i) => {
        const on = i === n - 1;
        it.classList.toggle('on', on);
        if (on) { it.style.setProperty('--dur', DUR[i] + 'ms'); it.classList.remove('on'); void it.offsetWidth; it.classList.add('on'); }
      });
    };
    const go = (n: number) => {
      clear(); scene = n; mark(n);
      if (still) { sub(3); setNums(n, true); return; }
      const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
      at(420, () => { sub(0); setNums(n, false); });
      if (n === 1) {
        at(800, () => { sub(1); anim(1500, (p) => { if (c1) c1.textContent = String(Math.round(18 * p)); if (spent) spent.textContent = fmt(2340 * p); }); });
        at(2000, () => sub(2)); at(3400, () => sub(3));
      } else if (n === 2) {
        at(1500, () => sub(1)); at(3300, () => sub(2)); at(4700, () => sub(3));
      } else if (n === 3) {
        at(800, () => sub(1)); at(2700, () => { sub(2); if (sent) sent.textContent = '8'; }); at(4600, () => sub(3));
      } else {
        at(800, () => sub(1));
        at(2000, () => { sub(2); anim(1800, (p) => { if (cl) cl.textContent = fmt(1284 * p); if (dp) dp.textContent = fmt(3920 * p); }); });
        at(4000, () => sub(3));
      }
      if (auto) at(DUR[n - 1], () => go(n === 4 ? 1 : n + 1));
    };
    const jump = (n: number) => { if (!still) { auto = true; root.classList.add('run'); } go(n); };
    if (still) { go(1); }
    else {
      new IntersectionObserver((es) => {
        const v = es[0].isIntersecting;
        if (v && !visible) { visible = true; auto = true; root.classList.add('run'); go(scene || 1); }
        else if (!v && visible) { visible = false; auto = false; root.classList.remove('run'); clear(); }
      }, { threshold: 0.35 }).observe(stage ?? root);
      redo?.addEventListener('click', () => jump(1));
      stage?.addEventListener('click', () => jump(scene === 4 ? 1 : scene + 1));
      // tilt with the pointer, away from touch screens
      if (matchMedia('(hover: hover) and (pointer: fine)').matches && stage && panel) {
        const rtl = document.documentElement.dir === 'rtl' ? -1 : 1;
        panel.addEventListener('pointermove', (e) => {
          const r = panel.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
          stage.style.setProperty('--ry', (x * 7 * rtl).toFixed(2) + 'deg');
          stage.style.setProperty('--rx', (-y * 6).toFixed(2) + 'deg');
        });
        panel.addEventListener('pointerleave', () => { stage.style.setProperty('--ry', '0deg'); stage.style.setProperty('--rx', '0deg'); });
      }
    }
    items.forEach((it, i) => {
      it.addEventListener('click', () => jump(i + 1));
      it.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); jump(i + 1); } });
    });
  }
</script>
