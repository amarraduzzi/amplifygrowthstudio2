---
// The hero of the Dentists page: the Agenda tab of the practice app, played live. It copies the real screen:
// the dark navy app, the tabs, the waiting room on the left (counters, who waits and for how long, who is in the
// chair) and the day per chair on the right, one block per appointment coloured by its state.
// The morning plays out: bookings land, a WhatsApp reminder confirms one, a patient checks in with the QR,
// is called into the chair, a request comes in from the practice's site. Loops while in view.
// Reduced motion: the end state is shown at once. Demo practice, invented names.
import { tr, langOf } from '../i18n/t';
const lang = langOf(Astro.url);
const tt = tr(lang);
const LOC = { fr: 'fr-FR', en: 'en-GB', ar: 'ar-MA-u-nu-latn' }[lang];
type St = 'booked' | 'confirmed' | 'arrived' | 'in_chair' | 'done' | 'pending';
// id, chair, start (minutes after 9:00), duration, patient, act, state at the start of the loop
const A: [string, number, number, number, string, string, St][] = [
  ['a', 1, 0, 30, 'Nadia Chraibi', tt('Détartrage'), 'done'],
  ['b', 2, 0, 45, 'Omar Tazi', tt('Soin carie'), 'done'],
  ['c', 1, 45, 60, 'Youssef Benali', tt('Implant 46'), 'in_chair'],
  ['d', 2, 60, 30, 'Sara El Idrissi', tt('Consultation'), 'booked'],
  ['e', 2, 105, 30, 'Mehdi Alaoui', tt('Couronne'), 'booked'],
  ['f', 1, 120, 45, 'Khadija Bennis', tt('Dévitalisation'), 'booked'],
  ['g', 2, 150, 30, 'Rachid Amrani', tt('Contrôle'), 'pending'],
  ['h', 1, 180, 45, 'Lina Squalli', tt('Blanchiment'), 'booked'],
];
const SPAN = 240; // 9:00 to 13:00
const NOW = 75;   // 10:15
const hh = (m: number) => `${String(9 + Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
const day = new Date().toLocaleDateString(LOC, { weekday: 'long', day: 'numeric', month: 'long' });
const LABEL: Record<St, string> = { booked: tt('Prévu'), confirmed: tt('Confirmé'), arrived: tt('En salle d’attente'), in_chair: tt('Au fauteuil'), done: tt('Terminé'), pending: tt('Demande en ligne') };
---
<div class="dh" data-dh data-a={JSON.stringify(A.map(a => [a[0], a[6]]))} dir="ltr" aria-hidden="true"><div class="dh-in">
  <div class="dh-bar">
    <span class="dh-logo">CA</span>
    <div class="dh-who"><b>Cabinet Dr Alami</b><small>10:15 · Salma</small></div>
    <div class="dh-tabs">
      {[tt('Agenda'), tt('Patients'), tt('Rappels'), tt('Devis'), tt('Caisse')].map((x, i) => <span class={i === 0 ? 'on' : ''}>{x}</span>)}
    </div>
  </div>
  <div class="dh-body">
    <!-- the waiting room, right now -->
    <div class="dh-side">
      <div class="dh-cnt">
        <span><b class="w" data-n="arrived">0</b><small>{tt('Attendent')}</small></span>
        <span><b class="c" data-n="in_chair">1</b><small>{tt('Au fauteuil')}</small></span>
        <span><b class="d" data-n="done">2</b><small>{tt('Terminés')}</small></span>
      </div>
      <div class="dh-room">
        <p class="dh-h"><i class="dh-clock"></i>{tt('Salle d’attente')}</p>
        <p class="dh-empty">{tt('Personne n’attend.')}</p>
        <ul class="dh-list">
          {A.filter(a => a[0] === 'd' || a[0] === 'f').map(a => (
            <li class="dh-w" data-w={a[0]}>
              <span class="dh-wn"><b>{a[4]}{a[0] === 'd' && <i class="dh-qr" title="QR"></i>}</b><small>{tt('RDV')} {hh(a[2])} · {tt('Fauteuil')} {a[1]}</small>{a[0] === 'd' && <em>{tt('Questionnaire rempli')}</em>}</span>
              <span class="dh-min" data-min={a[0]}>0′</span>
            </li>))}
        </ul>
        <p class="dh-sub">{tt('Au fauteuil')}</p>
        <ul class="dh-list">
          {A.filter(a => a[0] === 'c' || a[0] === 'd').map(a => (
            <li class="dh-ch" data-c={a[0]}><span class="dh-wn"><b>{a[4]}</b><small>{tt('Fauteuil')} {a[1]} · {a[5]}</small></span><span class="dh-done">{tt('Terminé')}</span></li>))}
        </ul>
      </div>
    </div>
    <!-- the day, per chair -->
    <div class="dh-agenda">
      <div class="dh-top"><b>{day}</b><span class="dh-new">+ {tt('Rendez-vous')}</span></div>
      <div class="dh-chairs"><span></span><span>{tt('Fauteuil')} 1</span><span>{tt('Fauteuil')} 2</span></div>
      <div class="dh-grid">
        <div class="dh-hours">{[1, 2, 3].map(h => <span style={`top:${(h * 60 / SPAN) * 100}%`}>{hh(h * 60)}</span>)}</div>
        {[1, 2].map(c => (
          <div class="dh-col">
            {Array.from({ length: SPAN / 30 }, (_, i) => <i class={i % 2 ? 'half' : ''} style={`top:${(i * 30 / SPAN) * 100}%`}></i>)}
            {A.filter(a => a[1] === c).map(([id, , s, n, who, act, st]) => (
              <span class="dh-b" data-b={id} data-s={st} style={`top:calc(${(s / SPAN) * 100}% + 1px);height:calc(${(n / SPAN) * 100}% - 2px)`}>
                <b><small>{hh(s)}</small>{who}<i class="dh-ok"></i><i class="dh-web"></i><i class="dh-card"></i></b>
                <em>{act} · <span data-l>{LABEL[st]}</span></em>
              </span>))}
          </div>))}
        <div class="dh-now" style={`top:${(NOW / SPAN) * 100}%`}><small>10:15</small><i></i></div>
      </div>
    </div>
  </div>
  <script type="application/json" data-labels set:html={JSON.stringify(LABEL)} />
</div></div>

<style is:global>
  .dh { container-type: inline-size; position: relative; background: #020F20; color: #ECF2FA; font-family: inherit; }
  .dh-in { font-size: 2.15cqw; }
  .dh-bar { display: flex; align-items: center; gap: 1.2em; padding: 1em 1.4em; background: #071B36; border-bottom: 1px solid rgba(210, 225, 245, .07); }
  .dh-logo { display: grid; place-items: center; width: 2.5em; height: 2.5em; border-radius: 30%; background: #05B962; color: #001E3E; font-weight: 800; font-size: .85em; }
  .dh-who b { display: block; font-size: 1.1em; } .dh-who small { color: #8CA0BE; font-size: .78em; }
  .dh-tabs { margin-inline-start: auto; display: flex; gap: .25em; padding: .25em; border-radius: .8em; background: rgba(2, 15, 32, .7); border: 1px solid rgba(210, 225, 245, .06); }
  .dh-tabs span { padding: .45em .8em; border-radius: .6em; font-size: .8em; font-weight: 700; color: #8CA0BE; }
  .dh-tabs .on { background: linear-gradient(160deg, #26D07D, #05B962); color: #001E3E; }
  .dh-body { display: grid; grid-template-columns: 31% 1fr; gap: 1em; padding: 1em; }
  .dh-cnt { display: grid; grid-template-columns: repeat(3, 1fr); gap: .45em; text-align: center; }
  .dh-cnt span { background: #071B36; border-radius: .7em; padding: .55em .2em; }
  .dh-cnt b { display: block; font-size: 1.9em; line-height: 1; font-weight: 800; font-variant-numeric: tabular-nums; transition: transform .35s cubic-bezier(.3,1.6,.5,1); }
  .dh-cnt b.bump { transform: scale(1.35); }
  .dh-cnt .w { color: #F2AD46; } .dh-cnt .c { color: #05B962; } .dh-cnt .d { color: #8CA0BE; }
  .dh-cnt small { display: block; margin-top: .3em; font-size: .58em; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #8CA0BE; }
  .dh-room { margin-top: .6em; background: #071B36; border-radius: .9em; padding: .8em; min-height: 15em; }
  .dh-h { display: flex; align-items: center; gap: .45em; font-weight: 800; font-size: 1.02em; }
  .dh-clock { width: .95em; height: .95em; border-radius: 50%; border: .14em solid #F2AD46; position: relative; }
  .dh-clock::after { content: ""; position: absolute; left: 40%; top: 15%; width: .12em; height: .4em; background: #F2AD46; }
  .dh-empty { margin: .7em 0 .2em; text-align: center; font-size: .75em; color: #8CA0BE; transition: opacity .3s; }
  .dh-room.has-w .dh-empty { display: none; }
  .dh-list { list-style: none; margin: 0; padding: 0; }
  .dh-w, .dh-ch { display: flex; align-items: center; gap: .5em; border-radius: .7em; padding: 0 .6em; max-height: 0; opacity: 0; overflow: hidden; transform: translateX(-1.2em);
    transition: max-height .5s cubic-bezier(.2,.8,.2,1), opacity .4s, transform .5s cubic-bezier(.2,.8,.2,1), padding .5s, margin .5s; }
  .dh-w { background: #020F20; } .dh-ch { background: rgba(5, 185, 98, .1); box-shadow: inset 0 0 0 1px rgba(5, 185, 98, .25); }
  .dh-w.on, .dh-ch.on { max-height: 4.6em; opacity: 1; transform: none; padding: .45em .6em; margin-top: .4em; }
  .dh-wn { min-width: 0; flex: 1; }
  .dh-wn b { display: flex; align-items: center; gap: .35em; font-size: .82em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dh-wn small { display: block; font-size: .64em; color: #8CA0BE; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dh-wn em { display: inline-block; margin-top: .2em; font-style: normal; font-size: .58em; font-weight: 800; color: #588CFF; background: rgba(88, 140, 255, .15); border-radius: .3em; padding: .1em .4em; }
  .dh-qr { width: .8em; height: .8em; background: conic-gradient(#8CA0BE 25%, transparent 0 50%, #8CA0BE 0 75%, transparent 0) 0 0 / .4em .4em; border-radius: .1em; flex-shrink: 0; }
  .dh-min { font-weight: 800; font-size: 1.05em; color: #2DD4BF; font-variant-numeric: tabular-nums; }
  .dh-sub { margin-top: .8em; font-size: .6em; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #8CA0BE; }
  .dh-done { font-size: .62em; font-weight: 800; color: #001E3E; background: #05B962; border-radius: .45em; padding: .4em .6em; transition: transform .2s; }
  .dh-done.press { transform: scale(.88); box-shadow: 0 0 0 .4em rgba(5, 185, 98, .3); }
  .dh-agenda { background: #071B36; border-radius: .9em; overflow: hidden; display: flex; flex-direction: column; }
  .dh-top { display: flex; align-items: center; justify-content: space-between; padding: .7em .9em; border-bottom: 1px solid rgba(210, 225, 245, .07); }
  .dh-top b { font-size: 1.05em; } .dh-top b::first-letter { text-transform: uppercase; }
  .dh-new { font-size: .72em; font-weight: 800; color: #001E3E; background: #05B962; border-radius: .6em; padding: .5em .8em; }
  .dh-chairs { display: grid; grid-template-columns: 3.4em 1fr 1fr; border-bottom: 1px solid rgba(210, 225, 245, .07); }
  .dh-chairs span { padding: .45em; text-align: center; font-size: .62em; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #8CA0BE; }
  .dh-grid { position: relative; display: grid; grid-template-columns: 3.4em 1fr 1fr; height: 21em; }
  .dh-hours { position: relative; }
  .dh-hours span { position: absolute; right: .5em; transform: translateY(-50%); font-size: .62em; font-weight: 700; color: #8CA0BE; }
  .dh-col { position: relative; border-left: 1px solid rgba(210, 225, 245, .07); }
  .dh-col > i { position: absolute; left: 0; right: 0; border-top: 1px solid rgba(210, 225, 245, .09); }
  .dh-col > i.half { border-top-style: dashed; border-color: rgba(210, 225, 245, .05); }
  .dh-b { position: absolute; left: .3em; right: .3em; display: flex; flex-direction: column; justify-content: flex-start; padding: .3em .5em; border-radius: .5em; overflow: hidden; line-height: 1.15;
    transition: background-color .5s, box-shadow .5s, color .5s, opacity .45s, transform .7s cubic-bezier(.2,.85,.25,1); }
  .dh-b b { display: flex; align-items: center; gap: .3em; font-size: .74em; white-space: nowrap; overflow: hidden; }
  .dh-b b small { font-size: .85em; opacity: .7; font-weight: 800; }
  .dh-b em { font-style: normal; font-size: .62em; font-weight: 600; opacity: .78; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dh-b i { display: none; flex-shrink: 0; }
  .dh-ok { width: .8em; height: .45em; border-left: .16em solid #588CFF; border-bottom: .16em solid #588CFF; transform: rotate(-45deg) translateY(-.1em); }
  .dh-web { width: .85em; height: .85em; border-radius: 50%; border: .14em solid #F2AD46; }
  .dh-card { width: 1.1em; height: .75em; border-radius: .15em; background: linear-gradient(#05B962 0 30%, #ECF2FA 30% 48%, #05B962 48%); }
  .dh-b[data-s='booked'] { background: #163662; box-shadow: inset 0 0 0 1px rgba(210, 225, 245, .2); }
  .dh-b[data-s='confirmed'] { background: rgba(88, 140, 255, .2); box-shadow: inset 0 0 0 1px rgba(88, 140, 255, .5); }
  .dh-b[data-s='confirmed'] .dh-ok { display: block; }
  .dh-b[data-s='arrived'] { background: rgba(242, 173, 70, .25); box-shadow: inset 0 0 0 1px rgba(242, 173, 70, .6); }
  .dh-b[data-s='in_chair'] { background: rgba(5, 185, 98, .25); box-shadow: inset 0 0 0 1px rgba(5, 185, 98, .7); }
  .dh-b[data-s='done'] { background: #0D274A; color: #8CA0BE; box-shadow: inset 0 0 0 1px rgba(210, 225, 245, .1); }
  .dh-b[data-s='pending'] { background: repeating-linear-gradient(135deg, rgba(242, 173, 70, .2) 0 .5em, rgba(242, 173, 70, .08) .5em 1em); box-shadow: inset 0 0 0 1px #F2AD46; }
  .dh-b[data-s='pending'] .dh-web { display: block; }
  .dh-b.paid .dh-card { display: block; }
  .dh-b.flash { animation: dh-flash 1s ease-out; }
  @keyframes dh-flash { 0% { box-shadow: 0 0 0 0 rgba(5, 185, 98, .9); } 100% { box-shadow: 0 0 0 .9em rgba(5, 185, 98, 0); } }
  .dh-b.off { opacity: 0; transform: translateY(-2.5em) scale(.85); }
  .dh-now { position: absolute; left: 0; right: 0; z-index: 2; display: flex; align-items: center; pointer-events: none; }
  .dh-now small { width: 5.2em; padding-right: .3em; text-align: right; font-size: .62em; font-weight: 800; color: #F46363; }
  .dh-now i { flex: 1; height: .14em; background: #F46363; }
  .dh.out .dh-b, .dh.out .dh-w, .dh.out .dh-ch { opacity: 0; transition: opacity .5s; }
  @media (prefers-reduced-motion: reduce) { .dh-b, .dh-w, .dh-ch { transition: none; } }
</style>

<script>
  type St = 'booked' | 'confirmed' | 'arrived' | 'in_chair' | 'done' | 'pending';
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-dh]').forEach((root) => {
    const start = Object.fromEntries(JSON.parse(root.dataset.a || '[]') as [string, St][]) as Record<string, St>;
    const labels = JSON.parse(root.querySelector('[data-labels]')?.textContent || '{}') as Record<St, string>;
    const blocks = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-b]')].map(b => [b.dataset.b!, b]));
    const waits = [...root.querySelectorAll<HTMLElement>('[data-w]')], chairs = [...root.querySelectorAll<HTMLElement>('[data-c]')];
    const nums = [...root.querySelectorAll<HTMLElement>('[data-n]')];
    const room = root.querySelector<HTMLElement>('.dh-room')!;
    const mins = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-min]')].map(m => [m.dataset.min!, m]));
    let st: Record<string, St> = { ...start };
    const since: Record<string, number> = {};
    const render = () => {
      for (const [id, b] of Object.entries(blocks)) {
        if (b.dataset.s !== st[id]) { b.dataset.s = st[id]; const l = b.querySelector('[data-l]'); if (l) l.textContent = labels[st[id]]; }
      }
      waits.forEach(w => w.classList.toggle('on', st[w.dataset.w!] === 'arrived'));
      chairs.forEach(c => c.classList.toggle('on', st[c.dataset.c!] === 'in_chair'));
      room.classList.toggle('has-w', waits.some(w => st[w.dataset.w!] === 'arrived'));
      nums.forEach(n => {
        const v = String(Object.values(st).filter(s => s === n.dataset.n).length);
        if (n.textContent !== v) { n.textContent = v; n.classList.add('bump'); setTimeout(() => n.classList.remove('bump'), 350); }
      });
    };
    let timers: number[] = [], running = false;
    const later = (ms: number, f: () => void) => { timers.push(window.setTimeout(f, ms)); };
    const set = (id: string, s: St, flash = true) => { st[id] = s; if (s === 'arrived') since[id] = 0; render(); if (flash) { blocks[id].classList.remove('flash'); void blocks[id].offsetWidth; blocks[id].classList.add('flash'); } };
    if (still) { st = { ...start, d: 'in_chair', e: 'confirmed', f: 'arrived', g: 'confirmed', c: 'done' }; blocks.h.classList.add('paid'); render(); return; }
    // the waiting minutes tick (one demo minute every 0.9 s)
    const tick = () => { for (const [id, m] of Object.entries(mins)) { if (st[id] === 'arrived') { since[id] = (since[id] ?? 0) + 1; m.textContent = `${since[id]}′`; m.style.color = since[id] >= 15 ? '#F2AD46' : '#2DD4BF'; } } };
    const press = (id: string) => { const b = chairs.find(c => c.dataset.c === id)?.querySelector('.dh-done'); b?.classList.add('press'); later(260, () => b?.classList.remove('press')); };
    const loop = () => {
      root.classList.remove('out');
      st = { ...start }; Object.keys(since).forEach(k => delete since[k]); Object.values(mins).forEach(m => { m.textContent = '0′'; });
      const fresh = ['d', 'e', 'f', 'g', 'h'];
      fresh.forEach(id => blocks[id].classList.add('off')); blocks.h.classList.remove('paid'); render();
      fresh.filter(id => id !== 'g').forEach((id, i) => later(400 + i * 380, () => blocks[id].classList.remove('off')));
      later(2600, () => set('e', 'confirmed'));                 // the WhatsApp reminder is confirmed
      later(4000, () => set('d', 'arrived'));                   // Sara checks in with the QR
      later(5600, () => set('f', 'arrived'));                   // Khadija is early
      later(7000, () => blocks.g.classList.remove('off'));      // a request from the site lands
      later(8600, () => { press('c'); set('c', 'done'); });     // the implant is done
      later(9600, () => set('d', 'in_chair'));                  // Sara is called in
      later(11000, () => { blocks.h.classList.add('paid'); blocks.h.classList.remove('flash'); void blocks.h.offsetWidth; blocks.h.classList.add('flash'); }); // deposit paid by card
      later(12400, () => set('g', 'confirmed'));                // the request is accepted
      later(16500, () => root.classList.add('out'));
      later(17200, loop);
    };
    let iv = 0;
    const go = () => { if (running) return; running = true; loop(); iv = window.setInterval(tick, 900); };
    const stop = () => { running = false; timers.forEach(clearTimeout); timers = []; clearInterval(iv); };
    if (!('IntersectionObserver' in window)) { go(); return; }
    new IntersectionObserver(([e]) => { if (e.isIntersecting) go(); else stop(); }, { threshold: 0.3 }).observe(root);
  });
</script>
