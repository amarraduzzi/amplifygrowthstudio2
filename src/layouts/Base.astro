---
import '../styles/global.css';
import { SITE, CONTACT, isPlaceholder } from '../config';
import { ROUTES, LOCALE, liveLanguages, abs, type Lang, type PageKey } from '../i18n/routes';
import { copy } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaButton from '../components/WaButton.astro';

interface Props {
  lang: Lang; page: PageKey; title: string; description: string; wa: string;
  schema?: Record<string, unknown>[];
  /** pages that exist in some languages only (e.g. a French article): no hreflang or language menu for the others */
  langsOnly?: Lang[];
  /** in-page index shown at the top of the phone menu */
  toc?: { id: string; label: string }[];
}
const { lang, page, title, description, wa, schema = [], langsOnly, toc } = Astro.props;
const t = copy(lang);
const canonical = abs(ROUTES[page][lang]);
const langs = langsOnly ?? liveLanguages();

// The business itself, on every page (NAP identical everywhere). Unknown fields are left out.
const address = {
  '@type': 'PostalAddress', addressLocality: CONTACT.city, addressCountry: CONTACT.country,
  ...(isPlaceholder(CONTACT.street) ? {} : { streetAddress: CONTACT.street }),
  ...(isPlaceholder(CONTACT.postalCode) ? {} : { postalCode: CONTACT.postalCode }),
};
const business = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': `${SITE.url}/#business`,
  name: SITE.name, url: SITE.url, telephone: `+${CONTACT.whatsapp}`, email: CONTACT.email, address,
  areaServed: { '@type': 'Country', name: 'Maroc' },
  ...(isPlaceholder(CONTACT.googleProfileUrl) ? {} : { sameAs: [CONTACT.googleProfileUrl] }),
};
const crumbs = page === 'home' ? [] : [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.ui.home, item: abs(ROUTES.home[lang]) },
    { '@type': 'ListItem', position: 2, name: title.split(/[|,]/)[0].trim(), item: canonical },
  ],
}];
const ld = [business, ...crumbs, ...schema];
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!SITE.live && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  {langs.map(l => <link rel="alternate" hreflang={LOCALE[l]} href={abs(ROUTES[page][l])} />)}
  <link rel="alternate" hreflang="x-default" href={abs(ROUTES[page].fr)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={LOCALE[lang].replace('-', '_')} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="theme-color" content="#001E3E" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
</head>
<body class="min-h-dvh overflow-x-clip">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-paper focus:px-4 focus:py-2">{t.ui.skip}</a>
  <Header lang={lang} page={page} wa={wa} langs={langs} toc={toc} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
  <!-- on phones the WhatsApp button stays at the bottom of the screen -->
  <div id="sticky-wa" class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 px-3 py-2 backdrop-blur transition-transform duration-300 md:hidden">
    <WaButton text={wa} label={t.ui.whatsapp} where={`${page}-sticky`} class="min-h-11! w-full" />
  </div>
  <div class="h-16 bg-navy md:hidden" aria-hidden="true"></div>
  <script>
    // Phones: the bottom WhatsApp bar stays out of the way. It appears once the hero button has scrolled
    // away, and hides again whenever another WhatsApp button is on screen (no double button, nothing covered).
    const heroCta = document.getElementById('hero-cta');
    const bar = document.getElementById('sticky-wa');
    if (bar && 'IntersectionObserver' in window) {
      let heroPast = !heroCta;
      const seen = new Set<Element>();
      const apply = () => { const h = !heroPast || seen.size > 0; bar.style.transform = h ? 'translateY(110%)' : ''; bar.inert = h; };
      if (heroCta) { apply(); new IntersectionObserver(([e]) => { heroPast = !e.isIntersecting && e.boundingClientRect.top <= 0; apply(); }).observe(heroCta); }
      const io = new IntersectionObserver((es) => { es.forEach(e => e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)); apply(); }, { rootMargin: '-64px 0px -72px 0px' });
      document.querySelectorAll('a[data-wa]').forEach(a => { if (!bar.contains(a) && !a.closest('header')) io.observe(a); });
    }
    // Swipeable rows (tabs, chips): a soft fade on the side where more is hidden, so visitors know they can swipe.
    const rows = [...document.querySelectorAll<HTMLElement>('.snap-row, .vp-tabs, .cs-tabs')];
    const edge = (el: HTMLElement) => {
      const max = el.scrollWidth - el.clientWidth, pos = Math.abs(el.scrollLeft), rtl = getComputedStyle(el).direction === 'rtl';
      const more = max > 4;
      const startMore = more && pos > 4, endMore = more && pos < max - 4;
      el.style.setProperty('--fl', String(+(rtl ? endMore : startMore)));
      el.style.setProperty('--fr', String(+(rtl ? startMore : endMore)));
    };
    rows.forEach(el => { el.classList.add('edge-fade'); edge(el); el.addEventListener('scroll', () => edge(el), { passive: true }); });
    addEventListener('resize', () => rows.forEach(edge));
    addEventListener('load', () => rows.forEach(edge));
    // Scroll-linked blocks: --p from 0 (block enters at the bottom) to 1 (block reaches the upper part of the screen).
    const scrubs = [...document.querySelectorAll<HTMLElement>('[data-scrub]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (scrubs.length && !still) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = innerHeight;
        for (const el of scrubs) {
          const r = el.getBoundingClientRect();
          const span = el.dataset.scrub === 'steps' ? r.height * 0.75 + vh * 0.1 : r.height + vh * 0.35;
          const p = Math.min(1, Math.max(0, (vh * 0.9 - r.top) / span));
          el.style.setProperty('--p', p.toFixed(3));
          const parts = el.dataset.scrub === 'words' ? el.querySelectorAll('.word') : el.querySelectorAll('.step');
          parts.forEach((w, i) => w.classList.toggle('on', p >= (parts.length === 1 ? 0 : i / (parts.length - 1)) * 0.92 + 0.04));
        }
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();
    } else scrubs.forEach(el => el.querySelectorAll('.word, .step').forEach(w => w.classList.add('on')));
    // WhatsApp clicks are the conversion: send them to analytics once it is added (dataLayer / gtag).
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[data-wa]') as HTMLAnchorElement | null;
      if (!a) return;
      const detail = { event: 'whatsapp_click', where: a.dataset.wa, lang: document.documentElement.lang };
      (window as any).dataLayer?.push(detail);
      (window as any).gtag?.('event', 'whatsapp_click', detail);
    });
  </script>
</body>
</html>
